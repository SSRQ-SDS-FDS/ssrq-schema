    <gloss versionDate="2025-02-03" xml:lang="de">Datum</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">date</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">date</gloss>
    <desc versionDate="2023-08-17" xml:lang="de">Enthält ein Datum.</desc>
    <desc versionDate="2023-08-17" xml:lang="en">Contains a date.</desc>
    <desc versionDate="2023-08-17" xml:lang="fr">Contient une date.</desc>
    <classes mode="replace">
        <memberOf key="att.calendarSystem"/>
        <memberOf key="att.datable"/>
        <memberOf key="att.datable.custom"/>
        <memberOf key="att.duration.iso"/>
        <memberOf key="att.typed"/>
        <memberOf key="macro.dateLike"/>
        <memberOf key="model.publicationStmtPart.detail"/>
    </classes>
    <content>
        <alternate maxOccurs="unbounded" minOccurs="0">
            <elementRef key="precision"/>
            <macroRef key="ssrq.content.default"/>
        </alternate>
    </content>
    <constraintSpec ident="sch-el-date-outside-teiHeader" mode="add" scheme="schematron"
    xml:lang="en">
        <desc versionDate="2025-02-08" xml:lang="en">constraint for tei:date outside
        tei:teiHeader</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:date[not(ancestor::tei:teiHeader)]">
                    <sch:assert test="string-length(normalize-space(.)) &gt; 0 or child::*"> The
                    element tei:date must not be empty when outside tei:teiHeader. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <constraintSpec ident="sch-el-date-publicationStmt" mode="add" scheme="schematron"
    xml:lang="en">
        <desc versionDate="2025-02-08" xml:lang="en">constraint for tei:date inside
        tei:publicationStmt</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:date[ancestor::tei:publicationStmt]">
                    <sch:assert test="string-length(normalize-space(.)) = 0 and not(child::*)"> If
                    tei:date is part of tei:publicationStmt it must be empty. </sch:assert>
                    <sch:assert test=".[@type][@type/data(.) = (&apos;electronic&apos;,
                    &apos;print&apos;)]"> If tei:date is part of tei:publicationStmt it must
                    contain @type with a value of &apos;electronic&apos; or &apos;print&apos;.
                    </sch:assert>
                    <sch:assert test=".[@when-custom or (@from-custom and
                    @to-custom)][not(@calendar|@dur-iso|@notAfter-custom|@notBefore-custom|@period)]"> If tei:date is part of tei:publicationStmt it must contain @when-custom or @from-custom and to-custom, and may not contain @calendar, @dur-iso, @notAfter-custom, @notBefore-custom or @period. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <constraintSpec ident="sch-el-date-electronic-print" mode="add" scheme="schematron"
    xml:lang="en">
        <desc versionDate="2025-02-17" xml:lang="en">constraint for tei:date with type
        &apos;electronic&apos; and &apos;print&apos; outside tei:publicationStmt</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:date[not(ancestor::tei:publicationStmt)]">
                    <sch:report test=".[@type=&apos;electronic&apos; or @type=&apos;print&apos;]">
                    If tei:date is outside tei:publicationStmt it may not be of @type
                    &apos;electronic&apos; or &apos;print&apos;. </sch:report>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="dur-iso" mode="change">
            <datatype>
                <dataRef key="ssrq.duriso.date"/>
            </datatype>
        </attDef>
        <attDef ident="period" mode="change">
            <datatype>
                <rng:choice>
                    <rng:ref name="ssrq.period.days"/>
                    <rng:ref name="ssrq.period.seasons"/>
                </rng:choice>
            </datatype>
        </attDef>
        <attDef ident="type" mode="replace">
            <desc versionDate="2025-02-03" xml:lang="de">die Art des Datums</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the type of date</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">le type de date</desc>
            <datatype>
                <dataRef key="ssrq.type.date"/>
            </datatype>
        </attDef>
    </attList>
