<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="body" mode="change" module="textstructure" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2023-07-14" xml:lang="de">Textbereich</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">text section</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">zone de texte</gloss>
    <desc versionDate="2025-02-05" xml:lang="de">Enthält den transkribierten Text einschliesslich
    aller sonstigen Textblöcke.</desc>
    <desc versionDate="2023-04-06" xml:lang="en">Contains the transcribed source text as well as
    the contemporaneous dorsual notes in <gi>ab</gi>.</desc>
    <desc versionDate="2025-02-05" xml:lang="fr">Contient le texte transcrit, y compris tous les
    autres blocs de texte.</desc>
    <classes mode="replace"/>
    <content>
        <alternate>
            <sequence preserveOrder="false">
                <elementRef key="ab" maxOccurs="unbounded" minOccurs="0"/>
                <elementRef key="div" maxOccurs="unbounded"/>
                <elementRef key="gap" maxOccurs="unbounded" minOccurs="0"/>
                <elementRef key="pb" maxOccurs="unbounded" minOccurs="0"/>
            </sequence>
            <elementRef key="bibl" maxOccurs="unbounded" minOccurs="2"/>
        </alternate>
    </content>
    <constraintSpec ident="sch-el-body" scheme="schematron" xml:lang="en">
        <desc versionDate="2025-05-05" xml:lang="en">constraint for tei:body</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:body[parent::tei:text[@type = &apos;collection&apos;]]">
                    <sch:assert test="every $child in ./* satisfies $child/name() =
                    &apos;bibl&apos;"> It&apos;s only allowed to use tei:bibl-elements directly
                    inside tei:body, when tei:body is part of tei:text with
                    type=&quot;collection&quot;. </sch:assert>
                </sch:rule>
                <sch:rule context="tei:body[parent::tei:text[not(@type =
                &apos;collection&apos;)]]">
                    <sch:report test=".[tei:bibl]"> It&apos;s only allowed to use tei:bibl-elements
                    directly inside tei:body, when tei:body is part of tei:text with
                    type=&quot;collection&quot;. </sch:report>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <xi:include href="examples.xml" xpointer="ex-body-de"/>
    <xi:include href="examples.xml" xpointer="ex-body-en"/>
    <xi:include href="examples.xml" xpointer="ex-body-fr"/>
</elementSpec>