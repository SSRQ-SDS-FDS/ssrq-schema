<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="cell" mode="change" module="figures" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Zelle einer Tabelle</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">cell of a table</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">cellule d’un tableau</gloss>
    <desc versionDate="2025-02-05" xml:lang="de">Enthält eine Zelle einer Tabelle.</desc>
    <desc versionDate="2023-07-13" xml:lang="en">Describes a cell of a table.</desc>
    <desc versionDate="2025-02-05" xml:lang="fr">Contient la cellule d’un tableau.</desc>
    <classes mode="replace">
        <memberOf key="att.global.rendition"/>
        <memberOf key="att.tableDecoration"/>
    </classes>
    <content>
        <sequence maxOccurs="unbounded">
            <macroRef key="ssrq.content.default"/>
        </sequence>
    </content>
    <attList>
        <attDef ident="rend" mode="replace">
            <desc versionDate="2025-01-31" xml:lang="de">die Ausrichtung des Texts innerhalb der
            Tabellenzelle</desc>
            <desc versionDate="2025-01-31" xml:lang="en">the text alignment within the table
            cell</desc>
            <desc versionDate="2025-01-31" xml:lang="fr">l’alignement du texte à l’intérieur de la
            cellule du tableau</desc>
            <datatype>
                <dataRef key="ssrq.rend.cell"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-cell-de"/>
    <xi:include href="examples.xml" xpointer="ex-cell-en"/>
    <xi:include href="examples.xml" xpointer="ex-cell-fr"/>
    <remarks versionDate="2025-02-05" xml:lang="de">
        <p>
            Wird zusammen mit <gi>table</gi> und <gi>row</gi> für die Darstellung von Tabellen
            benötigt. Mit <att>role</att> = <val>label</val> wird eine Spaltenüberschrift, z. B.
            die Währung einer Spalte, angegeben.
        </p>
    </remarks>
    <remarks versionDate="2023-07-11" xml:lang="en">
        <p>
            Is required within <gi>table</gi> together with <gi>row</gi> (row) for displaying
            tables. With <att>role</att> = <val>label</val> a column heading, e.g. B. a currency of
            a column entry specified.
        </p>
    </remarks>
    <remarks versionDate="2025-02-05" xml:lang="fr">
        <p>
            Est requis avec <gi>table</gi> et <gi>row</gi> pour afficher les tableaux. Avec
            <att>role</att> = <val>label</val>, on indique un titre de colonne, p. ex. la devise
            (monnaie) d’une colonne.
        </p>
    </remarks>
</elementSpec>