<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="precision" mode="change" module="certainty" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-04" xml:lang="de">Genauigkeit</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">precision</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">précision</gloss>
    <desc versionDate="2025-07-05" xml:lang="de">Gibt den Grad der Unsicherheit einer Datierung
    an.</desc>
    <desc versionDate="2023-07-14" xml:lang="en">Indicates uncertainty in dating.</desc>
    <desc versionDate="2025-07-05" xml:lang="fr">Indique le degré de certitude dans la
    datation.</desc>
    <classes mode="replace">
        <memberOf key="att.scoping"/>
        <memberOf key="model.certLike"/>
        <memberOf key="model.global.meta"/>
    </classes>
    <content>
        <empty/>
    </content>
    <constraintSpec ident="sch-el-precision" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-03-07" xml:lang="en">constraint for tei:precision</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:precision[@match]">
                    <sch:let name="parent" value="./parent::*"/>
                    <sch:assert test="every $matchAttr in tokenize(./@match, &apos; &apos;)
                    satisfies exists($parent/@*[name() = substring-after($matchAttr,
                    &apos;@&apos;)])"> Every value that is targeted via @match must have a
                    corresponding attribute on the parent element. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="precision" mode="change" usage="req">
            <desc versionDate="2025-02-24" xml:lang="de">die Präzision der in <att>match</att>
            genannten Attribute</desc>
            <desc versionDate="2025-02-24" xml:lang="en">the precision of the attributes mentioned
            in <att>match</att></desc>
            <desc versionDate="2025-02-24" xml:lang="fr">la précision des attributs mentionnés dans
            <att>match</att></desc>
        </attDef>
        <attDef ident="stdDeviation" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-precision-de"/>
    <xi:include href="examples.xml" xpointer="ex-precision-en"/>
    <xi:include href="examples.xml" xpointer="ex-precision-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Mit dem Attribut <att>match</att> wird auf ein oder mehrere Attribute von <gi>date</gi>
            Bezug genommen. Mit dem Attribut <att>precision</att> wird der Grad der Unsicherheit
            angegeben.
        </p>
    </remarks>
    <remarks versionDate="2023-07-14" xml:lang="en">
        <p>
            <att>match</att> is used to refer to one or more attributes of <gi>date</gi>.
            <att>precision</att> specifies the degree of uncertainty.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            L’attribut <att>match</att> permet de faire référence à un ou plusieurs attributs de
            <gi>date</gi>. L’attribut <att>precision</att> indique le degré de certitude.
        </p>
    </remarks>
</elementSpec>