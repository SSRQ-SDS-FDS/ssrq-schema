<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="editorialDecl" mode="change" module="header"
xmlns="http://www.tei-c.org/ns/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-06" xml:lang="de">Transkriptionsrichtlinien</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">editorial declaration</gloss>
    <gloss versionDate="2025-02-06" xml:lang="fr">principes de transcription</gloss>
    <desc versionDate="2023-07-17" xml:lang="de">Enthält einen Link zu den
    Transkriptionsrichtlinien.</desc>
    <desc versionDate="2023-07-17" xml:lang="en">Includes a link to the transcription
    guidelines.</desc>
    <desc versionDate="2023-07-17" xml:lang="fr">Contient un lien vers les principes de
    transcription.</desc>
    <classes mode="replace">
        <memberOf key="model.encodingDescPart"/>
    </classes>
    <content>
        <elementRef key="p"/>
    </content>
    <constraintSpec ident="sch-el-editorialDecl" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-08-01" xml:lang="en">constraint for tei:editorialDecl</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:editorialDecl">
                    <sch:assert test="./tei:p/tei:ref"> tei:editorialDecl must contain a tei:p with
                    a tei:ref as a child. </sch:assert>
                    <sch:assert
                    test="./tei:p/tei:ref[@target=&apos;https://p.ssrq-sds-fds.ch/guidelines/transcription&apos;]"> The link inside tei:editorialDecl must point to the latest transcription guidelines: &lt;p&gt;&lt;ref target=&quot;https://p.ssrq-sds-fds.ch/guidelines/transcription&quot;/&gt;&lt;/p&gt;. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <xi:include href="examples.xml" xpointer="ex-editorialDecl-de"/>
    <xi:include href="examples.xml" xpointer="ex-editorialDecl-en"/>
    <xi:include href="examples.xml" xpointer="ex-editorialDecl-fr"/>
</elementSpec>