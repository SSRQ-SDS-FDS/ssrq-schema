<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="handNote" mode="change" module="header" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Anmerkung zu einer Hand</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">note on one hand</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">note sur une main</gloss>
    <desc versionDate="2023-05-22" xml:lang="de">Beschreibt eine Hand und identifiziert sie
    gegebenenfalls mit einem Schreiber.</desc>
    <desc versionDate="2023-05-22" xml:lang="en">Describes a hand and, where appropriate,
    identifies it with a scribe.</desc>
    <desc versionDate="2023-05-22" xml:lang="fr">Décrit une main et, le cas échéant, l’identifie en
    la rattachant à un scribe.</desc>
    <classes mode="replace">
        <memberOf key="att.global"/>
        <memberOf key="att.handFeatures"/>
    </classes>
    <content>
        <sequence>
            <elementRef key="date" maxOccurs="unbounded" minOccurs="0"/>
            <elementRef key="p" maxOccurs="unbounded" minOccurs="0"/>
        </sequence>
    </content>
    <constraintSpec ident="sch-el-handNote" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-10-16" xml:lang="en">constraint for tei:handNote</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:handNote[@xml:id]">
                    <sch:let name="note-id" value="@xml:id"/>
                    <sch:assert test="root(.)//@hand[. = $note-id]"> The tei:handNote-element with
                    the @xml:id
                        <sch:value-of select="$note-id"/>
                        is not referenced by the @hand of any element. Please reference the
                        handNote-element or delete it, if it is not needed anymore. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="n" mode="delete"/>
        <attDef ident="xml:id" mode="change" usage="req">
            <datatype>
                <rng:choice>
                    <rng:ref name="ssrq.hand"/>
                    <rng:ref name="ssrq.hand.century"/>
                    <rng:ref name="ssrq.id.string"/>
                </rng:choice>
            </datatype>
        </attDef>
        <attDef ident="xml:lang" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-handDesc-de"/>
    <xi:include href="examples.xml" xpointer="ex-handDesc-en"/>
    <xi:include href="examples.xml" xpointer="ex-handDesc-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Vgl. die <ref target="scribes-and-hands.de.md">Transkriptionsrichtlinien</ref> zur
            Erfassung der Schreiber und Hände.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            Consultez les <ref target="scribes-and-hands.fr.md">principes de transcription</ref>
            pour l’enregistrement des scribes et des mains.
        </p>
    </remarks>
</elementSpec>