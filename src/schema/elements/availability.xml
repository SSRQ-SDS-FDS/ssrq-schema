<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="availability" mode="change" module="header" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Verfügbarkeit</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">availability</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">disponibilité</gloss>
    <desc versionDate="2025-02-05" xml:lang="de">Enthält Elemente, die die Verfügbarkeit eines
    Textes beschreiben.</desc>
    <desc versionDate="2023-07-17" xml:lang="en">Describes the availability of a text.</desc>
    <desc versionDate="2025-02-05" xml:lang="fr">Contient des éléments déclaratifs sur la mise à
    disposition d’un texte.</desc>
    <classes mode="replace">
        <memberOf key="model.publicationStmtPart.detail"/>
    </classes>
    <content>
        <elementRef key="licence"/>
    </content>
    <attList>
        <attDef ident="status" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-availability-de"/>
    <xi:include href="examples.xml" xpointer="ex-availability-en"/>
    <xi:include href="examples.xml" xpointer="ex-availability-fr"/>
    <remarks versionDate="2025-07-08" xml:lang="de">
        <p>
            Das Element gibt die Informationen zur Lizenzierung an.
        </p>
    </remarks>
    <remarks versionDate="2023-07-17" xml:lang="en">
        <p>
            Indicates restrictions on use or disclosure, licensing, etc. We use the tag to mention
            the institution that provided us with facsimiles. A facsimile can be produced by a
            third party (rather than the institution where the source is archived). A source may be
            in the AVN, # but the facsimile was made available or created by the BPUN.
        </p>
    </remarks>
    <remarks versionDate="2025-07-08" xml:lang="fr">
        <p>
            Cet élément permet d’indiquer les informations de licence.
        </p>
    </remarks>
</elementSpec>