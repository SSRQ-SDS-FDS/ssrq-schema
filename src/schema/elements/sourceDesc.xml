<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="sourceDesc" mode="change" module="header" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-04" xml:lang="de">Quellenbeschreibung</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">source description</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">description de la source</gloss>
    <desc versionDate="2025-07-05" xml:lang="de">Enthält Elemente zur Beschreibung des
    Textträgers.</desc>
    <desc versionDate="2023-07-18" xml:lang="en">Contains elements describing the source or
    sources.</desc>
    <desc versionDate="2025-07-05" xml:lang="fr">Contient des éléments pour décrire le support de
    texte.</desc>
    <classes mode="replace"/>
    <content>
        <alternate>
            <elementRef key="msDesc"/>
            <elementRef key="listWit"/>
        </alternate>
    </content>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-msDesc-de"/>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-msDesc-en"/>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-msDesc-fr"/>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-listWit-de"/>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-listWit-en"/>
    <xi:include href="examples.xml" xpointer="ex-sourceDesc-listWit-fr"/>
    <remarks versionDate="2025-02-07" xml:lang="de">
        <p>
            Gibt es nur einen Textträger, ist der Inhalt von <gi>sourceDesc</gi> ein einzelnes
            <gi>msDesc</gi>; gibt es mehrere, dann folgt ein <gi>listWit</gi>-Element, innerhalb
            dessen für jeden Textträger ein eigenes <gi>witness</gi> mit einer eigenen
            <gi>msDesc</gi> angelegt wird.
        </p>
    </remarks>
    <remarks versionDate="2023-08-18" xml:lang="en">
        <p>
            Content (regest), place of storage, material, layout, scribe, seal and bibliographical
            references are described.
        </p>
    </remarks>
    <remarks versionDate="2025-02-07" xml:lang="fr">
        <p>
            S’il n’y a qu’un seul support de texte, le contenu de <gi>sourceDesc</gi> est un
            <gi>msDesc</gi> unique ; s’il y en a plusieurs, il est suivi d’un élément
            <gi>listWit</gi>, à l’intérieur duquel un <gi>witness</gi> distinct est créé pour
            chaque support de témoin, avec son propre <gi>msDesc</gi>.
        </p>
    </remarks>
</elementSpec>