<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="TEI" mode="change" module="textstructure" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2023-03-09" xml:lang="de">TEI Dokument</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">TEI document</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">document TEI</gloss>
    <desc versionDate="2025-02-07" xml:lang="de">Enthält als sogenanntes Root-Element einen
    einzelnen edierten Text.</desc>
    <desc versionDate="2023-07-14" xml:lang="en">Contains a single document (piece) as a so-called
    root element.</desc>
    <desc versionDate="2025-02-07" xml:lang="fr">Contient un seul texte édité en tant qu’élément
    dit « racine ».</desc>
    <classes mode="replace">
        <memberOf key="att.global"/>
    </classes>
    <content>
        <sequence>
            <elementRef key="teiHeader"/>
            <elementRef key="text"/>
        </sequence>
    </content>
    <attList>
        <attDef ident="n" mode="delete"/>
        <attDef ident="version" mode="delete"/>
        <attDef ident="xml:id" mode="delete"/>
        <attDef ident="xml:lang" mode="change" usage="req">
            <datatype>
                <rng:choice>
                    <rng:ref name="ssrq.lang.de"/>
                    <rng:ref name="ssrq.lang.fr"/>
                    <rng:ref name="ssrq.lang.it"/>
                </rng:choice>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-TEI-de"/>
    <xi:include href="examples.xml" xpointer="ex-TEI-en"/>
    <xi:include href="examples.xml" xpointer="ex-TEI-fr"/>
    <remarks versionDate="2025-02-07" xml:lang="de">
        <p>
            Die Metadaten zum edierten Text werden im <gi>teiHeader</gi> erfasst, der edierte Text
            mit allen Kommentaren im darauffolgenden <gi>text</gi>-Element.
        </p>
        <p>
            Mit dem Attribut <att>xml:lang</att> wird die Sprache der Bearbeitung angegeben.
        </p>
        <p>
            Jedes Stück erhält ein eigenes TEI-XML-Dokument.
        </p>
    </remarks>
    <remarks versionDate="2023-07-14" xml:lang="en">
        <p>
            The language of the processing is specified with <att>xml:lang</att>.
        </p>
    </remarks>
    <remarks versionDate="2025-02-07" xml:lang="fr">
        <p>
            Les métadonnées relatives au texte sont saisies dans le <gi>teiHeader</gi>, alors que
            le texte édité avec tous les commentaires dans l’élément <gi>text</gi> qui suit.
        </p>
        <p>
            L’attribut <att>xml:lang</att> permet d’indiquer la langue de l’édition.
        </p>
        <p>
            Chaque pièce dispose de son propre document XML TEI.
        </p>
    </remarks>
</elementSpec>