<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="placeName" mode="change" module="namesdates"
xmlns="http://www.tei-c.org/ns/1.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Ortsname</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">place name</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">nom de lieu</gloss>
    <desc versionDate="2025-02-21" xml:lang="de">Enthält eine topographische Bezeichnung (wie einen
    Ort oder einen Flurnamen).</desc>
    <desc versionDate="2023-04-20" xml:lang="en">Indicates topographical designations (a place or a
    field name).</desc>
    <desc versionDate="2025-02-21" xml:lang="fr">Contient une désignation topographique (tel qu’un
    lieu ou un lieu-dit).</desc>
    <classes mode="replace">
        <memberOf key="att.canonical"/>
        <memberOf key="model.placeNamePart"/>
    </classes>
    <content>
        <sequence maxOccurs="unbounded">
            <macroRef key="ssrq.content.default"/>
        </sequence>
    </content>
    <attList>
        <attDef ident="ref" mode="replace">
            <datatype>
                <dataRef key="ssrq.pointer.places"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-placeName-de"/>
    <xi:include href="examples.xml" xpointer="ex-placeName-en"/>
    <xi:include href="examples.xml" xpointer="ex-placeName-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Es gelten die ausführlichen Richtlinien zur Auszeichnung von Orten und Räumen in den
            <ref target="places.de.md">Transkriptionsrichtlinien</ref>.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            Les directives détaillées pour l’indication des lieux et des espaces se trouvent dans
            les <ref target="places.fr.md">principes de transcription</ref> s’appliquent.
        </p>
    </remarks>
</elementSpec>