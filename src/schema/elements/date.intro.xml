<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="date" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron">
    <gloss versionDate="2025-02-03" xml:lang="de">Datum</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">date</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">date</gloss>
    <classes mode="replace">
        <memberOf key="att.datable.custom"/>
        <memberOf key="att.typed"/>
        <memberOf key="macro.dateLike"/>
        <memberOf key="model.publicationStmtPart.detail"/>
    </classes>
    <content/>
    <constraintSpec ident="sch-el-date-publicationStmt" mode="add" scheme="schematron"
    xml:lang="en">
        <desc versionDate="2025-02-08" xml:lang="en">constraint for tei:date inside
        tei:publicationStmt</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:date">
                    <sch:assert test=".[@when-custom or (@from-custom and
                    @to-custom)][not(@notAfter-custom|@notBefore-custom)]"> tei:date must contain
                    @when-custom or @from-custom and to-custom, and may not contain
                    @notAfter-custom or @notBefore-custom. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="type" mode="replace" usage="req">
            <desc versionDate="2025-02-03" xml:lang="de">die Art des Datums</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the type of date</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">le type de date</desc>
            <datatype>
                <dataRef key="ssrq-lit.type.date"/>
            </datatype>
        </attDef>
    </attList>
</elementSpec>