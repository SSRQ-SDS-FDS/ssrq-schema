<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="fw" mode="change" module="transcr" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2023-07-13" xml:lang="de">Gestaltungselement</gloss>
    <gloss versionDate="2023-07-13" xml:lang="en">forme work</gloss>
    <gloss versionDate="2023-07-13" xml:lang="fr">élément de mise en page</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält Gestaltungselemente, die nicht zum
    eigentlichen Text gehören.</desc>
    <desc versionDate="2023-08-18" xml:lang="en">Contains catchwords and reclamants. The word at
    the bottom of the page is usually omitted or transcribed on the next page.</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient des éléments de mise en page qui ne font
    pas partie du texte lui-même.</desc>
    <classes mode="replace">
        <memberOf key="att.typed"/>
    </classes>
    <content>
        <sequence maxOccurs="unbounded">
            <macroRef key="ssrq.content.default"/>
        </sequence>
    </content>
    <attList>
        <attDef ident="type" mode="replace" usage="req">
            <desc versionDate="2025-02-03" xml:lang="de">die Art des Gestaltungselements</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the type of forme work</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">le type d’élément de mise en page</desc>
            <datatype>
                <dataRef key="ssrq.type.fw"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-fw-de"/>
    <xi:include href="examples.xml" xpointer="ex-fw-en"/>
    <xi:include href="examples.xml" xpointer="ex-fw-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Wir benutzen das Element für Kustoden (Lagenbezeichnungen) und Reklamanten
            (Anfangswörter der Folgeseite), sofern diese transkribiert werden. Vgl. hierzu die <ref
            target="paratext.de.md">Transkriptionsrichtlinien</ref>.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            Nous utilisons cet élément pour les signatures (qui numérotent les cahiers en vue leur
            assemblage) et les réclames (premiers mots de la page suivante), à condition que ces
            éléments soient transcrits. Voir les <ref target="paratext.fr.md">principes de
            transcription</ref>.
        </p>
    </remarks>
</elementSpec>