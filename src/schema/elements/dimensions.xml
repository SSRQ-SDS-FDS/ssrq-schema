<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="dimensions" mode="change" module="msdescription"
xmlns="http://www.tei-c.org/ns/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Dimensionen</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">dimensions</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">dimensions</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält die Masse einer Quelle.</desc>
    <desc versionDate="2023-04-19" xml:lang="en">Dimension of a source</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient les dimensions d’une source.</desc>
    <classes mode="replace">
        <memberOf key="att.typed"/>
        <memberOf key="model.pPart.msdesc"/>
    </classes>
    <content>
        <sequence preserveOrder="false">
            <elementRef key="width"/>
            <elementRef key="height" minOccurs="0"/>
        </sequence>
    </content>
    <constraintSpec ident="sch-el-dimensions" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-04-19" xml:lang="en">constraint for tei:dimensions</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:dimensions[@type = &apos;plica&apos;]">
                    <sch:assert test="count(*) = 1 and */name() = &apos;width&apos;">If the value
                    of @type is &apos;plica&apos; only one tei:width is allowed as a
                    child.</sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="type" mode="replace" usage="req">
            <desc versionDate="2025-01-31" xml:lang="de">die Art des Masses</desc>
            <desc versionDate="2025-01-31" xml:lang="en">the type of dimension</desc>
            <desc versionDate="2025-01-31" xml:lang="fr">le type de dimension</desc>
            <datatype>
                <dataRef key="ssrq.type.dimensions"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-extent-de"/>
    <xi:include href="examples.xml" xpointer="ex-extent-en"/>
    <xi:include href="examples.xml" xpointer="ex-extent-fr"/>
    <remarks versionDate="2025-02-05" xml:lang="de">
        <p>
            Wenn das Attribut <att>type</att> den Wert <val>plica</val> hat, dann ist nur ein
            <gi>width</gi>-Element als Kindelement erlaubt, ansonsten sollten sowohl <gi>width</gi>
            als auch <gi>height</gi> angeben werden.
        </p>
    </remarks>
    <remarks versionDate="2023-07-14" xml:lang="en">
        <p>
            If <att>type</att> has value <val>plica</val> then only one <gi>width</gi> element is
            allowed as content.
        </p>
    </remarks>
    <remarks versionDate="2025-02-05" xml:lang="fr">
        <p>
            Si l’attribut <att>type</att> a la valeur <val>plica</val>, alors un seul élément
            <gi>width</gi> est autorisé comme élément enfant, sinon il faut indiquer aussi bien
            <gi>width</gi> que <gi>height</gi>.
        </p>
    </remarks>
</elementSpec>