<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="listBibl" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron">
    <gloss versionDate="2023-09-14" xml:lang="de">Liste bibliographischer Angaben</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">list of bibliographical statements</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">liste des déclarations bibliographiques</gloss>
    <classes mode="replace">
        <memberOf key="model.biblLike"/>
    </classes>
    <content>
        <sequence>
            <elementRef key="head"/>
            <alternate>
                <elementRef key="bibl" maxOccurs="unbounded"/>
                <elementRef key="listBibl" maxOccurs="unbounded" minOccurs="2"/>
            </alternate>
        </sequence>
    </content>
    <constraintSpec ident="sch-el-listBibl-lit" mode="add" scheme="schematron" xml:lang="en">
        <desc versionDate="2025-04-30" xml:lang="en">constraint for nesting of tei:listBibl</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:listBibl">
                    <sch:assert test="count(ancestor::tei:listBibl) &lt;= 1"> The element
                    tei:listBibl may only be nested once inside another tei:listBibl. Here are too
                    many nesting levels. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
</elementSpec>