<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="supplied" mode="change" module="transcr" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-04" xml:lang="de">Ergänzung</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">supplement</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">ajout</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält eine Ergänzung durch die
    Bearbeitenden.</desc>
    <desc versionDate="2023-07-14" xml:lang="en">Contains an addition by the editor.</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient un ajout de la part des éditeurs.</desc>
    <classes mode="replace">
        <memberOf key="att.global.responsibility"/>
        <memberOf key="att.global.source"/>
    </classes>
    <content>
        <alternate maxOccurs="unbounded">
            <elementRef key="p"/>
            <macroRef key="ssrq.content.default"/>
        </alternate>
    </content>
    <constraintSpec ident="sch-el-supplied" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-05-02" xml:lang="en">constraint for tei:supplied</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:supplied">
                    <sch:assert test=".[@resp][not(@source)] or .[@source][not(@resp)]">
                    tei:supplied must contain either a @resp or a @source attribute. </sch:assert>
                </sch:rule>
                <sch:rule context="tei:supplied[@source]">
                    <sch:let name="sources" value="for $source in tokenize(@source, &apos; &apos;)
                    return replace($source,
                    &apos;^(id-ssrq-[\w\d-]+)(#(\d+|fol\d+[rv]?|[pn]\d+))?$&apos;,
                    &apos;$1&apos;)"/>
                    <sch:assert test="every $source in $sources satisfies exists(id($source))"
                    xml:lang="en"> Every referenced ID in @source must belong to an element with
                    the same ID. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="cert" mode="delete"/>
        <attDef ident="source" mode="replace">
            <datatype>
                <rng:list>
                    <rng:oneOrMore>
                        <rng:choice>
                            <rng:ref name="ssrq.pointer.id"/>
                            <rng:ref name="ssrq.pointer.urn"/>
                        </rng:choice>
                    </rng:oneOrMore>
                </rng:list>
            </datatype>
        </attDef>
        <attDef ident="reason" mode="replace">
            <desc versionDate="2025-02-03" xml:lang="de">der Grund für die Ergänzung</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the reason for the supplement</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">la raison de l’ajout</desc>
            <datatype>
                <dataRef key="ssrq.reason.supplied"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-supplied-de"/>
    <xi:include href="examples.xml" xpointer="ex-supplied-en"/>
    <xi:include href="examples.xml" xpointer="ex-supplied-fr"/>
    <xi:include href="examples.xml" xpointer="ex-damage-supplied-de"/>
    <xi:include href="examples.xml" xpointer="ex-damage-supplied-en"/>
    <xi:include href="examples.xml" xpointer="ex-damage-supplied-fr"/>
    <remarks versionDate="2025-07-14" xml:lang="de">
        <p>
            Wenn die Bearbeitenden eine Passage frei ergänzen, weisen sie sich im Attribut
            <att>resp</att> mit ihrem Kürzel aus. Erfolgt eine Textergänzung anhand einer weiteren
            Textvorlage, wird auf diese mit dem Attribut <att>source</att> referenziert. Der Grund
            für eine Ergänzung kann mit <att>reason</att> angegeben werden. Eine Anmerkung in
            <gi>note</gi> oder ein Kommentar in <gi>back</gi> ist nötig.
        </p>
    </remarks>
    <remarks versionDate="2023-07-14" xml:lang="en">
        <p>
            If an editor freely adds a passage, he identifies himself in <att>resp</att> with his
            abbreviation. If a text is supplemented using another text template, this is referenced
            with <att>source</att>. The reason for an addition can be specified with
            <att>reason</att>. A note in <gi>note</gi> or a comment in <gi>back</gi> is required.
        </p>
    </remarks>
    <remarks versionDate="2025-07-14" xml:lang="fr">
        <p>
            Si un éditeur ajoute librement un passage, il s’identifie avec <att>resp</att> en
            indiquant son abréviation. Si un texte est complété à l’aide d’une autre variante de
            texte, celle-ci est référencée par <att>source</att>. La raison d’un ajout peut être
            signalée avec l’attribut <att>reason</att>. Une <gi>note</gi> ou un commentaire dans
            <gi>back</gi> est nécessaire.
        </p>
    </remarks>
</elementSpec>