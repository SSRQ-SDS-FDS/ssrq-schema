<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="bibl" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">bibliographische Angabe</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">bibliographical statement</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">référence bibliographique</gloss>
    <desc versionDate="2025-02-05" xml:lang="de">Enthält eine bibliographische Angabe mit
    Stellenreferenz.</desc>
    <desc versionDate="2023-07-18" xml:lang="en">Contains a bibliographical reference with page
    references.</desc>
    <desc versionDate="2025-02-05" xml:lang="fr">Contient une indication bibliographique
    référencée.</desc>
    <classes mode="replace">
        <memberOf key="att.global"/>
        <memberOf key="model.biblLike"/>
    </classes>
    <content>
        <alternate maxOccurs="unbounded">
            <elementRef key="pc"/>
            <elementRef key="ref"/>
            <textNode/>
        </alternate>
    </content>
    <constraintSpec ident="sch-el-bibl" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-10-16" xml:lang="en">constraint for tei:bibl</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:bibl[@xml:id]">
                    <sch:assert test="./parent::tei:listBibl"> The attribute @xml:id for tei:bibl
                    is allowed only inside tei:listBibl. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="n" mode="delete"/>
        <attDef ident="xml:id" mode="change">
            <datatype>
                <dataRef key="ssrq.id"/>
            </datatype>
        </attDef>
        <attDef ident="xml:lang" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-bibl-zot-de"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-zot-en"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-zot-fr"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-doc-de"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-doc-en"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-doc-fr"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-url-de"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-url-en"/>
    <xi:include href="examples.xml" xpointer="ex-bibl-url-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Das Kindelement <gi>ref</gi> verweist auf externe Websites, weitere edierte Stücke oder
            die Literaturdatenbank der SSRQ auf <ref
            target="https://www.zotero.org/groups/5048222/ssrq/">Zotero</ref>.
        </p>
    </remarks>
    <remarks versionDate="2023-07-18" xml:lang="en">
        <p>
            The <gi>ref</gi> child element links to external websites, other edited pieces, or the
            Zotero literature database.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            L’élément enfant <gi>ref</gi> renvoie à des sites Web externes, à d’autres pièces
            éditées ou à la base de données bibliographique des SDS sur <ref
            target="https://www.zotero.org/groups/5048222/ssrq/">Zotero</ref>.
        </p>
    </remarks>
</elementSpec>