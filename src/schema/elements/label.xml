<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="label" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Randanmerkung</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">label</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">étiquette</gloss>
    <desc versionDate="2023-07-19" xml:lang="de">Enthält Randanmerkungen, die in den Editionstext
    integriert werden.</desc>
    <desc versionDate="2023-07-19" xml:lang="en">Contains marginal notes that are integrated into
    the edition text.</desc>
    <desc versionDate="2023-07-19" xml:lang="fr">Contient des notes marginales qui seront intégrées
    dans le texte de l’édition.</desc>
    <classes mode="replace">
        <memberOf key="att.placement"/>
        <memberOf key="att.typed"/>
        <memberOf key="att.written"/>
        <memberOf key="model.labelLike"/>
    </classes>
    <content>
        <sequence maxOccurs="unbounded">
            <macroRef key="ssrq.content.default"/>
        </sequence>
    </content>
    <constraintSpec ident="sch-el-label" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-05-25" xml:lang="en">constraint for tei:label</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:label[not(parent::list)]">
                    <sch:assert test="preceding-sibling::*[1][self::tei:lb]"> tei:label must follow
                    after a tei:lb. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="place" mode="replace" usage="req">
            <desc versionDate="2025-02-03" xml:lang="de">der Ort der Randanmerkung</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the place of the label</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">le lieu de l’étiquette</desc>
            <datatype>
                <dataRef key="ssrq.place.label"/>
            </datatype>
        </attDef>
        <attDef ident="type" mode="replace" usage="req">
            <desc versionDate="2025-02-03" xml:lang="de">die Art der Randanmerkung</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the type of the label</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">le type de l’étiquette</desc>
            <datatype>
                <dataRef key="ssrq.type.label"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-label-de"/>
    <xi:include href="examples.xml" xpointer="ex-label-en"/>
    <xi:include href="examples.xml" xpointer="ex-label-fr"/>
</elementSpec>