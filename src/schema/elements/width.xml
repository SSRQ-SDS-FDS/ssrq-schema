<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="width" mode="change" module="msdescription" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-04" xml:lang="de">Breite</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">width</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">largeur</gloss>
    <desc versionDate="2025-02-07" xml:lang="de">Beschreibt innerhalb von <gi>dimensions</gi> die
    Breite eines Textträgers.</desc>
    <desc versionDate="2023-07-15" xml:lang="en">Describes the width of a sheet or book and the
    width of the plica.</desc>
    <desc versionDate="2025-02-07" xml:lang="fr">Décrit la largeur d’un support de texte dans
    <gi>dimensions</gi>.</desc>
    <classes mode="replace">
        <memberOf key="att.dimensions"/>
        <memberOf key="model.dimLike"/>
        <memberOf key="model.measureLike"/>
    </classes>
    <content>
        <empty/>
    </content>
    <attList>
        <attDef ident="unit" mode="change" usage="req">
            <datatype>
                <rng:choice>
                    <rng:ref name="ssrq.dimensions.unknown"/>
                    <rng:ref name="ssrq.measure.lengths.base.cm"/>
                </rng:choice>
            </datatype>
        </attDef>
        <attDef ident="quantity" mode="change" usage="req"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-width-cm-de"/>
    <xi:include href="examples.xml" xpointer="ex-width-cm-en"/>
    <xi:include href="examples.xml" xpointer="ex-width-cm-fr"/>
    <xi:include href="examples.xml" xpointer="ex-width-unknown-de"/>
    <xi:include href="examples.xml" xpointer="ex-width-unknown-en"/>
    <xi:include href="examples.xml" xpointer="ex-width-unknown-fr"/>
    <remarks versionDate="2025-02-07" xml:lang="de">
        <p>
            Die Masseinheit für das Attribut <att>unit</att> ist Zentimeter (cm), ist die Breite
            des Textträgers unbekannt, wird das wie in Beispiel 2 ausgedrückt.
        </p>
    </remarks>
    <remarks versionDate="2023-07-14" xml:lang="en">
        <p>
            The unit of measure for <att>unit</att> is centimeters (cm).
        </p>
    </remarks>
    <remarks versionDate="2025-02-07" xml:lang="fr">
        <p>
            L’unité de mesure de l’attribut <att>unit</att> est le centimètre (cm) ; si la largeur
            du support de texte est inconnue, elle est exprimée comme dans l’exemple 2.
        </p>
    </remarks>
</elementSpec>