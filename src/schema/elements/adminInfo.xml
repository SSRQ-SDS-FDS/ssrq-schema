<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="adminInfo" mode="change" module="msdescription"
xmlns="http://www.tei-c.org/ns/1.0" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">administrative Informationen</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">administrative information</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">informations administratives</gloss>
    <desc versionDate="2025-02-05" xml:lang="de">Enthält administrative Informationen zur
    Aufbewahrung des Textzeugen.</desc>
    <desc versionDate="2023-09-19" xml:lang="en">Contains information on the storage of a document.
    Used, for example, in the case of lost manuscripts.</desc>
    <desc versionDate="2025-02-05" xml:lang="fr">Contient des informations administratives sur la
    conservation du document.</desc>
    <classes mode="replace"/>
    <content>
        <elementRef key="custodialHist"/>
    </content>
    <xi:include href="examples.xml" xpointer="ex-adminInfo-de"/>
    <xi:include href="examples.xml" xpointer="ex-adminInfo-fr"/>
    <xi:include href="examples.xml" xpointer="ex-adminInfo-en"/>
    <remarks versionDate="2025-02-05" xml:lang="de">
        <p>
            Wir verwenden das Element nur, wenn der Textzeuge verloren ist und geben in
            <gi>custodialHist</gi> die Informationen zum Verlust des Textzeugen an.
        </p>
    </remarks>
    <remarks versionDate="2025-02-05" xml:lang="fr">
        <p>
            Nous n’utilisons cet élément que si le texte est perdu et indiquons dans
            <gi>custodialHist</gi> les informations relatives à sa perte.
        </p>
    </remarks>
</elementSpec>