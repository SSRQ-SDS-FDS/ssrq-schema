<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="persName" mode="change" module="namesdates" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Personenname</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">personal name</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">nom de personne</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält den Namen einer Person.</desc>
    <desc versionDate="2024-04-20" xml:lang="en">Indicates a person and usually includes only the
    first and last name.</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient le nom d’une personne.</desc>
    <classes mode="replace">
        <memberOf key="att.canonical"/>
        <memberOf key="att.naming"/>
        <memberOf key="model.nameLike.agent"/>
    </classes>
    <content>
        <sequence maxOccurs="unbounded">
            <macroRef key="ssrq.content.default"/>
        </sequence>
    </content>
    <constraintSpec ident="sch-el-persName" mode="add" scheme="schematron" xml:lang="en">
        <desc versionDate="2023-06-23" xml:lang="en">constraint for tei:persName</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:persName[ancestor::tei:editor]">
                    <sch:assert test="not(@ref|@role)"> If tei:persName is part of tei:editor it
                    must not contain the attributes @ref or @role. </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="ref" mode="replace">
            <datatype>
                <dataRef key="ssrq.pointer.persons"/>
            </datatype>
        </attDef>
        <attDef ident="role" mode="replace">
            <desc versionDate="2025-01-30" xml:lang="de">die Rolle einer Person im Text</desc>
            <desc versionDate="2025-01-30" xml:lang="en">the role of a person in the text</desc>
            <desc versionDate="2025-01-30" xml:lang="fr">le rôle d’une personne dans le
            texte</desc>
            <datatype>
                <dataRef key="ssrq.role.person"/>
            </datatype>
        </attDef>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-persName-1-de"/>
    <xi:include href="examples.xml" xpointer="ex-persName-1-en"/>
    <xi:include href="examples.xml" xpointer="ex-persName-1-fr"/>
    <xi:include href="examples.xml" xpointer="ex-persName-2-de"/>
    <xi:include href="examples.xml" xpointer="ex-persName-2-en"/>
    <xi:include href="examples.xml" xpointer="ex-persName-2-fr"/>
    <xi:include href="examples.xml" xpointer="ex-persName-3-de"/>
    <xi:include href="examples.xml" xpointer="ex-persName-3-en"/>
    <xi:include href="examples.xml" xpointer="ex-persName-3-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Es gelten die ausführlichen Richtlinien zur Auszeichnung von Personen in den <ref
            target="persons.de.md">Transkriptionsrichtlinien</ref>.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Les directives détaillées relatives à la dénomination des personnes dans les <ref
            target="persons.de.md">principes de transcription</ref> s’appliquent.
        </p>
    </remarks>
</elementSpec>