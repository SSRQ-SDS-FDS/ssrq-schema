<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="pubPlace" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-04" xml:lang="de">Publikationsort</gloss>
    <gloss versionDate="2025-02-04" xml:lang="en">publication place</gloss>
    <gloss versionDate="2025-02-04" xml:lang="fr">lieu de publication</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält den Publikationsort.</desc>
    <desc versionDate="2023-07-20" xml:lang="en">Contains the place of publication.</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient le lieu de publication.</desc>
    <classes mode="replace">
        <memberOf key="att.canonical"/>
        <memberOf key="att.global.responsibility"/>
    </classes>
    <content>
        <textNode/>
    </content>
    <attList>
        <attDef ident="ref" mode="replace" usage="req">
            <datatype>
                <dataRef key="ssrq.pointer.places"/>
            </datatype>
        </attDef>
        <attDef ident="resp" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-docImprint-1-de"/>
    <xi:include href="examples.xml" xpointer="ex-docImprint-1-en"/>
    <xi:include href="examples.xml" xpointer="ex-docImprint-1-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Bei Druckschriften wird innerhalb von <gi>docImprint</gi> der Publikationsort mit
            <gi>pubPlace</gi> genannt.
        </p>
    </remarks>
    <remarks versionDate="2023-07-20" xml:lang="en">
        <p>
            This can be both the place of publication of the electronic edition and the place of
            publication of the article or book listed in the bibliography. In the case of
            publications, the place of printing is named with <gi>pubPlace</gi> within
            <gi>docImprint</gi>.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            Pour les documents imprimés, le lieu de publication est signalé avec <gi>pubPlace</gi>
            dans <gi>docImprint</gi>.
        </p>
    </remarks>
</elementSpec>