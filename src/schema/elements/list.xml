<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="list" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Liste</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">list</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">liste</gloss>
    <desc versionDate="2025-02-06" xml:lang="de">Enthält eine Liste oder Aufzählung jeder
    Art.</desc>
    <desc versionDate="2023-07-19" xml:lang="en">Describes a list or enumeration of any
    kind.</desc>
    <desc versionDate="2025-02-06" xml:lang="fr">Contient une liste ou une énumération de toute
    sorte.</desc>
    <classes mode="replace">
        <memberOf key="att.global.rendition"/>
        <memberOf key="model.listLike"/>
    </classes>
    <content>
        <sequence>
            <elementRef key="head" minOccurs="0"/>
            <sequence preserveOrder="false">
                <elementRef key="item" maxOccurs="unbounded"/>
                <alternate maxOccurs="unbounded" minOccurs="0">
                    <elementRef key="cb"/>
                    <elementRef key="pb"/>
                    <macroRef key="ssrq.content.anchor.spans"/>
                </alternate>
            </sequence>
        </sequence>
    </content>
    <attList>
        <attDef ident="rend" mode="replace">
            <desc versionDate="2025-02-03" xml:lang="de">das Aussehen der Liste</desc>
            <desc versionDate="2025-02-03" xml:lang="en">the appearance of the list</desc>
            <desc versionDate="2025-02-03" xml:lang="fr">l’apparence de la liste</desc>
            <datatype>
                <dataRef key="ssrq.rend.list"/>
            </datatype>
        </attDef>
        <attDef ident="type" mode="delete"/>
    </attList>
    <xi:include href="examples.xml" xpointer="ex-list-de"/>
    <xi:include href="examples.xml" xpointer="ex-list-en"/>
    <xi:include href="examples.xml" xpointer="ex-list-fr"/>
    <xi:include href="examples.xml" xpointer="ex-list-head-de"/>
    <xi:include href="examples.xml" xpointer="ex-list-head-en"/>
    <xi:include href="examples.xml" xpointer="ex-list-head-fr"/>
    <xi:include href="examples.xml" xpointer="ex-list-complex-de"/>
    <xi:include href="examples.xml" xpointer="ex-list-complex-en"/>
    <xi:include href="examples.xml" xpointer="ex-list-complex-fr"/>
    <remarks versionDate="2025-02-06" xml:lang="de">
        <p>
            Für die Auflistung aller Textzeugen im <gi>teiHeader</gi> verwenden wir das
            spezialisiertere Element <gi>listWit</gi>, für die Auflistung bibliographischer Angaben
            kommt <gi>listBibl</gi> zum Einsatz.
        </p>
        <p>
            Eine ggfs. vorhandene Listenüberschrift wird mit <gi>head</gi> ausgezeichnet.
        </p>
    </remarks>
    <remarks versionDate="2025-02-06" xml:lang="fr">
        <p>
            Pour lister toutes les témoins d’un texte dans le <gi>teiHeader</gi>, nous utilisons
            l’élément plus spécialisé <gi>listWit</gi>; pour lister les informations
            bibliographiques, nous utilisons <gi>listBibl</gi>.
        </p>
        <p>
            S’il y a un en-tête de liste, il est marqué avec <gi>head</gi>.
        </p>
    </remarks>
</elementSpec>