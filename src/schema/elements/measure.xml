<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<elementSpec ident="measure" mode="change" module="core" xmlns="http://www.tei-c.org/ns/1.0"
xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude">
    <gloss versionDate="2025-02-03" xml:lang="de">Massangabe</gloss>
    <gloss versionDate="2025-02-03" xml:lang="en">measure</gloss>
    <gloss versionDate="2025-02-03" xml:lang="fr">mesure</gloss>
    <desc versionDate="2023-07-19" xml:lang="de">Enthält eine Massangabe jeder Art.</desc>
    <desc versionDate="2023-07-19" xml:lang="en">Contains a measurement of any type.</desc>
    <desc versionDate="2023-07-19" xml:lang="fr">Contient une indication de mesure de n’importe
    quel type.</desc>
    <classes mode="replace">
        <memberOf key="att.measurement"/>
        <memberOf key="att.typed"/>
        <memberOf key="model.measureLike"/>
    </classes>
    <content>
        <alternate maxOccurs="unbounded">
            <textNode/>
            <macroRef key="ssrq.content.critical"/>
            <macroRef key="ssrq.content.display"/>
            <macroRef key="ssrq.content.content"/>
            <macroRef key="ssrq.content.entities"/>
        </alternate>
    </content>
    <constraintSpec ident="sch-measure" mode="change" module="core" scheme="schematron"
    xml:lang="en">
        <desc versionDate="2023-03-23" xml:lang="en">constraint for tei:measure</desc>
        <constraint>
            <sch:pattern>
                <sch:rule context="tei:measure[@type = &apos;age&apos;]">
                    <sch:let name="age" value="{{concat(&apos;&quot;&apos;,
                    string-join(sort(//tei:dataSpec[@ident =
                    &apos;ssrq.measure.time&apos;]//tei:valItem/@ident), &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $age, &apos;$&apos;))">
                    &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid time unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($age, &apos;\|&apos;), &apos;,
                        &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;area&apos;]">
                    <sch:let name="area" value="{{concat(&apos;&quot;&apos;,
                    string-join(//tei:dataSpec[@ident = (&apos;ssrq.measure.area&apos;,
                    &apos;ssrq.measure.parts.vierling&apos;)]//tei:valItem/@ident, &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $area, &apos;$&apos;))">
                    &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid area unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($area, &apos;\|&apos;), &apos;,
                        &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;currency&apos;]">
                    <sch:let name="currency" value="{{concat(&apos;&quot;&apos;,
                    string-join(//tei:dataSpec[@ident =
                    &apos;ssrq.measure.currency&apos;]//tei:valItem/@ident, &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $currency,
                    &apos;$&apos;))"> &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid currency unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($currency, &apos;\|&apos;),
                        &apos;, &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;length&apos;]">
                    <sch:let name="length" value="{{concat(&apos;&quot;&apos;,
                    string-join(sort(//tei:dataSpec[@ident = (&apos;ssrq.measure.length&apos;,
                    &apos;ssrq.measure.lengths.base.cm&apos;,
                    &apos;ssrq.measure.parts.vierling&apos;)]//tei:valItem/@ident), &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $length,
                    &apos;$&apos;))"> &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid length unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($length, &apos;\|&apos;),
                        &apos;, &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;undefined&apos;]">
                    <sch:let name="various" value="{{concat(&apos;&quot;&apos;,
                    string-join(sort(//tei:dataSpec[@ident = (&apos;ssrq.measure.various&apos;,
                    &apos;ssrq.measure.parts.stuck&apos;)]//tei:valItem/@ident), &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $various,
                    &apos;$&apos;))"> &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid unspecific unit – you need to choose from the
                        following list:
                        <sch:value-of select="string-join(tokenize($various, &apos;\|&apos;),
                        &apos;, &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;volume&apos;]">
                    <sch:let name="volume" value="{{concat(&apos;&quot;&apos;,
                    string-join(sort(//tei:dataSpec[@ident = (&apos;ssrq.measure.capacity&apos;,
                    &apos;ssrq.measure.parts.stuck&apos;,
                    &apos;ssrq.measure.parts.vierling&apos;)]//tei:valItem/@ident), &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $volume,
                    &apos;$&apos;))"> &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid capacity unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($volume, &apos;\|&apos;),
                        &apos;, &apos;)"/>
                        </sch:assert>
                </sch:rule>
                <sch:rule context="tei:measure[@type = &apos;weight&apos;]">
                    <sch:let name="weight" value="{{concat(&apos;&quot;&apos;,
                    string-join(sort(//tei:dataSpec[@ident =
                    (&apos;ssrq.measure.parts.vierling&apos;, &apos;ssrq.measure.weight&apos;,
                    &apos;ssrq.measure.parts.stuck&apos;)]//tei:valItem/@ident), &apos;|&apos;),
                    &apos;&quot;&apos;)}}"/>
                    <sch:assert test="matches(@unit, concat(&apos;^&apos;, $weight,
                    &apos;$&apos;))"> &quot;
                        <sch:value-of select="./@unit"/>
                        &quot; is not a valid weight unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($weight, &apos;\|&apos;),
                        &apos;, &apos;)"/>
                        </sch:assert>
                </sch:rule>
            </sch:pattern>
        </constraint>
    </constraintSpec>
    <attList>
        <attDef ident="type" mode="replace" usage="req">
            <desc versionDate="2025-01-30" xml:lang="de">die Art der Massangabe</desc>
            <desc versionDate="2025-01-30" xml:lang="en">the type of measure</desc>
            <desc versionDate="2025-01-30" xml:lang="fr">le type de la mesure</desc>
            <datatype>
                <dataRef key="ssrq.measure.att.type"/>
            </datatype>
        </attDef>
    </attList>
