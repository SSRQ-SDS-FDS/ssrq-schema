<?xml version="1.0" encoding="UTF-8"?>
<?xml-model
href="http://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/odd/p5.nvdl"
type="application/xml" schematypens="http://purl.oclc.org/dsdl/nvdl/ns/structure/1.0"?>
<div xmlns="http://www.tei-c.org/ns/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
    <specGrp xml:id="constraints">
        <constraintSpec ident="sch-att-calendar" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of dating
            attributes</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[@calendar]">
                        <sch:assert
                        test=".[@when-custom|@notBefore-custom|@notAfter-custom|@from-custom|@to-custom]"> More attributes must be used together with @calendar to specify the date. </sch:assert>
                    </sch:rule>
                    <sch:rule
                    context="tei:*[@when-custom|@notBefore-custom|@notAfter-custom|@from-custom|@to-custom][not(ancestor::tei:publicationStmt)][not(self::tei:time)]">
                        <sch:assert test=".[@calendar]"> @calendar must be used, when either
                        @when-custom, @from-custom, @to-custom, @notAfter-custom or
                        @notBefore-custom is used. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-data-custom" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of custom
            dating attributes</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[@when-custom]">
                        <sch:report
                        test="@notBefore-custom|@notAfter-custom|@from-custom|@to-custom">
                        @when-custom cannot be used together with @notBefore-custom,
                        @notAfter-custom, @from-custom or @to-custom. </sch:report>
                    </sch:rule>
                    <sch:rule context="tei:*[@from-custom or @to-custom]">
                        <sch:assert test="@from-custom and @to-custom"> @from-custom and @to-custom
                        must always be used together. </sch:assert>
                        <sch:report test="@notBefore-custom|@notAfter-custom"> The usage of
                        @notBefore-custom and @notAfter-custom is not allowed together with
                        @from-custom and @to-custom. </sch:report>
                        <sch:assert test="if (matches(@from-custom,
                        &apos;^\d{4}-\d{2}-\d{2}$&apos;) and matches(@from-custom,
                        &apos;^\d{4}-\d{2}-\d{2}$&apos;)) then (number(translate(@to-custom,
                        &apos;-&apos;, &apos;&apos;)) - number(translate(@from-custom,
                        &apos;-&apos;, &apos;&apos;))) &gt; 0 else true()"> Invalid timespan:
                        @to-custom must be a point later in time than @from-custom. </sch:assert>
                    </sch:rule>
                    <sch:rule context="tei:*[@notBefore-custom and @notAfter-custom]">
                        <sch:assert test="if (matches(@notBefore-custom,
                        &apos;^\d{4}-\d{2}-\d{2}$&apos;) and matches(@notAfter-custom,
                        &apos;^\d{4}-\d{2}-\d{2}$&apos;)) then (number(translate(@notAfter-custom,
                        &apos;-&apos;, &apos;&apos;)) - number(translate(@notBefore-custom,
                        &apos;-&apos;, &apos;&apos;))) &gt; 0 else true()"> Invalid timespan:
                        @notAfter-custom must be a point later in time than @notBefore-custom.
                        </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-dimensions" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of @quantity
            and @unit</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[@unit=&apos;unknown&apos;]">
                        <sch:assert test="./@quantity=&apos;unknown&apos;" xml:lang="en"> If @unit
                        has the value &apos;unknown&apos;, @quantity must be &apos;unknown&apos;
                        too. </sch:assert>
                    </sch:rule>
                    <sch:rule context="tei:*[@unit or @quantity]">
                        <sch:assert test="@quantity and @unit" xml:lang="en"> @unit and @quantity
                        must be used together. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-dimensions-2" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to prevent that quantity is
            zero</desc>
            <constraint>
                <sch:pattern>
                    <!--Testing for integer (0) and float (0.0) values-->
                    <sch:rule context="tei:*[number(@quantity)=0 or number(@quantity)=0.0]">
                        <sch:report test="not(@type=&apos;currency&apos;)" xml:lang="en"> @quantity
                        may only be zero, if it occurs in combination with
                        @type=&quot;currency&quot;. </sch:report>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-spanTo" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of
            @spanTo</desc>
            <constraint>
                <sch:rule context="tei:*[@spanTo]">
                    <sch:assert test="id(@spanTo) and following::*[@xml:id=(current()/@spanTo)]">
                    The element indicated by @spanTo (
                        <sch:value-of select="@spanTo"/>
                        ) must occur after the current element <sch:name/>. </sch:assert>
                </sch:rule>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-facs" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure the pattern of
            facsimile names</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="*[@facs]">
                        <sch:report test="matches(@facs, &apos;__&apos;)" xml:lang="en"> An
                        underscore should not be followed by another underscore in @facs.
                        </sch:report>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-wit" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the reference of
            @wit</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[@wit]">
                        <sch:let name="wits" value="for $wit in tokenize(@wit, &apos; &apos;)
                        return tokenize($wit, &apos;#&apos;)[1]"/>
                        <!--This rule is introduced, because @wit should not point to any other
                        element type than witness or bibl, and this: <anyElement xml:id="foo"/>
                        <rdg wit="foo"/> should not be valid.-->
                        <sch:assert test="every $wit in $wits satisfies id($wit)/name() =
                        (&apos;bibl&apos;, &apos;witness&apos;)" xml:lang="en"> Every referenced ID
                        in @wit must belong to a tei:witness or tei:bibl element. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-att-hand" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to check the reference of
            @hand</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[@hand]">
                        <sch:let name="handNoteRef" value="@hand"/>
                        <sch:assert test="exists(id($handNoteRef)) and id($handNoteRef)/name() =
                        &apos;handNote&apos;"> The referenced ID in @hand must belong to a
                        tei:handNote element. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-trim-attributes" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to trim any attribute
            value</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="@*">
                        <sch:report test="matches(., &apos;^(\s+|\t+|\n)(.*)$&apos;)"
                        xml:lang="en"> The value of <sch:name/> should not start with whitespace.
                        </sch:report>
                        <sch:report test="matches(., &apos;^(.*)(\s+|\t+|\n)$&apos;)"
                        xml:lang="en"> The value of <sch:name/> should not end with whitespace.
                        </sch:report>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-duplicate-attribute-values" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure that no attribute has
            duplicate values</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="@*">
                        <sch:assert test="count(distinct-values(tokenize(.))) =
                        count(tokenize(.))"> An attribute should not have duplicate values.
                        </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-non-empty-elements" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure the usage of text in
            elements</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:*[name() = (&apos;ab&apos;, &apos;abbr&apos;,
                    &apos;add&apos;, &apos;additional&apos;, &apos;author&apos;,
                    &apos;availability&apos;, &apos;bibl&apos;, &apos;body&apos;,
                    &apos;custEvent&apos;, &apos;custodialHist&apos;, &apos;del&apos;,
                    &apos;dimensions&apos;, &apos;div&apos;, &apos;docImprint&apos;,
                    &apos;editorialDecl&apos;, &apos;encodingDesc&apos;, &apos;expan&apos;,
                    &apos;extent&apos;, &apos;foreign&apos;, &apos;fw&apos;, &apos;handDesc&apos;,
                    &apos;head&apos;, &apos;hi&apos;, &apos;history&apos;, &apos;idno&apos;,
                    &apos;item&apos;, &apos;keywords&apos;, &apos;label&apos;, &apos;lem&apos;,
                    &apos;licence&apos;, &apos;list&apos;, &apos;listBibl&apos;,
                    &apos;listWit&apos;, &apos;measure&apos;, &apos;measureGrp&apos;,
                    &apos;msContents&apos;, &apos;msItem&apos;, &apos;note&apos;, &apos;num&apos;,
                    &apos;objectDesc&apos;, &apos;orgName&apos;, &apos;orig&apos;,
                    &apos;origPlace&apos;, &apos;p&apos;, &apos;persName&apos;,
                    &apos;physDesc&apos;, &apos;placeName&apos;, &apos;publicationStmt&apos;,
                    &apos;publisher&apos;, &apos;pubPlace&apos;, &apos;q&apos;, &apos;quote&apos;,
                    &apos;repository&apos;, &apos;resp&apos;, &apos;respStmt&apos;,
                    &apos;row&apos;, &apos;sealDesc&apos;, &apos;seg&apos;, &apos;settlement&apos;,
                    &apos;sic&apos;, &apos;signed&apos;, &apos;sourceDesc&apos;, &apos;subst&apos;,
                    &apos;summary&apos;, &apos;supplied&apos;, &apos;support&apos;,
                    &apos;supportDesc&apos;, &apos;table&apos;, &apos;TEI&apos;,
                    &apos;teiHeader&apos;, &apos;text&apos;, &apos;textClass&apos;,
                    &apos;time&apos;, &apos;title&apos;, &apos;unclear&apos;,
                    &apos;witness&apos;)][not(*)]">
                        <sch:assert test="string-length(normalize-space(.)) &gt; 0"> The element
                        <sch:name/> must not be empty. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="non-breaking-whitespace" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-01-28" xml:lang="en">constraint to forbid non-breaking
            space</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="text()">
                        <sch:report role="warning" test="matches(., &apos; &apos;)"> It is not
                        allowed to use a non-breaking space in the text. </sch:report>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="no-quotation-marks" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-05-19" xml:lang="en">constraint to forbid quotation
            marks</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="text()">
                        <sch:report role="warning" test="matches(., &apos;[&quot;«»‹›]&apos;)">It
                        is not allowed to use quotation marks in the text. Use tei:quote, tei:q,
                        tei:orig or tei:foreign instead.</sch:report>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="sch-milestones" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-09-01" xml:lang="en">constraint for milestones</desc>
            <constraint>
                <sch:pattern>
                    <sch:rule context="tei:pb | tei:cb | tei:lb">
                        <sch:assert test="ancestor::tei:body or ancestor::tei:orig">tei:<sch:name/>
                        may only be used inside tei:body or tei:orig. </sch:assert>
                    </sch:rule>
                </sch:pattern>
            </constraint>
        </constraintSpec>
        <constraintSpec ident="unique-xml-ids" scheme="schematron" xml:lang="en">
            <desc versionDate="2025-10-20" xml:lang="en">constraint to ensure the uniqueness of
            xml:id attributes. </desc>
            <constraint>
                <sch:rule context="tei:TEI">
                    <sch:assert test="count(//@xml:id) = count(distinct-values(//@xml:id))"> All
                    values of @xml:id attributes in this document must be unique. </sch:assert>
                </sch:rule>
            </constraint>
        </constraintSpec>
    </specGrp>
</div>