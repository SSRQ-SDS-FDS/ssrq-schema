                        <desc versionDate="2022-05-10" xml:lang="en">at the bottom left of the
                        verso</desc>
                        <desc versionDate="2022-05-10" xml:lang="fr">au verso en bas à
                        gauche</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">sul verso inferiore a
                        sinistra</desc>
                     </valItem>
                     <valItem ident="verso_bottom_middle">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite unten in der
                        Mitte</desc>
                        <desc versionDate="2022-05-10" xml:lang="en">at the bottom of the verso in
                        the middle</desc>
