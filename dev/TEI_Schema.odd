                        <desc versionDate="2022-09-05" xml:lang="it">cancellazione sbarrata</desc>
                     </valItem>
                     <valItem ident="overwritten">
                        <desc versionDate="2023-05-02" xml:lang="de">Streichung durch direkte
                        Überschreibung</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">deleted text directly
