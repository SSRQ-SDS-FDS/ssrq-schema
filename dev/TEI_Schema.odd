                      module="derived-module-ssrq-main-schema"
                      ident="ssrq.type.text"
                      mode="add">
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <valList type="closed">
                     <valItem ident="collection">
                        <desc versionDate="2023-09-12" xml:lang="de">Sammlung von Stücken</desc>
                        <desc versionDate="2025-02-03" xml:lang="en">collection of source
                        documents</desc>
                        <desc versionDate="2025-02-03" xml:lang="fr">collection de documents
                        sources</desc>
                        <desc versionDate="2025-02-03" xml:lang="it">raccolta dei documenti
                        originali</desc>
                     </valItem>
                     <valItem ident="summary">
                        <desc versionDate="2023-04-05" xml:lang="de">Regest des Quellstücks</desc>
                        <desc versionDate="2025-02-03" xml:lang="en">regest of the source
                        document</desc>
                        <desc versionDate="2025-02-03" xml:lang="fr">résumé du document
                        source</desc>
                        <desc versionDate="2025-02-03" xml:lang="it">regest del documento di
                        origine</desc>
                     </valItem>
                     <valItem ident="transcript">
                        <desc versionDate="2023-04-06" xml:lang="de">Transkript des
                        Quellstücks</desc>
                        <desc versionDate="2025-02-03" xml:lang="en">transcript of the source
                        document</desc>
                        <desc versionDate="2025-02-03" xml:lang="fr">transcription du document
                        source</desc>
                        <desc versionDate="2025-02-03" xml:lang="it">trascrizione del documento di
                        origine</desc>
                     </valItem>
                  </valList>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      module="derived-module-ssrq-main-schema"
                      ident="ssrq.xmlid.anchor"
                      mode="add">
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <dataRef name="ID" restriction="(del|damage|add)[1-9][0-9]*"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.date.point"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Datumsangaben</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for dates</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les dates</desc>
               <content>
                  <dataRef name="string"
                           restriction="(((\d{4}|-)-(0[1-9]|1[0-2]))|--)-(0[1-9]|[1-2][0-9]|3[0-1])"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.time.point"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Zeitangaben</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for times</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les temps</desc>
               <content>
                  <dataRef name="string"
                           restriction="(((2[0-3]|[0-1][0-9]):[0-5][0-9]:[0-5][0-9])|24:00:00)"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.time.duration"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-03-05" xml:lang="de">das Muster für Zeitspannen nach ISO
            8601</desc>
               <desc versionDate="2025-03-05" xml:lang="en">the pattern for time spans according to
            ISO 8601</desc>
               <desc versionDate="2025-03-05" xml:lang="fr">le modèle pour le temps s’étend selon ISO
            8601</desc>
               <content>
                  <dataRef name="string" restriction="(R/)?PT(\d+(\.\d+)?[HMS])+"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.foliation"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für die Blattzählung</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for the foliation</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour le foliation</desc>
               <content>
                  <dataRef name="string"
                           restriction="((([1-9]\d*)|([IVXLCDM]+))([ab]|bis)?[rv])|[rv]"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pagination"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für die Seitenzählung</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for the pagination</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour le pagination</desc>
               <content>
                  <dataRef name="string"
                           restriction="(([1-9]\d*(\.[1-9]\d*)?|([IVXLCDM]+))([ab]|bis)?)"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.section"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für die
            Abschnittszählung</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for the section
            numbering</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour la numérotation des
            sections</desc>
               <content>
                  <dataRef name="string" restriction="s([1-9]\d*)"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.numbering"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-02-03" xml:lang="de">die originale Paginierung, Foliierung oder
            Zählung der Pergamentstücke</desc>
               <desc versionDate="2025-02-03" xml:lang="en">the original pagination, foliation or
            counting the pieces of parchment</desc>
               <desc versionDate="2025-02-03" xml:lang="fr">la pagination originale, la foliation ou
            la numérotation des morceaux de parchemin</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <dataRef key="ssrq.foliation"/>
                     <dataRef key="ssrq.pagination"/>
                     <dataRef key="ssrq.section"/>
                  </alternate>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.facs.name"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Faksimilenamen</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for facsimile names</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle poul les noms de
            télécopie</desc>
               <content>
                  <dataRef name="string" restriction="[A-Za-z_\-\d]+(\d|[IVXLCDM]|[rv]|plica)"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.keywords"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Schlagwort-IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for keyword IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les ID de mots-clés</desc>
               <content>
                  <dataRef name="string" restriction="key\d{6}"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.lemma"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Lemma-IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for lemma IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les ID de lemmes</desc>
               <content>
                  <dataRef name="string" restriction="lem\d{6}(\.1?\d{2})?"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.org"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Organisations-IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for organisation IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les ID de
            organisations</desc>
               <content>
                  <dataRef name="string" restriction="org\d{6}(\.1?\d{2})?"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.persons"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Personen-IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for person IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les ID de personne</desc>
               <content>
                  <dataRef name="string" restriction="per\d{6}[abc]?(\.1?\d{2})?"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.places"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für Ort-IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for place IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour les ID de lieux</desc>
               <content>
                  <dataRef name="string" restriction="loc\d{6}(\.1?\d{2})?"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.databases"
                      mode="add"
                      module="ssrq.core.module">
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <dataRef key="ssrq.pointer.keywords"/>
                     <dataRef key="ssrq.pointer.lemma"/>
                     <dataRef key="ssrq.pointer.org"/>
                     <dataRef key="ssrq.pointer.persons"/>
                     <dataRef key="ssrq.pointer.places"/>
                  </alternate>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.doi"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für eine DOI</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for a DOI.</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour une DOI.</desc>
               <content>
                  <dataRef name="string" restriction="doi:10\.\d{4,6}/.*"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.url"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für eine URL</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for a URL</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour une URL</desc>
               <content>
                  <dataRef name="anyURI" restriction="(https?|ftp)://[^\s/$.?#].[^\s]*"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.urn"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für eine URN</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for a URN</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour une URN</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <dataRef name="string"
                              restriction="urn:ssrq:(SSRQ|SDS|FDS)-([A-Z]{2})-([A-Za-z0-9_]+)-(((([A-Za-z0-9]+\.)*)([0-9]+)-1))(#(\d+|fol\d+[rv](\-\d+[rv])?|[pn]\d+(\.\d+)?(\-\d+(\.\d+)?)?))?"/>
                     <dataRef name="string"
                              restriction="urn:ssrq:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}(#(\d+|fol\d+[rv](\-\d+[rv])?|[pn]\d+(\.\d+)?(\-\d+(\.\d+)?)?))?"/>
                  </alternate>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.target"
                      mode="add"
                      module="ssrq.core.module">
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <dataRef key="ssrq.pointer.doi"/>
                     <dataRef key="ssrq.pointer.url"/>
                     <dataRef key="ssrq.pointer.urn"/>
                     <dataRef key="ssrq.pointer.id"/>
                  </alternate>
               </content>
            </dataSpec>
            <dataSpec rend="add" ident="ssrq.id" mode="add" module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für eine SSRQ UUID</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for an SLS UUID</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour un UUID SDS</desc>
               <content>
                  <dataRef name="ID"
                           restriction="id-ssrq-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.id.string"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für eine SSRQ UUID</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for an SLS UUID</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour un UUID SDS</desc>
               <content>
                  <dataRef name="string"
                           restriction="id-ssrq-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}"/>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      ident="ssrq.pointer.id"
                      mode="add"
                      module="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Muster für einen Pointer mit
            Fragmentbezeichner auf SSRQ IDs</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the pattern for a pointer with fragment
            identifier on SLS IDS</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le modèle pour un pointeur avec un
            identifiant de fragment sur les ID SDS</desc>
               <content>
                  <dataRef name="string"
                           restriction="id-ssrq-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}(#(\d+|fol\d+[rv](\-\d+[rv])?|[pn]\d+(\.\d+)?(\-\d+(\.\d+)?)?))?"/>
               </content>
            </dataSpec>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="ST"
                        xml:id="DSTTEI2"
                        ident="tei"
                        type="core"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="CO"
                        xml:id="DCO"
                        ident="core"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="AI"
                        xml:id="DAI"
                        ident="analysis"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="CE"
                        xml:id="DCE"
                        ident="certainty"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="FT"
                        xml:id="DFTFF"
                        ident="figures"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="HD"
                        xml:id="DHD"
                        ident="header"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="SA"
                        xml:id="DSA"
                        ident="linking"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="MS"
                        xml:id="DMSD2"
                        ident="msdescription"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="ND"
                        xml:id="DND"
                        ident="namesdates"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="TC"
                        xml:id="DTC"
                        ident="textcrit"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="DS"
                        xml:id="DDS"
                        ident="textstructure"/>
            <moduleSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                        n="PH"
                        xml:id="DPH"
                        ident="transcr"/>
         </schemaSpec>
      </body>
   </text>
</TEI>
