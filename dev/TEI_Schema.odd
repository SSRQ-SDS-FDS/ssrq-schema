                        <desc versionDate="2023-05-02" xml:lang="fr">suppression par
                        surcharge</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">cancellazione con
                        sovrascrittura diretta</desc>
                     </valItem>
                     <valItem ident="rubbing">
                        <desc versionDate="2023-05-02" xml:lang="de">Streichung durch
                        Textlöschung/Rasur</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">deletion by scraping</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">suppression par
                        grattage</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">cancellazione raschiata</desc>
                     </valItem>
                     <valItem ident="strikethrough">
                        <desc versionDate="2023-05-02" xml:lang="de">Streichung durch einfache
