                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD11">2.1.1. The TEI Header and Its Components</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-editorialDecl"
                         ident="editorialDecl">
               <gloss rend="replace" versionDate="2025-02-06" xml:lang="de">Transkriptionsrichtlinien</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">editorial declaration</gloss>
               <gloss rend="replace" versionDate="2025-02-06" xml:lang="fr">principes de transcription</gloss>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="de">Enthält einen Link zu den
    Transkriptionsrichtlinien.</desc>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="en">Includes a link to the transcription
    guidelines.</desc>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="fr">Contient un lien vers les principes de
    transcription.</desc>
               <classes/>
               <content>
                  <elementRef key="p"/>
               </content>
               <constraintSpec ident="sch-el-editorialDecl" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-08-01" xml:lang="en">constraint for tei:editorialDecl</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:editorialDecl">
                           <sch:assert test="./tei:p/tei:ref"> tei:editorialDecl must contain a tei:p with
                    a tei:ref as a child. </sch:assert>
                           <sch:assert test="./tei:p/tei:ref[@target='https://p.ssrq-sds-fds.ch/guidelines/transcription']"> The link inside tei:editorialDecl must point to the latest transcription guidelines: &lt;p&gt;&lt;ref target="https://p.ssrq-sds-fds.ch/guidelines/transcription"/&gt;&lt;/p&gt;. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-editorialDecl-de" xml:lang="de">
