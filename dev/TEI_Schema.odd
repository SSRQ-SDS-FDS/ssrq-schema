                        <desc versionDate="2023-05-16" xml:lang="en">tear</desc>
                        <desc versionDate="2023-05-16" xml:lang="fr">déchirure</desc>
                        <desc versionDate="2022-05-16" xml:lang="it">strappo</desc>
