               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD21">2.2.1. The Title Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2">2.2. The File Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-extent"
                         ident="extent">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Ausmass</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">extent</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">étendue</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Elemente, die die Masse des Textträgers
    angeben.</desc>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="en">Describes the dimensions of a source.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des éléments qui spécifient les
    dimensions du support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="dimensions" maxOccurs="2"/>
               </content>
               <constraintSpec ident="sch-el-extent" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-04-19" xml:lang="en">constraint for tei:extent</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:extent[count(tei:dimensions) &gt; 1]">
                           <sch:assert test="count(distinct-values(tei:dimensions/@type)) =                     count(tei:dimensions)"> The @type of each tei:dimensions inside tei:extent
                    needs to be unique. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-extent-de" xml:lang="de">
                  <p>
                Beispiel für die Massangabe einer Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-extent-en" xml:lang="en">
                  <p>
                Example of the dimension of a source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-extent-fr" xml:lang="fr">
                  <p>
                Exemple des dimensions d’une source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD23">2.2.3. Type and Extent of File</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2">2.2. The File Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph1">11.7.1. Object Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-publicationStmt"
                         ident="publicationStmt">
               <gloss rend="replace" versionDate="2023-07-18" xml:lang="de">Angaben zur Publikation</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">publication statement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">statut de la publication</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Elemente zur Beschreibung der Publikation
    und Verbreitung des bearbeiteten Textes.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Contains elements describing the publication and
    distribution of the edited piece.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des éléments descriptifs et déclaratifs
    sur la publication et la mise à disposition du texte édité.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="publisher"/>
                     <sequence minOccurs="0" maxOccurs="1">
                        <elementRef key="date"/>
                        <elementRef key="date" minOccurs="0"/>
                     </sequence>
                     <elementRef key="availability"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-publicationStmt-de" xml:lang="de">
                  <p>
                Beispiel für die Angaben zur Publikation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <publicationStmt>
                        <publisher>SSRQ-SDS-FDS</publisher>
                        <date type="electronic" when-custom="2023-01-01"/>
                        <date type="print" when-custom="2023-01-01"/>
                        <availability>
                           <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
            </licence>
                        </availability>
                     </publicationStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-publicationStmt-en" xml:lang="en">
                  <p>
                Example of a publication statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <publicationStmt>
                        <publisher>SSRQ-SDS-FDS</publisher>
                        <date type="electronic" when-custom="2023-01-01"/>
                        <date type="print" when-custom="2023-01-01"/>
                        <availability>
                           <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
            </licence>
                        </availability>
                     </publicationStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-publicationStmt-fr" xml:lang="fr">
                  <p>
                Exemple d’informations de publication
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <publicationStmt>
                        <publisher>SSRQ-SDS-FDS</publisher>
                        <date type="electronic" when-custom="2023-01-01"/>
                        <date type="print" when-custom="2023-01-01"/>
                        <availability>
                           <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
            </licence>
                        </availability>
                     </publicationStmt>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2">2.2. The File Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-idno"
                         ident="idno">
               <gloss rend="replace" versionDate="2023-07-07" xml:lang="de">Identifikationsnummer</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">identification number</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">numéro d’identification</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält im Identifikationsnummer.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="en">Contains an identification number.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un numéro d’identification.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.global.source"/>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="hi"/>
                     <textNode/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-idno" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-09-26" xml:lang="en">constraint for tei:idno</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:idno[parent::tei:seriesStmt]">
                           <sch:assert test="not(@xml:lang)"> The usage of @xml:lang is prohibited, when
                    tei:idno is used inside tei:seriesStmt. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:idno[parent::tei:seriesStmt][not(@type)]">
                           <sch:assert role="warning"
                                       test="matches(normalize-space(.),                     '^(SSRQ|SDS|FDS)-([A-Z]{2})-([A-Za-z0-9_]+)-(?:(?:[A-Za-z0-9]+\.)*)([0-9]+)-1$')"> The tei:idno must match the defined schema – see the examples in the documentation. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:idno[parent::tei:seriesStmt][@type]">
                           <sch:assert test="matches(normalize-space(.),                     '^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$')"> The tei:idno needs to be a UUID. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:idno[parent::tei:msIdentifier]">
                           <sch:assert test="@xml:lang"> The tei:idno needs an attribute @xml:lang if
                    it's inside tei:msIdentifier. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:TEI">
                           <sch:let name="idnos"
                                    value="//tei:idno[not(parent::tei:altIdentifier)] !                     normalize-space(.)"/>
                           <sch:assert test="count(distinct-values($idnos)) = count($idnos)"> The value of
                    every tei:idno should be unique. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:idno[tei:hi]">
                           <sch:assert test="./ancestor::tei:msIdentifier"> tei:hi inside tei:idno is only
                    allowed in tei:msIdentifier. </sch:assert>
                           <sch:assert test="tei:hi/@rend = 'sup'"> If tei:hi is used inside
                    tei:idno the attribute rend must have the value "sup". </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art der Identifikationsnummer</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of identification number</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type du numéro d’identification</desc>
                     <datatype>
                        <dataRef key="ssrq.type.idno"/>
                     </datatype>
                  </attDef>
                  <attDef ident="source" mode="replace">
                     <datatype>
                        <dataRef key="ssrq.pointer.url"/>
                     </datatype>
                  </attDef>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-idno-msIdentifier-de" xml:lang="de">
                  <p>
                Beispiel für eine Identifikationsnummer als Teil einer Handschriftensignatur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-idno-msIdentifier-en" xml:lang="en">
                  <p>
                Example of an identification number as part of a manuscript signature
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-idno-msIdentifier-fr" xml:lang="fr">
                  <p>
                Exemple de numéro d’identification dans le cadre d’une cote manuscrite
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-idno-seriesStmt-de" xml:lang="de">
                  <p>
                Beispiel für Identifikationsnummern als Teil der Reihenangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-idno-seriesStmt-en" xml:lang="en">
                  <p>
                Example of identification numbers as part of the series statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-idno-seriesStmt-fr" xml:lang="fr">
                  <p>
                Exemple de numéros d’identification servant à désigner la série
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-09-02" xml:lang="de">
                  <p>
            Wir verwenden das Element in mehreren Zusammenhängen: In <gi>seriesStmt</gi> enthält
            <gi>idno</gi> (mit <att>type</att> = <val>UUID</val>) eine <ref target="https://de.wikipedia.org/wiki/Universally_Unique_Identifier">UUID</ref>, um das
            XML-Dokument eindeutig zu bezeichnen. Ebenfalls in <gi>seriesStmt</gi> wird das
            Bandkürzel (Kanton, Teil, Stücknummer) der SSRQ angegeben. In <gi>msIdentifier</gi>
            gibt <gi>idno</gi> die Archivsignatur eines Textträgers an, in diesem Fall richtet sich
            diese nach dem System des jeweiligen Archivs.
        </p>
                  <p>
            Enthält <gi>idno</gi> eine Archivsignatur, dann folgt auf das Kürzel des Archivs kein
            Komma.
        </p>
                  <p>
            Enthält <gi>idno</gi> eine UUID, dann muss diese dem folgenden regulären Ausdruck
            entsprechen:
            <val>^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$</val>. Die UUID ist wie folgt aufgebaut:
            <list>
                        <item>Genau acht Zeichen aus folgendem Set: die Ziffern "0-9", die
                Grossbuchstaben "A-F" oder die Kleinbuchstaben "a-f".</item>
                        <item>Ein Bindestrich. </item>
                        <item>Genau vier Zeichen aus dem oben genannten Set.</item>
                        <item>Ein Bindestrich. </item>
                        <item>Die Ziffer "4", gefolgt von drei Zeichen aus dem oben genannten
                Set. </item>
                        <item>Ein Bindestrich.</item>
                        <item>Genau einmal ein Zeichen aus folgendem Set: "8", "9",
                "A", "B", "a", "b" gefolgt von genau drei
                Zeichen aus dem oben genannten Set. </item>
                        <item>Ein Bindestrich. </item>
                        <item>Genau zwölf Zeichen aus dem oben genannten Set.</item>
                     </list>
                  </p>
                  <p>
            Enthält <gi>idno</gi> ein Bandkürzel der SSRQ, dann muss dies dem folgenden regulären
            Ausdruck entsprechen:
            <val>^(SSRQ|SDS|FDS)-([A-Z]{2})-([A-Za-z0-9_]+)-(?:(?:[A-Za-z0-9]+\.)*)([0-9]+)-1$</val>. Die Bandkürzel sind wie folgt aufgebaut:
            <list>
                        <item>Das Präfix "SSRQ" oder "SDS" oder "FDS".</item>
                        <item>Ein Bindestrich. </item>
                        <item>Das Kürzel des Kantons bestehend aus zwei Grossbuchstaben. </item>
                        <item>Ein Bindestrich.</item>
                        <item>Ein Kürzel des Bandes bestehend aus beliebig vielen Grossbuchstaben,
                Kleinbuchstaben, Ziffern und Unterstrichen. </item>
                        <item>Ein Bindestrich.</item>
                        <item>Die Kapiteleinteilung des Bandes (optional) bestehend aus beliebig vielen
                Grossbuchstaben, Kleinbuchstaben, Ziffern und Punkten. </item>
                        <item>Ein Kürzel des Stücks bestehend aus beliebig vielen Ziffern. </item>
                        <item>Ein Bindestrich und die Ziffer 1</item>
                     </list>
                  </p>
               </remarks>
               <remarks versionDate="2025-09-02" xml:lang="en">
                  <p>
            If <gi>idno</gi> contains the signature of an archive, it has to match the system of
            the respective archive.
        </p>
                  <p>
            If <gi>idno</gi> contains the signature of an archive, the abbreviation of the archive
            is not followed by a comma
        </p>
                  <p>
            If <gi>idno</gi> contains a UUID, then it must match the following regular expression:
            <val>^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-
            9A-Fa-f]{3}-[0-9A-Fa-f]{12}$</val>. The UUID is structured as follows:
            <list>
                        <item>Exactly eight characters from the following set: the digits "0-9",
                the capital letters "A-F" or the lowercase letters
                "a-f".</item>
                        <item>A hyphen.</item>
                        <item>Exactly four characters from the above set.</item>
                        <item>A hyphen.</item>
                        <item>The digit "4" followed by three characters from the above
                set.</item>
                        <item>A hyphen. </item>
                        <item>Exactly one character from the following set: "8", "9",
                "A", "B", "a", "b" followed by exactly
                three characters from the above set.</item>
                        <item>A hyphen. </item>
                        <item>Exactly twelve characters from the above set.</item>
                     </list>
                  </p>
                  <p>
            If <gi>idno</gi> contains a volume abbreviation of the SLS, then this must match the
            following regular expression:
            <val>^(SSRQ|SDS|FDS)-([A-Z]{2})-([A-Za-z0-9_]+)-(?:(?:[A-Za-z0-9]+\.)*)([0-9]+)-1$</val>. The volume abbreviations are structured as follows:
            <list>
                        <item>The prefix "SSRQ" or "SDS" or "FDS".</item>
                        <item>A hyphen.</item>
                        <item>The abbreviation of the canton consisting of two capital letters.</item>
                        <item>A hyphen. </item>
                        <item>An abbreviation of the volume consisting of any number of uppercase letters,
                lowercase letters, digits and underline.</item>
                        <item>A hyphen.</item>
                        <item>The chapter division of the volume (optional) consisting of any number of
                capital letters, Lowercase letters, digits and periods.</item>
                        <item>An abbreviation of the piece consisting of any number of digits.</item>
                        <item>A hyphen and the letter one.</item>
                     </list>
                  </p>
               </remarks>
               <remarks versionDate="2025-09-02" xml:lang="fr">
                  <p>
            Nous utilisons cet élément dans plusieurs contextes : dans <gi>seriesStmt</gi>,
            <gi>idno</gi> (avec <att>type</att> = <val>UUID</val>) contient un <ref target="https://de.wikipedia.org/wiki/Universally_Unique_Identifier">UUID</ref> pour
            désigner de manière claire le document XML. Toujours dans <gi>seriesStmt</gi>, on
            trouve l’abréviation du volume (canton, partie, numéro de document) des SDS. Dans
            <gi>msIdentifier</gi>, <gi>idno</gi> indique la cote d’archive du support de texte
            selon le système de classement de l’archive concernée.
        </p>
                  <p>
            Si <gi>idno</gi> contient une cote d’archive, l’abréviation de l’archive n’est pas
            suivie d’une virgule.
        </p>
                  <p>
            Si <gi>idno</gi> contient un UUID, celui-ci doit correspondre à l’expression régulière
            suivante : <val>^[0-9A-Fa-f]{8}-[0-9A-Fa -
            f]{4}-[4][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$</val>. L’UUID est
            structuré comme suit :
            <list>
                        <item>Exactement huit caractères parmi l’ensemble suivant : les chiffres
                "0-9", les lettres majuscules "A-F" ou les lettres minuscules
                "a-f".</item>
                        <item>Un trait d’union. </item>
                        <item>Exactement quatre caractères de l’ensemble ci-dessus.</item>
                        <item>Un trait d’union.</item>
                        <item>Le chiffre "4" suivi de trois caractères du jeu ci-dessus. </item>
                        <item>Un trait d’union.</item>
                        <item>Exactement un caractère du jeu suivant : "8", "9",
                "A", "B", "a", "b" suivi d’exactement trois
                caractères de l’ensemble ci-dessus. </item>
                        <item>Un trait d’union.</item>
                        <item>Exactement douze caractères de l’ensemble ci-dessus.</item>
                     </list>
                  </p>
                  <p>
            Si <gi>idno</gi> désigne le volume des SDS, cela doit correspondre à l’expression
            régulière suivante :
            <val>^(SSRQ|SDS|FDS)-([A-Z]{2})-([A-Za-z0-9_]+)-(?:(?:[A-Za-z0-9]+\.)*)([0-9]+)-1$</val> Les abréviations de volume sont structurées comme suit :
            <list>
                        <item>Le préfixe "SSRQ" ou "SDS" ou "FDS".</item>
                        <item>Un trait d’union. </item>
                        <item>L’abréviation du canton composé de deux lettres majuscules.</item>
                        <item>Un trait d’union.</item>
                        <item>Une abréviation du volume composée d’un nombre quelconque de lettres
                majuscules, de lettres minuscules, de chiffres et de traits de soulignement.
                </item>
                        <item>Un trait d’union.</item>
                        <item>La division du chapitre du volume (facultatif) consistant en un nombre
                quelconque de lettres majuscules, minuscules, chiffres et points.</item>
                        <item>Une désignation de la pièce composée d’un nombre quelconque. </item>
                        <item>Un trait d’union et la chiffre "1".</item>
                     </list>
                  </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPERSbp">14.3.1. Basic Principles</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD26">2.2.5. The Series Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-availability"
                         ident="availability">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Verfügbarkeit</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">availability</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">disponibilité</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält Elemente, die die Verfügbarkeit eines
    Textes beschreiben.</desc>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="en">Describes the availability of a text.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient des éléments déclaratifs sur la mise à
    disposition d’un texte.</desc>
               <classes/>
               <content>
                  <elementRef key="licence"/>
               </content>
               <attList>
                  <attDef ident="status" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-availability-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung der Verfügbarkeit eines Textes
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-availability-en" xml:lang="en">
                  <p>
                Example for describing the availability of a text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-availability-fr" xml:lang="fr">
                  <p>
                Exemple pour décrire la mise à disposition d’un texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-08" xml:lang="de">
                  <p>
            Das Element gibt die Informationen zur Lizenzierung an.
        </p>
               </remarks>
               <remarks versionDate="2023-07-17" xml:lang="en">
                  <p>
            Indicates restrictions on use or disclosure, licensing, etc. We use the tag to mention
            the institution that provided us with facsimiles. A facsimile can be produced by a
            third party (rather than the institution where the source is archived). A source may be
            in the AVN, # but the facsimile was made available or created by the BPUN.
        </p>
               </remarks>
               <remarks versionDate="2025-07-08" xml:lang="fr">
                  <p>
            Cet élément permet d’indiquer les informations de licence.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-licence"
                         ident="licence">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Lizenz</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">licence</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">licence</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beschreibt die Lizenz, unter der der Text
    verfügbar ist.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Describes the license under which a text is
    available.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Décrit la licence sous laquelle le texte est
    disponible.</desc>
               <classes>
                  <memberOf key="att.pointing"/>
               </classes>
               <content>
                  <valList type="closed">
                     <valItem ident="Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA             4.0)"/>
                  </valList>
               </content>
               <attList>
                  <attDef ident="target" mode="replace" usage="req">
                     <datatype>
                        <dataRef key="ssrq.target.licence"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-availability-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung der Verfügbarkeit eines Textes
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-availability-en" xml:lang="en">
                  <p>
                Example for describing the availability of a text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-availability-fr" xml:lang="fr">
                  <p>
                Exemple pour décrire la mise à disposition d’un texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <availability>
                        <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
            Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
        </licence>
                     </availability>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Wir verwenden eine Creative-Commons-Lizenz mit folgenden Bedingungen: Bei der weiteren
            Verarbeitung der Daten muss eine Namensnennung erfolgen (BY), die Verwendung darf nicht
            kommerziellen Zwecken dienen (NC) und bei einer Weitergabe der Daten müssen dieselben
            Lizenzbedingungen angewendet werden (SA).
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Nous utilisons une licence Creative Commons avec les conditions suivantes : en cas de
            traitement ultérieur des données, le nom doit être mentionné (BY), l’utilisation ne
            doit pas servir à des fins commerciales (NC) et en cas de diffusion des données, les
            mêmes conditions de licence doivent être appliquées (SA).
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-seriesStmt"
                         ident="seriesStmt">
               <gloss rend="replace" versionDate="2023-07-18" xml:lang="de">Angaben zur Reihe</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">series statement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">informations sur la série</gloss>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="de">Enthält Informationen zur Reihe, zur dazugehörigen
    Sammlung und die Identifikationsnummer des Stücks.</desc>
               <desc rend="replace" versionDate="2023-04-21" xml:lang="en">Contains elements for describing the collection of
    Swiss legal sources series.</desc>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="fr">Contient des informations relatives à la série, à
    la collection à laquelle elle appartient et le numéro d’identification de la pièce.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="title"/>
                     <elementRef key="respStmt"/>
                     <elementRef key="idno" maxOccurs="2" minOccurs="2"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-seriesStmt-de" xml:lang="de">
                  <p>
                Beispiel für eine Reihenangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-seriesStmt-en" xml:lang="en">
                  <p>
                Example of a series statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-seriesStmt-fr" xml:lang="fr">
                  <p>
                Exemple de description d’une série
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <seriesStmt>
                        <title>Sammlung Schweizerischer Rechtsquellen</title>
                        <respStmt>
                           <orgName>Rechtsquellenstiftung der Schweizerischen Juristischen Gesellschaft</orgName>
                           <resp>Herausgabe</resp>
                        </respStmt>
                        <idno type="uuid">ad28656b-5c8d-459c-afb4-3e6ddf70810e</idno>
                        <idno>SSRQ-FR-I-1-1</idno>
                     </seriesStmt>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD26">2.2.5. The Series Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2">2.2. The File Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-sourceDesc"
                         ident="sourceDesc">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Quellenbeschreibung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">source description</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">description de la source</gloss>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="de">Enthält Elemente zur Beschreibung des
    Textträgers.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Contains elements describing the source or
    sources.</desc>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="fr">Contient des éléments pour décrire le support de
    texte.</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="msDesc"/>
                     <elementRef key="listWit"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-sourceDesc-msDesc-de" xml:lang="de">
                  <p>
                Beispiel für eine Quellenbeschreibung mit einem Textzeugen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <msDesc>
                ...
            </msDesc>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sourceDesc-msDesc-en" xml:lang="en">
                  <p>
                Example of a source description with a text witness
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <msDesc>
                ...
            </msDesc>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sourceDesc-msDesc-fr" xml:lang="fr">
                  <p>
                Exemple de description d’une source avec un seul texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <msDesc>
                ...
            </msDesc>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sourceDesc-listWit-de" xml:lang="de">
                  <p>
                Beispiel für eine Quellenbeschreibung mit einer Liste von Textzeugen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <listWit>
                ...
            </listWit>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sourceDesc-listWit-en" xml:lang="en">
                  <p>
                Example of a source description with a list of text witnesses
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <listWit>
                ...
            </listWit>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sourceDesc-listWit-fr" xml:lang="fr">
                  <p>
                Exemple d’une description de source avec une liste de témoins
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sourceDesc>
                        <listWit>
                ...
            </listWit>
                     </sourceDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Gibt es nur einen Textträger, ist der Inhalt von <gi>sourceDesc</gi> ein einzelnes
            <gi>msDesc</gi>; gibt es mehrere, dann folgt ein <gi>listWit</gi>-Element, innerhalb
            dessen für jeden Textträger ein eigenes <gi>witness</gi> mit einer eigenen
            <gi>msDesc</gi> angelegt wird.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            Content (regest), place of storage, material, layout, scribe, seal and bibliographical
            references are described.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            S’il n’y a qu’un seul support de texte, le contenu de <gi>sourceDesc</gi> est un
            <gi>msDesc</gi> unique ; s’il y en a plusieurs, il est suivi d’un élément
            <gi>listWit</gi>, à l’intérieur duquel un <gi>witness</gi> distinct est créé pour
            chaque support de témoin, avec son propre <gi>msDesc</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD3">2.2.7. The Source Description</ref>
               </listRef>
            </elementSpec>
