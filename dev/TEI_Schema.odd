                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD4">2.4. The Profile Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD11">2.1.1. The TEI Header and Its Components</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="HANDNOTE"
                         ident="handNote">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Anmerkung zu einer Hand</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">note on one hand</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">note sur une main</gloss>
               <desc rend="replace" versionDate="2023-05-22" xml:lang="de">Beschreibt eine Hand und identifiziert sie
    gegebenenfalls mit einem Schreiber.</desc>
               <desc rend="replace" versionDate="2023-05-22" xml:lang="en">Describes a hand and, where appropriate,
    identifies it with a scribe.</desc>
               <desc rend="replace" versionDate="2023-05-22" xml:lang="fr">Décrit une main et, le cas échéant, l’identifie en
    la rattachant à un scribe.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.handFeatures"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="date" maxOccurs="unbounded" minOccurs="0"/>
                     <elementRef key="p" maxOccurs="unbounded" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-handNote" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-10-16" xml:lang="en">constraint for tei:handNote</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:handNote[@xml:id]">
                           <sch:let name="note-id" value="@xml:id"/>
                           <sch:assert test="root(.)//@hand[. = $note-id]"> The tei:handNote-element with
                    the @xml:id
                        <sch:value-of select="$note-id"/>
                        is not referenced by the @hand of any element. Please reference the
                        handNote-element or delete it, if it is not needed anymore. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.hand"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.hand.century"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.id.string"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-handDesc-de" xml:lang="de">
                  <p>
                Beispiel für mehrere Beschreibungen von bekannten und unbekannten Schreiberhänden
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handDesc-en" xml:lang="en">
                  <p>
                Example of several descriptions of known and unknown scribal hands
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handDesc-fr" xml:lang="fr">
                  <p>
                Exemple de descriptions de mains de scribes connus et inconnus
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Vgl. die <ref target="scribes-and-hands.de.md">Transkriptionsrichtlinien</ref> zur
            Erfassung der Schreiber und Hände.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Consultez les <ref target="scribes-and-hands.fr.md">principes de transcription</ref>
            pour l’enregistrement des scribes et des mains.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph2">11.7.2. Writing, Decoration, and Other Notations</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-textClass"
                         ident="textClass">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Textklassifikation</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">text classification</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">classification du texte</gloss>
               <desc rend="replace" versionDate="2023-04-20" xml:lang="de">Enthält Elemente zur Beschreibung eines Textes
    mithilfe von Schlagworten.</desc>
               <desc rend="replace" versionDate="2023-04-20" xml:lang="en">Contains elements for describing a text using
    keywords.</desc>
               <desc rend="replace" versionDate="2023-04-20" xml:lang="fr">Contient des éléments qui décrivent la nature ou
    le sujet du texte à l’aide de mots-clés.</desc>
               <classes/>
               <content>
                  <elementRef key="keywords"/>
               </content>
               <exemplum xml:id="ex-textClass-de" xml:lang="de">
                  <p>
                Beispiel für den Aufbau der Textklassifikation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <textClass>
                        <keywords>
            ...
        </keywords>
                     </textClass>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-textClass-en" xml:lang="en">
                  <p>
                Example of the structure of the text classification
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <textClass>
                        <keywords>
            ...
        </keywords>
                     </textClass>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-textClass-fr" xml:lang="fr">
                  <p>
                Exemple de structure de la classification de texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <textClass>
                        <keywords>
            ...
        </keywords>
                     </textClass>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD43">2.4.3. The Text Classification</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-keywords"
                         ident="keywords">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Schlagworte</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">keywords</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">mots-clés</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält die wichtigsten Schlagworte zum Inhalt
    eines Stücks.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Contains the most important keywords for the
    content of a source.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient les mots-clés les plus importants sur le
    contenu d’un document. </desc>
               <classes/>
               <content>
                  <elementRef key="term" maxOccurs="unbounded"/>
               </content>
               <attList>
                  <attDef ident="scheme" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-keywords-de" xml:lang="de">
                  <p>
                Beispiel für eine Liste von Schlagwörtern
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <keywords>
                        <term ref="key000192"/>
                        <term ref="key000097"/>
                        <term ref="key000049"/>
                        <term ref="key000193"/>
                     </keywords>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-keywords-en" xml:lang="en">
                  <p>
                Example of a list of keywords
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <keywords>
                        <term ref="key000192"/>
                        <term ref="key000097"/>
                        <term ref="key000049"/>
                        <term ref="key000193"/>
                     </keywords>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-keywords-fr" xml:lang="fr">
                  <p>
                Exemple de liste de mots-clés
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <keywords>
                        <term ref="key000192"/>
                        <term ref="key000097"/>
                        <term ref="key000049"/>
                        <term ref="key000193"/>
                     </keywords>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Die Liste mit den Schlagworten ersetzt das klassische Sachregister der analogen Bände.
            Die Schlagworte beziehen sich in der Regel auf das gesamte Stück. Die Schlagworte
            werden gemäss der entsprechenden <ref target="https://termini.ssrq-sds-fds.ch">Datenbank</ref> der SSRQ vergeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-18" xml:lang="en">
                  <p>
            The list of keywords replaces the classic subject index of the analogue volumes. The
            catchphrases usually refer to the entire piece. With longer numbers or with the edition
            of a book, the keywords are assigned according to the structure in articles or
            paragraphs. The keywords should be assigned according to a controlled word list.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            La liste des mots-clés remplace l’index thématique classique des volumes analogiques.
            En règle générale, les mots-clés se rapportent à la pièce entière. Les mots-clés sont
            attribués conformément à <ref target="https://termini.ssrq-sds-fds.ch">la base de
            données</ref> correspondante des SDS.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD43">2.4.3. The Text Classification</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="linking"
                         xml:id="gi-ab"
                         ident="ab">
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="de">anonymer Textblock</gloss>
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="en">anonymous block</gloss>
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="fr">bloc anonyme</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält einen beliebigen Textblock ohne klar
    definierte Zuordnung.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="en">Contains any text block without a clearly defined
    assignment.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient un bloc de texte quelconque sans
    affectation clairement définie.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
                  <memberOf key="model.pLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-ab" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-05-08" xml:lang="en">constraints for tei:ab</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:ab[tei:hi]">
                           <sch:report role="warning"
                                       test=".[count(*) =                     1][string-length(normalize-space(string-join(text(), ''))) = 0]"
                                       xml:lang="en"> If no further text is used inside tei:ab and tei:hi is the only
                    child, consider using the rend-attribute of tei:ab. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:ab[@type='marginal_note']">
                           <sch:assert test=".[@place[contains(., 'margin')]]" xml:lang="en"> If
                    tei:ab is of type marginal_note, its place must be either
                    'left_margin' or 'right_margin'. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:ab[@type='dorsal']">
                           <sch:assert test=".[@place[contains(., 'verso')]]" xml:lang="en"> If
                    tei:ab is of type dorsal, its place must be on the verso page. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="abstractModel-structure-ab-in-l"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:l//tei:ab">
                        <sch:assert test="ancestor::tei:floatingText | parent::tei:figure | parent::tei:note">
          Abstract model violation: Metrical lines may not contain higher-level divisions such as p or ab, unless ab is a child of figure or note, or is a descendant of floatingText.
        </sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="place" mode="replace" usage="req">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort des anonymen Textblocks</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the anonymous block</desc>
                     <desc versionDate="2025-04-28" xml:lang="fr">l’emplacement du bloc anonyme</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place.ab"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place.add"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">das verwendete Schreibmittel</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the writing means used</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">les moyens d’écriture utilisés</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.add"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.placement"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.rotation"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-31" xml:lang="de">die Art des Textblocks</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the type of text block</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le type de bloc de texte</desc>
                     <datatype>
                        <dataRef key="ssrq.type.ab"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-ab-de" xml:lang="de">
                  <p>
                Beispiel für einen Kanzleivermerk
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ab place="right_plica" type="chancery_notation" xml:lang="la">
        Ad mandatum domini regis <persName>Ulricus de Albeck</persName>
                        <note>Ulrich von Albeck (1431 gestorben, ab 1401 Angehöriger der Kanzlei König
        Ruprechts, später Bischof), vgl. Ruoff, Hochgerichtsbarkeit, S. 365. </note> decretorum doctor.
    </ab>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ab-fr" xml:lang="fr">
                  <p>
                Exemple de note de chancellerie
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ab place="right_plica" type="chancery_notation" xml:lang="la">
        Ad mandatum domini regis <persName>Ulricus de Albeck</persName>
                        <note>Ulrich von Albeck (1431 gestorben, ab 1401 Angehöriger der Kanzlei König
        Ruprechts, später Bischof), vgl. Ruoff, Hochgerichtsbarkeit, S. 365. </note> decretorum doctor.
    </ab>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ab-en" xml:lang="en">
                  <p>
                Example of a clerk’s note
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ab place="right_plica" type="chancery_notation" xml:lang="la">
        Ad mandatum domini regis <persName>Ulricus de Albeck</persName>
                        <note>Ulrich von Albeck (1431 gestorben, ab 1401 Angehöriger der Kanzlei König
        Ruprechts, später Bischof), vgl. Ruoff, Hochgerichtsbarkeit, S. 365. </note> decretorum doctor.
    </ab>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Wir verwenden das Element mit den Attributen <att>type</att> und <att>place</att> für
            Vermerke aller Art wie Dorsualnotizen, Kanzleivermerke oder Registraturvermerke, sowie
            für Marginalien.
        </p>
                  <p>
            Die Vermerke werden in chronologischer Reihenfolge aufgenommen. Zeitgleich entstandene
            Vermerke werden aufgrund der chronologischen Reihenfolge immer an der gleichen Stelle
            aufgeführt. Wenn z. B. bei einem Missiv auf der Rückseite eine Dorsualnotiz an erster
            Stelle steht, dann die Adresse folgt und schliesslich zwei weitere Dorsualnotizen, dann
            steht die Adresse trotzdem an erster Stelle, weil sie der chronologisch gesehen erste
            Eintrag ist.
        </p>
                  <p>
            Bei Papsturkunden erfolgt die Angabe der Vermerke in folgender Reihenfolge: zuerst die
            Vermerke unter der Plica, dann die auf der Plica und zum Schluss die Vermerke auf der
            Rückseite der Urkunde.
        </p>
                  <p>
            Alle jeweils zeitgleichen Vermerke werden in Leserichtung von oben nach unten und von
            links nach rechts erfasst. Falls die Leserichtung, an der man sich orientieren soll,
            nicht eindeutig ist, z. B. wenn ein Vermerk auf dem Kopf steht, ist ein Kommentar
            notwendig.
        </p>
               </remarks>
               <remarks versionDate="2023-06-30" xml:lang="en">
                  <p>
            We always use the tag together with <att>type</att> and <att>place</att> for notes,
            dorsal notes, chancery notes and registry notes as well as for marginalia.
        </p>
                  <p>
            In the case of papal documents, the notes are given in the following order: first the
            notes under the plica, then the notes on the plica from left to right, and finally the
            notes on the back of the document from left to right.
        </p>
                  <p>
            The endorsements and dorsual notes are recorded in chronological order. Contemporaneous
            notes are always listed first because of the chronological order. Contemporaneous notes
            are recorded in reading direction from top to bottom and from left to right. For
            example, if a missive has a dorsal notation on the back in first place, followed by the
            address and finally two more dorsal notations, the address will still be in first
            place. If the reading direction to be followed is not uniform, i.e. a dorsual note is
            upside down, a comment is necessary.
        </p>
               </remarks>
               <remarks versionDate="2025-04-28" xml:lang="fr">
                  <p>
            Nous utilisons l’élément avec les attributs <att>type</att> et <att>place</att> pour
            toutes sortes de notes telles que les notes dorsales, les notes de chancellerie ou les
            notes de greffe, ainsi que pour les notes marginales.
        </p>
                  <p>
            Les notes sont disposées par ordre chronologique. Les notes créées en même temps sont
            toujours répertoriées au même endroit selon l’ordre chronologique. Si p. ex. une note
            dorsale apparaît en premier au dos d’une missive, suivie de l’adresse et enfin de deux
            autres notes dorsales, l’adresse figure tout de même en première position, car elle est
            la première mention chronologiquement parlant.
        </p>
                  <p>
            Dans le cas des documents papaux, les notes sont données dans l’ordre suivant : d’abord
            les notes sous le repli (plica), puis celles sur le repli et enfin les notes au dos du
            document.
        </p>
                  <p>
            Toutes les notes simultanées sont enregistrées dans le sens de lecture de haut en bas
            et de gauche à droite. Si le sens de lecture à suivre n’est pas clair, p. ex. si une
            note est à l’envers, un commentaire est nécessaire.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SASE">17.3. Blocks, Segments, and Anchors</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="linking"
                         xml:id="gi-anchor"
                         ident="anchor">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Ankerpunkt</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">anchoring point</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">point d’ancrage</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Markiert den Endpunkt einer umfangreichen
    Hinzufügung (<gi>addSpan</gi>), Tilgung (<gi>delSpan</gi>) oder Beschädigung
    (<gi>damageSpan</gi>).</desc>
               <desc rend="replace" versionDate="2023-08-18" xml:lang="en">Endpoint of extensive addition (<gi>addSpan</gi>),
    deletion (<gi>delSpan</gi>) or corruption (<gi>damageSpan</gi>). </desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Marque le point final d’un ajout volumineux
    (<gi>addSpan</gi>), d’une suppression volumineuse (<gi>delSpan</gi>) ou d’une séquence
    volumineuse altérée (<gi>damageSpan</gi>). </desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="xml:id" mode="change" usage="req">
                     <datatype>
                        <dataRef key="ssrq.xmlid.anchor"/>
                     </datatype>
                  </attDef>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-addSpan-de" xml:lang="de">
                  <p>
                Beispiel für eine umfangreichere Hinzufügung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-addSpan-en" xml:lang="en">
                  <p>
                Example of a larger addition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-addSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’un ajout volumineux
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-delSpan-de" xml:lang="de">
                  <p>
                Beispiel für eine umfangreichere Tilgung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-delSpan-en" xml:lang="en">
                  <p>
                Example of a larger deletion
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-delSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’une suppression volumineuse
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damageSpan-de" xml:lang="de">
                  <p>
                Beispiel für einen umfangreicheren Schaden
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damageSpan-en" xml:lang="en">
                  <p>
                Example of a more extensive damage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damageSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’une séquence volumineuse altérée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-24" xml:lang="de">
                  <p>
            Als Wert des Attributs <att>xml:id</att> ist der erste Teil des Namens des
            entsprechenden Elements (<gi>addSpan</gi> = <val>add</val>, <gi>delSpan</gi> =
            <val>del</val> bzw. <gi>damageSpan</gi> = <val>damage</val>) sowie eine fortlaufende
            Nummer zu wählen: z. B. <val>add1</val>, <val>add2</val> usw. oder <val>del1</val>,
            <val>del2</val> usw. oder <val>damage1</val>, <val>damage2</val> usw.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            The value of the <att>xml:id</att> attribute is the first part of the name of the
            corresponding elements (<gi>addSpan</gi>, <gi>delSpan</gi> or <gi>damageSpan</gi>) and
            a to dial a consecutive number: e.g. add1, add2 etc. or del1, del2 etc. or damage1,
            damage2 etc.
        </p>
               </remarks>
               <remarks versionDate="2025-02-24" xml:lang="fr">
                  <p>
            La valeur de l’attribut <att>xml:id</att> doit être la première partie du nom d’élément
            correspondant (<gi>addSpan</gi> = <val>add</val>, <gi>delSpan</gi> = <val>del</val> ou
            <gi>damageSpan</gi> = <val>damage</val>) ainsi qu’un numéro consécutif : p. ex.
            <val>add1</val>, <val>add2</val> etc. ou <val>del1</val>, <val>del2</val> etc. ou
            <val>damage1</val>, <val>damage2</val> etc.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TS.html#TSSAPA">8.4.2. Synchronization and Overlap</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SACS">17.5. Correspondence and Alignment</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="linking"
                         xml:id="gi-seg"
                         ident="seg">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Segment</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">segment</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">segment</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält einen Abschnitt, der von den Bearbeitenden
    zur Strukturierung des Quellentextes eingefügt wurde.</desc>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="en">Paragraphs inserted by the editor to structure the
    source text.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un segment inséré par les éditeurs pour
    structurer le texte de la source.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.segLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="unbounded">
                        <elementRef key="add"/>
                        <elementRef key="cb"/>
                        <elementRef key="head"/>
                        <elementRef key="list"/>
                        <elementRef key="p"/>
                        <elementRef key="pb"/>
                        <elementRef key="table"/>
                     </alternate>
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <macroRef key="ssrq.content.default"/>
                     </sequence>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="n" mode="change">
                     <desc versionDate="2025-02-04" xml:lang="de">die Nummerierung des Segments</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the numbering of the segment</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">la numérotation du segment</desc>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-seg-de" xml:lang="de">
                  <p>
                Beispiel für vom Bearbeitenden eingeführte Absätze mit nicht originaler Nummerierung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg n="1">
                           <lb/>Item wann man den raut bu̍ttet an ain  unnd welcher dann nit
            <lb/>kompt, der gitt zuͦ buͦß ain schilling haller.
        </seg>
                        <seg n="2">
            Item so man den raut
            <lb/>bu̍ttet an ain marck silbers unnd welcher dann
            <lb/>nit kompt, der gitt zuͦ buͦß ii .
        </seg>
                        <seg n="3">
                           <lb/>Item wann man den
            <lb/>raut bu̍tet by dem ayd unnd weder von der statt
            <lb/>ze ritten noch zuͤ gon, welcher dann nit kompt, der gitt zuͦ buͦß
            <lb/>v  haller.
        </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-seg-en" xml:lang="en">
                  <p>
                Example of paragraphs introduced by the editor with non-original numbering
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg n="1">
                           <lb/>Item wann man den raut bu̍ttet an ain  unnd welcher dann nit
            <lb/>kompt, der gitt zuͦ buͦß ain schilling haller.
        </seg>
                        <seg n="2">
            Item so man den raut
            <lb/>bu̍ttet an ain marck silbers unnd welcher dann
            <lb/>nit kompt, der gitt zuͦ buͦß ii .
        </seg>
                        <seg n="3">
                           <lb/>Item wann man den
            <lb/>raut bu̍tet by dem ayd unnd weder von der statt
            <lb/>ze ritten noch zuͤ gon, welcher dann nit kompt, der gitt zuͦ buͦß
            <lb/>v  haller.
        </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-seg-fr" xml:lang="fr">
                  <p>
                Exemple de paragraphes introduits par l’éditeur avec une numérotation non original
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg n="1">
                           <lb/>Item wann man den raut bu̍ttet an ain  unnd welcher dann nit
            <lb/>kompt, der gitt zuͦ buͦß ain schilling haller.
        </seg>
                        <seg n="2">
            Item so man den raut
            <lb/>bu̍ttet an ain marck silbers unnd welcher dann
            <lb/>nit kompt, der gitt zuͦ buͦß ii .
        </seg>
                        <seg n="3">
                           <lb/>Item wann man den
            <lb/>raut bu̍tet by dem ayd unnd weder von der statt
            <lb/>ze ritten noch zuͤ gon, welcher dann nit kompt, der gitt zuͦ buͦß
            <lb/>v  haller.
        </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-seg-de" xml:lang="de">
                  <p>
                Beispiel für einen Absatz mit Untergliederung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-seg-en" xml:lang="en">
                  <p>
                Example of a paragraph with subdivision
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-seg-fr" xml:lang="fr">
                  <p>
                Exemple de paragraphe avec subdivision
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
                     <gi>seg</gi> kann innerhalb von <gi>p</gi> zur Binnenstrukturierung eines originalen
            Absatzes verwendet werden oder ausserhalb von <gi>p</gi>, um mehrere Bestandteile des
            Textes zu einer Einheit zusammenzufassen. In beiden Fällen kommen auf einer
            Hierarchieebene mindestens zwei gleichrangige <gi>seg</gi>-Elemente zum Einsatz.
        </p>
                  <p>
            Dagegen werden <gi>div</gi> und <gi>p</gi> nur für originale Abschnitte und Absätze
            verwendet, vgl. auch die Regeln zur Strukturierung von Texten in den <ref target="textstructure.de.md">Transkriptionsrichtlinien</ref>.
        </p>
                  <p>
            Bei längeren Originaltexten wie Offnungen oder Urbarien kann es sinnvoll sein, Artikel,
            Absätze oder Paragraphen durch <gi>seg</gi> zusätzlich mit <att>n</att> zu nummerieren.
            Eine Nummerierung wird nur dort eingeführt, wo die Struktur des Textes es hergibt (vgl.
            Beispiele in den gedruckten Bänden der SSRQ).
        </p>
               </remarks>
               <remarks versionDate="2024-05-08" xml:lang="en">
                  <p>
            Used inside <gi>p</gi>. On the other hand, <gi>div</gi> and <gi>p</gi> are only used
            for original paragraphs.
        </p>
                  <p>
            With longer original texts such as openings or urbaria, it can make sense to number
            articles, divisions or paragraphs with <gi>seg</gi> with <att>n</att> additionally.
            Numbering is introduced only where the structure of the text allows it (cf. examples in
            the printed volumes of the SLS). For the structuring of closing formulas, see the
            examples on the page on textstructure.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            L’élément <gi>seg</gi> peut être utilisé à l’intérieur de <gi>p</gi> pour structurer un
            paragraphe original, ou en dehors de <gi>p</gi> pour combiner plusieurs parties du
            texte en une seule unité. Dans les deux cas, il faut utiliser au moins deux éléments
            <gi>seg</gi> de même rang, à l’intérieur d’un même niveau hiérarchique.
        </p>
                  <p>
            En revanche, <gi>div</gi> et <gi>p</gi> ne sont utilisés que pour les sections et les
            paragraphes originaux, voir également les règles de structuration des textes dans les
            <ref target="textstructure.fr.md">principes de transcription</ref>.
        </p>
                  <p>
            Pour les textes originaux plus longs tels que les ouvertures ou les registres fonciers,
            il peut être utile de numéroter les articles, les paragraphes ou les sections en
            utilisant <gi>seg</gi>, en plus avec <att>n</att>. La numérotation n’est introduite que
            là où la structure du texte le permet (voir des exemples dans les volumes imprimés de
            la SDS).
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SASE">17.3. Blocks, Segments, and Anchors</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/VE.html#VESE">6.2. Components of the Verse Line</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DR.html#DRPAL">7.2.5. Speech Contents</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="MSDESC"
                         ident="msDesc">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Handschriftenbeschreibung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">manuscript description</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">description du manuscrit</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beschreibt einen Textträger wie eine Handschrift
    oder einen frühneuzeitlichen Druck.</desc>
               <desc rend="replace" versionDate="2023-05-30" xml:lang="en">Describes the edited source document, including
    place of preservation, material, layout, scribe, seal and bibliography on secondary literature
    (metadata).</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Décrit un support de texte tel qu’un manuscrit ou
    un imprimer moderne.</desc>
               <classes>
                  <memberOf key="model.biblLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="msIdentifier" minOccurs="0"/>
                     <elementRef key="head" maxOccurs="unbounded" minOccurs="0"/>
                     <elementRef key="msContents" minOccurs="0"/>
                     <elementRef key="physDesc" minOccurs="0"/>
                     <elementRef key="history"/>
                     <elementRef key="additional" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-msDesc" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-03-07" xml:lang="en">constraint for tei:msDesc</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:msDesc[ancestor::tei:TEI//tei:text[@type =                 'collection']]">
                           <sch:assert test=".[not(//tei:adminInfo)][not(tei:physDesc)]"> Neither
                    tei:physDesc nor tei:adminInfo are allowed for documents with tei:text/@type =
                    'collection'.</sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:msDesc[not(ancestor::tei:TEI//tei:text[@type =                 'collection'])][not(tei:physDesc)]">
                           <sch:assert test=".[//tei:adminInfo]"> If no tei:physDesc is given,
                    tei:adminInfo is required.</sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-msDesc-head" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-02-24" xml:lang="en">constraint to ensure the usage of tei:head in
        at least the first witness</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:msDesc[parent::tei:sourceDesc]">
                           <sch:assert test=".[tei:head]"> tei:head is necessary when there is only one
                    text witness. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:msDesc[parent::tei:witness[@n='A']]">
                           <sch:assert test="./tei:head"> tei:head is necessary for the main text witness.
                    </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-msDesc-head-2" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-10-23" xml:lang="en">constraint to ensure that one tei:head is used
        per language</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:msDesc[count(tei:head)=1]">
                           <sch:report test="tei:head[@xml:lang]"> If just one tei:head is used in a text
                    witness, @xml:lang may not be specified there. </sch:report>
                        </sch:rule>
                        <sch:rule context="tei:msDesc[count(tei:head)&gt;1]">
                           <sch:assert test="tei:head[@xml:lang]"> If multiple tei:head elements are used
                    in a text witness, @xml:lang must be specified for them. </sch:assert>
                           <sch:assert test="count(distinct-values(tei:head/@xml:lang)) =                     count(tei:head)"> If multiple tei:head elements are used in a text witness,
                    @xml:lang must be unique for all of these. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec scheme="schematron" ident="one_ms_singleton_max" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:msContents|tei:physDesc|tei:history|tei:additional">
        <!-- Note: This rule applies to <msContents>, <physDesc>,
             <history>, and <additional> wherever they occur. Luckily
             they are only allowed in places where they are
             constrained to 0 or 1 occurence. If that changes someday,
             this constraint may will likely need to be updated,
             too. -->
        <!-- Also worth noting that
             a) if & when we can use abstract patterns, this would be
             better handled as a single abstract rule somewhere, and
             concrete rules in the individual <elementSpec>s; and
             b) I did not test for the existence of "../*[name(.) eq
             $gi][2]" because then an error would be generated for
             each of the multiple occurences of $gi. -->
                        <sch:let name="gi" value="name(.)"/>
                        <sch:report test="preceding-sibling::*[ name(.) eq $gi ]                           and                           not( following-sibling::*[ name(.) eq $gi ] )">
          Only one <sch:name/> is allowed as a child of <sch:value-of select="name(..)"/>.
        </sch:report>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-msDesc-de" xml:lang="de">
                  <p>
                Beispiel für eine Textzeugenbeschreibung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msDesc>
                        <msIdentifier>
            ...
        </msIdentifier>
                        <head>...</head>
                        <msContents>
            ...
        </msContents>
                        <physDesc>
            ...
        </physDesc>
                        <history>
            ...
        </history>
                        <additional>
            ...
        </additional>
                     </msDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msDesc-fr" xml:lang="fr">
                  <p>
                Exemple de structure servant à la description d’un texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msDesc>
                        <msIdentifier>
            ...
        </msIdentifier>
                        <head>...</head>
                        <msContents>
            ...
        </msContents>
                        <physDesc>
            ...
        </physDesc>
                        <history>
            ...
        </history>
                        <additional>
            ...
        </additional>
                     </msDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msDesc-en" xml:lang="en">
                  <p>
                Example of a text witness description
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msDesc>
                        <msIdentifier>
            ...
        </msIdentifier>
                        <head>...</head>
                        <msContents>
            ...
        </msContents>
                        <physDesc>
            ...
        </physDesc>
                        <history>
            ...
        </history>
                        <additional>
            ...
        </additional>
                     </msDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            In den Kindelementen werden alle Metadaten zu einem Textträger, wie Aufbewahrungsort,
            Material, Layout, Schreiber, Siegel und Bibliographie erfasst.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Toutes les métadonnées relatives à un support textuel, telles que le lieu de
            conservation, le matériau, la mise en page, le scribe, le sceau et la bibliographie
            sont saisies dans les éléments enfants de cet élément.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msov">11.1. Overview</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="DIMENSIONS"
                         ident="dimensions">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Dimensionen</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">dimensions</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">dimensions</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält die Masse einer Quelle.</desc>
               <desc rend="replace" versionDate="2023-04-19" xml:lang="en">Dimension of a source</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient les dimensions d’une source.</desc>
               <classes>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.pPart.msdesc"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                     <elementRef key="width"/>
                     <elementRef key="height" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-dimensions" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-04-19" xml:lang="en">constraint for tei:dimensions</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:dimensions[@type = 'plica']">
                           <sch:assert test="count(*) = 1 and */name() = 'width'">If the value
                    of @type is 'plica' only one tei:width is allowed as a
                    child.</sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec scheme="schematron" ident="duplicateDim" xml:lang="en">
    <!-- It would be simpler to use just
         "( count(tei:width), count(tei:height), count(tei:depth) ) > 1",
         but then we would not be able to tell the user which element
         had too many occurences. -->
                  <constraint>
                     <sch:rule context="tei:dimensions">
                        <sch:report test="count(tei:width) gt 1">
          The element <sch:name/> may appear once only
        </sch:report>
                        <sch:report test="count(tei:height) gt 1">
          The element <sch:name/> may appear once only
        </sch:report>
                        <sch:report test="count(tei:depth) gt 1">
          The element <sch:name/> may appear once only
        </sch:report>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-31" xml:lang="de">die Art des Masses</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the type of dimension</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le type de dimension</desc>
                     <datatype>
                        <dataRef key="ssrq.type.dimensions"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-extent-de" xml:lang="de">
                  <p>
                Beispiel für die Massangabe einer Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-extent-en" xml:lang="en">
                  <p>
                Example of the dimension of a source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-extent-fr" xml:lang="fr">
                  <p>
                Exemple des dimensions d’une source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <extent>
                        <dimensions type="leaves">
                           <height quantity="33.0" unit="cm"/>
                           <width quantity="24.0" unit="cm"/>
                        </dimensions>
                        <dimensions type="plica">
                           <width quantity="4.0" unit="cm"/>
                        </dimensions>
                     </extent>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Wenn das Attribut <att>type</att> den Wert <val>plica</val> hat, dann ist nur ein
            <gi>width</gi>-Element als Kindelement erlaubt, ansonsten sollten sowohl <gi>width</gi>
            als auch <gi>height</gi> angeben werden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            If <att>type</att> has value <val>plica</val> then only one <gi>width</gi> element is
            allowed as content.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Si l’attribut <att>type</att> a la valeur <val>plica</val>, alors un seul élément
            <gi>width</gi> est autorisé comme élément enfant, sinon il faut indiquer aussi bien
            <gi>width</gi> que <gi>height</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdim">11.3.4. Dimensions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="HEIGHT"
                         ident="height">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Höhe</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">height</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">hauteur</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beschreibt innerhalb von <gi>dimensions</gi> die
    Höhe eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-03-21" xml:lang="en">Describes the height of a sheet or book.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Décrit la hauteur d’un support de texte dans
    <gi>dimensions</gi>.</desc>
               <classes>
                  <memberOf key="att.dimensions"/>
                  <memberOf key="model.measureLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="unit" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.dimensions.unknown"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.measure.lengths.base.cm"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="quantity" mode="change" usage="req"/>
               </attList>
               <exemplum xml:id="ex-height-cm-de" xml:lang="de">
                  <p>
                Beispiel für eine Höhenangabe in Zentimetern
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-height-cm-en" xml:lang="en">
                  <p>
                Example of a height in centimeters
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-height-cm-fr" xml:lang="fr">
                  <p>
                Exemple d’une taille en centimètres
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-height-unknown-de" xml:lang="de">
                  <p>
                Beispiel für eine unbekannte Höhenangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-height-unknown-en" xml:lang="en">
                  <p>
                Example of an unknown height
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-height-unknown-fr" xml:lang="fr">
                  <p>
                Exemple d’une hauteur inconnue
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <height quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-27" xml:lang="de">
                  <p>
            Die Masseinheit für das Attribut <att>unit</att> ist Zentimeter (cm). Ist die Höhe des
            Textträgers unbekannt, wird das wie in Beispiel 2 ausgedrückt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            The unit of measure for <att>unit</att> is centimeters (cm).
        </p>
               </remarks>
               <remarks versionDate="2025-02-27" xml:lang="fr">
                  <p>
            L’unité de mesure de l’attribut <att>unit</att> est le centimètre (cm). Si la hauteur
            du support de texte est inconnue, elle est exprimée comme dans l’exemple 2.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdim">11.3.4. Dimensions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="WIDTH"
                         ident="width">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Breite</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">width</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">largeur</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Beschreibt innerhalb von <gi>dimensions</gi> die
    Breite eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Describes the width of a sheet or book and the
    width of the plica.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Décrit la largeur d’un support de texte dans
    <gi>dimensions</gi>.</desc>
               <classes>
                  <memberOf key="att.dimensions"/>
                  <memberOf key="model.measureLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="unit" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.dimensions.unknown"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.measure.lengths.base.cm"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="quantity" mode="change" usage="req"/>
               </attList>
               <exemplum xml:id="ex-width-cm-de" xml:lang="de">
                  <p>
                Beispiel für eine Breitenangabe in Zentimetern
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-width-cm-en" xml:lang="en">
                  <p>
                Example of a width in centimeters
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-width-cm-fr" xml:lang="fr">
                  <p>
                Exemple de largeur en centimètres
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="4" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-width-unknown-de" xml:lang="de">
                  <p>
                Beispiel für eine unbekannte Breitenangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-width-unknown-en" xml:lang="en">
                  <p>
                Example of an unknown width
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-width-unknown-fr" xml:lang="fr">
                  <p>
                Exemple de largeur inconnue
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <width quantity="unknown" unit="unknown"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Die Masseinheit für das Attribut <att>unit</att> ist Zentimeter (cm), ist die Breite
            des Textträgers unbekannt, wird das wie in Beispiel 2 ausgedrückt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            The unit of measure for <att>unit</att> is centimeters (cm).
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            L’unité de mesure de l’attribut <att>unit</att> est le centimètre (cm) ; si la largeur
            du support de texte est inconnue, elle est exprimée comme dans l’exemple 2.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdim">11.3.4. Dimensions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="MATERIAL"
                         ident="material">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Material</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">material</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">matériau</gloss>
               <desc rend="replace" versionDate="2025-02-27" xml:lang="de">Beschreibt das Material des Textträgers.</desc>
               <desc rend="replace" versionDate="2023-04-14" xml:lang="en">Describes the support material.</desc>
               <desc rend="replace" versionDate="2025-02-27" xml:lang="fr">Décrit le matériau du support de texte.</desc>
               <classes>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.pPart.msdesc"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="type" mode="change" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Materials</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of material</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de matériau</desc>
                     <datatype>
                        <dataRef key="ssrq.type.material"/>
                     </datatype>
                  </attDef>
                  <attDef ident="function" mode="delete"/>
                  <attDef ident="target" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-support-de" xml:lang="de">
                  <p>
                Beispiel für eine Beschreibung des Beschreibstoffs einer Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-support-en" xml:lang="en">
                  <p>
                Example of a description of the descriptive material of a source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-support-fr" xml:lang="fr">
                  <p>
                Exemple de description du matériau d’une source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msmat">11.3.2. Material and Object Type</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ORIGDATE"
                         ident="origDate">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Entstehungsdatum</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">date of origin</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">date d’origine</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält im <gi>teiHeader</gi> das Entstehungsdatum
    eines Textträgers oder seines Inhalts.</desc>
               <desc rend="replace" versionDate="2023-09-13" xml:lang="en">Contains this in the head area the date of
    creation of a document.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient la date de création d’un support de texte
    ou de son contenu dans le <gi>teiHeader</gi>.</desc>
               <classes>
                  <memberOf key="att.calendarSystem"/>
                  <memberOf key="att.datable.custom"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.pPart.msdesc"/>
               </classes>
               <content>
                  <alternate minOccurs="0" maxOccurs="unbounded">
                     <elementRef key="precision"/>
                     <macroRef key="ssrq.content.default"/>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="calendar" mode="change" usage="req"/>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-30" xml:lang="de">worauf sich das Entstehungsdatum
            bezieht</desc>
                     <desc versionDate="2025-01-30" xml:lang="en">what the date of origin refers to</desc>
                     <desc versionDate="2025-01-30" xml:lang="fr">à quoi la date d’origine fait
            référence</desc>
                     <datatype>
                        <dataRef key="ssrq.orig.type"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-history-de" xml:lang="de">
                  <p>
                Beispiel für die Datierung, den Ausstellungsort und den Aussteller eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-en" xml:lang="en">
                  <p>
                Example of the dating, place of issue and issuer of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-fr" xml:lang="fr">
                  <p>
                Exemple de datation, de lieu d’émission et d’émetteur d’un document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-abbr-de" xml:lang="de">
                  <p>
                Originaldatierung mit Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origDate calendar="gregorian" when-custom="1669-11-10">10. <abbr>9bris</abbr> 1669</origDate>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-abbr-en" xml:lang="en">
                  <p>
                Original dating with abbreviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origDate calendar="gregorian" when-custom="1669-11-10">10. <abbr>9bris</abbr> 1669</origDate>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-abbr-fr" xml:lang="fr">
                  <p>
                Datation originale avec abréviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origDate calendar="gregorian" when-custom="1669-11-10">10. <abbr>9bris</abbr> 1669</origDate>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-multiple-de" xml:lang="de">
                  <p>
                Beispiel für die Unterscheidung von Herstellungsdatum und Datum des Inhalts eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origin>
                        <origDate calendar="julian" type="content" when-custom="1473-04-26"/>
                        <origDate calendar="unknown"
                                  notAfter-custom="1685-11-01"
                                  notBefore-custom="1660-11-01"
                                  type="document">
                           <precision match="@notAfter-custom" precision="medium"/> nach 1. November 1660 </origDate>
                     </origin>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-multiple-en" xml:lang="en">
                  <p>
                Example of distinguishing between date of manufacture and date the content of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origin>
                        <origDate calendar="julian" type="content" when-custom="1473-04-26"/>
                        <origDate calendar="unknown"
                                  notAfter-custom="1685-11-01"
                                  notBefore-custom="1660-11-01"
                                  type="document">
                           <precision match="@notAfter-custom" precision="medium"/> nach 1. November 1660 </origDate>
                     </origin>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-origDate-multiple-fr" xml:lang="fr">
                  <p>
                Exemple de distinction entre la date de production du document et la date du contenu
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <origin>
                        <origDate calendar="julian" type="content" when-custom="1473-04-26"/>
                        <origDate calendar="unknown"
                                  notAfter-custom="1685-11-01"
                                  notBefore-custom="1660-11-01"
                                  type="document">
                           <precision match="@notAfter-custom" precision="medium"/> nach 1. November 1660 </origDate>
                     </origin>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Bei Kopien muss sowohl das Herstellungsdatum des Dokuments (<tag>origDate
            type="document"</tag>) als auch das ursprüngliche Entstehungsdatum des
            Inhalts des Dokuments (<tag>origDate type="content"</tag>) ausgezeichnet
            werden.Das Datum wird gemäss den <ref target="dating_guidelines.md">Datierungsrichtlinien</ref> erfasst.
        </p>
                  <p>
            In allen anderen Textteilen wird stattdessen <gi>date</gi> verwendet, vgl. auch den
            Unterschied von <gi>origPlace</gi> und <gi>placeName</gi>.
        </p>
               </remarks>
               <remarks versionDate="2023-09-13" xml:lang="en">
                  <p>
            For copies, the date of manufacture of the document must be included (<tag>origDate
            type="document"</tag>) as well as the original creation date of the content
            of the document (<tag>origDate type="content"</tag>).
        </p>
                  <p>
            With <att>when-custom</att> and <att>calendar</att> the date is set according to the
            <ref target="dating_guidelines.md">dating guidelines</ref>.
        </p>
                  <p>
            In the text area, comments and notes, <gi>date</gi> is used instead. For information on
            how to deal with saints’ feast days and other church holidays, see <gi>date</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Pour les copies, il faut indiquer à la fois la date de production du document
            (<tag>origDate type="document"</tag>) et la date originale de création du
            contenu du document (<tag>origDate type="content"</tag>). La date est
            indiquée conformément aux <ref target="dating_guidelines.md">principes de
            datation</ref>.
        </p>
                  <p>
            Dans toutes les autres parties du texte, on utilise <gi>date</gi>, voir également la
            différence entre <gi>origPlace</gi> et <gi>placeName</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdates">11.3.1. Origination</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ORIGPLACE"
                         ident="origPlace">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Entstehungsort</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">place of origin</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">lieu d’origine</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält im <gi>teiHeader</gi> den Entstehungsort
    eines Textträgers oder seines Inhalts.</desc>
               <desc rend="replace" versionDate="2023-05-16" xml:lang="en">Contains the place of issue or printing of a
    source.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient le lieu d’origine d’un support de texte
    ou de son contenu dans le <gi>teiHeader</gi>.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.pPart.msdesc"/>
               </classes>
               <content>
                  <textNode/>
               </content>
               <attList>
                  <attDef ident="ref" mode="replace" usage="req">
                     <datatype>
                        <dataRef key="ssrq.pointer.places"/>
                     </datatype>
                  </attDef>
                  <attDef ident="resp" mode="delete"/>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-30" xml:lang="de">worauf sich der Entstehungsort
            bezieht</desc>
                     <desc versionDate="2025-01-30" xml:lang="en">what the place of origin refers to</desc>
                     <desc versionDate="2025-01-30" xml:lang="fr">à quoi le lieu d’origine fait
            référence</desc>
                     <datatype>
                        <dataRef key="ssrq.orig.type"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-history-de" xml:lang="de">
                  <p>
                Beispiel für die Datierung, den Ausstellungsort und den Aussteller eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-en" xml:lang="en">
                  <p>
                Example of the dating, place of issue and issuer of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-fr" xml:lang="fr">
                  <p>
                Exemple de datation, de lieu d’émission et d’émetteur d’un document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            In allen anderen Textteilen wird stattdessen <gi>placeName</gi> verwendet, vgl. auch
            den Unterschied von <gi>origDate</gi> und <gi>date</gi>.
        </p>
               </remarks>
               <remarks versionDate="2023-08-23" xml:lang="en">
                  <p>
            In <att>ref</att>, an ID (locNNNNNN) refers to the place in the place database, in
            which all information about a place can be found. Topographical designations in the
            edited text are marked with <gi>placeName</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Dans toutes les autres parties du texte, on utilise <gi>placeName</gi>, voir également
            la différence entre <gi>origDate</gi> et <gi>date</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdates">11.3.1. Origination</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="MSIDENTIFIER"
                         ident="msIdentifier">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Handschriftenbezeichner</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">manuscript identifier</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">identification du manuscrit</gloss>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="de">Beschreibt den aktuellen und früheren
    Aufbewahrungsort sowie die aufbewahrende Institution des Textträgers, ebenso wie dessen
    Signatur oder eine andere Kennung, die zur Lokalisierung innerhalb dieser Institution verwendet
    wird.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Describes the current and historical locations of
    the source.</desc>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="fr">Décrit le lieu de conservation actuel et ancien,
    l’institution de conservation du support de texte, ainsi que sa cote ou tout autre identifiant
    utilisé pour indiquer sa localisation au sein de cette institution.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <elementRef key="settlement"/>
                        <elementRef key="repository"/>
                        <elementRef key="idno"/>
                     </sequence>
                     <elementRef key="altIdentifier" maxOccurs="unbounded" minOccurs="0"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-msIdentifier-de" xml:lang="de">
                  <p>
                Beispiel für eine Handschriftensignatur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-en" xml:lang="en">
                  <p>
                Example of a manuscript identifier
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-fr" xml:lang="fr">
                  <p>
                Exemple d’identification d’un manuscrit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msid">11.4. The Manuscript Identifier</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="REPOSITORY"
                         ident="repository">
               <gloss rend="replace" versionDate="2023-02-04" xml:lang="de">Archiv</gloss>
               <gloss rend="replace" versionDate="2023-02-04" xml:lang="en">repository</gloss>
               <gloss rend="replace" versionDate="2023-02-04" xml:lang="fr">lieu de conservation</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält den vollständigen Namen des Archivs, in
    welchem der Textträger aufbewahrt wird.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Contains the name of the archive in which the
    source is located without abbreviation.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient le nom complet du dépôt d’archives dans
    lequel se trouve le support de texte.</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <textNode/>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.de"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.fr"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-msIdentifier-de" xml:lang="de">
                  <p>
                Beispiel für eine Handschriftensignatur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-en" xml:lang="en">
                  <p>
                Example of a manuscript identifier
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-fr" xml:lang="fr">
                  <p>
                Exemple d’identification d’un manuscrit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msid">11.4. The Manuscript Identifier</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ALTIDENTIFIER"
                         ident="altIdentifier">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">alternative Bezeichnung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">alternative identifier</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">identifiant alternatif</gloss>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="de">Enthält eine alte Archivsignatur.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Contains an old archive signature.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="fr">Contient une ancienne cote d’archive.</desc>
               <classes/>
               <content>
                  <elementRef key="idno"/>
               </content>
               <exemplum xml:id="ex-altIdentifier-de" xml:lang="de">
                  <p>
                Beispiel für eine alte Handschriftensignatur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-altIdentifier-en" xml:lang="en">
                  <p>
                Example of an old manuscript identifier
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-altIdentifier-fr" xml:lang="fr">
                  <p>
                Exemple d’une ancienne cote de manuscrit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msid">11.4. The Manuscript Identifier</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="MSCONTENTS"
                         ident="msContents">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Handschrifteninhalte</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">manuscript contents</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">contenu du manuscrit</gloss>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="de">Enthält das Regest und Informationen zur Sprache
    und gegebenenfalls zum Autor des Textes.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Contains the regest and text language of the
    source.</desc>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="fr">Contient le résumé et des informations sur la
    langue et éventuellement l’auteur du texte.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="summary" maxOccurs="unbounded" minOccurs="0"/>
                     <elementRef key="msItem"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-msContents-summary" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-07-23" xml:lang="en">constraint for tei:summary inside
        tei:msContents</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:msContents[count(tei:summary) &gt; 1]">
                           <sch:assert test="count(distinct-values(tei:summary/@xml:lang)) =                     count(tei:summary)"
                                       xml:lang="en"> When there are more than one
                    tei:summary-elements inside tei:msContents, their @xml:lang attributes must be
                    different. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-msContents-de" xml:lang="de">
                  <p>
                Beispiel für eine Beschreibung des Dokumentinhalts
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msContents>
                        <summary>
            ...
        </summary>
                        <msItem>
            ...
        </msItem>
                     </msContents>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msContents-en" xml:lang="en">
                  <p>
                Example of a description of the document content
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msContents>
                        <summary>
            ...
        </summary>
                        <msItem>
            ...
        </msItem>
                     </msContents>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msContents-fr" xml:lang="fr">
                  <p>
                Exemple de description d’un texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msContents>
                        <summary>
            ...
        </summary>
                        <msItem>
            ...
        </msItem>
                     </msContents>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msco">11.6. Intellectual Content</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="MSITEM"
                         ident="msItem">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Handschriftenteil</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">manuscript item</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">élément du manuscrit</gloss>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="de">Enthält Informationen über die Sprache und
    gegebenenfalls den Autor eines Textes.</desc>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="en">Contains information about a single part of a
    source.</desc>
               <desc rend="replace" versionDate="2025-07-10" xml:lang="fr">Contient des informations sur la langue et
    éventuellement l’auteur du texte.</desc>
               <classes/>
               <content>
                  <elementRef key="textLang" maxOccurs="unbounded"/>
                  <alternate minOccurs="0" maxOccurs="1">
                     <elementRef key="author" maxOccurs="unbounded"/>
                     <elementRef key="docImprint"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-msItem-ms-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung eines einzelnen handschriftlichen Dokumentteils
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <author>Max von Schilda</author>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msItem-ms-en" xml:lang="en">
                  <p>
                Example for the description of a single handwritten document part
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <author>Max von Schilda</author>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msItem-ms-fr" xml:lang="fr">
                  <p>
                Exemple de description d’une pièce manuscrite
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <author>Max von Schilda</author>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msItem-print-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung eines einzelnen gedruckten Dokumentteils
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msItem-print-en" xml:lang="en">
                  <p>
                Example for the description of a single printed part of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msItem-print-fr" xml:lang="fr">
                  <p>
                Exemple de description d’une seule partie de document imprimé
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Die im Text verwendeten Sprachen werden mit <gi>textLang</gi> angeben. Bei
            Handschriften können die Autoren mit <gi>author</gi> angegeben werden, bei
            Druckschriften können innerhalb von <gi>docImprint</gi> der Druckort und die Druckerei
            angegeben werden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-15" xml:lang="en">
                  <p>
            The text languages of the source are specified with <gi>textLang</gi>. In the case of
            manuscripts, the authors can be indicated with <gi>author</gi>, in the case of printed
            books the place of printing and the printer can be indicated within
            <gi>docImprint</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les langues utilisées dans le texte sont indiquées avec <gi>textLang</gi>. Pour les
            manuscrits, les auteurs ou les scribes peuvent être indiqués avec <gi>author</gi> ;
            pour les publications imprimées, le lieu d’impression et l’imprimeur peuvent être
            indiqués dans <gi>docImprint</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#mscoit">11.6.1. The msItem and msItemStruct Elements</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="SUMMARY"
                         ident="summary">
               <gloss rend="replace" versionDate="2023-07-15" xml:lang="de">Regest</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">regest</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">résumé</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält ein ausführliches Regest des
    Textes.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Describes the content of the source in
    detail.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient un résumé détaillé du texte.</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <elementRef key="p" maxOccurs="unbounded"/>
               </content>
               <constraintSpec ident="sch-el-summary" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-04-14" xml:lang="en">constraint for tei:summary</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:summary/tei:p">
                           <sch:assert test="not(.[@xml:lang])"> tei:p inside tei:summary should not have
                    an attribute @xml:lang. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req"/>
               </attList>
               <exemplum xml:id="ex-summary-de" xml:lang="de">
                  <p>
                Beispiel für ein Regest
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <summary xml:lang="de">
                        <p>
                Bürgermeister und Rat regeln die Auszahlung nachfolgend genannter Erbteile an Ehefrauen, deren Männer verstorben sind: die Aussteuer, die sie
                in Form von Fahrhabe in die Ehe eingebracht haben (1); die vom Ehemann erhaltene Morgengabe (2; 3); das Eherecht sowie ein Drittel des
                gemeinsamen Vermögens, sofern sie ihre Erbschaft anzutreten wünschen (4); die Aussteuer, die in Form von liegenden Gütern in die Ehe
                eingebracht wurde (5); die Anteile von Ehefrauen, deren Männer verstorben sind, am Gut ihrer Schwiegereltern (6).
            </p>
                     </summary>
                     <summary xml:lang="fr">
                        <p>
                Le maire et le conseil règlent le paiement des parts d’héritage suivantes aux épouses dont les maris sont décédés : la dot qu’elles ont
                apportée au mariage sous forme de biens mobiliers (1) ; la dot reçue du mari (2 ; 3) ; loi sur le mariage et un tiers des biens communs s’ils
                souhaitent accepter leur héritage (4); la dot apportée au mariage sous forme de biens (5) ; les parts des épouses dont les maris sont décédés
                dans la succession de leurs beaux-parents (6).
            </p>
                     </summary>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-summary-en" xml:lang="en">
                  <p>
                Example of a summary
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <summary xml:lang="de">
                        <p>
                Bürgermeister und Rat regeln die Auszahlung nachfolgend genannter Erbteile an Ehefrauen, deren Männer verstorben sind: die Aussteuer, die sie
                in Form von Fahrhabe in die Ehe eingebracht haben (1); die vom Ehemann erhaltene Morgengabe (2; 3); das Eherecht sowie ein Drittel des
                gemeinsamen Vermögens, sofern sie ihre Erbschaft anzutreten wünschen (4); die Aussteuer, die in Form von liegenden Gütern in die Ehe
                eingebracht wurde (5); die Anteile von Ehefrauen, deren Männer verstorben sind, am Gut ihrer Schwiegereltern (6).
            </p>
                     </summary>
                     <summary xml:lang="fr">
                        <p>
                Le maire et le conseil règlent le paiement des parts d’héritage suivantes aux épouses dont les maris sont décédés : la dot qu’elles ont
                apportée au mariage sous forme de biens mobiliers (1) ; la dot reçue du mari (2 ; 3) ; loi sur le mariage et un tiers des biens communs s’ils
                souhaitent accepter leur héritage (4); la dot apportée au mariage sous forme de biens (5) ; les parts des épouses dont les maris sont décédés
                dans la succession de leurs beaux-parents (6).
            </p>
                     </summary>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-summary-fr" xml:lang="fr">
                  <p>
                Exemple de résumé
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <summary xml:lang="de">
                        <p>
                Bürgermeister und Rat regeln die Auszahlung nachfolgend genannter Erbteile an Ehefrauen, deren Männer verstorben sind: die Aussteuer, die sie
                in Form von Fahrhabe in die Ehe eingebracht haben (1); die vom Ehemann erhaltene Morgengabe (2; 3); das Eherecht sowie ein Drittel des
                gemeinsamen Vermögens, sofern sie ihre Erbschaft anzutreten wünschen (4); die Aussteuer, die in Form von liegenden Gütern in die Ehe
                eingebracht wurde (5); die Anteile von Ehefrauen, deren Männer verstorben sind, am Gut ihrer Schwiegereltern (6).
            </p>
                     </summary>
                     <summary xml:lang="fr">
                        <p>
                Le maire et le conseil règlent le paiement des parts d’héritage suivantes aux épouses dont les maris sont décédés : la dot qu’elles ont
                apportée au mariage sous forme de biens mobiliers (1) ; la dot reçue du mari (2 ; 3) ; loi sur le mariage et un tiers des biens communs s’ils
                souhaitent accepter leur héritage (4); la dot apportée au mariage sous forme de biens (5) ; les parts des épouses dont les maris sont décédés
                dans la succession de leurs beaux-parents (6).
            </p>
                     </summary>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-summary-list-de" xml:lang="de">
                  <p>
                Beispiel für ein Regest mit einer Aufzählung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <summary xml:lang="de">
                        <p>
                Der Werdenberger Landvogt Jakob Feldmann stellt auf Bitten von Altbürgermeister Hans Forrer von Werdenberg, Richter Heinrich Montaschiner und
                Hans Forrer, alle Bürger von Werdenberg, einen Vidimus des im Jahre 1538 von Landvogt Hans Leuzinger ausgestellten Buchs aus.
            </p>
                        <p>
                           <list>
                              <item>1. Die Bürger sind sowohl in der Stadt als auf dem Land vom Fall befreit.</item>
                              <item>2. Die Bürger sind vom Kälberzehnt befreit.</item>
                              <item>3. Die Bürger geben kein Weihnachtsholz.</item>
                              <item>4. Die Bürger geben keine Fasnachtshenne.</item>
                              <item>5. Wenn ein Bürger oder Einwohner mehr Holz als zugelassen in die Stadt führt, bezahlt er 15 Schilling Busse.</item>
                              <item>6. Die Bürger sind nicht befugt, ohne Erlaubnis eine Versammlung einzuberufen.</item>
                              <item>7. Die Bürger verfügen über die Metzgerei vor der Stadt.</item>
                              <item>8. Den Bürgern steht das Bürgerholz zu, in dem die Müller widerrechtlich Holz geschlagen haben. Die Bürger haben an einem Rechtstag
                    auf ihren Einspruch verzichtet. Die Müller sollen die Bürger dennoch entsprechend bezahlen.</item>
                              <item>9. Den Bürgern gebührt zu messen (pfächten), während dem Landvogt die Strafe vorbehalten ist.</item>
                              <item>10. Den Bürgern gehört ein "Halden" unter dem Rathaus.</item>
                              <item>11. Den Bürgern gehört der Abzug von allen Bürgern.</item>
                              <item>12. Auf den Martinstag haben die Bürger eine Steuer von 38 Gulden zu erlegen.</item>
                              <item>13. Aufgrund eines alten Pfandbriefes von Graf Wilhelm von Montfort muss Glarus den Bürgern einen jährlichen Zins von acht Schilling
                    entrichten. Der Zins ist aber mit der einmaligen Zahlung von acht Gulden zu lösen.</item>
                           </list>
                        </p>
                        <p>
                Die Bürger können jeweils am Martinstag einen Bürgermeister und einen Stadtknecht für drei Jahre wählen.
            </p>
                        <p>
                Ein Bürger darf vom Land in die Stadt ziehen. Wenn er sich aber anschliessend wieder auf dem Land niederlässt, verliert er sein Bürgerrecht.
                Wenn ein Bürger mit unehelichen Kindern aus der Stadt zieht, verlieren sie das Bürgerrecht. Wenn ein Bürger ausserhalb der Stadt heiratet und
                sich niederlässt, verliert er das Bürgerrecht.
            </p>
                        <p>
                Es siegelt im Original Jakob Feldmann.
            </p>
                     </summary>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-summary-list-en" xml:lang="en">
                  <p>
                Example of a regest with an enumeration
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <summary xml:lang="de">
                        <p>
                Der Werdenberger Landvogt Jakob Feldmann stellt auf Bitten von Altbürgermeister Hans Forrer von Werdenberg, Richter Heinrich Montaschiner und
                Hans Forrer, alle Bürger von Werdenberg, einen Vidimus des im Jahre 1538 von Landvogt Hans Leuzinger ausgestellten Buchs aus.
            </p>
                        <p>
