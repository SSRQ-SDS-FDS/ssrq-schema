               <exemplum xml:id="ex-date-deadline-de" xml:lang="de">
                  <p>
                Beispiel für einen Termin bzw. eine Frist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        wellind und doch nit länger dann bis <date calendar="unknown"
                           from-custom="--04-10"
                           to-custom="--04-20"
                           type="deadline">zuͦ mittem aprellen</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-deadline-en" xml:lang="en">
                  <p>
                Example of a deadline or time limit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        wellind und doch nit länger dann bis <date calendar="unknown"
                           from-custom="--04-10"
                           to-custom="--04-20"
                           type="deadline">zuͦ mittem aprellen</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-deadline-fr" xml:lang="fr">
                  <p>
                Exemple d’une échéance ou d’un délai
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        wellind und doch nit länger dann bis <date calendar="unknown"
                           from-custom="--04-10"
                           to-custom="--04-20"
                           type="deadline">zuͦ mittem aprellen</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-deadline-2-de" xml:lang="de">
                  <p>
                Beispiel für eine Deadline mit einem Zeitraum
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="unknown"
                           from-custom="--11-01"
                           to-custom="--04-15"
                           type="deadline">
                        <term ref="lem001324">wintermonat</term> weg bis spätest in die
        mitte des aprils <precision match="@from-custom" precision="low"/>
                        <precision match="@to-custom" precision="medium"/>
                     </date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-deadline-2-en" xml:lang="en">
                  <p>
                Example of a deadline with a period
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="unknown"
                           from-custom="--11-01"
                           to-custom="--04-15"
                           type="deadline">
                        <term ref="lem001324">wintermonat</term> weg bis spätest in die
        mitte des aprils <precision match="@from-custom" precision="low"/>
                        <precision match="@to-custom" precision="medium"/>
                     </date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-deadline-2-fr" xml:lang="fr">
                  <p>
                Exemple d’une échéance fixée par une période
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="unknown"
                           from-custom="--11-01"
                           to-custom="--04-15"
                           type="deadline">
                        <term ref="lem001324">wintermonat</term> weg bis spätest in die
        mitte des aprils <precision match="@from-custom" precision="low"/>
                        <precision match="@to-custom" precision="medium"/>
                     </date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-de" xml:lang="de">
                  <p>
                Beispiel einer Zeitspanne mit
                <att>
                    dur-iso
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="P14D">vierzehn Tage</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-en" xml:lang="en">
                  <p>
                Example of a time span with
                <att>
                    dur-iso
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="P14D">vierzehn Tage</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-fr" xml:lang="fr">
                  <p>
                Exemple de période avec
                <att>
                    dur-iso
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="P14D">vierzehn Tage</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-repeated-de" xml:lang="de">
                  <p>
                Wiederholungen bzw. wiederholende Zeitabstände lassen sich nur mit dem vollen ISO-8601-Format ausdrücken
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1Y">jährlich</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-repeated-en" xml:lang="en">
                  <p>
                Repetitions or repeating time intervals can only be expressed with the full ISO-8601 format
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1Y">jährlich</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-repeated-fr" xml:lang="fr">
                  <p>
                Les événements qui reviennent à des intervalles réguliers ne peuvent être exprimés qu’avec le format complet ISO-8601
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1Y">jährlich</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-period-de" xml:lang="de">
                  <p>
                Beispiel für eine sich wöchentlich wiederholende Datumsangabe im ISO-8601-Format
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1W" period="P1WD">all sontag</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-period-en" xml:lang="en">
                  <p>
                Example of a weekly repeating date in ISO 8601 format
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1W" period="P1WD">all sontag</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-duriso-period-fr" xml:lang="fr">
                  <p>
                Exemple d’une période qui revient de manière hebdomadaire au format ISO 8601
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... <date dur-iso="R/P1W" period="P1WD">all sontag</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-holiday-de" xml:lang="de">
                  <p>
                Beispiel eines Heiligentages
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... samstag nach <date type="holiday">
                        <persName ref="per000351">Paul</persName>i</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-holiday-en" xml:lang="en">
                  <p>
                Example of a saint’s day
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... samstag nach <date type="holiday">
                        <persName ref="per000351">Paul</persName>i</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-holiday-fr" xml:lang="fr">
                  <p>
                Exemple de fête des saints
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ... samstag nach <date type="holiday">
                        <persName ref="per000351">Paul</persName>i</date> ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-from-to-de" xml:lang="de">
                  <p>
                Auszeichnung eines Zeitraums
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" from-custom="1583-05-30" to-custom="1584-05-21">von Pfingstmontag 1583 bis Pfingstmontag 1584</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-from-to-en" xml:lang="en">
                  <p>
                Encoding of a period
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" from-custom="1583-05-30" to-custom="1584-05-21">von Pfingstmontag 1583 bis Pfingstmontag 1584</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-from-to-fr" xml:lang="fr">
                  <p>
                Désignation d’un espace temporel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" from-custom="1583-05-30" to-custom="1584-05-21">von Pfingstmontag 1583 bis Pfingstmontag 1584</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-gregjul-de" xml:lang="de">
                  <p>
                Bei Texten, die doppelt, d. h. nach dem alten und neuen Stil, datiert sind, wird nach dem neuen Stil bzw. dem Gregorianischen Kalender datiert.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="gregorian" when-custom="1590-10-25">25/15. octobris anno 90</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-gregjul-en" xml:lang="en">
                  <p>
                In the case of texts that are dated twice, i.e. according to the old and new styles, they are dated according to the new style or the Gregorian
                calendar.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="gregorian" when-custom="1590-10-25">25/15. octobris anno 90</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-gregjul-fr" xml:lang="fr">
                  <p>
                Exemple d’une double datation. Pour les textes qui sont doublement datés, par ex. selon l’ancien et le nouveau style, la datation est effectuée
                selon le nouveau style ou le calendrier grégorien.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="gregorian" when-custom="1590-10-25">25/15. octobris anno 90</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-annunciation-de" xml:lang="de">
                  <p>
                Beispielhafte Datierung im Annuntiationsstil
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian_annunciation" when-custom="1363-02-04">le quatre jour du mois de février en l’ans Notre Seigneur courant 1363</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-annunciation-en" xml:lang="en">
                  <p>
                Exemplary dating in the annunciation style
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian_annunciation" when-custom="1363-02-04">le quatre jour du mois de février en l’ans Notre Seigneur courant 1363</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-annunciation-fr" xml:lang="fr">
                  <p>
                Exemple de datation dans le style de l’annonciation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian_annunciation" when-custom="1363-02-04">le quatre jour du mois de février en l’ans Notre Seigneur courant 1363</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-period-de" xml:lang="de">
                  <p>
                Auszeichnung einer Jahreszeit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date period="summer">somer</date> unnd <date period="winter">wintter</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-period-en" xml:lang="en">
                  <p>
                Encoding of a season
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date period="summer">somer</date> unnd <date period="winter">wintter</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-period-fr" xml:lang="fr">
                  <p>
                Encodage d’une saison
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date period="summer">somer</date> unnd <date period="winter">wintter</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-roman-de" xml:lang="de">
                  <p>
                Beispiel für ein Datum mit römischen Ziffern
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/> qual cosa si è essequito sino nell’
        <lb/> anno <date calendar="julian" when-custom="1558">mdlviii</date> all’hora più oltra è apparso a
        <lb/> n[ost]ri sig[no]ri et superiori
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-roman-en" xml:lang="en">
                  <p>
                Example of a date with Roman numerals
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/> qual cosa si è essequito sino nell’
        <lb/> anno <date calendar="julian" when-custom="1558">mdlviii</date> all’hora più oltra è apparso a
        <lb/> n[ost]ri sig[no]ri et superiori
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-roman-fr" xml:lang="fr">
                  <p>
                Exemple de date avec des chiffres romains
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/> qual cosa si è essequito sino nell’
        <lb/> anno <date calendar="julian" when-custom="1558">mdlviii</date> all’hora più oltra è apparso a
        <lb/> n[ost]ri sig[no]ri et superiori
    </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Daten in Quelltexten (Originaldaten) und den editorischen Paratexten (Einleitung,
            Kommentare, Fussnoten) werden mit <gi>date</gi> ausgezeichnet. Die ausführlichen <ref target="dating_guidelines.md">Datierungsrichtlinien</ref> sind zu beachten.
        </p>
                  <p>
            Termine (Weidetermine, Jagdzeitbeschränkungen etc.) werden auch als Daten behandelt.
            Zur Kennzeichnung, dass es sich um einen Termin handelt, wird das Attribut
            <att>type</att> mit dem Wert <val>deadline</val> eingefügt.
        </p>
               </remarks>
               <remarks versionDate="2023-09-05" xml:lang="en">
                  <p>
            Dating in source texts (original data) and the paratexts (introduction, comments,
            footnotes) are marked with <gi>date</gi>. The <ref target="dating_guidelines.md">dating
            guidelines</ref> must be observed.
        </p>
                  <p>
            Dates (grazing dates, hunting time restrictions, etc.) are also treated as dates.
            <att>type</att> with the content <val>deadline</val> is inserted to indicate that it is
            an appointment.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Les dates présentent dans les textes sources (données originales) et les paratextes
            (introduction, commentaires, notes) sont marquées par <gi>date</gi>. Les <ref target="dating_guidelines.md">principes de datation</ref> doivent être respectés.
        </p>
                  <p>
            Les échéances ou les calendriers (dates de pâturage, restrictions de temps de chasse,
            etc.) sont également traités comme des dates. Un attribut <att>type</att> avec le
            contenu <val>deadline</val> est inséré pour indiquer qu’il s’agit d’une échéance.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA">3.6.4. Dates and Times</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD6">2.6. The Revision Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCAHSE">16.2.3. The Setting Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE">14.4. Dates</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-time"
                         ident="time">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Zeit</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">time</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">temps</gloss>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="de">Enthält eine Zeitangabe.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains a time specification.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="fr">Contient une indication temporelle.</desc>
               <classes>
                  <memberOf key="att.datable"/>
                  <memberOf key="att.datable.custom"/>
                  <memberOf key="att.duration.iso"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="dur-iso" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.duration"/>
                     </datatype>
                  </attDef>
                  <attDef ident="from-custom" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="notAfter-custom" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="notBefore-custom" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="to-custom" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="period" mode="change">
                     <datatype>
                        <dataRef key="ssrq.period.daytimes"/>
                     </datatype>
                  </attDef>
                  <attDef ident="when-custom" mode="change">
                     <datatype>
                        <dataRef key="ssrq.time.point"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-time-duriso-de" xml:lang="de">
                  <p>
                Angabe einer Zeitspanne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time dur-iso="PT3H">dri stund</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-duriso-en" xml:lang="en">
                  <p>
                Specification of a time span
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time dur-iso="PT3H">dri stund</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-duriso-fr" xml:lang="fr">
                  <p>
                Indication d’une période
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time dur-iso="PT3H">dri stund</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-period-de" xml:lang="de">
                  <p>
                Erfassung von Zeitperioden, die nicht mit ISO 8601 beschrieben werden können
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time period="byNight">nachtz</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-period-en" xml:lang="en">
                  <p>
                Recording of time periods that cannot be described with ISO 8601
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time period="byNight">nachtz</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-period-fr" xml:lang="fr">
                  <p>
                Indication de périodes qui ne peuvent être décrites par la norme ISO 8601
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time period="byNight">nachtz</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-point-de" xml:lang="de">
                  <p>
                Erfassung eines Zeitpunkts
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time when-custom="08:48:00">8 Uhr 48</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-point-en" xml:lang="en">
                  <p>
                Recording of a point in time
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time when-custom="08:48:00">8 Uhr 48</time>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-time-point-fr" xml:lang="fr">
                  <p>
                Enregistrement d’un point temporel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <time when-custom="08:48:00">8 Uhr 48</time>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Mithilfe der zugelassenen Attribute können die Angaben in einem normalisierten Format
            maschinenlesbar ausgedrückt werden. Das Format ist die vom W3C definierte Untermenge
            des ISO-Standards 8601.
        </p>
                  <p>
            Zeitpunkte werden mit <att>when-custom</att> bzw. <att>notBefore-custom</att> und
            <att>notAfter-custom</att> angegeben, Zeiträume mit <att>from-custom</att> und
            <att>to-custom</att>. Zeitspannen ohne Angabe von Anfang und Ende können mit
            <att>dur-iso</att> näher bezeichnet werden. Unbestimmte Tageszeiten, wie z. B.
            «nachts», werden mit <att>period</att> getaggt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            With the help of the permitted attributes, the information can be expressed in a
            normalized, machine-readable format. The format is the subset of ISO 8601 defined by
            the W3C. Points in time are specified with <att>when-custom</att>,
            <att>notBefore-custom</att> and <att>notAfter-custom</att>, time periods with
            <att>from-custom</att> and <att>to-custom</att>. Periods of time without beginning and
            end can be specified with <att>dur-iso</att>. Undetermined times of the day, e.g. at
            night, are tagged with <att>period</att>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Les attributs autorisés permettent d’exprimer les informations dans un format normalisé
            et lisible par machine. Le format est le sous-ensemble de la norme ISO 8601 défini par
            le W3C.
        </p>
                  <p>
            Les points temporels sont indiqués avec <att>when-custom</att> ou
            <att>notBefore-custom</att> et <att>notAfter-custom</att>, les périodes avec
            <att>from-custom</att> et <att>to-custom</att>. Les périodes temporelles sans
            indication de début et de fin peuvent être précisées davantage avec <att>dur-iso</att>.
            Les moments indéfinis de la journée, comme « la nuit », sont indiqués avec
            <att>period</att>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA">3.6.4. Dates and Times</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-abbr"
                         ident="abbr">
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="de">Abkürzung</gloss>
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="en">abbreviation</gloss>
               <gloss rend="replace" versionDate="2023-06-30" xml:lang="fr">abréviation</gloss>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="de">Enthält eine Abkürzung.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="en">Contains an abbreviation.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="fr">Contient une abréviation.</desc>
               <classes>
                  <memberOf key="model.pPart.editorial"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <elementRef key="hi"/>
                     <elementRef key="lb"/>
                     <elementRef key="sic"/>
                     <elementRef key="subst"/>
                     <elementRef key="unclear"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-abbr"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-05-19" xml:lang="en">constraint for points inside tei:abbr</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:abbr">
                           <sch:report test="contains(./string(), '.')"> No points are allowed
                    inside tei:abbr, cf. the guidelines for transcription. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-abbr-de" xml:lang="de">
                  <p>
                Beispiel einer nicht aufgelösten Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <abbr>etc</abbr>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-abbr-en" xml:lang="en">
                  <p>
                Abbreviation not transcribed
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <abbr>etc</abbr>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-abbr-fr" xml:lang="fr">
                  <p>
                Exemple d’abréviation non résolue
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <abbr>etc</abbr>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-de" xml:lang="de">
                  <p>
                Beispiel für eine aufgelöste Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-fr" xml:lang="fr">
                  <p>
                Exemple d’abréviation développée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-en" xml:lang="en">
                  <p>
                Example of a resolved abbreviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-abbr-de" xml:lang="de">
                  <p>
                Datierung mit Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" when-custom="1623-08-25">25.<hi rend="sup">ten</hi>
                        <abbr>Aug</abbr> 1623</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-abbr-en" xml:lang="en">
                  <p>
                Dating with abbreviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" when-custom="1623-08-25">25.<hi rend="sup">ten</hi>
                        <abbr>Aug</abbr> 1623</date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-date-abbr-fr" xml:lang="fr">
                  <p>
                Date avec abréviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian" when-custom="1623-08-25">25.<hi rend="sup">ten</hi>
                        <abbr>Aug</abbr> 1623</date>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Es werden keine Kürzungspunkte verwendet, da die Abkürzung durch die Auszeichnung mit
            <gi>abbr</gi> bereits als solche gekennzeichnet ist.
        </p>
                  <p>
            Orthographische Gepflogenheiten des Schreibers werden ohne besondere Kennzeichnung
            berücksichtigt. Selbstverständliches wird stillschweigend aufgelöst, z. B.
            Nasalstriche, Affixe («-er», «con-», «per-»). Xsti wird stillschweigend aufgelöst in
            Christi, ebenso Ao = anno, wz = was oder dz = das.
        </p>
                  <p>
            Wenn es möglich und sinnvoll ist, werden Abkürzungen mithilfe von <gi>choice</gi> und
            <gi>expan</gi> aufgelöst.
        </p>
                  <p>
            Abkürzungen von Mass- und Münzbezeichnungen werden, ausser in Fliesstexten
            (Kommentaren, Bemerkungen), nicht aufgelöst. Es werden die entsprechenden Sonderzeichen
            verwendet, vgl. die <ref target="abbreviations.de.md">Transkriptionsrichtlinien</ref>,
            die <ref target="abbreviation-list.de.md">Liste der Abkürzungen</ref> und die <ref target="special.de.md">Liste der Sonderzeichen</ref>.
        </p>
               </remarks>
               <remarks versionDate="2023-06-30" xml:lang="en">
                  <p>
            No abbreviation points are used, as the abbreviations are already marked as such by the
            markup.
        </p>
                  <p>
            The writer’s spelling conventions are taken into account without special
            identification. The self-evident is tacitly resolved, e.g. B. nasal strokes, affixes
            («-er», «con-», «per-»). Xsti is tacitly resolved into Christi, as is Ao = anno, wz =
            was or dz = das.
        </p>
                  <p>
            Abbreviations in the text template are, if possible and sensible, with the help of
            <gi>choice</gi> and <gi>expan</gi> resolved.
        </p>
                  <p>
            Abbreviations of dimensions and coin designations are not resolved except in continuous
            text (comments, remarks). The corresponding special characters are used.
        </p>
               </remarks>
               <remarks versionDate="2025-04-28" xml:lang="fr">
                  <p>
            Aucun point d’abréviation n’est utilisé, car l’abréviation est déjà marquée comme telle
            avec la balise <gi>abbr</gi>.
        </p>
                  <p>
            Les conventions orthographiques du scribe sont prises en compte sans identification
            particulière. L’évidence est tacitement résolue, p. ex. traits nasaux, affixes («-er»,
            «con-», «per-»). Xsti est tacitement résolu en Christi, tout comme Ao = anno, wz = was
            ou dz = das.
        </p>
                  <p>
            Lorsque cela est possible et utile, les abréviations sont développées en utilisant
            <gi>choice</gi> et <gi>expan</gi>.
        </p>
                  <p>
            Les abréviations de mesures et de noms de pièces ne sont pas résolues, sauf dans le
            texte courant (commentaires, remarques). Les caractères spéciaux correspondants sont
            utilisés, voir les <ref target="abbreviations.fr.md">principes de transcription</ref>,
            la <ref target="abbreviation-list.fr.md">liste des abréviations</ref> et la <ref target="special.fr.md">liste des caractères spéciaux</ref>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONAAB">3.6.5. Abbreviations and Their Expansions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-expan"
                         ident="expan">
               <gloss rend="replace" versionDate="2023-07-19" xml:lang="de">Auflösung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">expansion</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">développement</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Enthält die Auflösung einer Abkürzung.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains the expansion of an abbreviation.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Contient le développement d’une
    abréviation.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="model.pPart.editorial"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <macroRef key="ssrq.content.entities"/>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="cert" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-choice-abbr-de" xml:lang="de">
                  <p>
                Beispiel für eine aufgelöste Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-fr" xml:lang="fr">
                  <p>
                Exemple d’abréviation développée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-en" xml:lang="en">
                  <p>
                Example of a resolved abbreviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Für die Auflösung von Abkürzungen gelten die Regeln der <ref target="abbreviations.de.md">Transkriptionsrichtlinien</ref>, vgl. auch die <ref target="abbreviation-list.de.md">Liste der Abkürzungen</ref>.
        </p>
                  <p>
            Mit dem Attribut <att>resp</att> wird die für die Auflösung verantwortliche Person
            angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            When resolving abbreviations, use historical rather than modern spelling when there is
            no clear spelling clue, e.g. B.: egen = egenante (not egenannte), schulth = schultheis
            (not schultheiss). Ao is tacitly dissolved in anno.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les règles des <ref target="abbreviations.fr.md">principes de transcription</ref>
            s’appliquent au développement des abréviations. Voir également la <ref target="abbreviation-list.fr.md">liste des abréviations</ref>
                  </p>
                  <p>
            L’attribut <att>resp</att> spécifie la personne responsable du développement.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONAAB">3.6.5. Abbreviations and Their Expansions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-ref"
                         ident="ref">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Verweis</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">reference</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">référence</gloss>
               <desc rend="replace" versionDate="2023-04-28" xml:lang="de">Enthält einen Verweis.</desc>
               <desc rend="replace" versionDate="2023-04-28" xml:lang="en">Contains a reference.</desc>
               <desc rend="replace" versionDate="2023-04-28" xml:lang="fr">Contient une référence.</desc>
               <classes>
                  <memberOf key="att.pointing"/>
                  <memberOf key="model.ptrLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="hi"/>
                     <textNode/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-ref" mode="add" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-06-22" xml:lang="en">constraint for tei:ref</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:ref[not(*)]">
                           <sch:assert test="if (not(.[@target])) then string-length(normalize-space(.))                     &gt; 0 else .[@target]"> tei:ref should contain some text or must use the
                    attribute @target. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-ref-in-bibl"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2024-11-04" xml:lang="en">constraint for tei:ref in tei:bibl</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:ref[not(ancestor::tei:editorialDecl)][not(parent::tei:note[@type='text_comparison'])]">
                           <sch:assert test="./parent::tei:bibl"> If tei:ref is not part of
                    tei:editorialDecl or tei:note with @type="text_comparison", it should
                    be enclosed in tei:bibl. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-ref-print-de" xml:lang="de">
                  <p>
                Beispiel für einen Verweis auf eine gedruckte Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref>SDS GE 3</ref>, <ref target="https://www.ssrq-sds-fds.ch/online/GE_3/index.html#p_66">n° 1680</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ref-print-en" xml:lang="en">
                  <p>
                Example of a reference to a printed source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref>SDS GE 3</ref>, <ref target="https://www.ssrq-sds-fds.ch/online/GE_3/index.html#p_66">n° 1680</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ref-print-fr" xml:lang="fr">
                  <p>
                Exemple de référence à une source imprimée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref>SDS GE 3</ref>, <ref target="https://www.ssrq-sds-fds.ch/online/GE_3/index.html#p_66">n° 1680</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ref-urn-de" xml:lang="de">
                  <p>
                Beispiel für einen Verweis auf eine Online-Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ref target="urn:ssrq:SDS-GE-5-142-1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ref-urn-en" xml:lang="en">
                  <p>
                Example of a reference to an online source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ref target="urn:ssrq:SDS-GE-5-142-1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-ref-urn-fr" xml:lang="fr">
                  <p>
                Exemple de référence à une source en ligne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <ref target="urn:ssrq:SDS-GE-5-142-1"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Der Verweis kann auf ein anderes Dokument, die Einleitung, das Register eines
            retrodigitalisierten Bandes, einen Eintrag im HLS, zitierte Literatur etc. zeigen.
        </p>
                  <p>
            Es ist sinnvoll, Links auf weitere, nicht edierte, aber in einem
            Archivinformationssystem einzeln verzeichnete Quellenstücke innerhalb von <gi>ref</gi>
            zu setzen. Nicht sinnvoll ist es, wenn bei einer einzelnen Urkunde auf den ganzen
            Urkundenbestand verlinkt wird, weil die Einzelurkunde nicht verzeichnet ist. Bei
            Einträgen aus einem Buch, die man nicht einzeln in einem Archivinformationssystem
            verzeichnen will (wenn das überhaupt möglich ist), kann auf das (ganze) Buch, das im
            Archivkatalog verzeichnet ist, verlinkt werden.
        </p>
                  <p>
            Wird auf andere Editionen verlinkt, wird zuerst die Signatur der Quelle angegeben, wenn
            die Archivalie konsultiert wurde (Autopsie) oder wenn sich die Signatur via Query
            verifizieren und verlinken lässt. Hat man eine Archivalie anhand einer Edition
            beurteilt, ist nur die Edition anzugeben.
        </p>
                  <p>
            Wenn man auf eine Quelle, die in einer Editionseinheit der SSRQ ediert wird, verweisen
            möchte, ist es nicht notwendig, die Archivsignatur zu wiederholen, sondern es reicht,
            auf die Stücknummer der Editionseinheit zu verlinken. Ebenso ist es möglich, innerhalb
            der eigenen Editionseinheit von einem Stück auf ein anderes zu referenzieren. Wir
            verwenden dafür die <gi>idno</gi>. Verweise auf andere Stücke werden in <gi>bibl</gi>
            eingeschlossen.
        </p>
               </remarks>
               <remarks versionDate="2024-11-04" xml:lang="en">
                  <p>
            The reference can point to another document, the introduction, the index of a
            retrodigitized volume, an entry in the HLS, cited literature, etc. It makes sense to
            place links within <gi>ref</gi> to other source pieces that are not edited but are
            individually listed in an archive information system. It does not make sense if a
            single certificate is linked to the entire stock of certificates because the individual
            certificate is not listed. In the case of entries from a book that one does not want to
            list individually in an archive information system (if that is at all possible), a link
            can be made to the (entire) book that is listed in the archive catalogue. If links are
            made to other editions, the call number of the source is given first if the archival
            material was consulted (autopsy) or if the call number can be verified and linked via
            query. If an archival item has been assessed based on an edition, only the edition
            needs to be specified. If you want to refer to a source that is edited in an edition
            unit of the SLS, it is not necessary to repeat the archival reference, but it is
            sufficient to link to the item number of the edition unit (see example below). It is
            also possible to reference from one piece to another within your own edition unit. We
            use the <gi>idno</gi> for this.
        </p>
                  <p>
            References to other pieces are included in <gi>bibl</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Le renvoi peut pointer vers un autre document, l’introduction, le registre d’un volume
            rétro-numérisé, une entrée du DHS, une littérature citée, etc.
        </p>
                  <p>
            Les référence à des sources non éditées, mais répertoriées dans un système
            d’information archivistique, devraient être signalées par un lien à l’intérieur de
            <gi>ref</gi>. Il n’est toutefois pas judicieux de créer un lien vers l’ensemble du
            fonds documentaire pour un acte isolé. Pour les parties d’un livre (chapitre,
            contribution) que l’on ne souhaite pas répertorier individuellement dans un système
            d’information archivistique, il est possible de créer un lien vers le livre (entier)
            répertorié dans le catalogue des archives.
        </p>
                  <p>
            Si l’on établit un lien vers d’autres documents, on indique la cote de la source si le
            document d’archives a été consulté directement ou si la cote peut être vérifiée et
            reliée via un système d’information archivistique. En revanche, si l’on a pris
            connaissance d’une archive sur la seule base d’une édition, seule l’édition doit être
            indiquée.
        </p>
                  <p>
            Si l’on souhaite faire référence à une source éditée dans une unité d’édition des SDS,
            il n’est pas nécessaire de répéter la cote de l’archive, mais il suffit de faire un
            lien vers le numéro de la pièce au sein de l’unité d’édition en question. De même, il
            est possible de référencer une pièce qui se situe à l’intérieur de sa propre unité
            d’édition. Nous utilisons pour cela le <gi>idno</gi> de la pièce. Les renvois aux
            autres pièces sont signalés dans <gi>bibl</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COXR">3.7. Simple Links and Cross-References</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/SA.html#SAPT">17.1. Links</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-list"
                         ident="list">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Liste</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">list</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">liste</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Liste oder Aufzählung jeder
    Art.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Describes a list or enumeration of any
    kind.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une liste ou une énumération de toute
    sorte.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="model.listLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="head" minOccurs="0"/>
                     <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                        <elementRef key="item" maxOccurs="unbounded"/>
                        <alternate minOccurs="0" maxOccurs="unbounded">
                           <elementRef key="cb"/>
                           <elementRef key="pb"/>
                           <macroRef key="ssrq.content.anchor.spans"/>
                        </alternate>
                     </sequence>
                  </sequence>
               </content>
               <constraintSpec ident="gloss-list-must-have-labels"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:list[@type='gloss']">
                        <sch:assert test="tei:label">The content of a "gloss" list should include a sequence of one or more pairs of a label element followed by an item element</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">das Aussehen der Liste</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the appearance of the list</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">l’apparence de la liste</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.list"/>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-list-de" xml:lang="de">
                  <p>
                Beispiel für eine Liste mit einfachen Einträgen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-en" xml:lang="en">
                  <p>
                Example of a list with simple entries
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-fr" xml:lang="fr">
                  <p>
                Exemple de liste avec des entrées simples
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-head-de" xml:lang="de">
                  <p>
                Beispiel für eine Liste mit einer Überschrift
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-head-en" xml:lang="en">
                  <p>
                Example of a list with a heading
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-head-fr" xml:lang="fr">
                  <p>
                Exemple de liste avec un en-tête
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-complex-de" xml:lang="de">
                  <p>
                Beispiel für eine komplexe Liste
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <pb n="1r"/>
                        <cb n="a"/>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                        <cb n="b"/>
                        <item>Tomate</item>
                        <item>Banane</item>
                        <item>...</item>
                        <delSpan spanTo="del1"/>
                        <item>Aubergine</item>
                        <item>Avocado</item>
                        <anchor xml:id="del1"/>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-complex-en" xml:lang="en">
                  <p>
                Example of a complex list
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <pb n="1r"/>
                        <cb n="a"/>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                        <cb n="b"/>
                        <item>Tomate</item>
                        <item>Banane</item>
                        <item>...</item>
                        <delSpan spanTo="del1"/>
                        <item>Aubergine</item>
                        <item>Avocado</item>
                        <anchor xml:id="del1"/>
                     </list>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-list-complex-fr" xml:lang="fr">
                  <p>
                Exemple de liste complexe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <list>
                        <head>Lebensmittel</head>
                        <pb n="1r"/>
                        <cb n="a"/>
                        <item>Apfel</item>
                        <item>Fisch</item>
                        <item>...</item>
                        <cb n="b"/>
                        <item>Tomate</item>
                        <item>Banane</item>
                        <item>...</item>
                        <delSpan spanTo="del1"/>
                        <item>Aubergine</item>
                        <item>Avocado</item>
                        <anchor xml:id="del1"/>
                     </list>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Für die Auflistung aller Textzeugen im <gi>teiHeader</gi> verwenden wir das
            spezialisiertere Element <gi>listWit</gi>, für die Auflistung bibliographischer Angaben
            kommt <gi>listBibl</gi> zum Einsatz.
        </p>
                  <p>
            Eine ggfs. vorhandene Listenüberschrift wird mit <gi>head</gi> ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Pour lister toutes les témoins d’un texte dans le <gi>teiHeader</gi>, nous utilisons
            l’élément plus spécialisé <gi>listWit</gi>; pour lister les informations
            bibliographiques, nous utilisons <gi>listBibl</gi>.
        </p>
                  <p>
            S’il y a un en-tête de liste, il est marqué avec <gi>head</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COLI">3.8. Lists</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-item"
                         ident="item">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Eintrag</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">item</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">entrée</gloss>
               <desc rend="replace" versionDate="2023-05-25" xml:lang="de">Enthält einen Listeneintrag.</desc>
               <desc rend="replace" versionDate="2023-05-25" xml:lang="en">Contains a list entry.</desc>
               <desc rend="replace" versionDate="2023-05-25" xml:lang="fr">Contient une entrée au sein d’une liste.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-list-de" xml:lang="de">
