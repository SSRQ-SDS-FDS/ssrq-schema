               <content xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <valList type="closed">
                     <valItem ident="index">
                        <desc versionDate="2025-02-03" xml:lang="de">Stichwort für den Index</desc>
                        <desc versionDate="2025-02-03" xml:lang="en">keyword for the index</desc>
                        <desc versionDate="2025-02-03" xml:lang="fr">mot-clé pour l’index</desc>
                     </valItem>
                     <valItem ident="unknown">
