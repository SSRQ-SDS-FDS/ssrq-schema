            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="SUPPORT"
                         ident="support">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Material des Textträgers</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">support</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">support</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält Elemente zur Beschreibung des Materials
    des Textträgers.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains elements describing the support.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient des éléments décrivant le matériau du
    support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="material"/>
               </content>
               <exemplum xml:id="ex-support-de" xml:lang="de">
                  <p>
                Beispiel für eine Beschreibung des Beschreibstoffs einer Quelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-support-en" xml:lang="en">
                  <p>
                Example of a description of the descriptive material of a source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-support-fr" xml:lang="fr">
                  <p>
                Exemple de description du matériau d’une source
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <support>
                        <material type="paper"/>
                     </support>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph1">11.7.1. Object Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="FOLIATION"
                         ident="foliation">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Blattzählung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">foliation</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">foliation</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beschreibt die Blattzählung des
    Textträgers.</desc>
               <desc rend="replace" versionDate="2023-05-17" xml:lang="en">Describes the foliation of a source.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Décrit la foliation d’un support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="p" maxOccurs="unbounded"/>
               </content>
               <exemplum xml:id="ex-foliation-de" xml:lang="de">
                  <p>
                Beispiel für eine Beschreibung der Blattzählung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <foliation>
                        <p xml:lang="de">
            Originale Foliierung des 16. Jahrhunderts
        </p>
                        <p xml:lang="de">
            Paginierung eines Archivars des 19. Jahrhunderts
        </p>
                     </foliation>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-foliation-en" xml:lang="en">
                  <p>
                Example of a leaf count description
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <foliation>
                        <p xml:lang="de">
            Originale Foliierung des 16. Jahrhunderts
        </p>
                        <p xml:lang="de">
            Paginierung eines Archivars des 19. Jahrhunderts
        </p>
                     </foliation>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-foliation-fr" xml:lang="fr">
                  <p>
                Exemple d’une description de la foliation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <foliation>
                        <p xml:lang="de">
            Originale Foliierung des 16. Jahrhunderts
        </p>
                        <p xml:lang="de">
            Paginierung eines Archivars des 19. Jahrhunderts
        </p>
                     </foliation>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msphfo">11.7.1.4. Foliation</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="CONDITION"
                         ident="condition">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Erhaltungszustand</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">condition</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">état de conservation</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält <gi>p</gi>-Elemente zur Beschreibung des
    Erhaltungszustands und der Schäden eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-04-14" xml:lang="en">Describes the state of preservation and damage to
    a source. Detailed descriptions, such as gaps, holes, etc., are given at the appropriate
    place.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient des éléments <gi>p</gi> pour décrire
    l’état de conservation et les altérations d’un support de texte.</desc>
               <classes>
                  <memberOf key="att.damaged"/>
               </classes>
               <content>
                  <elementRef key="p" minOccurs="0"/>
               </content>
               <exemplum xml:id="ex-condition-de" xml:lang="de">
                  <p>
                Beispiel für eine Beschreibung des Erhaltungszustands
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <condition agent="mice folio_lost">
                        <p xml:lang="de">
            Mäusefrass am gesamten Buchblock
        </p>
                        <p xml:lang="de">
            Zwei ausgefallene Blätter am Ende der dritten Lage.
        </p>
                     </condition>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-condition-en" xml:lang="en">
                  <p>
                Example of a description of the state of conservation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <condition agent="mice folio_lost">
                        <p xml:lang="de">
            Mäusefrass am gesamten Buchblock
        </p>
                        <p xml:lang="de">
            Zwei ausgefallene Blätter am Ende der dritten Lage.
        </p>
                     </condition>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-condition-fr" xml:lang="fr">
                  <p>
                Exemple de description de l’état de conservation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <condition agent="mice folio_lost">
                        <p xml:lang="de">
            Mäusefrass am gesamten Buchblock
        </p>
                        <p xml:lang="de">
            Zwei ausgefallene Blätter am Ende der dritten Lage.
        </p>
                     </condition>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Mit dem Attribut <att>agent</att> werden alle Beschädigungen auf standardisierte Weise
            angegeben. In den <gi>p</gi>-Elementen erfolgt eine detailliertere Beschreibung als
            Freitext.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            L’attribut <att>agent</att> permet d’indiquer tous les altérations de manière
            standardisée. Dans les éléments <gi>p</gi> il y a une description plus détaillée sous
            forme de texte libre.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msphco">11.7.1.5. Condition</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="HANDDESC"
                         ident="handDesc">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Beschreibung der Hände</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">hand description</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">description des mains</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält die Beschreibungen alle relevanten Hände
    eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-05-22" xml:lang="en">Describes the hands and all hand changes.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient les descriptions de toutes les mains
    intervenues sur le support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="handNote" maxOccurs="unbounded"/>
               </content>
               <attList>
                  <attDef ident="hands" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-handDesc-de" xml:lang="de">
                  <p>
                Beispiel für mehrere Beschreibungen von bekannten und unbekannten Schreiberhänden
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handDesc-en" xml:lang="en">
                  <p>
                Example of several descriptions of known and unknown scribal hands
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handDesc-fr" xml:lang="fr">
                  <p>
                Exemple de descriptions de mains de scribes connus et inconnus
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <handDesc>
                        <handNote scribe="per123456" xml:id="firstHand">
                           <date calendar="gregorian"
                                 from-custom="1001-01-01"
                                 to-custom="1100-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="hand18c">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31"/>
                        </handNote>
                        <handNote xml:id="hand18cf">
                           <date calendar="gregorian"
                                 from-custom="1701-01-01"
                                 to-custom="1800-12-31">
                              <precision match="@from-custom" precision="low"/>
                           </date>
                        </handNote>
                        <handNote xml:id="secondHand"/>
                        <handNote xml:id="otherHand"/>
                        <handNote xml:id="laterHand"/>
                     </handDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Es werden nur «wichtige» Hände eingetragen. Jede Hand erhält ihr eigenes
            <gi>handNote</gi>-Element.
        </p>
               </remarks>
               <remarks versionDate="2023-08-22" xml:lang="en">
                  <p>
            Marginals, deletions, corrections, etc. are marked directly at the point in the text.
            Only «important» writers are entered.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Seules les mains «importantes» sont saisies. Chaque main possède son propre élément
            <gi>handNote</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph2">11.7.2. Writing, Decoration, and Other Notations</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="BINDINGDESC"
                         ident="bindingDesc">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Beschreibung der Bindung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">binding description</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">description de la reliure</gloss>
               <desc rend="replace" versionDate="2025-07-08" xml:lang="de">Enthält Informationen über die Materialität oder
    Bindung eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Contains information about the physical structure
    or binding of a text.</desc>
               <desc rend="replace" versionDate="2025-07-08" xml:lang="fr">Contient des informations sur la matérialité ou la
    reliure d’un support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="p" maxOccurs="unbounded"/>
               </content>
               <exemplum xml:id="ex-bindingDesc-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung einer Bindung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bindingDesc>
                        <p xml:lang="de">
            Buch mit kartoniertem Ledereinband
        </p>
                     </bindingDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bindingDesc-en" xml:lang="en">
                  <p>
                Example of a binding description
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bindingDesc>
                        <p xml:lang="de">
            Buch mit kartoniertem Ledereinband
        </p>
                     </bindingDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bindingDesc-fr" xml:lang="fr">
                  <p>
                Exemple de description de reliure
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bindingDesc>
                        <p xml:lang="de">
            Buch mit kartoniertem Ledereinband
        </p>
                     </bindingDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Mit diesem Element können Details wie die Art der Bindung (z. B. Buchbindung, Broschur)
            angegeben werden. Die Beschreibung wird als Freitext in <gi>p</gi> angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            This tag can be used to specify details such as the type of binding (e.g. book binding,
            brochure). The description is given as free text in <gi>p</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Cet élément peut être utilisé pour indiquer des détails tels que le type de reliure (p.
            ex. reliure de livre, brochure). La description est donnée sous forme de texte libre
            dans <gi>p</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msphbi">11.7.3.1. Binding Descriptions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="SEALDESC"
                         ident="sealDesc">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Siegelbeschreibung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">seal description</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">description du sceau</gloss>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="de">Enthält Elemente zur Beschreibung der
    Siegel.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Contains elements describing the seals.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="fr">Contient des éléments décrivant les sceaux.</desc>
               <classes/>
               <content>
                  <elementRef key="seal" maxOccurs="unbounded"/>
               </content>
               <exemplum xml:id="ex-sealDesc-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung von Siegeln
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sealDesc-en" xml:lang="en">
                  <p>
                Example for the description of seals
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sealDesc-fr" xml:lang="fr">
                  <p>
                Exemple de description de sceaux
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Eine Urkunde, die ohne Siegel ausgestellt wurde, erhält auch keine <gi>sealDesc</gi>.
            Urkunden, bei denen einzelne Siegel fehlen, jedoch schon vgl. <gi>seal</gi> (mit dem
            Attribut <att>condition</att> = <val>absent</val>). Bei ausserordentlichen Befunden (z.
            B. Nachherstellungen) sollte immer ein Kommentar geschrieben werden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-15" xml:lang="en">
                  <p>
            A certificate that was issued without a seal also does not contain a <gi>sealDesc</gi>.
            Documents that are missing some seals, see <gi>seal</gi>, <att>condition</att>. In the
            case of extraordinary findings (e.g. reproductions), a comment should be written.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Un document qui a été établi sans sceau ne contient pas de <gi>sealDesc</gi>. Les actes
            dont certains sceaux sont absents, par contre, sont déjà mentionnés dans <gi>seal</gi>
            (avec l’attribut <att>condition</att> = <val>absent</val>). Dans le cas de découvertes
            extraordinaires (p. ex., des rectifications), il faudrait toujours écrire un
            commentaire.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msphse">11.7.3.2. Seals</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="SEAL"
                         ident="seal">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Siegel</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">seal</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">sceau</gloss>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="de">Beschreibt ein Siegel.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Describes a seal.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="fr">Décrit un sceau.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.global"/>
                  <memberOf key="att.global.facs"/>
                  <memberOf key="att.placement"/>
                  <memberOf key="ssrq.att.seal"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="0" maxOccurs="1">
                        <elementRef key="orgName"/>
                        <elementRef key="persName"/>
                     </alternate>
                     <elementRef key="p" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-seal"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-06-01" xml:lang="en">constraint for tei:seal</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:seal">
                           <sch:let name="expectedNumber"
                                    value="count(./preceding-sibling::tei:seal) +                     1"/>
                           <sch:assert test="./@n = $expectedNumber"> The value of @n must be equal to
                        <sch:value-of select="$expectedNumber"/>
                        . </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="change" usage="req">
                     <desc versionDate="2025-02-04" xml:lang="de">die Nummerierung des Siegels</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the numbering of the seal</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">la numérotation du sceau</desc>
                     <datatype>
                        <dataRef name="positiveInteger"/>
                     </datatype>
                  </attDef>
                  <attDef ident="place" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort des Siegels</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the seal</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">l’emplacement du sceau</desc>
                     <datatype>
                        <dataRef key="ssrq.place.seal"/>
                     </datatype>
                  </attDef>
                  <attDef ident="ref" mode="replace">
                     <desc versionDate="2025-02-14" xml:lang="de">ein Link zu einer Siegeldatenbank</desc>
                     <desc versionDate="2025-02-14" xml:lang="en">a link to a database of seals</desc>
                     <desc versionDate="2025-02-14" xml:lang="fr">un lien vers la base de données des
            sceaux</desc>
                     <datatype>
                        <dataRef key="ssrq.pointer.url"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="delete"/>
                  <attDef ident="contemporary" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-sealDesc-de" xml:lang="de">
                  <p>
                Beispiel für die Beschreibung von Siegeln
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sealDesc-en" xml:lang="en">
                  <p>
                Example for the description of seals
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sealDesc-fr" xml:lang="fr">
                  <p>
                Exemple de description de sceaux
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sealDesc>
                        <seal attachment="sealed_on_a_parchment_tag"
                              condition="damaged"
                              material="wax"
                              n="1"
                              shape="round">
                           <persName ref="per000271" role="sigillant">Johannes von Belmont</persName>
                        </seal>
                        <seal attachment="sealed_on_a_leather_tag"
                              condition="in_a_box"
                              material="wax_in_a_box"
                              n="2"
                              place="end"
                              shape="triangular">
                           <orgName ref="org123456" role="sigillant">Schultheiss und Rat von Schilda</orgName>
                        </seal>
                     </sealDesc>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Die Beschreibung der Siegel erfolgt von links nach rechts. Der Siegler wird, wenn es
            sich um eine Person handelt, mit <gi>persName</gi> und dem Attribut <att>role</att> =
            <val>sigillant</val> oder, wenn es sich um eine Institution handelt, mit
            <gi>orgName</gi> und dem gleichen Attribut erfasst. Wenn die Namen der Siegler auf der
            Plica oder dem Pergamentstreifen stehen, sollte innerhalb von <gi>persName</gi> ein
            <gi>orig</gi> den handschriftlichen Namen umfassen.
        </p>
                  <p>
            Bei unsicheren Siegelidentifikationen, wenn z. B. der Siegler in der Urkunde nicht
            genannt ist, werden kein <gi>orgName</gi> oder <gi>persName</gi> angegeben. Wenn bei
            mehreren Siegeln die Siegler nicht sicher zugeordnet werden können, wird die
            Siegelidentifikation offen gelassen.
        </p>
                  <p>
            Die Siegel werden mit <att>n</att> durchnummeriert. Wünschenswert wäre, wenn der
            Edition nicht nur ein Faksimile des Textes, sondern auch Fotos der Siegel inkl. Masstab
            (Vor- und Rückseite) beigefügt würden.
        </p>
                  <p>
            Im Text wird der Anbringungsort eines Siegels mit <gi>figure</gi> (<att>type</att> =
            <val>locus_sigilli</val>) erfasst. Je nach Bedarf kann ein Kommentar zu den Siegeln
            verfasst werden.
        </p>
                  <p>
            Wichtig ist der Vergleich der Siegelankündigung im Text und die Besiegelung selber.
            <list>
                        <item>Haben alle angekündigten Siegler ihr Siegel an der Urkunde angebracht?
                </item>
                        <item>Hängt ein Siegel eines nicht angekündigten Sieglers?</item>
                        <item>Wurde evtl. ein Siegel gefälscht oder später angebracht?</item>
                     </list>
                  </p>
                  <p>
            Es ist zu prüfen, ob das Siegel mit dem angekündigten Siegler übereinstimmt.
            Siegelankündigungen, auch von fehlenden Siegeln und Siegelabdrücken, werden im Regest
            (<gi>summary</gi>) erwähnt. Fehlt ein angekündigtes Siegel, ist dies in
            <att>condition</att> mit <val>absent</val> anzumerken. Zudem ist in einer Anmerkung
            (<gi>note</gi>) zu beschreiben, weshalb wohl das Siegel fehlt bzw. weshalb die Urkunde
            unbesiegelt blieb.
        </p>
                  <p>
            Zu den Kaisersiegeln: [Posse Otto: Die Siegel der deutschen Kaiser und Könige von
            751–1806 und 1871–1913, 5 Bde., Dresden
            1909–1913](http://de.wikisource.org/wiki/Die_Siegel_der_Deutschen_Kaiser_und_K%C3%B6nige).
        </p>
               </remarks>
               <remarks versionDate="2023-08-23" xml:lang="en">
                  <p>
            The seals are described from left to right. If it is a person, the sealer is marked
            with <gi>persName</gi> and the attribute <att>role</att> = <val>sigillant</val> or, if
            it is an institution, with <gi>orgName</gi> and the same attribute. If the sealers’
            names are on the plica or parchment strip, within <gi>persName</gi> a <gi>orig</gi>
            should enclose the handwritten name.
        </p>
                  <p>
            In the case of uncertain seal identifications, if e.g. For example, if the sealer is
            not named in the certificate, no <gi>orgName</gi> or <gi>persName</gi> are given. If
            the seals cannot be assigned with certainty in the case of several seals, the seal
            identification is left open.
        </p>
                  <p>
            The seals are numbered with <att>n</att>. It would be desirable if the edition not only
            included a facsimile of the text, but also photos of the seals, including the scale
            (front and back). If this were the case for all seals, <att>extent</att> could be
            omitted.
        </p>
                  <p>
            L. S. = Locus sigilli is recorded with <gi>figure</gi>. If a document was issued
            without a seal, no seal is recorded. A comment on the seals can be written as required.
        </p>
                  <p>
            It is important to compare the announcement of the seal in the text and the seal
            itself.
            <list>
                        <item>Have all announced sealers affixed their seals to the deed?</item>
                        <item>Is there a seal of an unannounced sealer?</item>
                        <item>Was a seal possibly forged or affixed later?</item>
                     </list>
                  </p>
                  <p>
            It is to be checked whether the seal corresponds to the announced seal. Seal
            announcements, including missing seals and seal impressions, are mentioned in the
            regest (<gi>summary</gi>). If an announced seal is missing, this is to be noted in
            <att>condition</att> with <val>absent</val>. In addition, a note (<gi>note</gi>) must
            describe why the seal is missing or why the document remained unsealed.
        </p>
                  <p>
            On the imperial seals: [Posse Otto: Die Siegel der deutschen Kaiser und Könige von
            751–1806 und 1871–1913, 5 Bde., Dresden 1909–1913]
            (http://de.wikisource.org/wiki/Die_Siegel_der_Deutschen_Kaiser_und_K%C3%B6nige).
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            La description des sceaux se fait de gauche à droite. Le sigillant (personne physique
            ou morale au nom de qui un sceau est gravé), s’il s’agit d’une personne, est signalé
            par <gi>persName</gi> avec l’attribut <att>role</att> = <val>sigillant</val> ; s’il
            s’agit d’une institution, il est signalé par <gi>orgName</gi> avec l’attribut
            <att>role</att> = <val>sigillant</val>. Si les noms des sigillants figurent sur le
            repli ou sur la retaille du parchemin, un <gi>orig</gi> dans <gi>persName</gi> devrait
            inclure le nom manuscrit.
        </p>
                  <p>
            Si l’identification du sceau est incertaine, p. ex. quand le sigillant n’est pas
            mentionné dans le texte, on n’ajoute pas de <gi>orgName</gi> ni <gi>persName</gi>. Si,
            dans le cas de plusieurs sceaux, les sigillants ne peuvent pas être attribués avec
            certitude, l’identification du sceau est laissée ouverte.
        </p>
                  <p>
            Les sceaux sont numérotés avec <att>n</att>. Il serait souhaitable que l’édition soit
            accompagnée non seulement d’un fac-similé du texte, mais aussi de photos des sceaux,
            accompagnées d’une échelle (recto et verso).
        </p>
                  <p>
            Dans le texte, le lieu d’apposition d’un sceau est saisi avec <gi>figure</gi>
            (<att>type</att> = <val>locus_sigilli</val>). Selon les besoins, un commentaire sur les
            sceaux peut être rédigé.
        </p>
                  <p>
            Il est important de comparer l’annonce des sceaux dans le texte et le sceau lui-même.
            <list>
                        <item>Tous les scelleurs annoncés ont-ils apposé leurs sceaux sur l’acte ? </item>
                        <item>Y a-t-il le sceau d’un scelleur qui n’est pas annoncé ? </item>
                        <item>Un sceau a-t-il éventuellement été falsifié ou apposé plus tard ? </item>
                     </list>
                  </p>
                  <p>
            Il convient de vérifier si le sceau correspond au sigillant annoncé. Les annonces de
            sceaux, y compris les sceaux manquants et les empreintes de sceaux, sont mentionnées
            dans le résumé (<gi>summary</gi>). Si un sceau annoncé manque, il faut le mentionner
            dans <att>condition</att> avec <val>absent</val>. De plus, il convient de préciser dans
            une note (<gi>note</gi>) pour laquelle le sceau manque ou pourquoi le document n’a pas
            été scellé.
        </p>
                  <p>
            Concernant les sceaux impériaux : [Posse Otto: Die Siegel der deutschen Kaiser und
            Könige von 751–1806 und 1871–1913, 5 Bde., Dresden
            1909–1913](http://de.wikisource.org/wiki/Die_Siegel_der_Deutschen_Kaiser_und_K%C3%B6nige).
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msphse">11.7.3.2. Seals</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="HISTORY"
                         ident="history">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Geschichte</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">history</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">histoire</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Informationen zur Geschichte eines
    Textträgers.</desc>
               <desc rend="replace" versionDate="2023-07-15" xml:lang="en">Contains information about the history of a
    document. These include, for example, dating or the place of issue.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des informations sur l’historique d’un
    support de texte.</desc>
               <classes/>
               <content>
                  <elementRef key="origin"/>
               </content>
               <exemplum xml:id="ex-history-de" xml:lang="de">
                  <p>
                Beispiel für die Datierung, den Ausstellungsort und den Aussteller eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-en" xml:lang="en">
                  <p>
                Example of the dating, place of issue and issuer of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-fr" xml:lang="fr">
                  <p>
                Exemple de datation, de lieu d’émission et d’émetteur d’un document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#mshy">11.8. History</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ORIGIN"
                         ident="origin">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Herkunft</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">origin</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">origine</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Informationen zur Herkunft eines
    Textträgers oder seines Inhalts.</desc>
               <desc rend="replace" versionDate="2023-05-16" xml:lang="en">Contains information on the origin of a
    document.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des informations sur l’origine d’un
    support de texte ou de son contenu.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="origDate" maxOccurs="2" minOccurs="1"/>
                     <elementRef key="origPlace" maxOccurs="unbounded" minOccurs="0"/>
                     <elementRef key="orgName" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-origDate"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2024-06-05" xml:lang="en">constraint for tei:origDate</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:origin">
                           <sch:assert test="count(distinct-values(tei:origDate/@type)) =                     count(tei:origDate)"> When there are two tei:origDates inside tei:origin, their
                    @type attributes must be different. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-history-de" xml:lang="de">
                  <p>
                Beispiel für die Datierung, den Ausstellungsort und den Aussteller eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
