   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>SLS TEI-Schema</title>
            <author>
                    Bastian Politycki
                </author>
            <author>
                    Christian Sonder
                </author>
            <author>
                    Pascale Sutter
                </author>
         </titleStmt>
         <publicationStmt>
            <publisher>
                    SSRQ-SDS-FDS
                </publisher>
            <date when="2026-01-09Z"/>
            <idno>1.7.0</idno>
            <availability>
               <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/">
                        Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0)
                    </licence>
            </availability>
         </publicationStmt>
         <sourceDesc>
            <p>The main schema used by the Swiss Law Sources to validate TEI XML transcriptions</p>
         </sourceDesc>
      </fileDesc>
      <tei:encodingDesc xmlns:tei="http://www.tei-c.org/ns/1.0">
         <tei:constraintDecl scheme="schematron" queryBinding="xslt2">
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="tei"
                    uri="http://www.tei-c.org/ns/1.0"/>
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="xs"
                    uri="http://www.w3.org/2001/XMLSchema"/>
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="rng"
                    uri="http://relaxng.org/ns/structure/1.0"/>
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="rna"
                    uri="http://relaxng.org/ns/compatibility/annotations/1.0"/>
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="sch"
                    uri="http://purl.oclc.org/dsdl/schematron"/>
            <sch:ns xmlns:rng="http://relaxng.org/ns/structure/1.0"
                    xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                    prefix="sch1x"
                    uri="http://www.ascc.net/xml/schematron"/>
         </tei:constraintDecl>
      </tei:encodingDesc>
   </teiHeader>
   <text>
      <body>
            <!--additional translations, - note: inclusion path is relative to the examples
            directory (the base_path is defined by `resolve_xincludes` in `compile.py` - note: the
            xpointer values correspond to the xml:id attributes of the tei:dataSpec in the included
            file-->
         <dataSpec ident="ssrq.translations.global" xml:id="ssrq-translations-global">
            <content>
               <valList>
                  <valItem ident="amount">
                     <desc versionDate="2024-11-13" xml:lang="de">Menge</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">amount</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">quantité</desc>
                     <desc versionDate="2025-01-31" xml:lang="it">quantità</desc>
                  </valItem>
                  <valItem ident="and">
                     <desc versionDate="2024-11-13" xml:lang="de">und</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">and</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">et</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">e</desc>
                  </valItem>
                  <valItem ident="by">
                     <desc versionDate="2024-11-13" xml:lang="de">von</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">by</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">de</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">da</desc>
                  </valItem>
                  <valItem ident="comments">
                     <desc versionDate="2024-11-13" xml:lang="de">Kommentar</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">comment</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">commentaire</desc>
                     <desc versionDate="2025-01-31" xml:lang="it">commento</desc>
                  </valItem>
                  <valItem ident="compare">
                     <desc versionDate="2024-11-13" xml:lang="de">Vgl.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">See</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">Cf.</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">Cfr.</desc>
                  </valItem>
                  <valItem ident="edited-by">
                     <desc versionDate="2024-11-13" xml:lang="de">bearb. von</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">ed. by</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">éd. par</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">a cura di</desc>
                  </valItem>
                  <valItem ident="editor">
                     <desc versionDate="2025-01-31" xml:lang="de">hg.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">ed.</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">éd.</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">ed.</desc>
                  </valItem>
                  <valItem ident="in">
                     <desc versionDate="2024-11-13" xml:lang="de">in</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">in</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">dans</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">in</desc>
                  </valItem>
                  <valItem ident="page-abbr">
                     <desc versionDate="2024-11-13" xml:lang="de">S.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">p.</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">p.</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">p.</desc>
                  </valItem>
                  <valItem ident="pb">
                     <desc versionDate="2024-11-13" xml:lang="de">Seitenumbruch</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">page break</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">saut de page</desc>
                     <desc versionDate="2025-01-31" xml:lang="it">interruzione di pagina</desc>
                  </valItem>
                  <valItem ident="signed">
                     <desc versionDate="2024-11-13" xml:lang="de">Unterschrift</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">signature</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">signature</desc>
                     <desc versionDate="2025-01-31" xml:lang="it">firma</desc>
                  </valItem>
                  <valItem ident="summary">
                     <desc versionDate="2024-11-13" xml:lang="de">Regest</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">summary</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">résumé</desc>
                     <desc versionDate="2025-01-31" xml:lang="it">regesto</desc>
                  </valItem>
                  <valItem ident="through">
                     <desc versionDate="2024-11-13" xml:lang="de">durch</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">through</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">par</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">da</desc>
                  </valItem>
               </valList>
            </content>
         </dataSpec>
         <dataSpec ident="ssrq.translations.datetime" xml:id="ssrq-translations-datetime">
            <content>
               <valList>
                  <valItem ident="century-abbr">
                     <desc versionDate="2024-11-13" xml:lang="de">Jh.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">c.</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">s.</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">sec.</desc>
                  </valItem>
                  <valItem ident="century-ordinal">
                     <desc versionDate="2024-11-13" xml:lang="de">.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">.</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">
                        <hi rend="sup">e</hi>
                     </desc>
                     <desc versionDate="2024-11-13" xml:lang="it">°</desc>
                  </valItem>
                  <valItem ident="date">
