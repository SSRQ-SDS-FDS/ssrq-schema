                     <desc versionDate="2024-11-13" xml:lang="en">half</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">moitié du</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">metà del</desc>
                  </valItem>
                  <valItem ident="hour">
                     <desc versionDate="2024-11-13" xml:lang="de">Stunde</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="de">Stunden</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">hour</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="en">hours</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">heure</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="fr">heures</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">ora</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="it">ore</desc>
                  </valItem>
                  <valItem ident="mid-cent-abbr">
                     <desc versionDate="2024-11-13" xml:lang="de">Mitte</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">mid</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">milieu du</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">metà del</desc>
                  </valItem>
                  <valItem ident="minute">
                     <desc versionDate="2024-11-13" xml:lang="de">Minute</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="de">Minuten</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">minute</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="en">minutes</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">minute</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="fr">minutes</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">minuto</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="it">minuti</desc>
                  </valItem>
                  <valItem ident="month">
                     <desc versionDate="2024-11-13" xml:lang="de">Monat</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="de">Monate</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">month</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="en">months</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">mois</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">mese</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="it">mesi</desc>
                  </valItem>
                  <valItem ident="notAfter">
                     <desc versionDate="2024-11-13" xml:lang="de">nicht nach</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">not after</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">pas après</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">non dopo</desc>
                  </valItem>
                  <valItem ident="notBefore">
                     <desc versionDate="2024-11-13" xml:lang="de">nicht vor</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">not before</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">pas avant</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">non prima</desc>
                  </valItem>
                  <valItem ident="old-style-abbr">
                     <desc versionDate="2024-11-13" xml:lang="de">a. S.</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">O.S.</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">a. s.</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">v. s.</desc>
