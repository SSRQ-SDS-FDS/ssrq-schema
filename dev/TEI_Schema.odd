                        <desc versionDate="2022-09-05" xml:lang="it">sul verso superiore</desc>
                     </valItem>
                     <valItem ident="verso_above_left">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite oben
                        links</desc>
                        <desc versionDate="2022-05-10" xml:lang="en">at the top left of the
                        verso</desc>
                        <desc versionDate="2022-05-10" xml:lang="fr">au verso en haut à
                        gauche</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">sul verso superiore a
                        sinistra</desc>
                     </valItem>
                     <valItem ident="verso_above_middle">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite oben in der
                        Mitte</desc>
                        <desc versionDate="2022-05-10" xml:lang="en">at the top of the verso in the
