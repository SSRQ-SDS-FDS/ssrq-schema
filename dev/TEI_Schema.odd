               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#mshy">11.8. History</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ADDITIONAL"
                         ident="additional">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">zusätzliche Informationen</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">additional information</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">informations complémentaires</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält zusätzliche Informationen zum
    Textzeugen.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Contains references to editions, regesta and
    literature.</desc>
               <desc rend="replace" versionDate="2025-04-29" xml:lang="fr">Contient des informations complémentaires sur le
    texte.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="adminInfo" minOccurs="0"/>
                     <elementRef key="listBibl" maxOccurs="unbounded" minOccurs="0"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-additional-de" xml:lang="de">
                  <p>
                Beispiel für Literaturhinweise
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <additional>
                        <listBibl type="literature">
                           <bibl>
                              <ref target="http://permalink.snl.ch/bib/chbsg000137461">Ott, Rechtsquellen</ref>, Teil 1, S. 95, Nr. 258 (Dipl. Nr. 168)</bibl>
                        </listBibl>
                     </additional>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-additional-en" xml:lang="en">
                  <p>
                Example of bibliographical references
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <additional>
                        <listBibl type="literature">
                           <bibl>
                              <ref target="http://permalink.snl.ch/bib/chbsg000137461">Ott, Rechtsquellen</ref>, Teil 1, S. 95, Nr. 258 (Dipl. Nr. 168)</bibl>
                        </listBibl>
                     </additional>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-additional-fr" xml:lang="fr">
                  <p>
                Exemple de références bibliographiques
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <additional>
                        <listBibl type="literature">
                           <bibl>
                              <ref target="http://permalink.snl.ch/bib/chbsg000137461">Ott, Rechtsquellen</ref>, Teil 1, S. 95, Nr. 258 (Dipl. Nr. 168)</bibl>
                        </listBibl>
                     </additional>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            In <gi>additional</gi> wird die Literatur zum Textzeugen, z. B. Editionen, Regesten
            oder Sekundärliteratur mithilfe von <gi>listBibl</gi> verzeichnet.
        </p>
                  <p>
            Ist der Textzeuge nicht mehr erhalten, werden Angaben zum Verlust des Textzeugen in
            <gi>adminInfo</gi> hinterlegt.
        </p>
               </remarks>
               <remarks versionDate="2025-04-29" xml:lang="fr">
                  <p>
            Dans <gi>additional</gi>, la littérature relative au texte, p. ex. les éditions, les
            résumés ou la littérature secondaire, est répertoriée à l’aide de <gi>listBibl</gi>.
        </p>
                  <p>
            Si le texte n’est plus conservé, des informations sur sa perte sont indiquées dans
            <gi>adminInfo</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msad">11.9. Additional Information</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="ADMININFO"
                         ident="adminInfo">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">administrative Informationen</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">administrative information</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">informations administratives</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält administrative Informationen zur
    Aufbewahrung des Textzeugen.</desc>
               <desc rend="replace" versionDate="2023-09-19" xml:lang="en">Contains information on the storage of a document.
    Used, for example, in the case of lost manuscripts.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient des informations administratives sur la
    conservation du document.</desc>
               <classes/>
               <content>
                  <elementRef key="custodialHist"/>
               </content>
               <exemplum xml:id="ex-adminInfo-de" xml:lang="de">
                  <p>
                Beispiel administrativer Informationen zum Verlust eines Dokuments nach Erstedition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-fr" xml:lang="fr">
                  <p>
                Exemple d’information sur la perte d’un document après sa création
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-en" xml:lang="en">
                  <p>
                Example of administrative information on the loss of a document after creation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Wir verwenden das Element nur, wenn der Textzeuge verloren ist und geben in
            <gi>custodialHist</gi> die Informationen zum Verlust des Textzeugen an.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Nous n’utilisons cet élément que si le texte est perdu et indiquons dans
            <gi>custodialHist</gi> les informations relatives à sa perte.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msadad">11.9.1. Administrative Information</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="CUSTODIALHIST"
                         ident="custodialHist">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Aufbewahrungsgeschichte</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">custodial history</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">historique de conservation</gloss>
               <desc rend="replace" versionDate="2023-09-19" xml:lang="de">Enthält Informationen zur Aufbewahrungsgeschichte
    eines Dokuments.</desc>
               <desc rend="replace" versionDate="2023-09-19" xml:lang="en">Contains information on the custodial history of a
    document.</desc>
               <desc rend="replace" versionDate="2023-09-19" xml:lang="fr">Contient des informations sur l’historique de
    conservation d’un document.</desc>
               <classes/>
               <content>
                  <elementRef key="custEvent"/>
               </content>
               <exemplum xml:id="ex-adminInfo-de" xml:lang="de">
                  <p>
                Beispiel administrativer Informationen zum Verlust eines Dokuments nach Erstedition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-fr" xml:lang="fr">
                  <p>
                Exemple d’information sur la perte d’un document après sa création
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-en" xml:lang="en">
                  <p>
                Example of administrative information on the loss of a document after creation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-08" xml:lang="de">
                  <p>
            Das Element wird nur innerhalb von <gi>adminInfo</gi>benutzt, wenn der Textzeuge
            verloren gegangen ist.
        </p>
               </remarks>
               <remarks versionDate="2025-07-08" xml:lang="fr">
                  <p>
            Ne s’utilise qu’en cas de perte du document, dans <gi>adminInfo</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msadch">11.9.1.2. Availability and Custodial History</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="CUSTEVENT"
                         ident="custEvent">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Ereignis in der Aufbewahrungsgeschichte</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">event in the custodial history</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">événement dans l’historique de
    conservation</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Beschreibt den Verlust des Textträgers.</desc>
               <desc rend="replace" versionDate="2023-09-19" xml:lang="en">Describes an event in the custodial history of a
    document.</desc>
               <desc rend="replace" versionDate="2025-02-03" xml:lang="fr">Décrit un événement dans l’historique de
    conservation d’un texte.</desc>
               <classes>
                  <memberOf key="att.calendarSystem"/>
                  <memberOf key="att.datable.custom"/>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <textNode/>
               </content>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-31" xml:lang="de">die Art des Ereignisses</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the type of event</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le type d’événement</desc>
                     <datatype>
                        <dataRef key="ssrq.type.custevent"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-adminInfo-de" xml:lang="de">
                  <p>
                Beispiel administrativer Informationen zum Verlust eines Dokuments nach Erstedition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-fr" xml:lang="fr">
                  <p>
                Exemple d’information sur la perte d’un document après sa création
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-adminInfo-en" xml:lang="en">
                  <p>
                Example of administrative information on the loss of a document after creation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <adminInfo>
                        <custodialHist>
                           <custEvent calendar="gregorian" notBefore-custom="1858-09-01" type="lost">Verlust nicht vor Erscheinen der Erstedition des 19.
            Jahrhunderts.</custEvent>
                        </custodialHist>
                     </adminInfo>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msadch">11.9.1.2. Availability and Custodial History</ref>
               </listRef>
            </elementSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="namesdates"
                       xml:id="DATABLECUSTOM"
                       type="atts"
                       predeclare="true"
                       ident="att.datable.custom">
               <desc versionDate="2011-11-11" xml:lang="en">provides attributes for normalization of elements that contain datable events to a custom dating system
    (i.e. other than the Gregorian used by W3 and ISO).</desc>
               <classes/>
               <attList>
                  <attDef ident="from-custom" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">der Beginn des Zeitraums gemäss
                    ISO 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the beginning of the period
                    according to iso 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le début de la période selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="ssrq.date.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="notAfter-custom" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">das Ende des Zeitraums gemäss ISO
                    8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the end of the period according to
                    iso 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la fin de la période selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="ssrq.date.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="notBefore-custom" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">der Beginn des Zeitraums gemäss
                    ISO 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the beginning of the period
                    according to iso 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le début de la période selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="ssrq.date.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="to-custom" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">das Ende des Zeitraums gemäss ISO
                    8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the end of the period according to
                    iso 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la fin de la période selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="ssrq.date.point"/>
                     </datatype>
                  </attDef>
                  <attDef ident="when-custom" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">das Datum bzw. der Zeitpunkt
                    gemäss ISO 8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the date or time according to ISO
                    8601</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la date ou l’heure selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="ssrq.date.point"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE">14.4. Dates</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       predeclare="true"
                       module="namesdates"
                       xml:id="PERSPART"
                       type="model"
                       ident="model.persNamePart">
               <desc versionDate="2007-10-03" xml:lang="en">groups elements which form part of a personal name.</desc>
               <desc versionDate="2009-05-27" xml:lang="fr">regroupe des éléments qui font partie d'un nom de personne.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa gli elementi che compongono un nome proprio
        di persona</desc>
               <classes>
                  <memberOf key="model.nameLike"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPER">14.2.1. Personal Names</ref>
               </listRef>
            </classSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="namesdates"
                         xml:id="gi-orgName"
                         ident="orgName">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Organisationsname</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">organization name</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">nom d’organisation</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beinhaltet den Namen einer Organisation bzw.
    Institution.</desc>
               <desc rend="replace" versionDate="2023-03-17" xml:lang="en">Characterises an organisation or institution, such
    as monasteries, guilds, councils, neighbourhoods, etc.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient le nom d’une organisation ou d’une
    institution.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.naming"/>
                  <memberOf key="model.nameLike.agent"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-orgName"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-06-19" xml:lang="en">constraint for tei:orgName</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:orgName[ancestor::tei:seriesStmt]">
                           <sch:let name="ssrq"
                                    value="(normalize-space('Fondation des sources du                     droit de la Société suisse des juristes'),                     normalize-space('Rechtsquellenstiftung der Schweizerischen Juristischen                     Gesellschaft'))"/>
                           <sch:let name="content" value="normalize-space(.)"/>
                           <sch:assert test="$content = $ssrq"> The content of tei:orgName must match
                        <sch:value-of select="string-join($ssrq, ' or ')"/>
                        . </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:orgName[parent::tei:respStmt]">
                           <sch:assert test=".[not(@*)]"> If tei:orgName is used as part of tei:respStmt
                    no attributes are allowed. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-orgName-role"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-12-17" xml:lang="en">constraint for tei:orgName/@role</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:orgName[parent::tei:origin]">
                           <sch:assert test="@role">@role is mandatory, when tei:orgName is inside
                    tei:origin</sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="ref" mode="replace">
                     <datatype>
                        <dataRef key="ssrq.pointer.org"/>
                     </datatype>
                  </attDef>
                  <attDef ident="role" mode="change">
                     <desc versionDate="2025-01-30" xml:lang="de">die Rolle der Organisation im Text</desc>
                     <desc versionDate="2025-01-30" xml:lang="en">the role of the organization in the
            text</desc>
                     <desc versionDate="2025-01-30" xml:lang="fr">le rôle de l’organisation dans le
            texte</desc>
                     <datatype>
                        <dataRef key="ssrq.role.orgname"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-orgName-de" xml:lang="de">
                  <p>
                Als Organisation werden stets die Institutionen / Funktionen gekennzeichnet – jedoch nicht die Personen. Dies gilt, wie nachfolgend zeigt, auch
                für die namentliche Nennung des Bürgermeisters.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    presentibus
    <lb/>herr <persName ref="per001921">Bernhart von Chaam</persName>, <orgName ref="org002406">burgermeister, und beid
        <lb/>räth </orgName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-orgName-en" xml:lang="en">
                  <p>
                Institutions / functions are always identified as organisations – but not the people. As shown below, this also applies to the naming of the
                mayor.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    presentibus
    <lb/>herr <persName ref="per001921">Bernhart von Chaam</persName>, <orgName ref="org002406">burgermeister, und beid
        <lb/>räth </orgName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-orgName-fr" xml:lang="fr">
                  <p>
                Les institutions/fonctions sont toujours signalées en tant qu’organisation, mais pas les personnes. Comme indiqué ci-dessous, cela s’applique
                également à la désignation du maire.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    presentibus
    <lb/>herr <persName ref="per001921">Bernhart von Chaam</persName>, <orgName ref="org002406">burgermeister, und beid
        <lb/>räth </orgName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-de" xml:lang="de">
                  <p>
                Beispiel für die Datierung, den Ausstellungsort und den Aussteller eines Dokuments
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-en" xml:lang="en">
                  <p>
                Example of the dating, place of issue and issuer of a document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-history-fr" xml:lang="fr">
                  <p>
                Exemple de datation, de lieu d’émission et d’émetteur d’un document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <history>
                        <origin>
                           <origDate calendar="gregorian" type="document" when-custom="1600-01-01">1. Januar 1600</origDate>
                           <origDate calendar="julian" type="content" when-custom="1532-05-20">20. Mai 1532</origDate>
                           <origPlace ref="loc000701" type="document">
                Schaffhausen
            </origPlace>
                           <origPlace ref="loc000701" type="content">
                Schaffhausen
            </origPlace>
                           <orgName ref="org010289" role="issuer">Grosser Rat Schaffhausen</orgName>
                        </origin>
                     </history>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            In den Editionen der SSRQ werden folgende Entitäten als Organisationen gekennzeichnet:
            <list>
                        <item>Bevölkerungsgruppe (z. B. Juden, die Engländer)</item>
                        <item>Bruderschaft </item>
                        <item>Bürgermeister und Rat</item>
                        <item>Eidgenossenschaft bzw. Gruppe von eidgenössischen Orten (z. B. VII Orte)
                (wenn es sich nicht um den Ort, sondern die Organisation handelt) </item>
                        <item>Eigentümerschaft</item>
                        <item>Familie (z. B. die Grafen von Toggenburg, die Herren von Landenberg)</item>
                        <item>Heiligenverband/Heiligengruppe (z. B. Zehntausend Ritter, Elftausend
                Jungfrauen, Peter und Paul) </item>
                        <item>Herrschaftsverband</item>
                        <item>Kirchgenossenschaft/Pfarrei (Achtung: eine Kirchhöre oder ein Kirchspiel kann
                auch eine Ortsbezeichnung sein) </item>
                        <item>Klosterkonvent; hier: Konvent (Achtung: ein Kloster kann auch eine
                Ortsbezeichnung sein) </item>
                        <item>Knabenschaft</item>
                        <item>Kommission (z. B. Baukommission etc.) </item>
                        <item>Handelsgesellschaft</item>
                        <item>Nachbarschaft </item>
                        <item>Nutzungsgemeinschaft</item>
                        <item>Orden</item>
                        <item>Rat </item>
                        <item>Schützengesellschaft</item>
                        <item>Stiftung</item>
                        <item>Steuergenossenschaft </item>
                        <item>Zunft</item>
                     </list>
                  </p>
                  <p>
            Darüber hinaus wird im <gi>teiHeader</gi> die Herausgeberin der Reihe, d. h. die
            Rechtsquellenstiftung mit <gi>orgName</gi> ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            Within the collection of Swiss legal sources, for example, the following entities are
            designated as organisations:
            <list>
                        <item>Population group (e.g. Jews)</item>
                        <item>Brotherhood</item>
                        <item>Mayor and council</item>
                        <item>Citizenship</item>
                        <item>Federation or group of federated places (e.g. VII places) (if it is not the
                place but the organisation) </item>
                        <item>Ownership</item>
                        <item>Family (e.g. the Counts of Toggenburg, the Lords of Landenberg)</item>
                        <item>Saints’ association/saints’ group (e.g. Ten Thousand Knights, Eleven Thousand
                Virgins, Peter and Paul)</item>
                        <item>Dominion association </item>
                        <item>Kirchgenossenschaft/Pfarrei (Attention: a Kirchhöre or a Kirchspiel can also
                be a place name)</item>
                        <item>Convent of a monastery; here: Convent (attention: a monastery can also be a
                place name)</item>
                        <item>Boyship</item>
                        <item>Commission (e.g. building commission etc.)</item>
                        <item>Trade company</item>
                        <item>Neighbourhood </item>
                        <item>Community of use</item>
                        <item>Order</item>
                        <item>Council</item>
                        <item>Shooting Society</item>
                        <item>Foundation</item>
                        <item>Tax cooperative </item>
                        <item>Guild</item>
                     </list>
                  </p>
                  <p>
            The publisher of the series, here always the Legal Source Foundation, is honoured in
            the <gi>respStmt</gi> distinguished with <gi>orgName</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Dans les éditions des SDS, les entités suivantes sont signalées comme organisations :
            <list>
                        <item>un groupe de population (p. ex. juifs, les Anglais)</item>
                        <item>une confrérie </item>
                        <item>le bourgmestre et le conseil</item>
                        <item>la Confédération suisse ou un groupe de plusieurs cantons (p. ex. les VII
                cantons) (quand il ne s’agit pas du lieu, mais de l’organisation)</item>
                        <item>une propriété</item>
                        <item>une famille (p. ex. la maison de Toggenburg, von Landenberg) </item>
                        <item>une fête qui réunit plusieurs saints (Dix mille martyrs, Onze mille vierges,
                Pierre et Paul)</item>
                        <item>une entité politique</item>
                        <item>une circonscription ecclésiastique / paroisse (attention : une paroisse peut
                aussi être une indication topographique ou une provenance géographique)</item>
                        <item>un couvent (attention : un couvent peut également être le nom d’un
                lieu)</item>
                        <item>une société de jeunesse</item>
                        <item>une commission (p. ex. comité de construction etc.)</item>
                        <item>une société commerciale</item>
                        <item>un voisinage</item>
                        <item>une communauté d’utilisateurs</item>
                        <item>un ordre religieux</item>
                        <item>un conseil</item>
                        <item>une société de tir</item>
                        <item>une fondation</item>
                        <item>une coopérative de taxation</item>
                        <item>une corporation</item>
                     </list>
                  </p>
                  <p>
            De plus, dans le <gi>teiHeader</gi>, l’éditeur de la série, c’est-à-dire la Fondation
            des sources du droit, est désigné par <gi>orgName</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDORG">14.2.2. Organizational Names</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="namesdates"
                         xml:id="gi-persName"
                         ident="persName">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Personenname</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">personal name</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">nom de personne</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält den Namen einer Person.</desc>
               <desc rend="replace" versionDate="2024-04-20" xml:lang="en">Indicates a person and usually includes only the
    first and last name.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient le nom d’une personne.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.naming"/>
                  <memberOf key="model.nameLike.agent"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-persName"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-06-23" xml:lang="en">constraint for tei:persName</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:persName[ancestor::tei:editor]">
                           <sch:assert test="not(@ref|@role)"> If tei:persName is part of tei:editor it
                    must not contain the attributes @ref or @role. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="ref" mode="replace">
                     <datatype>
                        <dataRef key="ssrq.pointer.persons"/>
                     </datatype>
                  </attDef>
                  <attDef ident="role" mode="replace">
                     <desc versionDate="2025-01-30" xml:lang="de">die Rolle einer Person im Text</desc>
                     <desc versionDate="2025-01-30" xml:lang="en">the role of a person in the text</desc>
                     <desc versionDate="2025-01-30" xml:lang="fr">le rôle d’une personne dans le
            texte</desc>
                     <datatype>
                        <dataRef key="ssrq.role.person"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-persName-1-de" xml:lang="de">
                  <p>
                Beispiel für einen einfachen Personennamen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per008949a">Hans Gullisen</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-1-en" xml:lang="en">
                  <p>
                Example of a simple personal name
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per008949a">Hans Gullisen</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-1-fr" xml:lang="fr">
                  <p>
                Exemple de nom de personne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per008949a">Hans Gullisen</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-2-de" xml:lang="de">
                  <p>
                Auszeichnung eines Heiligen – nur der Name wird erfasst
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        sant <persName ref="per000351">Pauls</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-2-en" xml:lang="en">
                  <p>
                Tagging of a saint
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        sant <persName ref="per000351">Pauls</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-2-fr" xml:lang="fr">
                  <p>
                Signalisation d’un saint
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        sant <persName ref="per000351">Pauls</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-3-de" xml:lang="de">
                  <p>
                Beispiel für einen Namen mit
                <att>
                    role
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per002744a" role="sigillant">Johann Jakob Escher</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-3-en" xml:lang="en">
                  <p>
                Use with
                <att>
                    role
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per002744a" role="sigillant">Johann Jakob Escher</persName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-persName-3-fr" xml:lang="fr">
                  <p>
                Exemple d’un nom avec
                <att>
                    role
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <persName ref="per002744a" role="sigillant">Johann Jakob Escher</persName>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Es gelten die ausführlichen Richtlinien zur Auszeichnung von Personen in den <ref target="persons.de.md">Transkriptionsrichtlinien</ref>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Les directives détaillées relatives à la dénomination des personnes dans les <ref target="persons.de.md">principes de transcription</ref> s’appliquent.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPER">14.2.1. Personal Names</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="namesdates"
                         xml:id="gi-placeName"
                         ident="placeName">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Ortsname</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">place name</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">nom de lieu</gloss>
               <desc rend="replace" versionDate="2025-02-21" xml:lang="de">Enthält eine topographische Bezeichnung (wie einen
    Ort oder einen Flurnamen).</desc>
               <desc rend="replace" versionDate="2023-04-20" xml:lang="en">Indicates topographical designations (a place or a
    field name).</desc>
               <desc rend="replace" versionDate="2025-02-21" xml:lang="fr">Contient une désignation topographique (tel qu’un
    lieu ou un lieu-dit).</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="model.placeNamePart"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="ref" mode="replace">
                     <datatype>
                        <dataRef key="ssrq.pointer.places"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-placeName-de" xml:lang="de">
                  <p>
                Beispiel für die Erfassung eines historischen Ortsnamens mit Verweis auf die SSRQ-Datenbank
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <placeName ref="loc000284">Freiburg</placeName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-placeName-en" xml:lang="en">
                  <p>
                Example of recording a historical place name with a reference to the SLS database
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <placeName ref="loc000284">Freiburg</placeName>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-placeName-fr" xml:lang="fr">
                  <p>
                Exemple d’un nom de lieu avec une référence à la base de données SDS
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <placeName ref="loc000284">Freiburg</placeName>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Es gelten die ausführlichen Richtlinien zur Auszeichnung von Orten und Räumen in den
            <ref target="places.de.md">Transkriptionsrichtlinien</ref>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les directives détaillées pour l’indication des lieux et des espaces se trouvent dans
            les <ref target="places.fr.md">principes de transcription</ref> s’appliquent.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPLAC">14.2.3. Place Names</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="namesdates"
                         xml:id="gi-settlement"
                         ident="settlement">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Siedlungsname</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">settlement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">lieu d’archivage</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält innerhalb von <gi>msIdentifier</gi> den
    Standort des Archivs, in dem der Textträger aufbewahrt wird.</desc>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="en">Recording of a settlement name (location of the
    archive) within <gi>msIdentifier</gi>.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient dans <gi>msIdentifier</gi> la
    localisation de l’archive dans laquelle le support de texte est conservé.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.global"/>
                  <memberOf key="model.placeNamePart"/>
               </classes>
               <content>
                  <textNode/>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="ref" mode="replace" usage="req">
                     <datatype>
                        <dataRef key="ssrq.pointer.places"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.de"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.fr"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-msIdentifier-de" xml:lang="de">
                  <p>
                Beispiel für eine Handschriftensignatur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-en" xml:lang="en">
                  <p>
                Example of a manuscript identifier
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-msIdentifier-fr" xml:lang="fr">
                  <p>
                Exemple d’identification d’un manuscrit
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msIdentifier>
                        <settlement ref="loc123456" xml:lang="de">Schilda</settlement>
                        <repository xml:lang="de">Staatsarchiv Schilda</repository>
                        <idno xml:lang="de">StASh A X 2, S. 1-100</idno>
                        <settlement ref="loc123456" xml:lang="fr">Ville de Schilda</settlement>
                        <repository xml:lang="fr">Archives de l’État de Schilda</repository>
                        <idno xml:lang="fr">ArdEtSh A X 2, p. 1-100</idno>
                        <altIdentifier>
                           <idno>olim Ms. Cod. fol. 1234</idno>
                        </altIdentifier>
                     </msIdentifier>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDPLAC">14.2.3. Place Names</ref>
               </listRef>
            </elementSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="textcrit"
                       type="atts"
                       ident="att.witnessed">
               <desc versionDate="2021-08-22" xml:lang="en">provides attributes used to identify the witnesses
  supporting a particular reading in a critical apparatus.</desc>
               <classes/>
               <attList>
                  <attDef ident="wit" mode="replace" usage="req">
                     <desc versionDate="2025-01-28" xml:lang="de">ein oder mehrere Verweise auf die
                    <att>xml:id</att> von <gi>witness</gi>- oder <gi>bibl</gi>-Elementen</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">one or more references to the
                    <att>xml:id</att> of <gi>witness</gi> or <gi>bibl</gi> elements</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">une ou plusieurs références aux
                    <att>xml:id</att> des éléments <gi>witness</gi> ou <gi>bibl</gi>
                     </desc>
                     <datatype>
                        <rng:list>
                           <rng:oneOrMore>
                              <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.id"/>
                           </rng:oneOrMore>
                        </rng:list>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPLL">13.1. The Apparatus Entry, Readings, and Witnesses</ref>
               </listRef>
            </classSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textcrit"
                         xml:id="gi-app"
                         ident="app">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Apparat</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">apparatus</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">apparat critique</gloss>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="de">Enthält einen Apparateintrag.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Contains a apparatus entry.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="fr">Contient une entrée de l’apparat critique.</desc>
               <classes>
                  <memberOf key="model.global.edit"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="lem" minOccurs="0"/>
                     <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                        <alternate minOccurs="1" maxOccurs="unbounded">
                           <elementRef key="note"/>
                           <elementRef key="rdg"/>
                        </alternate>
                     </sequence>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="type" mode="delete"/>
                  <attDef ident="from" mode="delete"/>
                  <attDef ident="to" mode="delete"/>
                  <attDef ident="loc" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-app-rdg-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparateintrag
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-en" xml:lang="en">
                  <p>
                Example of an apparatus entry
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-fr" xml:lang="fr">
                  <p>
                Exemple d’apparat critique
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparat mit Textvergleich
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-en" xml:lang="en">
                  <p>
                Example of an apparatus with text comparison
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-fr" xml:lang="fr">
                  <p>
                Exemple d’un apparat critique avec comparaison de texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-lem-space-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparateintrag mit Lücke
                <gi>
                    space
                </gi>
                in der Editionsvorlage.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>
                           <space quantity="1" unit="word"/>
                        </lem>
                        <rdg wit="id-ssrq-4e7a04fd-4943-4e71-bfe1-c245e497c413">février</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-lem-space-en" xml:lang="en">
                  <p>
                Example of an apparatus entry with a free space
                <gi>
                    space
                </gi>
                in the edited document.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>
                           <space quantity="1" unit="word"/>
                        </lem>
                        <rdg wit="id-ssrq-4e7a04fd-4943-4e71-bfe1-c245e497c413">février</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-lem-space-fr" xml:lang="fr">
                  <p>
                Exemple d’une entrée d’appareil avec une lacune
                <gi>
                    space
                </gi>
                dans le modèle d’édition.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>
                           <space quantity="1" unit="word"/>
                        </lem>
                        <rdg wit="id-ssrq-4e7a04fd-4943-4e71-bfe1-c245e497c413">février</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-without-lem-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparateintrag ohne Lemma (
                <gi>
                    lem
                </gi>
                )
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">Da aber ein urteil gfellt wird vom gricht, mag derselben bschwerliche teill da
                <lb/>danen vorr einen <abbr>hrn</abbr> landvogt <term ref="lem001043">appellieren</term>. Da auch volgendts daselbsten denen widerumb
                <lb/>der beschwerte zum appellaz ußspruch mit seiner gegenwartt für mein gned
                <lb break="no"/>ig herren unnd weiter nicht kommen.</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-without-lem-en" xml:lang="en">
                  <p>
                Example of an apparatus entry without a lemma (
                <gi>
                    lem
                </gi>
                )
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">Da aber ein urteil gfellt wird vom gricht, mag derselben bschwerliche teill da
                <lb/>danen vorr einen <abbr>hrn</abbr> landvogt <term ref="lem001043">appellieren</term>. Da auch volgendts daselbsten denen widerumb
                <lb/>der beschwerte zum appellaz ußspruch mit seiner gegenwartt für mein gned
                <lb break="no"/>ig herren unnd weiter nicht kommen.</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-without-lem-fr" xml:lang="fr">
                  <p>
                Exemple d’entrée d’apparat sans lemme (
                <gi>
                    lem
                </gi>
                )
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">Da aber ein urteil gfellt wird vom gricht, mag derselben bschwerliche teill da
                <lb/>danen vorr einen <abbr>hrn</abbr> landvogt <term ref="lem001043">appellieren</term>. Da auch volgendts daselbsten denen widerumb
                <lb/>der beschwerte zum appellaz ußspruch mit seiner gegenwartt für mein gned
                <lb break="no"/>ig herren unnd weiter nicht kommen.</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <remarks versionDate="2023-08-18" xml:lang="de">
                  <p>
                     <gi>app</gi> gibt verschiedene Lesarten eines Wortes oder eines Textabschnittes unter
            Bezugnahme auf ein oder mehrere andere Dokumente an.
        </p>
                  <p>
            Existieren von einem Stück mehrere Textzeugen (Originale, Kopien) kann bei einer
            Fehlstelle einer der anderen Textzeugen hinzugezogen werden. Inhaltliche Abweichungen
            der anderen Originale oder Abschriften von der Editionsvorlage müssen zwingend
            angemerkt werden. Ebenso lassen sich bei zwei Originalen mit <gi>app</gi> die
            Abweichungen auszeichnen, sodass nicht beide Versionen transkribiert werden müssen.
        </p>
                  <p>
            Bei kurzen Nachträgen, z. B. einem halben Satz, kann man sich mit einem leeren
            <gi>lem</gi> behelfen (vgl. Beispiel unten). Bei längeren Nachträgen oder Zusätzen aus
            anderen Textzeugen empfiehlt es sich indessen, ein eigenes Stück dafür zu erstellen.
            Die bereits edierten Teile eines früheren Textzeugen können dann mit <gi>gap</gi>
            weggelassen werden. Es muss in diesem Fall jedoch mit <att>source</att> auf den
            edierten Text, der weggelassen wird, referenziert werden. Ein Kommentar hierzu in
            <gi>back</gi> ist notwendig.
        </p>
                  <p>
            Wenn eine Zweitausfertigung oder Abschrift eine signifikante Auslassung aufweist, kann
            dafür ein leeres <gi>rdg</gi> gesetzt werden (vgl. Beispiel unten). Für alternative
            Lesungen aus anderen Editionen bzw. moderner Literatur verwendet man hingegen
            <gi>note</gi> mit <att>type</att> = <val>text_comparison</val>.
        </p>
                  <p>
            Wird ein Stück erneut transkribiert und weicht die neue Transkription von bereits
            edierten ab, wird die Abweichung in der Regel nicht angegeben. Wenn die Neuedition sich
            jedoch in einem inhaltlichen Punkt bzw. einer Lesung wesentlich unterscheidet, wird
            dies nicht mit <gi>app</gi>, sondern mit <gi>note</gi> behandelt. Abweichungen der
            Schreibung eines weiteren Originals oder Abschriften sind ebenfalls nur anzumerken,
            wenn sie weitere Erkenntnisse liefern.
        </p>
                  <p>
            Wenn eine Stelle eines Originals wegen einer Beschädigung nicht mehr lesbar ist, kann
            der Textverlust mithilfe eines anderen Textzeugen ergänzt werden. Dafür verwenden wir
            nicht <gi>app</gi> und <gi>rdg</gi>, sondern <gi>damage</gi> zusammen mit
            <gi>supplied</gi>.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            Allows you to display different readings of a word or a section of text with reference
            to another document or documents. Must immediately follow the word without spaces.
        </p>
                  <p>
            If there are several text witnesses (originals, copies) of a piece, the other text
            witness can be consulted in the event of a gap. Deviations in content of the other
            originals or copies from the edition template must be noted. The deviations can also be
            marked with two originals, so that both versions do not have to be transcribed.
        </p>
                  <p>
            For short supplements, e.g. B. half a sentence, you can get by with an empty
            <gi>lem</gi> (see example below). In the case of longer supplements or additions from
            other text sources, however, it is advisable to create a separate piece for them. The
            already edited texts of an earlier text witness can be omitted with <gi>gap</gi>.
            However, it must be referenced with <att>source</att> to the edited text that is
            omitted. A remark (comment in <gi>back</gi>) is required.
        </p>
                  <p>
            If a duplicate or transcript has a significant omission (that is, a word or phrase has
            been omitted), an empty <gi>rdg</gi> may be substituted (see example below). For
            alternative readings from other editions or modern literature, on the other hand,
            <gi>note</gi> with <gi>quote</gi> is used. As a rule, deviations in the transcription
            from source pieces that have already been edited are not indicated. If the new edition
            differs significantly in terms of content or reading, a <gi>note</gi> is required.
            Deviations in the spelling of another original or copies are also only to be noted if
            they provide further insights.
        </p>
                  <p>
            If there are several originals, the criteria that contributed to the choice of the
            edition template should be explained in a comment in <gi>back</gi> if possible. The
            same applies in the case of copies. Caution: Reverses are considered independent lore.
        </p>
                  <p>
            If a part of an original is no longer legible due to damage, the text loss can be
            supplemented with the help of another text witness. Instead of using <gi>app</gi> and
            <gi>rdg</gi>, we use <gi>damage</gi> together with <gi>supplied</gi>.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="fr">
                  <p>
                     <gi>app</gi> donne différentes lectures d’un mot ou d’un passage de texte en se
            référant à un ou plusieurs autres documents.
        </p>
                  <p>
            S’il y a plusieurs témoins pour une pièce (originaux, copies), l’un des témoins peut
            être convoqué pour un passage. Toute divergence dans le contenu des autres originaux ou
            copies par rapport au texte édité doit être signalée. De même, s’il y a deux originaux,
            les différences peuvent être signalées avec <gi>app</gi> sans que les deux versions
            aient besoin d’être transcrites.
        </p>
                  <p>
            Pour des courts ajouts, p. ex. une demi-phrase, vous pouvez utiliser un <gi>lem</gi>
            vide (voir exemple ci-dessous). Cependant, pour des ajouts plus longs ou des ajouts
            d’autres témoins, il est conseillé de créer une pièce spécifique pour celles-ci. Les
            parties déjà éditées d’un texte antérieur peuvent alors être omises avec <gi>gap</gi>.
            Dans ce cas, cependant, le texte modifié qui est omis doit être référencé à l’aide de
            <att>source</att>. Un commentaire à ce sujet en <gi>back</gi> est nécessaire. Un
            <gi>lem</gi> vide peut également être utilisé si un mot ou une phrase a été omis et
            qu’il est attesté par un texte témoin.
        </p>
                  <p>
            Si une copie en double ou une copie comporte une omission significative, un
            <gi>rdg</gi> vide peut être défini pour celle-ci (voir exemple ci-dessous). Cependant,
            pour des lectures alternatives d’autres éditions ou de la littérature moderne, utilisez
            <gi>note</gi> avec <att>type</att> = <val>text_comparison</val>.
        </p>
                  <p>
            Si un morceau est à nouveau transcrit et que la nouvelle transcription diffère de celle
            précédemment éditée, la différence n’est généralement pas indiquée. Toutefois, si la
            nouvelle édition diffère sensiblement en termes de contenu ou de lecture, cela ne sera
            pas traité avec <gi>app</gi>, mais avec <gi>note</gi>. Les différences dans
            l’orthographe d’une autre version originale ou d’une copie ne doivent être notées que
            si elles fournissent des informations supplémentaires.
        </p>
                  <p>
            Si une partie d’un original n’est plus lisible en raison d’altérations, le texte perdu
            peut être complété avec l’aide d’une autre version. Pour cela, nous n’utilisons pas
            <gi>app</gi> et <gi>rdg</gi>, mais <gi>damage</gi> et <gi>supplied</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPEN">13.1.1. The Apparatus Entry</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textcrit"
                         xml:id="gi-lem"
                         ident="lem">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Lemma</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">lemma</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">lemme</gloss>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="de">Enthält eine Passage, von der es abweichende
    Textvarianten gibt.</desc>
               <desc rend="replace" versionDate="2023-07-24" xml:lang="en">Contains a passage of which there is a text
    variant that differs from the edition template.</desc>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="fr">Contient un passage pour lequel il existe
    différentes variantes de texte.</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <macroRef key="ssrq.content.default"/>
                     </sequence>
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-app-rdg-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparateintrag
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-en" xml:lang="en">
                  <p>
                Example of an apparatus entry
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-fr" xml:lang="fr">
                  <p>
                Exemple d’apparat critique
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Die abweichenden Textvarianten werden in <gi>rdg</gi> wiedergegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            The deviating text variant is rendered in <gi>rdg</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les variantes de texte déviantes sont indiquées dans <gi>rdg</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPLL">13.1. The Apparatus Entry, Readings, and Witnesses</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textcrit"
                         xml:id="gi-rdg"
                         ident="rdg">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Lesart</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">reading</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">leçon</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält eine vom edierten Text abweichende
    Textvariante.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Contains a text variant that differs from the
    edition template.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient une variante de texte différente du texte
    édité.</desc>
               <classes>
                  <memberOf key="att.witnessed"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-app-rdg-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparateintrag
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-en" xml:lang="en">
                  <p>
                Example of an apparatus entry
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-rdg-fr" xml:lang="fr">
                  <p>
                Exemple d’apparat critique
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>lxxxvii</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e#3"> quadringentesimo </rdg>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">lxxxiiii</rdg>
                     </app>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Mit dem Attribut <att>wit</att> wird auf den Textzeugen, auf dem die Lesart basiert,
            verwiesen. Bei Auslassungen kann ein leeres <gi>rdg</gi> verwendet werden. Verweise auf
            Teilabschnitte eines Textzeugen können über ein <val>#</val> angehängt werden.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            In <att>wit</att>, reference is made to the other textual witness on which the reading
            is based. An empty <gi>rdg</gi> can be used for omissions. References to subsections
            can be appended via a <val>#</val>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            L’attribut <att>wit</att> permet de faire référence au texte témoin sur lequel la
            lecture est basée. En cas d’omission, un <gi>rdg</gi> vide peut être utilisé. Les
            renvois à des sections partielles d’un témoin peuvent être ajoutés à l’aide d’un
            <val>#</val>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPLL">13.1. The Apparatus Entry, Readings, and Witnesses</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textcrit"
                         xml:id="gi-listWit"
                         ident="listWit">
               <gloss rend="replace" versionDate="2023-07-13" xml:lang="de">Textzeugenliste</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">list of text witnesses</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">liste des témoins</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Liste von
    Textträgerbeschreibungen.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Contains the piece descriptions of the
    sources.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une liste de descriptions de plusieurs
    témoins.</desc>
               <classes>
                  <memberOf key="model.listLike"/>
               </classes>
               <content>
                  <elementRef key="witness" maxOccurs="unbounded"/>
               </content>
               <exemplum xml:id="ex-listWit-de" xml:lang="de">
                  <p>
                Beispiel für eine Textzeugenliste
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listWit-en" xml:lang="en">
                  <p>
                Example of a text witness list
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listWit-fr" xml:lang="fr">
                  <p>
                Exemple de liste de témoins
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Für jeden Textträger wird ein eigenes <gi>witness</gi> erstellt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            A <gi>witness</gi> is created for each source.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Un <gi>witness</gi> distinct est créé pour chaque support de texte.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPLL">13.1. The Apparatus Entry, Readings, and Witnesses</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textcrit"
                         xml:id="gi-witness"
                         ident="witness">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Textzeuge</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">text witness</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">témoin</gloss>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="de">Enthält die Beschreibung eines Textzeugen.</desc>
               <desc rend="replace" versionDate="2023-08-23" xml:lang="en">Contains the piece description of a source
    (originals, copies, etc.).</desc>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="fr">Contient la description d’un témoin.</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <elementRef key="msDesc"/>
               </content>
               <attList>
                  <attDef ident="n" mode="replace" usage="req">
                     <desc versionDate="2025-02-04" xml:lang="de">die Nummerierung des Textzeugen</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the numbering of the text witness</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">la numérotation du témoin</desc>
                     <datatype>
                        <dataRef name="string" restriction="[A-Z][0-9]?"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="change" usage="req">
                     <datatype>
                        <dataRef key="ssrq.id"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-witness-de" xml:lang="de">
                  <p>
                Beispiel für mehrere Textzeugenbeschreibungen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-witness-en" xml:lang="en">
                  <p>
                Example of multiple text witness descriptions
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-witness-fr" xml:lang="fr">
                  <p>
                Exemple de plusieurs descriptions de témoins
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listWit>
                        <witness n="A" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="B" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810e">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                        <witness n="C" xml:id="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">
                           <msDesc>
                ...
            </msDesc>
                        </witness>
                     </listWit>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-14" xml:lang="de">
                  <p>
            Ein Textzeuge ist ein Dokument, das einen Text teilweise oder in seiner Gesamtheit
            überliefert und das als einer der Meilensteine bei der Überlieferung oder
            Transformation eines Textes angesehen wird.
        </p>
               </remarks>
               <remarks versionDate="2025-07-14" xml:lang="fr">
                  <p>
            Le témoin est un document qui transmet un texte, partiellement ou dans son intégralité,
            et qui est considéré comme l’un des jalons dans la transmission ou la transformation
            d’un texte.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPLL">13.1. The Apparatus Entry, Readings, and Witnesses</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-TEI"
                         ident="TEI">
               <gloss rend="replace" versionDate="2023-03-09" xml:lang="de">TEI Dokument</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">TEI document</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">document TEI</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält als sogenanntes Root-Element einen
    einzelnen edierten Text.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Contains a single document (piece) as a so-called
    root element.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient un seul texte édité en tant qu’élément
    dit « racine ».</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="teiHeader"/>
                     <elementRef key="text"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.de"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.fr"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.it"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="version" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-TEI-de" xml:lang="de">
                  <p>
                Minimalbeispiel für ein TEI-Dokument
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <TEI xml:lang="de">
                        <teiHeader>
            ...
        </teiHeader>
                        <text type="transcript">
            ...
        </text>
                     </TEI>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-TEI-en" xml:lang="en">
                  <p>
                Minimal example of a TEI document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <TEI xml:lang="de">
                        <teiHeader>
            ...
        </teiHeader>
                        <text type="transcript">
            ...
        </text>
                     </TEI>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-TEI-fr" xml:lang="fr">
                  <p>
                Exemple simplifié d’un document TEI
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <TEI xml:lang="de">
                        <teiHeader>
            ...
        </teiHeader>
                        <text type="transcript">
            ...
        </text>
                     </TEI>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Die Metadaten zum edierten Text werden im <gi>teiHeader</gi> erfasst, der edierte Text
            mit allen Kommentaren im darauffolgenden <gi>text</gi>-Element.
        </p>
                  <p>
            Mit dem Attribut <att>xml:lang</att> wird die Sprache der Bearbeitung angegeben.
        </p>
                  <p>
            Jedes Stück erhält ein eigenes TEI-XML-Dokument.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            The language of the processing is specified with <att>xml:lang</att>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Les métadonnées relatives au texte sont saisies dans le <gi>teiHeader</gi>, alors que
            le texte édité avec tous les commentaires dans l’élément <gi>text</gi> qui suit.
        </p>
                  <p>
            L’attribut <att>xml:lang</att> permet d’indiquer la langue de l’édition.
        </p>
                  <p>
            Chaque pièce dispose de son propre document XML TEI.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS">4. Default Text Structure</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCDEF">16.1. Varieties of Composite Text</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-text"
                         ident="text">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Text</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">text</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">texte</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält in <gi>body</gi> den vollständigen
    edierten Text und in <gi>back</gi> die zugehörige Kommentierung.</desc>
               <desc rend="replace" versionDate="2023-04-04" xml:lang="en">Includes all characters physically present on a
    source item or in a book (transcription / edition, i.e. primary data) as well as the commentary
    on the edited piece. </desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient le texte édité complet dans <gi>body</gi>
    et le commentaire associé dans <gi>back</gi>.</desc>
               <classes>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="body"/>
                     <elementRef key="back" minOccurs="0"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Textes</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of the text</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type du texte</desc>
                     <datatype>
                        <dataRef key="ssrq.type.text"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-text-1-de" xml:lang="de">
                  <p>
                Beispiel für ein Transkript mit optionalem Kommentarbereich
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="transcript">
                        <body>
                ...
            </body>
                        <back>
                ...
            </back>
                     </text>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-text-1-en" xml:lang="en">
                  <p>
                Example of a transcript with an optional comment section
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="transcript">
                        <body>
                ...
            </body>
                        <back>
                ...
            </back>
                     </text>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-text-1-fr" xml:lang="fr">
                  <p>
                Exemple de transcription avec une section de commentaires facultative
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="transcript">
                        <body>
                ...
            </body>
                        <back>
                ...
            </back>
                     </text>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-text-2-de" xml:lang="de">
                  <p>
                Beispiel für ein Regest ohne Kommentarbereich
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="summary">
                        <body>
                ...
            </body>
                     </text>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-text-2-en" xml:lang="en">
                  <p>
                Example of a regest without a comment section
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="summary">
                        <body>
                ...
            </body>
                     </text>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-text-2-fr" xml:lang="fr">
                  <p>
                Exemple de résumé sans section de commentaire
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <text type="summary">
                        <body>
                ...
            </body>
                     </text>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Im Normalfall, wenn in einem XML-Dokument genau ein Text ediert wird, wird im Attribut
            <att>type</att> der Wert <val>transcript</val> angegeben. Wird statt des Texts nur ein
            Regest desselben herausgegeben, steht hierfür der Wert <val>summary</val>. Handelt es
            sich um ein Mantelstück, d. h. eine Sammlung von Texten, die unter einer Stücknummer
            ediert werden, dann wird das mit <val>collection</val> ausgedrückt. In diesem Fall
            enthält der <gi>body</gi> keinen Editionstext, sondern lediglich die Verweise auf die
            einzelnen Texte der edierten Sammlung.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Dans le cas normal où un seul texte est édité dans un document XML, la valeur
            <val>transcript</val> est indiquée dans l’attribut <att>type</att>. Si, au lieu du
            texte, seul un résumé de celui-ci est édité, la valeur <val>summary</val> lui est
            attribuée. S’il s’agit d’une pièce maîtresse, c’est-à-dire d’une collection de textes
            édités sous un numéro de pièce, cela est exprimé par <val>collection</val>. Dans ce
            cas, le <gi>body</gi> ne contient pas l’édition du texte, mais uniquement les renvois
            aux différents textes de la collection éditée.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS">4. Default Text Structure</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCDEF">16.1. Varieties of Composite Text</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-body"
                         ident="body">
               <gloss rend="replace" versionDate="2023-07-14" xml:lang="de">Textbereich</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">text section</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">zone de texte</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält den transkribierten Text einschliesslich
    aller sonstigen Textblöcke.</desc>
               <desc rend="replace" versionDate="2023-04-06" xml:lang="en">Contains the transcribed source text as well as
    the contemporaneous dorsual notes in <gi>ab</gi>.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient le texte transcrit, y compris tous les
    autres blocs de texte.</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                        <elementRef key="ab" maxOccurs="unbounded" minOccurs="0"/>
                        <elementRef key="div" maxOccurs="unbounded"/>
                        <elementRef key="gap" maxOccurs="unbounded" minOccurs="0"/>
                        <elementRef key="pb" maxOccurs="unbounded" minOccurs="0"/>
                     </sequence>
                     <elementRef key="bibl" maxOccurs="unbounded" minOccurs="2"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-body" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-05-05" xml:lang="en">constraint for tei:body</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:body[parent::tei:text[@type = 'collection']]">
                           <sch:assert test="every $child in ./* satisfies $child/name() =                     'bibl'"> It's only allowed to use tei:bibl-elements directly
                    inside tei:body, when tei:body is part of tei:text with
                    type="collection". </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:body[parent::tei:text[not(@type =                 'collection')]]">
                           <sch:report test=".[tei:bibl]"> It's only allowed to use tei:bibl-elements
                    directly inside tei:body, when tei:body is part of tei:text with
                    type="collection". </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-body-de" xml:lang="de">
                  <p>
                Beispiel für einen Textbereich mit allen möglichen Kindelementen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <body>
                        <div>
                           <p>
                              <lb/>...
                <lb/>...
            </p>
                        </div>
                        <gap/>
                        <pb/>
                        <ab place="plica" type="sigillant">
            ...
        </ab>
                        <ab place="verso" type="dorsal">
            ...
        </ab>
                     </body>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-body-en" xml:lang="en">
                  <p>
                Example of a text area with all possible child elements
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <body>
                        <div>
                           <p>
                              <lb/>...
                <lb/>...
            </p>
                        </div>
                        <gap/>
                        <pb/>
                        <ab place="plica" type="sigillant">
            ...
        </ab>
                        <ab place="verso" type="dorsal">
            ...
        </ab>
                     </body>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-body-fr" xml:lang="fr">
                  <p>
                Exemple d’une zone de texte avec tous les éléments enfants possibles
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <body>
                        <div>
                           <p>
                              <lb/>...
                <lb/>...
            </p>
                        </div>
                        <gap/>
                        <pb/>
                        <ab place="plica" type="sigillant">
            ...
        </ab>
                        <ab place="verso" type="dorsal">
            ...
        </ab>
                     </body>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS">4. Default Text Structure</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-div"
                         ident="div">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Abschnitt</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">division</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">division</gloss>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="de">Gliedert innerhalb von <gi>body</gi> den
    transkribierten Text und innerhalb von <gi>back</gi> die Kommentare in Abschnitte.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="en">Sections source text within <gi>body</gi> or
    comments within <gi>back</gi> together with <gi>p</gi>.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="fr">Cet élément peut structurer en sections aussi bien
    le texte transcrit à l’intérieur de <gi>body</gi> que les commentaires dans
    <gi>back</gi>.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                        <elementRef key="head" maxOccurs="1" minOccurs="0"/>
                        <elementRef key="div" maxOccurs="unbounded" minOccurs="2"/>
                        <alternate minOccurs="0" maxOccurs="unbounded">
                           <elementRef key="cb"/>
                           <elementRef key="pb"/>
                           <elementRef key="ssrq.content.anchor.spans"/>
                        </alternate>
                     </sequence>
                     <alternate minOccurs="1" maxOccurs="unbounded">
                        <elementRef key="list"/>
                        <elementRef key="seg"/>
                        <elementRef key="p"/>
                        <macroRef key="ssrq.content.default"/>
                     </alternate>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-div-text"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2024-08-06" xml:lang="en">constraint for the usage of text inside
        tei:div</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:div">
                           <sch:assert test="string-length(normalize-space(string-join(text(),                     ''))) = 0"> Text is not allowed in tei:div. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-div-head"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-05-05" xml:lang="en">constraint for the combined usage of tei:head
        and tei:div</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:div[tei:head][tei:div]">
                           <sch:report test="tei:head[preceding-sibling::tei:div]"> If a tei:head is used
                    inside tei:div it must always precede all tei:div-elements. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-div-xml-lang"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2024-08-06" xml:lang="en">constraint for the usage of @xml:lang in
        tei:div</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:div[@xml:lang]">
                           <sch:let name="divs-in-back" value="count(./parent::tei:back/tei:div)"/>
                           <sch:assert test=".[parent::tei:back]"> The attribute @xml:lang for tei:div is
                    allowed only in tei:back. </sch:assert>
                           <sch:assert test="$divs-in-back gt 1"> If @xml:lang is specified for tei:div,
                    there must be at least two tei:divs. </sch:assert>
                           <sch:report test="./parent::tei:back/tei:div[not(@xml:lang)]"> If @xml:lang is
                    specified for tei:div, all sibling tei:divs must have this attribute.
                    </sch:report>
                           <sch:assert test="count(distinct-values(./parent::tei:back/tei:div/@xml:lang))                     = $divs-in-back"> If @xml:lang is specified for tei:div, at least another
                    tei:div with another language has to be specified </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-div-n"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-12-17" xml:lang="en">constraint for the usage of @n in
        tei:div</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:div[@n][parent::tei:back]">
                           <sch:let name="divs-in-back" value="count(./parent::tei:back/tei:div)"/>
                           <sch:assert test="$divs-in-back gt 1">If @n is specified for tei:div, there
                    must be at least two tei:divs.</sch:assert>
                           <sch:report test="./parent::tei:back/tei:div[not(@n)]">If @n is specified for
                    tei:div, all sibling tei:divs must have this attribute. </sch:report>
                           <sch:assert test="count(distinct-values(./parent::tei:back/tei:div/@n))                     = $divs-in-back"> If @n is specified for tei:div, each must have a unique
                    value.</sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="abstractModel-structure-div-in-l"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:l//tei:div">
                        <sch:assert test="ancestor::tei:floatingText">
          Abstract model violation: Metrical lines may not contain higher-level structural elements such as div, unless div is a descendant of floatingText.
        </sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="abstractModel-structure-div-in-ab-or-p"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:div">
                        <sch:report test="(ancestor::tei:p or ancestor::tei:ab) and not(ancestor::tei:floatingText)">
          Abstract model violation: p and ab may not contain higher-level structural elements such as div, unless div is a descendant of floatingText.
        </sch:report>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="change">
                     <desc versionDate="2025-01-31" xml:lang="de">die Nummerierung des Abschnitts</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the numbering of the division</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">la numérotation de la division</desc>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-01-31" xml:lang="de">die Art des Abschnitts</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the type of the division</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le type de la division</desc>
                     <datatype>
                        <dataRef key="ssrq.type.div"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-div-back-de" xml:lang="de">
                  <p>
                Beispiel für nummerierte Abschnitte innerhalb von
                <gi>
                    back
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <back>
                        <div n="1">
                           <p>
                Zum Verkauf der Burg <placeName ref="loc007559.01">Wildenburg</placeName> sowie zu den nachfolgenden Verkäufen an die Grafen <orgName ref="org000144">von Toggenburg</orgName> vgl. den Kommentar zum edierten Stück <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CH-StiASG/Urkunden/CC.2.B.1/charter">Bd. 5, Nr. 2839 </ref>
                              </bibl> sowie <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000118351">Gabathuler 2009c</ref>, S. 235–239 </bibl> .
            </p>
                        </div>
                        <div n="2">
                           <p>
                Zum Verkauf von Boden durch die Hohensaxer an die <orgName ref="org000425">Appenzeller </orgName> in der <placeName ref="loc007565">Saxerlücke</placeName>, der einzigen direkten Verbindung zwischen der Freiherrschaft Sax-Hohensax und Appenzell, zum Bau einer
                Letzi am <date calendar="julian" when-custom="1346-01-20">20. Januar 1346</date> (vgl. <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000080293">Deplazes-Haefliger 1976</ref>, S. 10 </bibl> , gedruckt in <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CSGVI/1346_I_20.1/charter">Bd. 6, Nr.
                3966 </ref>
                              </bibl> ).
            </p>
                        </div>
                     </back>
                  </egXML>
               </exemplum>
