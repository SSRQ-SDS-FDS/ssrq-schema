         <schemaSpec xmlns:teix="http://www.tei-c.org/ns/Examples"
                     docLang="de en fr"
                     ident="ssrq-main-schema"
                     defaultExceptions="http://www.tei-c.org/ns/1.0 teix:egXML"
                     source="https://www.tei-c.org/Vault/P5/4.9.0/xml/tei/odd/p5subset.xml">
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-breaking"
                       ident="att.breaking">
               <desc versionDate="2021-08-22" xml:lang="en">provides attributes to indicate whether or not the element
  concerned is considered to  mark the end of an orthographic token in the same way
  as whitespace.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">fournit un attribut pour indiquer si un élément est
consideré ou pas comme marquant la fin d'un mot orthographique, comme
le fait une espace.</desc>
               <classes/>
               <attList>
                  <attDef ident="break" mode="replace">
                     <desc versionDate="2025-02-06" xml:lang="de">Zeilenumbruch ausserhalb eines
                    Wortes<pc>?</pc>
                     </desc>
                     <desc versionDate="2025-02-06" xml:lang="en">line break after a
                    word<pc>?</pc>
                     </desc>
                     <desc versionDate="2025-02-06" xml:lang="fr">saut de ligne après un
                    mot<pc>?</pc>
                     </desc>
                     <valList type="closed">
                        <valItem ident="no">
                           <desc versionDate="2025-02-04" xml:lang="de">nein</desc>
                           <desc versionDate="2025-02-04" xml:lang="en">no</desc>
                           <desc versionDate="2025-02-04" xml:lang="fr">non</desc>
                        </valItem>
                     </valList>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CORS5">3.11.3. Milestone
Elements</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-canonical"
                       ident="att.canonical">
               <desc versionDate="2008-09-05" xml:lang="en">provides attributes that can be used to associate a representation such as a name or title
    with canonical information about the object being named or referenced.</desc>
               <desc versionDate="2009-05-25" xml:lang="fr">fournit des attributs qui peuvent être utilisés pour
    associer une représentation telle qu'un nom ou un titre à l'information canonique concernant
    l'objet nommé ou auquel il est fait référence.</desc>
               <classes/>
               <attList>
                  <attDef ident="ref" mode="replace">
                     <desc versionDate="2025-01-31" xml:lang="de">die Verknüpfung mit dem
                    entsprechenden Datenbankeintrag der SSRQ</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the link to the corresponding
                    database entry of the SLS</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le lien vers l’entrée de la base
                    de données correspondante des SDS</desc>
                     <datatype>
                        <dataRef key="ssrq.pointer.databases"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDATTSnr">14.1.1. Linking Names and Their Referents</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       predeclare="true"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-global.rendition"
                       ident="att.global.rendition">
               <desc versionDate="2014-12-02" xml:lang="en">provides rendering attributes common to all elements in the TEI encoding scheme.</desc>
               <classes/>
               <attList>
                  <attDef ident="rend" usage="opt">
                     <gloss versionDate="2007-07-02" xml:lang="en">rendition</gloss>
                     <gloss versionDate="2008-03-30" xml:lang="fr">interprétation</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">resa</gloss>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">das Aussehen des Elements im
                    Original</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the rendition of the element in
                    the original</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">l’apparition de l’élément dans
                    l’original</desc>
                     <datatype maxOccurs="unbounded">
                        <dataRef key="teidata.word"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STGAre">1.3.1.1.3. Rendition Indicators</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       predeclare="true"
                       type="atts"
                       xml:id="class-attr-global.responsibility"
                       ident="att.global.responsibility">
               <desc versionDate="2014-12-10" xml:lang="en">provides attributes indicating the agent
    responsible for some aspect of the text, the markup or 
    something asserted by the markup, and the degree of certainty 
    associated with it.</desc>
               <classes/>
               <attList>
                  <attDef ident="cert" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">der Grad der Sicherheit</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the degree of certainty</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le degré de certitude</desc>
                     <valList type="closed">
                        <valItem ident="high">
                           <desc versionDate="2023-04-11" xml:lang="de">hoch</desc>
                           <desc versionDate="2023-04-11" xml:lang="en">high</desc>
                           <desc versionDate="2023-04-11" xml:lang="fr">élevé</desc>
                           <desc versionDate="2023-04-28" xml:lang="it">alto</desc>
                        </valItem>
                        <valItem ident="medium">
                           <desc versionDate="2023-04-11" xml:lang="de">mittel</desc>
                           <desc versionDate="2023-04-11" xml:lang="en">medium</desc>
                           <desc versionDate="2023-04-11" xml:lang="fr">moyen</desc>
                           <desc versionDate="2023-04-28" xml:lang="it">medio</desc>
                        </valItem>
                        <valItem ident="low">
                           <desc versionDate="2023-04-11" xml:lang="de">niedrig</desc>
                           <desc versionDate="2022-05-06" xml:lang="en">low</desc>
                           <desc versionDate="2023-04-11" xml:lang="fr">faible</desc>
                           <desc versionDate="2023-04-28" xml:lang="it">basso</desc>
                        </valItem>
                     </valList>
                  </attDef>
                  <attDef ident="resp" usage="opt">
                     <gloss versionDate="2009-11-02" xml:lang="en">responsible party</gloss>
                     <gloss versionDate="2008-03-30" xml:lang="fr">responsable</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">responsabile</gloss>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">das Kürzel der bzw. des
                    Bearbeitenden</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the abbreviation of the
                    editor</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">l’abréviation de l’éditeur</desc>
                     <datatype>
                        <rng:list>
                           <rng:oneOrMore>
                              <rng:data type="string">
                                 <rng:param name="pattern">[A-Z]{2,3}</rng:param>
                              </rng:data>
                           </rng:oneOrMore>
                        </rng:list>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STGAso">1.3.1.1.4. Sources, certainty, and responsibility</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COED">3.5. Simple Editorial Changes</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHHR">12.3.2.2. Hand, Responsibility, and Certainty Attributes</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/AI.html#AISP">18.3. Spans and Interpretations</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDATTSnr">14.1.1. Linking Names and Their Referents</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       predeclare="true"
                       xml:id="GBLSRC"
                       module="tei"
                       type="atts"
                       ident="att.global.source">
               <desc versionDate="2021-08-22" xml:lang="en">provides attributes used by elements to point to an external source.</desc>
               <classes/>
               <constraintSpec scheme="schematron" ident="only_1_ODD_source" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:*[@source]">
                        <sch:let name="srcs" value="tokenize( normalize-space(@source),' ')"/>
                        <sch:report test="(   self::tei:classRef                                 | self::tei:dataRef                                 | self::tei:elementRef                                 | self::tei:macroRef                                 | self::tei:moduleRef                                 | self::tei:schemaSpec )                                   and                                   $srcs[2]">
              When used on a schema description element (like
              <sch:value-of select="name(.)"/>), the @source attribute
              should have only 1 value. (This one has <sch:value-of select="count($srcs)"/>.)
            </sch:report>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="source" usage="opt">
                     <desc rend="replace" versionDate="2023-02-03" xml:lang="de">eine externe Quelle</desc>
                     <desc rend="replace" versionDate="2023-02-03" xml:lang="en">an external source</desc>
                     <desc rend="replace" versionDate="2023-02-03" xml:lang="fr">une source externe</desc>
                     <datatype maxOccurs="unbounded">
                        <dataRef key="teidata.pointer"/>
                     </datatype>
                     <constraintSpec scheme="schematron" ident="only_1_ODD_source" xml:lang="en">
                        <constraint>
                           <sch:rule context="tei:*[@source]">
                              <sch:let name="srcs" value="tokenize( normalize-space(@source),' ')"/>
                              <sch:report test="(   self::tei:classRef                                 | self::tei:dataRef                                 | self::tei:elementRef                                 | self::tei:macroRef                                 | self::tei:moduleRef                                 | self::tei:schemaSpec )                                   and                                   $srcs[2]">
              When used on a schema description element (like
              <sch:value-of select="name(.)"/>), the @source attribute
              should have only 1 value. (This one has <sch:value-of select="count($srcs)"/>.)
            </sch:report>
                           </sch:rule>
                        </constraint>
                     </constraintSpec>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STGAso">1.3.1.1.4. Sources, certainty, and responsibility</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQQ">3.3.3. Quotation</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TS.html#TSBAWR">8.3.4. Writing</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-internetMedia"
                       ident="att.internetMedia">
               <desc versionDate="2007-10-18" xml:lang="en">provides attributes for specifying the type of a computer
  resource using a standard taxonomy.</desc>
               <desc versionDate="2009-05-27" xml:lang="fr">fournit des attributs pour spécifier le type de
ressource informatique selon une taxinomie normalisée.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">indica degli attributi che specificano il tipo di risorsa informatica utilizzando una tassonomia standard</desc>
               <classes/>
               <attList>
                  <attDef ident="mimeType" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">der Dateityp der mit
                    <att>url</att> verknüpften Datei</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the file type of the file linked
                    with <att>url</att>
                     </desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de fichier du fichier lié
                    avec <att>url</att>
                     </desc>
                     <valList type="closed">
                        <valItem ident="image/jpg"/>
                        <valItem ident="image/png"/>
                        <valItem ident="image/svg"/>
                     </valList>
                  </attDef>
               </attList>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       ident="att.measurement"
                       mode="replace"
                       type="atts">
               <attList>
                  <attDef ident="commodity" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">die gemessene Substanz</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the measured substance</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la substance mesurée</desc>
                     <datatype>
                        <dataRef key="ssrq.measure.att.commodity"/>
                     </datatype>
                  </attDef>
                  <attDef ident="origin" mode="add" module="ssrq.core.module">
                     <desc versionDate="2025-01-28" xml:lang="de">die Herkunft der
                    Masseinheit</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the origin of the unit of
                    measurement</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">l’origine de l’unité de
                    mesure</desc>
                     <datatype>
                        <dataRef key="ssrq.measure.att.origin"/>
                     </datatype>
                  </attDef>
                  <attDef ident="quantity" mode="replace" usage="req">
                     <desc versionDate="2025-01-28" xml:lang="de">die Grösse oder Menge der mit
                    <att>unit</att> angegebenen Masseinheit oder Währung</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the size or amount of the unit of
                    measurement or currency specified with <att>unit</att>
                     </desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la taille ou la quantité de
                    l’unité de mesure ou de devise indiquée avec <att>unit</att>
                     </desc>
                     <datatype>
                        <choice xmlns="http://relaxng.org/ns/structure/1.0">
                           <ref name="teidata.numeric"/>
                           <ref name="ssrq.dimensions.unknown"/>
                        </choice>
                     </datatype>
                  </attDef>
                  <attDef ident="unit" mode="replace" usage="req">
                     <desc versionDate="2025-01-28" xml:lang="de">die Masseinheit oder
                    Währung</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the unit of measurement or
                    currency</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">l’unité de mesure ou devise</desc>
                     <datatype>
                        <choice xmlns="http://relaxng.org/ns/structure/1.0">
                           <ref name="ssrq.measure.area"/>
                           <ref name="ssrq.measure.capacity"/>
                           <ref name="ssrq.measure.currency"/>
                           <ref name="ssrq.measure.length"/>
                           <ref name="ssrq.measure.lengths.base.cm"/>
                           <ref name="ssrq.measure.parts.stuck"/>
                           <ref name="ssrq.measure.parts.vierling"/>
                           <ref name="ssrq.measure.time"/>
                           <ref name="ssrq.measure.various"/>
                           <ref name="ssrq.measure.weight"/>
                        </choice>
                     </datatype>
                  </attDef>
                  <attDef ident="unitRef" mode="delete"/>
               </attList>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-placement"
                       ident="att.placement">
               <desc versionDate="2006-06-08" xml:lang="en">provides attributes for describing where on the source page or
  object a textual element appears.</desc>
               <desc versionDate="2009-05-28" xml:lang="fr">fournit des attributs pour décrire l'emplacement où apparaît un élément textuel dans la page ou l'objet source.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">identifica degli attributi
  che descrivono la collocazione di un elemento testuale all'interno
  della pagina o dell'oggetto di origine</desc>
               <classes/>
               <attList>
                  <attDef ident="place" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">eine Stelle auf einem
                    Textzeugen</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">a position on a text
                    witness</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">une position sur un témoin de
                    texte</desc>
                     <datatype maxOccurs="unbounded">
                        <dataRef key="ssrq.place"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD">3.5.3. Additions, Deletions, and Omissions</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHAD">12.3.1.4. Additions and Deletions</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-pointing"
                       ident="att.pointing">
               <desc versionDate="2016-01-15" xml:lang="en">provides a set of attributes used by all elements which point
  to other elements by means of one or more URI references.</desc>
               <desc versionDate="2016-02-15" xml:lang="fr">fournit un ensemble d'attributs utilisés par tous les éléments qui pointent vers d'autres éléments au moyen d'une ou de plusieurs références URI.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">definisce un insieme di attributi usati da tutti gli elementi che puntano ad altri elementi tramite uno o più URI</desc>
               <classes/>
               <constraintSpec ident="targetLang" scheme="schematron" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:*[not(self::tei:schemaSpec)][@targetLang]">
                        <sch:assert test="@target">@targetLang should only be used on <sch:name/> if @target is specified.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="target" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">ein Hyperlink, DOI oder interner
                    Verweis</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">a Hyperlink, DOI or an internal
                    reference</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">un lien hypertexte, DOI ou une
                    référence interne</desc>
                     <datatype>
                        <dataRef key="ssrq.pointer.target"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STGAla">1.3.1.1.2. Language Indicators</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COXR">3.7. Simple Links and Cross-References</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       ident="att.resourced">
               <desc versionDate="2013-01-11" xml:lang="en">provides attributes by which a resource (such as an externally
  held media file) may be located.</desc>
               <classes/>
               <attList>
                  <attDef ident="url" usage="req">
                     <gloss versionDate="2013-01-11" xml:lang="en">uniform resource locator</gloss>
                     <gloss versionDate="2008-03-30" xml:lang="fr">adresse URL</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">URL (localizzatore universale di risorse)</gloss>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">die Verknüpfung mit einer
                    Bilddatei</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the link to an image file</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">le lien vers un fichier
                    image</desc>
                     <datatype>
                        <dataRef key="teidata.pointer"/>
                     </datatype>
                  </attDef>
               </attList>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-scoping"
                       ident="att.scoping">
               <desc versionDate="2016-03-15" xml:lang="en">provides attributes for selecting particular elements
    within a document.</desc>
               <classes/>
               <attList>
                  <attDef ident="match" usage="req">
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">der Verweis auf ein oder mehrere
                    unsichere Attribute</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the reference to one or more
                    uncertain attributes</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">la référence à un ou plusieurs
                    attributs incertains</desc>
                     <datatype>
                        <rng:list>
                           <rng:oneOrMore>
                              <rng:data type="string">
                                 <rng:param name="pattern">@[a-zAB]{2,9}-custom|dur-iso|period|calendar</rng:param>
                              </rng:data>
                           </rng:oneOrMore>
                        </rng:list>
                     </datatype>
                  </attDef>
               </attList>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       ident="att.spanning">
               <desc versionDate="2006-01-05" xml:lang="en">provides attributes for elements which delimit a span of text by pointing mechanisms rather than by enclosing it.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">fournit des attributs pour les éléments qui délimitent un passage de texte par des mécanismes de pointage plutôt qu'en entourant le passage.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">assegna degli attributi agli elementi che delimitano una porzione di testo utilizzando dei puntatori invece di racchiudere il testo stesso</desc>
               <classes/>
               <attList>
                  <attDef ident="spanTo" usage="req">
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">der Verweis auf die
                    <att>xml:id</att> eines <gi>anchor</gi>-Elements</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the reference to the
                    <att>xml:id</att> of an <gi>anchor</gi> element</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">la référence à la
                    <att>xml:id</att> d’un élément <gi>anchor</gi>
                     </desc>
                     <datatype>
                        <dataRef name="IDREF"/>
                     </datatype>
                     <constraintSpec ident="spanTo-points-to-following"
                                     mode="delete"
                                     scheme="schematron"
                                     xml:lang="en"/>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHAD">12.3.1.4. Additions and Deletions</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STECAT">1.3.1. Attribute Classes</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       xml:id="TYPED"
                       type="atts"
                       ident="att.typed"
                       predeclare="true">
               <desc versionDate="2007-10-02" xml:lang="en">provides attributes that can be used to classify or subclassify elements in any way.</desc>
               <desc versionDate="2009-05-29" xml:lang="fr">fournit des attributs qui peuvent être
      utilisés pour classer ou interclasser des éléments de n'importe quelle façon.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">assegna degli attributi generici utilizzabili per qualsiasi classificazione e sottoclassificazione di elementi</desc>
               <classes/>
               <constraintSpec scheme="schematron" ident="subtypeTyped" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:*[@subtype]">
                        <sch:assert test="@type">The <sch:name/> element should not be categorized in detail with @subtype unless also categorized in general with @type</sch:assert>
                     </sch:rule>
                  </constraint>
