                        <desc versionDate="2022-09-05" xml:lang="it">sul verso superiore a
                        destra</desc>
                     </valItem>
                     <valItem ident="verso_bottom">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite unten</desc>
                        <desc versionDate="2022-05-10" xml:lang="en">at the bottom of the
                        verso</desc>
                        <desc versionDate="2022-05-10" xml:lang="fr">au verso en bas</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">sul verso inferiore</desc>
                     </valItem>
                     <valItem ident="verso_bottom_left">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite unten
