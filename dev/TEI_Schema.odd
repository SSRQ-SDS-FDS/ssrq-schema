            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <objectDesc>
                        <supportDesc>
            ...
        </supportDesc>
                     </objectDesc>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msph1">11.7.1. Object Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="msdescription"
                         xml:id="SUPPORTDESC"
                         ident="supportDesc">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Beschreibung des Materials des
    Textträgers</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">support description</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">description du support</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält Elemente zur Beschreibung von Material,
    Massen, Blattzählung und Erhaltungszustand eines Textträgers.</desc>
               <desc rend="replace" versionDate="2023-05-17" xml:lang="en">Contains elements to describe a source’s material,
    masses, foliation and conservation status.</desc>
               <desc rend="replace" versionDate="2023-08-23" xml:lang="fr">Contient des éléments décrivant le matériau, les
    dimensions, la foliation et l’état de conservation d’un support de texte.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="support"/>
                     <elementRef key="extent" minOccurs="0"/>
                     <elementRef key="foliation" minOccurs="0"/>
                     <elementRef key="condition" minOccurs="0"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="material" mode="delete"/>
               </attList>
