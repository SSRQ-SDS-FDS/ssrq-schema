               <desc versionDate="2005-11-17" xml:lang="en">groups elements used to directly contain quotations.</desc>
               <desc versionDate="2009-05-28" xml:lang="fr">regroupe des éléments employés pour contenir directement des citations.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa elementi che contengono direttamente le
    citazioni</desc>
               <classes>
                  <memberOf key="model.attributable"/>
               </classes>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="HQINTER"
                       type="model"
                       ident="model.attributable">
               <desc versionDate="2020-08-05" xml:lang="en">groups elements that contain a word or phrase that can be attributed to a source.</desc>
               <desc versionDate="2020-08-14" xml:lang="de">gruppiert Elemente, die ein Wort oder eine Phrase enthalten, welche einer Quelle zugeschrieben werden können.</desc>
               <classes>
                  <memberOf key="model.inter"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQQ">3.3.3. Quotation</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSFLT">4.3.2. Floating Texts</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       type="model"
                       ident="model.addressLike">
               <desc versionDate="2007-10-02" xml:lang="en">groups elements used to represent a postal or email address.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">regroupe des éléments employés pour représenter des
    adresses postales ou électroniques.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">raggruppa elementi utilizzati per rappresentare un
    indirizzo postale o di posta elettronica</desc>
               <classes>
                  <memberOf key="model.pPart.data"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#ST">1. The TEI Infrastructure</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="NAMING"
                       type="model"
                       ident="model.nameLike">
               <desc versionDate="2007-10-18" xml:lang="en">groups elements which name or refer to a person, place, or organization.</desc>
               <desc versionDate="2009-05-27" xml:lang="fr">regroupe des éléments qui nomment  une
    personne, un lieu ou une organisation, ou qui y font référence à.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa gli elementi che nominano o indicano una
    persona, un luogo (costruito dall'uomo o geografico), o un'organizzazione</desc>
               <classes>
                  <memberOf key="model.pPart.data"/>
               </classes>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="GLOBINCL"
                       type="model"
                       ident="model.global">
               <desc versionDate="2007-10-03" xml:lang="en">groups elements which may appear at any point within a TEI text.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">regroupe des éléments qui peuvent apparaître à un point
    quelconque dans un texte TEI.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa elementi vuoti che possono apparire in
    qualsiasi punto di un testo TEI</desc>
               <classes>
                  <memberOf key="model.paraPart"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STEC">1.3. The TEI Class System</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="DATA"
                       type="model"
                       ident="model.pPart.data">
               <desc versionDate="2005-10-10" xml:lang="en">groups phrase-level elements containing names, dates, numbers, measures, and similar data.</desc>
               <desc versionDate="2009-05-27" xml:lang="fr">regroupe des éléments de niveau expression contenant
    des noms, des dates, des nombres, des mesures et d'autres données semblables.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa elementi a livello sintagmatico che contengono
    nomi, date, numeri, misurazioni, e dati simili</desc>
               <classes>
                  <memberOf key="model.limitedPhrase"/>
                  <memberOf key="model.phrase"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONA">3.6. Names, Numbers, Dates, Abbreviations, and Addresses</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="INTER"
                       type="model"
                       ident="model.inter">
               <desc versionDate="2007-10-03" xml:lang="en">groups elements which can appear either within or between paragraph-like elements.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">regroupe des éléments qui peuvent apparaître à l’intérieur ou entre des composants semblables au paragraphe.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa elementi della classe intermedia
    (interlivello): tali elementi possono apparire sia all'interno che tra paragrafi e altri
    elementi del tipo porzione di testo</desc>
               <classes>
                  <memberOf key="model.paraPart"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STEC">1.3. The TEI Class System</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="PHRASE"
                       type="model"
                       ident="model.phrase">
               <desc versionDate="2007-10-03" xml:lang="en">groups elements which can occur at the level of individual words or phrases.</desc>
               <desc versionDate="2009-10-06" xml:lang="fr">regroupe des éléments qui apparaissent au niveau des
    mots isolés ou des groupes de mots.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">raggruppa gli elementi che appaiono a livello di singole
    parole o sintagmi</desc>
               <classes>
                  <memberOf key="model.paraPart"/>
               </classes>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STEC">1.3. The TEI Class System</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       xml:id="paraPart"
                       type="model"
                       ident="model.paraPart">
               <desc versionDate="2022-05-21" xml:lang="en">groups elements that may appear in paragraphs and similar elements.</desc>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COPA">3.1. Paragraphs</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       module="tei"
                       type="model"
                       ident="model.limitedPhrase">
               <desc versionDate="2008-02-23" xml:lang="en">groups phrase-level elements excluding those elements primarily intended for transcription
    of existing sources.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">regroupe des éléments du niveau de l'expression excluant ceux
    qui sont principalement destinés à la transcription des sources existantes.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">raggruppa elementi a livello di sintagma ad eccezione
    degli elementi intesi principalmente per la trascrizione di fonti esistenti</desc>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ST.html#STEC">1.3. The TEI Class System</ref>
               </listRef>
            </classSpec>
            <dataSpec module="tei" ident="teidata.certainty">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-10-18"
                     xml:lang="en">defines the range of attribute values expressing a degree of certainty.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme des valeurs d'attribut exprimant un degré de certitude.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi che esprimono un grado di certezza</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <valList type="closed">
                     <valItem ident="high"/>
                     <valItem ident="medium"/>
                     <valItem ident="low"/>
                     <valItem ident="unknown"/>
                  </valList>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.probability">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-10-18"
                     xml:lang="en">defines the range of attribute values expressing a probability.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme des valeurs d'attributs exprimant une
    probabilité.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi che esprimono
    una probabilità</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef name="double">
                     <dataFacet name="minInclusive" value="0"/>
                     <dataFacet name="maxInclusive" value="1"/>
                  </dataRef>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.numeric">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-10-18"
                     xml:lang="en">defines the range of attribute values used for numeric values.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme des valeurs d'attributs utilisées pour
    des valeurs numériques.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi usati per
    valori numerici</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <alternate>
                     <dataRef name="double"/>
                     <dataRef name="token" restriction="(\-?[\d]+/\-?[\d]+)"/>
                     <dataRef name="decimal"/>
                  </alternate>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.pointer">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2013-01-19"
                     xml:lang="en">defines the range of attribute values used to provide a single
  URI, absolute or relative, pointing to some other
resource, either within the current document or elsewhere.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2009-05-29"
                     xml:lang="fr">définit la gamme des valeurs d'attributs utilisées
      pour fournir un pointeur URI unique sur une autre ressource, soit dans le document courant, soit
      dans un autre document.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi usati per indicare un unico puntatore rispetto a qualsiasi altra risorsa all'interno del documento corrente o altrove</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef restriction="\S+" name="anyURI"/>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.word">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-10-22"
                     xml:lang="en">defines the range of attribute values expressed as a single
  word or token.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme des
  valeurs d'attributs exprimant un seul mot ou signe.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi espressi come singola parola o singolo token</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef name="token" restriction="[^\p{C}\p{Z}]+"/>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.text">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2012-06-17"
                     xml:lang="en">defines the range of attribute values used to express some
  kind of identifying string as a single sequence
  of Unicode characters possibly including whitespace.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme des valeurs d'attributs 
      exprimant une chaine de caracteres Unicode, y compris des
  espaces blancs.</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef name="string"/>
               </content>
            </dataSpec>
            <dataSpec module="tei" ident="teidata.enumerated">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-10-22"
                     xml:lang="en">defines the range of attribute values expressed as a single XML name taken from a list of
    documented possibilities.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme de
  valeurs des attributs exprimant un nom XML
    extrait d'une liste de possibilités documentées.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-01-21"
                     xml:lang="it">definisce la gamma di valori di attributi espressi come
    singola parola o token tratto da una lista di possibilità attestate</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef key="teidata.word"/>
               </content>
            </dataSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="CALENDARSYSTEM"
                       ident="att.calendarSystem">
               <desc versionDate="2023-05-09" xml:lang="en">provides attributes for indicating calendar systems to which a date belongs.</desc>
               <desc versionDate="2023-05-09" xml:lang="it">assegna attributi per indicare i sistemi o calendari ai quali appartiene una data.</desc>
               <classes/>
               <attList>
                  <attDef ident="calendar" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">der verwendete Kalender</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the calendar used</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le calendrier utilisé</desc>
                     <datatype>
                        <dataRef key="ssrq.date.calendar"/>
                     </datatype>
                     <constraintSpec ident="calendar_attr_on_empty_element"
                                     mode="delete"
                                     scheme="schematron"
                                     xml:lang="en"/>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA">3.6.4. Dates and Times</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE">14.4. Dates</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       predeclare="true"
                       type="atts"
                       ident="att.duration.iso">
               <desc versionDate="2012-12-26" xml:lang="en">provides attributes for recording normalized temporal durations.</desc>
               <desc versionDate="2008-12-09" xml:lang="fr">attributs pour l'enregistrement de durées temporelles normalisées.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">attributi per registrare durate temporali normalizzate</desc>
               <classes/>
               <attList>
                  <attDef ident="dur-iso" usage="opt">
                     <gloss versionDate="2007-04-09" xml:lang="en">duration</gloss>
                     <gloss versionDate="2008-12-09" xml:lang="fr">durée</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">durata</gloss>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="de">die Zeitspanne gemäss ISO
                    8601</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="en">the period of time according to
                    ISO 8601</desc>
                     <desc rend="replace" versionDate="2025-01-28" xml:lang="fr">la période temporelle selon ISO
                    8601</desc>
                     <datatype>
                        <dataRef key="teidata.duration.iso"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA">3.6.4. Dates and Times</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE">14.4. Dates</ref>
               </listRef>
            </classSpec>
            <dataSpec module="tei"
                      xml:id="data-duration.iso"
                      ident="teidata.duration.iso">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-04-09"
                     xml:lang="en">defines the range of attribute values available for representation of a duration in time
    using ISO 8601 standard formats.</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                     versionDate="2007-06-12"
                     xml:lang="fr">définit la gamme de valeurs d'attributs exprimant une durée temporaraire utilisant le norme ISO 8601.</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0"
                        xmlns:sch="http://purl.oclc.org/dsdl/schematron">
                  <dataRef name="token" restriction="[0-9.,DHMPRSTWYZ/:+\-]+"/>
               </content>
            </dataSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-p"
                         ident="p">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Absatz</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">paragraph</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">paragraphe</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält einen Absatz.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Describes a paragraph.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un paragraphe.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.pLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="unbounded">
                        <elementRef key="bibl"/>
                        <elementRef key="list"/>
                        <elementRef key="ref"/>
                        <macroRef key="ssrq.content.default"/>
                     </alternate>
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-p" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-05-22" xml:lang="en">constraint for tei:p</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:p[@xml:lang][following-sibling::tei:p|preceding-sibling::tei:p]">
                           <sch:assert test="every $p in                     ./following-sibling::tei:p|./preceding-sibling::tei:p satisfies $p[@xml:lang]"
                                       xml:lang="en"> If @xml:lang is used on tei:p the preceding and following tei:p
                    also have to use it. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:p[tei:ab]">
                           <sch:assert test="./tei:ab[@type = 'marginal_note']"> If tei:ab is
                    used inside tei:p the type must always have the value
                    'marginal_note'. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="abstractModel-structure-p-in-ab-or-p"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:p">
                        <sch:report test="(ancestor::tei:ab or ancestor::tei:p) and                        not( ancestor::tei:floatingText                           | parent::tei:exemplum                           | parent::tei:item                           | parent::tei:note                           | parent::tei:q                           | parent::tei:quote                           | parent::tei:remarks                           | parent::tei:said                           | parent::tei:sp                           | parent::tei:stage                           | parent::tei:cell                           | parent::tei:figure )">
          Abstract model violation: Paragraphs may not occur inside other paragraphs or ab elements.
        </sch:report>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="abstractModel-structure-p-in-l"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:l//tei:p">
                        <sch:assert test="ancestor::tei:floatingText | parent::tei:figure | parent::tei:note">
          Abstract model violation: Metrical lines may not contain higher-level structural elements such as div, p, or ab, unless p is a child of figure or note, or is a descendant of floatingText.
        </sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="change">
                     <desc versionDate="2025-02-04" xml:lang="de">die Nummerierung des Absatzes</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the numbering of the paragraph</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">la numérotation du paragraphe</desc>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-p-seg-de" xml:lang="de">
                  <p>
                Beispiel für einen Absatz mit Untergliederung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-seg-en" xml:lang="en">
                  <p>
                Example of a paragraph with subdivision
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-seg-fr" xml:lang="fr">
                  <p>
                Exemple de paragraphe avec subdivision
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <seg>
                           <lb/>Und deß zuͦ warem und vestem urkunde, so hatt der from, wys,
                <lb/>unnser gethruwer, lieber lanndt vogt zuͦ Baden im Ergöw Jacob
                <lb/>An der Rütty, des rats zuͦ Schwytz, sin eigen insigel, namen
                <lb/>unnser aller, gehennckt an disen brieff.
            </seg>
                        <seg>
                           <lb/>Der geben ist <date calendar="julian" when-custom="1453-08-11">uff den einlifften tag
                    <lb/>ougstens, nach der gepurt Christi getzalt, tusent fünffhundert
                    <lb/>viertzig und drü jare</date>.
            </seg>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-actum-de" xml:lang="de">
                  <p>
                Beispiel für eine Schlussformel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Actum montags, den <date calendar="julian" when-custom="1671-06-19">19<hi rend="sup">ten</hi> juny anno 1671</date>,
            <lb/>coram <orgName>senatu</orgName>.
        </p>
                     <p>
                        <lb/>Stattschryber <choice>
                           <abbr>ßt</abbr>
                           <expan>scripsit</expan>
                        </choice>.
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-actum-en" xml:lang="en">
                  <p>
                Example of a closing formula
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Actum montags, den <date calendar="julian" when-custom="1671-06-19">19<hi rend="sup">ten</hi> juny anno 1671</date>,
            <lb/>coram <orgName>senatu</orgName>.
        </p>
                     <p>
                        <lb/>Stattschryber <choice>
                           <abbr>ßt</abbr>
                           <expan>scripsit</expan>
                        </choice>.
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-p-actum-fr" xml:lang="fr">
                  <p>
                Exemple de formule de clôture
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Actum montags, den <date calendar="julian" when-custom="1671-06-19">19<hi rend="sup">ten</hi> juny anno 1671</date>,
            <lb/>coram <orgName>senatu</orgName>.
        </p>
                     <p>
                        <lb/>Stattschryber <choice>
                           <abbr>ßt</abbr>
                           <expan>scripsit</expan>
                        </choice>.
        </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            In der Transkription werden damit originale Absätze ausgezeichnet. Eine gröbere
            Strukturierung wird mit <gi>div</gi> vorgenommen. Eine zusätzliche inhaltliche
            Gliederung des Textes durch die Bearbeitenden kann mit <gi>seg</gi> erfolgen. Vgl. dazu
            auch die Ausführungen zur Strukturierung der Texte in den <ref target="textstructure.md">Transkriptionsrichtlinien</ref>.
        </p>
                  <p>
            Wird in einer Urkunde der Text nicht durch einen Zeilenumbruch, sondern durch einen
            horizontalen Abstand oder eine Initiale innerhalb der Zeile inhaltlich strukturiert,
            kann dies ebenfalls mit <gi>p</gi> ausgezeichnet werden. Paragraphenzeichen werden
            nicht speziell ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            In the transcription, this is used to mark original paragraphs. The text is structured
            by the editor with <gi>seg</gi>. See also the explanations "Structuring of the
            texts" in the <ref target="textstructure.md">SLS transcription guidelines</ref>
            and the description of <gi>div</gi>. If the text in a certificate is structured by a
            space or an initial, the paragraph can be marked with <gi>p</gi>. Paragraph signs,
            however, are not specially marked.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Dans la transcription, <gi>p</gi> signale les paragraphes originaux. Une structuration
            de niveau plus important est réalisée avec <gi>div</gi>. Si nécessaire, les éditeurs
            peuvent introduire une structuration supplémentaire du texte, non originale, en
            utilisant <gi>seg</gi>. Voir également les explications sur la structuration des textes
            dans les <ref target="textstructure.md">principes de transcription</ref>.
        </p>
                  <p>
            Si, dans un document, le texte n’est pas structuré par un retour à la ligne, mais par
            un espace horizontal ou une initiale à l’intérieur la ligne, cela peut également être
            signalé par <gi>p</gi>. Les signes de paragraphe ne sont pas spécialement marqués.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COPA">3.1. Paragraphs</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DR.html#DRPAL">7.2.5. Speech Contents</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-foreign"
                         ident="foreign">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">fremdsprachliche Form</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">foreign form</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">expression étrangère</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Text, der in einer anderen Sprache als der
    umgebende Text verfasst wurde.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains text that is in a different language than
    the main text.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des mots ou des expressions qui ne sont
    pas écrits dans la langue principale du texte.</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req"/>
               </attList>
               <exemplum xml:id="ex-foreign-de" xml:lang="de">
                  <p>
                Absatz mit fremdsprachigen Einschüben
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
        Versigleter <foreign xml:lang="rm">scütt</foreign> entzwischen der gmeindt Langnetz und der gmeind Fallß <foreign xml:lang="la">ut intus</foreign> zu
        sechen.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-foreign-fr" xml:lang="fr">
                  <p>
                Paragraphe avec expressions en langues étrangères
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
        Versigleter <foreign xml:lang="rm">scütt</foreign> entzwischen der gmeindt Langnetz und der gmeind Fallß <foreign xml:lang="la">ut intus</foreign> zu
        sechen.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-foreign-en" xml:lang="en">
                  <p>
                Paragraph with foreign language inserts
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
        Versigleter <foreign xml:lang="rm">scütt</foreign> entzwischen der gmeindt Langnetz und der gmeind Fallß <foreign xml:lang="la">ut intus</foreign> zu
        sechen.
    </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            «Actum», «datum» oder «etc.» werden nicht mit <gi>foreign</gi> ausgezeichnet. Längere
            fremdsprachige Textpassagen werden zusätzlich auch in den Metadaten unter
            <gi>textLang</gi> vermerkt.
        </p>
                  <p>
            Mit dem Attribut <att>xml:lang</att> wird immer die Sprache angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            "Actum", "datum" or "etc." are not marked with
            <gi>foreign</gi>. Longer foreign-language text passages are also noted in the metadata
            under <gi>textLang</gi>. If it is a part of the sentence that can be identified with a
            TEI element, the corresponding element must be provided with <att>xml:lang</att>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            « Actum », « datum » ou « etc » ne sont pas signalés avec <gi>foreign</gi>. Les longs
            passages de texte en langue étrangère sont également indiqués dans les métadonnées sous
            <gi>textLang</gi>.
        </p>
                  <p>
            La langue est toujours spécifiée avec l’attribut <att>xml:lang</att>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQHF">3.3.2.1. Foreign Words or Expressions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-hi"
                         ident="hi">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Hervorhebung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">highlighting</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">mise en évidence</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Beschreibt die graphische Hervorhebung von
    Text.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Describes the graphical highlighting of
    text.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Décrit de portions de texte mises en évidence
    graphiquement.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.written"/>
                  <memberOf key="model.hiLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="rend" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">das Aussehen der Hervorhebung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the appearance of the highlighting</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">l’apparition de la mise en évidence</desc>
                     <datatype maxOccurs="unbounded">
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.font"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.placement"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.rend.rotation"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-hi-sup-de" xml:lang="de">
                  <p>
                Auszeichnung eines hochgestellten Buchstabens
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        deß 1729<hi rend="sup">ten</hi> jahrs
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-sup-en" xml:lang="en">
                  <p>
                Encoding of a superscript letter
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        deß 1729<hi rend="sup">ten</hi> jahrs
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-sup-fr" xml:lang="fr">
                  <p>
                Encodage d’un passage placé en exposant
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        deß 1729<hi rend="sup">ten</hi> jahrs
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-underline-de" xml:lang="de">
                  <p>
                Beispiele einer Unterstreichung von späterer Hand – das Attribut
                <att>
                    hand
                </att>
                ist ein Verweis auf eine
                <gi>
                    handNote
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi hand="laterHand" rend="underline">unterstrichener Text mit anderer Tinte</hi>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-underline-en" xml:lang="en">
                  <p>
                Examples of a later hand underline - the
                <att>
                    hand
                </att>
                attribute is a reference to a
                <gi>
                    handNote
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi hand="laterHand" rend="underline">unterstrichener Text mit anderer Tinte</hi>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-underline-fr" xml:lang="fr">
                  <p>
                Exemples d’un soulignement par une main ultérieure – l’attribut
                <att>
                    hand
                </att>
                est une référence à une
                <gi>
                    handNote
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi hand="laterHand" rend="underline">unterstrichener Text mit anderer Tinte</hi>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-num-de" xml:lang="de">
                  <p>
                Beispiel für eine römische Zahl
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-num-en" xml:lang="en">
                  <p>
                Example of a Roman number
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-num-fr" xml:lang="fr">
                  <p>
                Exemple d’un nombre romain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-rotated-de" xml:lang="de">
                  <p>
                Beispiel für einen um 90 Grad gedrehten Text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi rend="rotated_90">Text, der von oben nach unten läuft</hi>.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-rotated-en" xml:lang="en">
                  <p>
                Markup of a text rotated by 90 degrees clockwise
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi rend="rotated_90">Text, der von oben nach unten läuft</hi>.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-rotated-fr" xml:lang="fr">
                  <p>
                Exemple d’un texte tourné à 90 degrés dans le sens des aiguilles d’une montre
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <hi rend="rotated_90">Text, der von oben nach unten läuft</hi>.
    </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Die Editionen der SSRQ sind keine faksimilierenden Transkriptionen, weshalb viele
            Hervorhebungen wie etwa Versalien nicht dargestellt werden. Punkte vor hochgestellten
            Buchstaben bei Aufzählungen, Datierungen, Abkürzungen usw. werden ebenfalls nicht
            berücksichtigt. Es werden nur für den Text «wichtige» Hervorhebungen transkribiert.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            The Legal Sources Foundation does not make facsimile transcriptions, which is why
            capital letters, indentations, etc. are not shown. Dots in front of superscript letters
            in enumerations, dates, abbreviations, etc. are not taken into account.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les éditions des SDS ne sont pas des transcriptions « photocopiant » le fac-similé,
            c’est pourquoi de nombreuses mises en évidence, comme les majuscules superflues, ne
            sont pas signalées. Les points précédant les caractères en exposant dans les
            énumérations, les datations, les abréviations, etc. ne sont pas non plus pris en
            compte. Seules les mises en évidence « significatives » pour le texte sont transcrites.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQHE">3.3.2.2. Emphatic Words and Phrases</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQH">3.3.2. Emphasis, Foreign Words, and Unusual Language</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-quote"
                         ident="quote">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Zitat</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">quote</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">citation</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält ein Zitat.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains a citation within an original
    text.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une citation.</desc>
               <classes>
                  <memberOf key="att.global.source"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.quoteLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="1">
                        <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                        <elementRef key="p" maxOccurs="unbounded" minOccurs="2"/>
                     </alternate>
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <macroRef key="ssrq.content.default"/>
                     </sequence>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-quote"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-05-31" xml:lang="en">constraint for tei:quote</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:quote[not(ancestor::tei:back)]">
                           <sch:assert role="warning" test=".[following-sibling::*[1][self::tei:note]]">
                    tei:quote should be followed by a tei:note element. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="source" mode="replace">
                     <datatype>
                        <rng:choice>
                           <rng:list>
                              <rng:oneOrMore>
                                 <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.urn"/>
                              </rng:oneOrMore>
                           </rng:list>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.url"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">die Art des Zitats</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the type of quote</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">le type de la citation</desc>
                     <datatype>
                        <dataRef key="ssrq.type.quote"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-quote-de" xml:lang="de">
                  <p>
                Beispiel für einen Hinweis auf eine Urkunde mit Zitat des Anfangs der Urkunde
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <add hand="otherHand" place="below">Hinfûr soll man leßen des banholtzes halb ein gschrift, stât ze end dis buchs, fahent an: <quote type="partially_inserted">Wir Johannes Mantss.</quote>
                        <note>Mit dem Verweis betreffend Bannholz ist StAZH G I 102, fol. 33r-v gemeint.</note>
                     </add>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-quote-en" xml:lang="en">
                  <p>
                Example of a reference to a document with a quote from the beginning of the document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <add hand="otherHand" place="below">Hinfûr soll man leßen des banholtzes halb ein gschrift, stât ze end dis buchs, fahent an: <quote type="partially_inserted">Wir Johannes Mantss.</quote>
                        <note>Mit dem Verweis betreffend Bannholz ist StAZH G I 102, fol. 33r-v gemeint.</note>
                     </add>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-quote-fr" xml:lang="fr">
                  <p>
                Exemple de référence à un document avec une citation du début du document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <add hand="otherHand" place="below">Hinfûr soll man leßen des banholtzes halb ein gschrift, stât ze end dis buchs, fahent an: <quote type="partially_inserted">Wir Johannes Mantss.</quote>
                        <note>Mit dem Verweis betreffend Bannholz ist StAZH G I 102, fol. 33r-v gemeint.</note>
                     </add>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-quote-fully-de" xml:lang="de">
                  <p>
                Beispiel für ein Zitat einer vollständigen Urkunde
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <quote type="fully_inserted"> Domine castellane, ego <persName ref="per030236a.01">Jacobus Arconcerii</persName>, procurator fiscalis et fidei a
            reverendo in <persName ref="per000353a.17">Christo</persName> patre et domino [hier der Rest des Zitats] conducere possim et valeam sicut ipsius
            <persName ref="per030242a.01">Johannis</persName> demerita exposcunt. </quote>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-quote-fully-en" xml:lang="en">
                  <p>
                Example of a quote of a complete document
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <quote type="fully_inserted"> Domine castellane, ego <persName ref="per030236a.01">Jacobus Arconcerii</persName>, procurator fiscalis et fidei a
            reverendo in <persName ref="per000353a.17">Christo</persName> patre et domino [hier der Rest des Zitats] conducere possim et valeam sicut ipsius
            <persName ref="per030242a.01">Johannis</persName> demerita exposcunt. </quote>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-quote-fully-fr" xml:lang="fr">
                  <p>
                Exemple d’une référence à un autre document intégralement inséré
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <quote type="fully_inserted"> Domine castellane, ego <persName ref="per030236a.01">Jacobus Arconcerii</persName>, procurator fiscalis et fidei a
            reverendo in <persName ref="per000353a.17">Christo</persName> patre et domino [hier der Rest des Zitats] conducere possim et valeam sicut ipsius
            <persName ref="per030242a.01">Johannis</persName> demerita exposcunt. </quote>
                     </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Enthält z. B. eine inserierte Urkunde oder eine Bibelstelle. Idealerweise folgt am
            Schluss des Zitats eine sachkritische Anmerkung mit <gi>note</gi> mit einem Verweis auf
            den Originaltext oder eine Edition desselben.
        </p>
                  <p>
            Für direkte Rede hingen verwenden wir <gi>q</gi>. Wird im edierten Text der Name eines
            Dokuments oder eines Gebets genannt, dann wird dieses nicht mit den Elementen
            <gi>q</gi> oder <gi>quote</gi> ausgezeichnet, aber der Titel grossgeschrieben. Das
            Gleiche gilt für historische Werktitel innerhalb der Paratexte. Innerhalb der Paratexte
            (Anmerkungen, Kommentar, Einleitung) benutzen wir <gi>quote</gi> für Zitate aus der
            Forschungsliteratur.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            Contains e.g. an advertised document or a passage from the Bible. Ideally, the citation
            should be followed by a factual comment with <gi>note</gi> with a reference to the
            original text or an edition of the same.
        </p>
                  <p>
            For direct speech in source texts, we use <gi>q</gi>. If the name of a document or a
            prayer is mentioned in a source piece, then this is not marked with the tag <gi>q</gi>
            or <gi>quote</gi>, but the title is capitalized. The same applies to historical work
            titles within the paratexts. Within the paratexts (notes, commentary, introduction) we
            use <gi>quote</gi> for citations from the research literature.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Contient p. ex. un acte inséré ou un passage de la Bible. Idéalement, la citation est
            suivie d’une note critique avec <gi>note</gi>, laquelle contient une référence au texte
            original ou à une édition de celui-ci.
        </p>
                  <p>
            Pour le discours direct nous utilisons <gi>q</gi>. Si le texte édité mentionne le nom
            d’un document ou d’une prière, celui-ci n’est pas signalé par les éléments <gi>q</gi>
            ou <gi>quote</gi>, mais le titre est mis en majuscule. Il en va de même pour les titres
            d’ouvrages historiques dans les paratextes. Dans les paratextes (notes, commentaires,
            introduction), nous utilisons <gi>quote</gi> pour les citations de la littérature de
            recherche.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQQ">3.3.3. Quotation</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSGRP">4.3.1. Grouped Texts</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-q"
                         ident="q">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">direkte Rede</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">quote</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">discours direct</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Text in direkter Rede.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains text in direct speech in the
    transcription.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une séquence de texte au discours
    direct.</desc>
               <classes>
                  <memberOf key="model.hiLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="type" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-q-de" xml:lang="de">
                  <p>
                Beispiel für direkte Rede im Text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der ander spricht: <q>Richt mich uß oder ich will dirs stellen bey der buß. </q>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-q-en" xml:lang="en">
                  <p>
                Example of direct speech in the text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der ander spricht: <q>Richt mich uß oder ich will dirs stellen bey der buß. </q>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-q-fr" xml:lang="fr">
                  <p>
                Exemple de discours direct dans un texte.
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der ander spricht: <q>Richt mich uß oder ich will dirs stellen bey der buß. </q>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-q-editor-de" xml:lang="de">
                  <p>
                Beispiel für eine Hervorhebung in editorischen Paratexten (Kommentare, Einleitung etc.)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der Buchstabe <q>v</q> wird in vokalischer Position stets als <q>u</q> transkribiert.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-q-editor-en" xml:lang="en">
                  <p>
                Example of highlighting in editorial paratexts (comments, introduction, etc.)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der Buchstabe <q>v</q> wird in vokalischer Position stets als <q>u</q> transkribiert.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-q-editor-fr" xml:lang="fr">
                  <p>
                Exemple de mise en évidence dans des paratextes éditoriaux (commentaires, introduction, etc.)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Der Buchstabe <q>v</q> wird in vokalischer Position stets als <q>u</q> transkribiert.
    </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
                     <gi>q</gi> wird z. B. bei Zeugenaussagen verwendet. Zitate und Inserte innerhalb eines
            Quellentextes werden hingegen mit <gi>quote</gi> ausgezeichnet.
        </p>
                  <p>
            Wird im edierten Text der Name eines Dokuments oder eines Gebets genannt, dann wird
            dieses nicht mit den Elementen <gi>q</gi> oder <gi>quote</gi> ausgezeichnet, aber der
            Titel grossgeschrieben. Das Gleiche gilt für historische Werktitel innerhalb der
            Paratexte.
        </p>
                  <p>
            Innerhalb der Paratexte (Anmerkungen, Kommentar, Einleitung) kann der Tag <gi>q</gi>
            bei modalisierender Funktion, d. h. ironisierend, distanzierend, übertragen etc., oder
            für Hervorhebungen verwendet werden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
                     <gi>q</gi> becomes e.g. used in witness statements. In the display, the tag is
            highlighted with quotation marks. Quotations and inserts within a source text, on the
            other hand, are marked with <gi>quote</gi>.
        </p>
                  <p>
            When a source piece mentions the name of a document or a prayer, it is not marked with
            the <gi>q</gi> or <gi>quote</gi> tag, but the title is capitalized. The same applies to
            historical work titles within the paratexts.
        </p>
                  <p>
            Within the paratexts (notes, comments, introduction), the <gi>q</gi> tag can be used
            with a modalizing function, i.e. ironic, distancing, transferred etc., or used for
            emphasis.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
                     <gi>q</gi> est utilisé p. ex. dans les déclarations de témoins. Les citations et les
            insertions à l’intérieur d’une source sont par contre signalées par <gi>quote</gi>.
        </p>
                  <p>
            Si le nom d’un document ou d’une prière est mentionné dans le texte édité, il n’est pas
            marqué par les éléments <gi>q</gi> ou <gi>quote</gi>, mais le titre est en majuscule.
            Il en va de même pour les titres d’œuvres historiques au sein des paratextes.
        </p>
                  <p>
            A l’intérieur des paratextes (notes, commentaires, introduction), la balise <gi>q</gi>
            peut être utilisée pour moduler le discours, par l’ironie, la distanciation, la
            transposition, etc. ou pour des mises en évidence.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHQQ">3.3.3. Quotation</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-term"
                         ident="term">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Stichwort/Schlagwort</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">term</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">terme</gloss>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="de">Enthält ein Stichwort oder Schlagwort.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains a lemma or a keyword.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="fr">Contient un lemme ou un mot-clé.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.emphLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-term" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-11-07" xml:lang="en">constraint for tei:term</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:term">
                           <sch:report test=".[not(@*)][not(normalize-space(.))][not(*)]"> tei:term should
                    have at least an attribute, text content or element content. </sch:report>
                           <sch:assert test=".[@ref or @type]"> tei:term should have a @ref, a @type or
                    both. </sch:assert>
                           <sch:report test=".[not(normalize-space(.))][not(*)][contains(@ref,                     'lem')]"> If tei:term has no text content or child nodes, the
                    @ref-attribute must reference a keyword, not a lemma. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:term[not(ancestor::tei:keywords)][not(normalize-space(.))][not(*)]">
                           <sch:assert test=".[@type eq 'index']"> If tei:term is used outside
                    tei:keywords and has no text content or child nodes, then it must have a
                    @type-attribute with the value 'index'. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:term[not(ancestor::tei:keywords)][normalize-space(.) or *]">
                           <sch:assert test=".[not(@type eq 'index')]"> If tei:term is used
                    outside tei:keywords and has text content or child elements, then it must not
                    have a @type-attribute with the value 'index'. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                     <sch:pattern>
                        <sch:rule context="tei:term[@ref]">
                           <sch:assert test=".[not(@type eq 'unknown')]"> If tei:term has a
                    @ref-attribute, it cannot be of @type 'unknown'. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="ref" mode="replace">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.keywords"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.lemma"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Stichworts/Schlagworts</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of the term</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">le type du terme</desc>
                     <datatype>
                        <dataRef key="ssrq.type.term"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-term-de" xml:lang="de">
                  <p>
                Erfassung eines Lemmas
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>
                     <term ref="lem001099">sesshafft</term> ist, alle haimlich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-term-en" xml:lang="en">
                  <p>
                Encoding of a lemma
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>
                     <term ref="lem001099">sesshafft</term> ist, alle haimlich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-term-fr" xml:lang="fr">
                  <p>
                Encodage d’un lemme
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>
                     <term ref="lem001099">sesshafft</term> ist, alle haimlich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-de" xml:lang="de">
                  <p>
                Verwendung von
                <gi>
                    sic
                </gi>
                in Kombination mit
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-en" xml:lang="en">
                  <p>
                Use of
                <gi>
                    sic
                </gi>
                in combination with
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-fr" xml:lang="fr">
                  <p>
                Utilisation de
                <gi>
                    sic
                </gi>
                combinée avec
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Über das Attribut <att>ref</att> werden die Einträge mit der entsprechenden <ref target="https://termini.ssrq-sds-fds.ch">Datenbank</ref> der SSRQ verknüpft.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            The entries are linked to the registry databases via the <att>ref</att> attribute.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            L’attribut <att>ref</att> relie les entrées à la <ref target="https://termini.ssrq-sds-fds.ch">base de données</ref> SDS correspondante.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COHTG">3.4.1. Terms and Glosses</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-sic"
                         ident="sic">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Latein für «so»</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">latin for «thus»</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">du latin «ainsi»</gloss>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="de">Enthält offensichtlich fehlerhaften Text.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains obviously incorrect text.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="fr">Contient un texte manifestement incorrect.</desc>
               <classes>
                  <memberOf key="model.pPart.transcriptional"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <elementRef key="abbr"/>
                     <elementRef key="add"/>
                     <elementRef key="del"/>
                     <elementRef key="lb"/>
                     <elementRef key="note"/>
                     <elementRef key="pb"/>
                     <elementRef key="subst"/>
                     <macroRef key="ssrq.content.entities"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-sic-de" xml:lang="de">
                  <p>
                Verwendung ohne Kindelemente
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sic>ernschlich</sic>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-en" xml:lang="en">
                  <p>
                Use without child elements
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sic>ernschlich</sic>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-fr" xml:lang="fr">
                  <p>
                Utilisation sans éléments enfants
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <sic>ernschlich</sic>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-de" xml:lang="de">
                  <p>
                Verwendung von
                <gi>
                    sic
                </gi>
                in Kombination mit
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-en" xml:lang="en">
                  <p>
                Use of
                <gi>
                    sic
                </gi>
                in combination with
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-sic-term-fr" xml:lang="fr">
                  <p>
                Utilisation de
                <gi>
                    sic
                </gi>
                combinée avec
                <gi>
                    term
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        der <sic>
                        <term ref="lem014672.11">hexenry</term>
                     </sic> anzenemmen.
    </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Offensichtliche Schreibfehler können von den Bearbeitenden mit <gi>corr</gi> korrigiert
            werden, beide Elemente stehen dann innerhalb von <gi>choice</gi>.
        </p>
                  <p>
            Auf die typrographische Hervorhebung des Schreibfehlers mit «[!]» wird verzichtet.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            Obvious spelling mistakes can be corrected with <gi>corr</gi>. "[!]" is not
            used.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Les fautes d’orthographe évidentes peuvent être corrigées par les éditeurs à l’aide de
            <gi>corr</gi>, les deux éléments se trouvant alors dans <gi>choice</gi>.
        </p>
                  <p>
            Il n’est pas indiqué de mettre en évidence la faute orthographique par « [!] ».
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDCOR">3.5.1. Apparent Errors</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-corr"
                         ident="corr">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Korrektur</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">correction</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">correction</gloss>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="de">Enthält die durch einen Editor bzw. eine Editorin
    vorgenommene Korrektur eines Schreibfehlers.</desc>
               <desc rend="replace" versionDate="2023-05-24" xml:lang="en">Contains a correction made by an editor.</desc>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="fr">Contient la correction d’une erreur typographique
    effectuée par un éditeur.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="model.pPart.transcriptional"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="cert" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-choice-sic-de" xml:lang="de">
                  <p>
                Beispiel für eine Korrektur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-sic-fr" xml:lang="fr">
                  <p>
                Exemple de correction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-sic-en" xml:lang="en">
                  <p>
                Example of a correction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Der mit <gi>corr</gi> korrigierte Schreibfehler wird mit <gi>sic</gi> ausgezeichnet.
            Beide Elemente werden mit <gi>choice</gi> gruppiert.
        </p>
                  <p>
            Bei irrtümlichen Wortwiederholungen enthält <gi>corr</gi> die korrekte Form. Ein leeres
            <gi>corr</gi> ist möglich, wenn ein überflüssiges Wort getilgt wird.
        </p>
                  <p>
            Mit <gi>corr</gi> werden nur Eingriffe durch die Editorinnen und Editoren
            ausgezeichnet, nicht aber Korrekturen, die ein Schreiber durchgeführt hat. Hierzu
            dienen die Elemente <gi>subst</gi>, <gi>add</gi> und <gi>del</gi>.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            Contains the correct form, for example, of a prescriber, identified with <gi>sic</gi>.
            The correction always comes from the editor and not from the hand of the writer of the
            document. For erroneous repetitions of words, <gi>corr</gi> contains the correct form.
            An empty <gi>corr</gi> is possible if a superfluous word is deleted by the editor.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="fr">
                  <p>
            La faute d’orthographe corrigée avec <gi>corr</gi> est marquée avec <gi>sic</gi>. Les
            deux éléments sont regroupés dans <gi>choice</gi>.
        </p>
                  <p>
            Si des mots sont répétés par erreur, <gi>corr</gi> contient la forme correcte. Un
            <gi>corr</gi> vide est possible si un mot superflu est supprimé.
        </p>
                  <p>
                     <gi>corr</gi> ne marque que les interventions des éditeurs, mais pas les corrections
            apportées par un scribe. Les éléments <gi>subst</gi>, <gi>add</gi> et <gi>del</gi> sont
            utilisés pour cela.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDCOR">3.5.1. Apparent Errors</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-choice"
                         ident="choice">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Alternative</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">choice</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">option</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Enthält zwei Elemente zur alternativen
    Auszeichnung einer Textpassage.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains two elements for alternative markup of a
    text passage.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Contient deux éléments permettant de présenter de
    manière alternative une même séquence du texte.</desc>
               <classes>
                  <memberOf key="model.pPart.editorial"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <sequence minOccurs="1" maxOccurs="1">
                        <elementRef key="abbr"/>
                        <elementRef key="expan"/>
                     </sequence>
                     <sequence minOccurs="1" maxOccurs="1">
                        <elementRef key="sic"/>
                        <elementRef key="corr"/>
                     </sequence>
                  </alternate>
               </content>
               <exemplum xml:id="ex-choice-abbr-de" xml:lang="de">
                  <p>
                Beispiel für eine aufgelöste Abkürzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-fr" xml:lang="fr">
                  <p>
                Exemple d’abréviation développée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-abbr-en" xml:lang="en">
                  <p>
                Example of a resolved abbreviation
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <abbr>sabbo</abbr>
                        <expan>sabbato</expan>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-sic-de" xml:lang="de">
                  <p>
                Beispiel für eine Korrektur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-sic-fr" xml:lang="fr">
                  <p>
                Exemple de correction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-choice-sic-en" xml:lang="en">
                  <p>
                Example of a correction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <choice>
                        <sic>offensiche</sic>
                        <corr resp="anh">offenliche</corr>
                     </choice>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Das Element kann entweder eine Abkürzung (<gi>abbr</gi>) mitsamt ihrer Auflösung
            (<gi>expan</gi>) oder einen Schreibfehler (<gi>sic</gi>) mitsamt seiner Korrektur
            (<gi>corr</gi>) enthalten. Die Auflösung bzw. die Korrektur stehen nach der Abkürzung
            bzw. dem Schreibfehler.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            The tag contains elements for breaking up abbreviations or correcting spelling
            mistakes. The resolution of the abbreviation and the corrections are given after the
            original text.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            L’élément peut contenir soit une abréviation (<gi>abbr</gi>) avec son développement
            (<gi>expan</gi>), soit une erreur typographique (<gi>sic</gi>) avec sa correction
            (<gi>corr</gi>). Le développement ou la correction apparaît après l’abréviation ou
            l’erreur typographique.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COED">3.5. Simple Editorial Changes</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-orig"
                         ident="orig">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">originalsprachliche Form</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">original form</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">forme originale</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält in editorischen Paratexten Textteile, die
    in Originalsprache verfasst sind.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains parts of text written in original
    language within introductions, comments and notes.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient, dans les paratextes éditoriaux, des
    parties de texte écrites dans la langue originale.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.pPart.transcriptional"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-orig-de" xml:lang="de">
                  <p>
                Beispiel für einen originalsprachlichen Ausdruck in einem Kommentar
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <note>Am Beispiel von Seebach lässt sich beobachten, wie Nachträge aus Beschlüssen der <orig>bursamy</orig> [...] zustande kommen. </note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-orig-en" xml:lang="en">
                  <p>
                Example of an original language expression in a comment
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <note>Am Beispiel von Seebach lässt sich beobachten, wie Nachträge aus Beschlüssen der <orig>bursamy</orig> [...] zustande kommen. </note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-orig-fr" xml:lang="fr">
                  <p>
                Exemple d’expression en langue originale dans un commentaire
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <note>Am Beispiel von Seebach lässt sich beobachten, wie Nachträge aus Beschlüssen der <orig>bursamy</orig> [...] zustande kommen. </note>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDREG">3.5.2. Regularization and
Normalization</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TC">13. Critical Apparatus</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-gap"
                         ident="gap">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Auslassung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">gap</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">omission</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Markiert eine Auslassung durch den Editor.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Describes an omission by the editor.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Marque une omission de la part de
    l’éditeur.</desc>
               <classes>
                  <memberOf key="att.dimensions"/>
                  <memberOf key="att.global.source"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="sch-el-gap" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-02-04" xml:lang="en">constraint for tei:gap</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:gap[parent::tei:damage]">
                           <sch:report test="@reason" xml:lang="en"> If tei:gap is a child of tei:damage,
                    @reason cannot be specified. </sch:report>
                           <sch:assert test="@unit and @quantity" xml:lang="en"> If tei:gap is a child of
                    tei:damage, @unit and @quantity need to specified. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:gap[not(parent::tei:damage) and @reason]">
                           <sch:report test="@reason = 'illegible' and (not(@unit) or                     not(@quantity))"> If @reason is specified on tei:gap and its value is
                    "illegible", @unit and @quantity must be present, too. </sch:report>
                        </sch:rule>
                        <sch:rule context="tei:gap[not(parent::tei:damage) and @source]">
                           <sch:report test="@unit or @quantity or @reason"> If @source is specified on
                    tei:gap, @unit, @quantity and @reason are forbidden. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="reason" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">der Grund für die Auslassung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the reason for the gap</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">la raison de l’omission</desc>
                     <datatype>
                        <dataRef key="ssrq.reason.gap"/>
                     </datatype>
                  </attDef>
                  <attDef ident="source" mode="replace">
                     <datatype>
                        <dataRef key="ssrq.pointer.urn"/>
                     </datatype>
                  </attDef>
                  <attDef ident="unit" mode="change">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.measure.lengths.base.cm"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.dimensions.typography"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.dimensions.scope"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="agent" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-gap-line-de" xml:lang="de">
                  <p>
                Unlesbare Zeile ohne Streichung oder Beschädigung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap quantity="1" reason="illegible" unit="line"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-line-en" xml:lang="en">
                  <p>
                Illegible line without deletion or damage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap quantity="1" reason="illegible" unit="line"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-line-fr" xml:lang="fr">
                  <p>
                Ligne illisible sans rature ou détérioration
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap quantity="1" reason="illegible" unit="line"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-missing-de" xml:lang="de">
                  <p>
                Beispiel eines fehlenden Textes, der in retrodigitalisierten Vorlage nicht vorhanden ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap reason="missing"/>
                     <note>Pas de transcription par Favarger 1982. Note Favarger 1982 : Cf. <ref>SDS_NE_1_47</ref> du 17 août 1508 qui accorde la
        même franchise aux francs habergeants de la Sagne.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-missing-en" xml:lang="en">
                  <p>
                Example of missing text not present in retro-digitised template
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap reason="missing"/>
                     <note>Pas de transcription par Favarger 1982. Note Favarger 1982 : Cf. <ref>SDS_NE_1_47</ref> du 17 août 1508 qui accorde la
        même franchise aux francs habergeants de la Sagne.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-missing-fr" xml:lang="fr">
                  <p>
                Exemple d’un texte manquant qui n’est pas présent dans le document rétro-numérisé
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap reason="missing"/>
                     <note>Pas de transcription par Favarger 1982. Note Favarger 1982 : Cf. <ref>SDS_NE_1_47</ref> du 17 août 1508 qui accorde la
        même franchise aux francs habergeants de la Sagne.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-source-de" xml:lang="de">
                  <p>
                Auslassung eines Textausschnittes, der bereits in einem anderen Stück ediert ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap source="urn:ssrq:SSRQ-SG-III_4-143-1"/>
                     <note>Inhaltlich gleich.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-source-en" xml:lang="en">
                  <p>
                Omission of a text excerpt already edited in another play
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap source="urn:ssrq:SSRQ-SG-III_4-143-1"/>
                     <note>Inhaltlich gleich.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-gap-source-fr" xml:lang="fr">
                  <p>
                Omission du passage d’un texte déjà édité dans une autre pièce
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <gap source="urn:ssrq:SSRQ-SG-III_4-143-1"/>
                     <note>Inhaltlich gleich.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Text unlesbar ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-en" xml:lang="en">
                  <p>
                Example of a damaged spot where the text is unreadable
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré où le texte est illisible
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Dies betrifft vor allem gänzlich unleserliche Stellen. Der Grund für eine Auslassung
            kann mit dem Attribut <att>reason</att> angegeben werden. Wenn die Ursache der
            Unlesbarkeit eine Beschädigung ist, so wird auf <att>reason</att> verzichtet –
            stattdessen wird das Element mit <gi>damage</gi> umschlossen. Ist der Grund für die
            Unlesbarkeit eine Rasur oder eine (heftige) Streichung, wird das Element in ein
            <gi>del</gi> geschachtelt.
        </p>
                  <p>
            Die Grösse der Auslassung wird mit den Attributen <att>unit</att> und
            <att>quantity</att> angegeben. Nicht runde Massangaben werden auf <val>0.5</val> auf-
            oder abgerundet.
        </p>
                  <p>
            Werden spätere Nachträge nicht beim Original, sondern als eigenständiges Stück ediert,
            können die Teile, die bereits in einem früheren Original ediert wurden, mit
            <gi>gap</gi> weggelassen werden. Auf das edierte Stück wird mit dem Attribut
            <att>source</att> verwiesen. In diesem Fall wird eine Anmerkung in <gi>note</gi> oder
            eine Bemerkung in <gi>back</gi> ergänzt.
        </p>
                  <p>
            Wird z. B. nur ein Eintrag auf einer Seite eines Ratsprotokolls transkribiert, d. h.
            die davorstehenden Einträge werden weggelassen, dann wird diese Auslassung mit nur
            einem <tag>gap reason="irrelevant"</tag> (auch wenn mehrere Einträge
            ausgelassen wurden) gekennzeichnet. Die Angabe der nachfolgenden Einträge ist nicht
            notwendig. Befindet sich der Titel zum Ratsprotokolleintrag eine oder mehrere Seiten
            weiter vorne, dann sollte dieser ebenfalls transkribiert und die Auslassung mit
            <gi>gap</gi> gekennzeichnet werden.
        </p>
                  <p>
            Für Zeilensprünge in der Vorlage, die von den Bearbeitenden ergänzt werde, wird nicht
            <gi>gap</gi>, sondern nur <gi>supplied</gi> verwendet.
        </p>
                  <p>
            Lücken in retrodigitalisierten Texten werden mit <tag>gap
            reason="missing"</tag> ausgezeichnet (z. B. in SDS NE 1).
        </p>
               </remarks>
               <remarks versionDate="2023-08-17" xml:lang="en">
                  <p>
            This mainly applies to completely illegible passages. The reason for an omission can be
            specified with <att>reason</att>. However, if the cause of illegibility is damage,
            <att>reason</att> is not used - instead the tag is enclosed in <gi>damage</gi>. If the
            reason for illegibility is a shave or a (heavy) deletion, the tag is nested in a
            <gi>del</gi>.
        </p>
                  <p>
            The size of the omission is specified with <att>unit</att> and <att>quantity</att>.
            Measurements are rounded up or down to 0.5.
        </p>
                  <p>
            If later supplements are not edited with the original but as a separate piece, the
            parts that have already been edited in an earlier original can be omitted with
            <gi>gap</gi>. The edited piece is referenced with <att>source</att>. In this case, a
            comment is added in <gi>note</gi> or in <gi>back</gi>.
        </p>
                  <p>
            If, for example, only one entry on one page of a council minute is transcribed, the
            preceding entries are omitted and the omission is marked with only one <gi>gap</gi>
                     <att>reason</att>= <val>irrelevant</val> (even if several entries are omitted). It is
            not necessary to specify the subsequent entries. If the title to the Council minutes
            entry is one or more pages further forward, then this should also be transcribed and
            the omission marked with <gi>gap</gi> (cf. example).
        </p>
                  <p>
            For line breaks in the template <gi>gap</gi> is not used, but <gi>supplied</gi>.
        </p>
                  <p>
            Gaps in retro-digitised texts are marked with <tag>gap reason="missing"</tag>
            (e.g. SDS NE 1).
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Cela s’applique particulièrement aux passages complètement illisibles. La raison d’une
            omission peut être indiquée avec l’attribut <att>reason</att>. Si la cause de
            l’illisibilité est une altération, on renonce à <att>reason</att> – à la place,
            l’élément est inclus dans <gi>damage</gi>. Si la cause de l’illisibilité est un gommage
            ou une rature intense, l’élément est imbriqué dans un <gi>del</gi>.
        </p>
                  <p>
            La taille de l’omission est indiquée avec les attributs <att>unit</att> et
            <att>quantity</att>. Les indications de mesure non rondes sont arrondies à
            <val>0,5</val> vers le haut ou vers le bas.
        </p>
                  <p>
            Si des ajouts ultérieurs ne sont pas édités avec l’original, mais comme pièce
            indépendante, les parties qui ont déjà été éditées dans un original antérieur peuvent
            être omises avec <gi>gap</gi>. Il est fait référence à la pièce éditée avec l’attribut
            <att>source</att>. Dans ce cas, une note est insérée dans <gi>note</gi> ou un
            commentaire est formulé dans <gi>back</gi>.
        </p>
                  <p>
            Si, p. ex., une seule entrée est transcrite sur une page d’un procès-verbal du Conseil,
            c’est-à-dire que les entrées qui la précèdent sont omises, cette omission est signalée
            par un seul <tag>gap reason="irrelevant"</tag> (même si plusieurs entrées ont
            été omises). Il n’est pas nécessaire de fournir les entrées suivantes. Si le titre de
            l’entrée du procès-verbal du Conseil se trouve une ou plusieurs pages plus haut,
            celui-ci doit également être transcrit et l’omission doit être signalée par
            <gi>gap</gi>.
        </p>
                  <p>
            Pour les sauts de ligne dans le document introduits par les éditeurs, on n’utilise pas
            <gi>gap</gi>, mais seulement <gi>supplied</gi>.
        </p>
                  <p>
            Les lacunes dans les textes rétro-numérisés sont signalés par <tag>gap
            reason="missing"</tag> (p. ex. dans SDS NE 1).
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD">3.5.3. Additions, Deletions, and Omissions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-add"
                         ident="add">
               <gloss rend="replace" versionDate="2025-03-02" xml:lang="de">Hinzufügung</gloss>
               <gloss rend="replace" versionDate="2025-03-02" xml:lang="en">addition</gloss>
               <gloss rend="replace" versionDate="2025-03-02" xml:lang="fr">ajout</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält eine Hinzufügung eines Schreibers.</desc>
               <desc rend="replace" versionDate="2023-05-24" xml:lang="en">Contains text added by a writer.</desc>
               <desc rend="replace" versionDate="2023-05-24" xml:lang="fr">Contient un ajout par un scribe.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
                  <memberOf key="model.pPart.transcriptional"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                     <sequence minOccurs="1" maxOccurs="1">
                        <elementRef key="head" minOccurs="0"/>
                        <elementRef key="p" maxOccurs="unbounded"/>
                     </sequence>
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <macroRef key="ssrq.content.default"/>
                     </sequence>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="place" mode="replace" usage="req">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort der Hinzufügung</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the addition</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">le lieu de l’ajout</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place.add"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">das verwendete Schreibmittel</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the writing means used</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">les moyens d’écriture utilisés</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.add"/>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-01-29" xml:lang="de">die Art der Hinzufügung</desc>
                     <desc versionDate="2025-01-29" xml:lang="en">the kind of addition</desc>
                     <desc versionDate="2025-01-29" xml:lang="fr">le type d’ajout</desc>
                     <datatype>
                        <dataRef key="ssrq.type.add"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-add-de" xml:lang="de">
                  <p>
                Nachtrag von gleicher Hand oberhalb der Zeile
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ff<add place="above">r</add>owen
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-en" xml:lang="en">
                  <p>
                Addendum by the same hand above the line
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ff<add place="above">r</add>owen
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-fr" xml:lang="fr">
                  <p>
                Ajout au-dessus de la ligne par la même main
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        ff<add place="above">r</add>owen
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-century-de" xml:lang="de">
                  <p>
                Beispiel für eine Hinzufügung einer Hand des 18. Jahrhunderts
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="hand18c" place="above">item so soll ein</add> kouffman
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-century-en" xml:lang="en">
                  <p>
                Example of an addition of a hand of the 18th century
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="hand18c" place="above">item so soll ein</add> kouffman
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-century-fr" xml:lang="fr">
                  <p>
                Exemple d’ajout d’une main du 18ème siècle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="hand18c" place="above">item so soll ein</add> kouffman
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-later-de" xml:lang="de">
                  <p>
                Beispiel für eine Hinzufügung von späterer Hand
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="laterHand" place="above">
                           <lb/>Collationata et auschultata est praesens prescripta copia per me
                <lb/>publicum apostolica notarium </add>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-later-en" xml:lang="en">
                  <p>
                Example of a later hand addition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="laterHand" place="above">
                           <lb/>Collationata et auschultata est praesens prescripta copia per me
                <lb/>publicum apostolica notarium </add>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-later-fr" xml:lang="fr">
                  <p>
                Exemple d’un ajout d’une main ultérieure
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="laterHand" place="above">
                           <lb/>Collationata et auschultata est praesens prescripta copia per me
                <lb/>publicum apostolica notarium </add>
                     </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-margin-de" xml:lang="de">
                  <p>
                Hinzufügung am linken Rand, markiert durch ein spezielles Zeichen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="otherHand"
                             place="left_margin"
                             rend="other_ink"
                             type="sign">
                           <lb/>zuͦ unnd be
                <lb break="no"/>schlossen </add> zuͦ halten ...
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-margin-en" xml:lang="en">
                  <p>
                Addition on the left margin, marked by a special sign
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="otherHand"
                             place="left_margin"
                             rend="other_ink"
                             type="sign">
                           <lb/>zuͦ unnd be
                <lb break="no"/>schlossen </add> zuͦ halten ...
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-add-margin-fr" xml:lang="fr">
                  <p>
                Ajout dans la marge de gauche, signalé par un signe de renvoi
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
            ... <add hand="otherHand"
                             place="left_margin"
                             rend="other_ink"
                             type="sign">
                           <lb/>zuͦ unnd be
                <lb break="no"/>schlossen </add> zuͦ halten ...
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-add-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, in die eine andere Hand Text eingetragen hat
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-add-en" xml:lang="en">
                  <p>
                Example of a damaged area where text has been written by another hand
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-add-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré où le texte a été écrit par une autre main
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-de" xml:lang="de">
                  <p>
                Beispiel für eine Ersetzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-en" xml:lang="en">
                  <p>
                Example of a replacement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-fr" xml:lang="fr">
                  <p>
                Exemple d’un remplacement (l’ajout remplace une suppression)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Der Ort der Hinzufügung muss zwingend in <att>place</att> und die Hand kann mit
            <att>hand</att> festgehalten werden. Handelt es sich um die Hand des Hauptschreibers,
            dann wird die Hand nicht speziell angemerkt. Falls notwendig, kann mit <att>rend</att>
            angegeben werden, mit welchem Schreibmittel (mit Bleistift oder mit anderer Tinte) die
            Hinzufügung vorgenommen wurde.
        </p>
                  <p>
            Es besteht die gleiche Problemlage wie im Fall von <gi>del</gi>: Hinzufügungen, die
            Hierarchiegrenzen überschreiten, müssen mit <gi>addSpan</gi> und <gi>anchor</gi>
            ausgezeichnet werden.
        </p>
                  <p>
            Ersetzt eine Hinzufügung eine Streichung, sollte <gi>subst</gi> verwendet werden.
        </p>
                  <p>
            Mit <gi>add</gi> werden keine Nachträge bzw. Zusätze aus anderen Textzeugen
            ausgezeichnet. Es wird nur für Hinzufügungen im selben Text verwendet. Ein Nachtrag am
            Schluss eines Textes von anderer Hand wird mit <gi>add</gi> und <gi>handShift</gi>
            umgesetzt.
        </p>
                  <p>
            Nachträglich hinzugefügte Titel auf Umschlägen (Heft, Doppelblatt) werden nicht in
            <gi>ab</gi>, sondern innerhalb eines <gi>head</gi> mit <gi>add</gi> mit <att>hand</att>
            = <val>otherHand</val> unter Angabe des Ortes in <att>place</att> erfasst.
        </p>
                  <p>
            Hinzufügungen, die wieder gestrichen werden, müssen wie folgt ausgezeichnet werden: mit
            <gi>del</gi>, das ein <gi>add</gi> enthält (und nicht andersherum).
        </p>
                  <p>
            Hinzufügungen, die als Vermerke zum Inhalt des Textes betrachtet werden können, sind
            mit <gi>ab</gi> zu taggen. Handelt es sich hingegen um weitere Informationen z. B. zur
            Versendung des gedruckten Mandats, Ergänzungen zu einzelnen Textteilen oder nicht mit
            dem Stück zusammenhängende Informationen ist <gi>add</gi> mit <att>hand</att> =
            <val>otherHand</val> zu verwenden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-18" xml:lang="en">
                  <p>
            The place of the addition must be in <att>place</att> and the hand of the added place
            can be held with <att>hand</att>. If necessary, <att>rend</att> can indicate how the
            addition (pencil, other ink, etc.) was made. If an addition is the hand of the first
            scribe, then the hand is not specifically noted.
        </p>
                  <p>
            The problem is the same as in the case of <gi>del</gi>. Insertions that cross hierarchy
            boundaries must be marked up with <gi>addSpan</gi> and <gi>anchor</gi>.
        </p>
                  <p>
            If an addition replaces a deletion, <gi>subst</gi> should be used. No supplements or
            additions from other text witnesses are marked with this. It is only used for additions
            in the same text. An addendum at the end of a text by another hand is converted with
            <gi>add</gi> and <gi>handShift</gi>.
        </p>
                  <p>
            Subsequently added titles on covers (booklet, double page) are not in <gi>ab</gi>, but
            within a <gi>head</gi> with <gi>add</gi> with <att>hand</att> = <val>otherHand</val>
            stating the location in <att>place</att>.
        </p>
                  <p>
            Additions that are deleted must be tagged with combined tags, namely <gi>del</gi>
            containing an <gi>add</gi> (and not the other way around).
        </p>
                  <p>
            Clear dorsal annotations that make a reference to the content of a print and/or record
            its dating are to be tagged as dorsal annotations with <gi>ab</gi>. If, on the other
            hand, it is more information, e.g. For sending the printed mandate, additions to
            individual parts of the text or information not related to the piece, <gi>add</gi>
            should be tagged with <att>hand</att> = <val>otherHand</val>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            L’emplacement de l’ajout doit être indiqué par <att>place</att> et la main du scribe
            peut être renseignée avec <att>hand</att>. S’il s’agit de la main du scribe principal,
            il n’est pas nécessaire de préciser la main. Si cela s’avère pertinent, <att>rend</att>
            permet d’indiquer avec quel moyen d’écriture (crayon ou autre encre) l’ajout a été
            effectué.
        </p>
                  <p>
            Les ajouts qui dépassent les limites hiérarchiques doivent être balisées avec
            <gi>addSpan</gi> et <gi>anchor</gi>. La limite hiérarchique est dépassée si
            l’utilisation de <gi>add</gi> ne suffit plus en raison de l’imbrication de nombreux
            éléments. Ce même principe s’applique pour <gi>damage</gi> et <gi>del</gi>.
        </p>
                  <p>
            Si un ajout remplace une suppression, <gi>subst</gi> doit être utilisé.
        </p>
                  <p>
            Avec <gi>add</gi>, on n’indique pas un ajout provenant d’autres sources textuelles ou
            d’un témoin. Il n’est utilisé que pour des ajouts dans un même texte. Un addendum à la
            fin d’un texte par une autre main est marqué avec <gi>add</gi> et <gi>handShift</gi>.
        </p>
                  <p>
            Les titres ajoutés ultérieurement sur les couvertures (livret, planche) ne sont pas
            indiqués par <gi>ab</gi>, mais dans un <gi>head</gi> avec <gi>add</gi> et
            <att>hand</att> = <val>otherHand</val> et en spécifiant l’emplacement dans
            <att>place</att>.
        </p>
                  <p>
            Les ajouts supprimés doivent être marqués comme suit : avec <gi>del</gi>, qui contient
            un <gi>add</gi> (et non l’inverse).
        </p>
                  <p>
            Les ajouts qui peuvent être considérés comme des notes sur le contenu du texte doivent
            être étiquetés avec <gi>ab</gi>. En revanche, s’il s’agit d’autres informations, p.
            ex., sur l’envoi d’un mandat ou d’une ordonnance imprimée, de compléments à certaines
            parties du texte ou d’informations sans rapport avec la pièce, <gi>add</gi> doit être
            utilisé avec <att>hand</att> = <val>otherHand</val>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD">3.5.3. Additions, Deletions, and Omissions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-del"
                         ident="del">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Tilgung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">deletion</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">suppression</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält eine Tilgung durch einen Schreiber.</desc>
               <desc rend="replace" versionDate="2023-05-24" xml:lang="en">Contains text deleted by a writer.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient une suppression effectuée par un
    scribe.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.written"/>
                  <memberOf key="model.pPart.transcriptional"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                     <sequence minOccurs="1" maxOccurs="1">
                        <elementRef key="head" minOccurs="0"/>
                        <elementRef key="p" maxOccurs="unbounded"/>
                     </sequence>
                     <sequence minOccurs="1" maxOccurs="unbounded">
                        <macroRef key="ssrq.content.default"/>
                     </sequence>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">das Aussehen der Tilgung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the appearance of the deletion</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">l’apparence de la suppression</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.del"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-del-de" xml:lang="de">
                  <p>
                Beispiel für eine einfache Streichung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        das best hoͧbt aͧn ein hoͧbt oder <del rend="strikethrough">das</del>
                     <lb/>das best gewant oder
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-en" xml:lang="en">
                  <p>
                Example of a simple deletion
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        das best hoͧbt aͧn ein hoͧbt oder <del rend="strikethrough">das</del>
                     <lb/>das best gewant oder
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-fr" xml:lang="fr">
                  <p>
                Exemple d’une suppression simple par biffage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        das best hoͧbt aͧn ein hoͧbt oder <del rend="strikethrough">das</del>
                     <lb/>das best gewant oder
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-gap-de" xml:lang="de">
                  <p>
                Unlesbare Textstelle aufgrund von Rasur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <del rend="rubbing">
                        <gap quantity="1" unit="cm"/>
                     </del>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-gap-en" xml:lang="en">
                  <p>
                Unreadable text passage due to rubbing
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <del rend="rubbing">
                        <gap quantity="1" unit="cm"/>
                     </del>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-gap-fr" xml:lang="fr">
                  <p>
                Passage de texte illisible en raison d’un grattage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <del rend="rubbing">
                        <gap quantity="1" unit="cm"/>
                     </del>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-de" xml:lang="de">
                  <p>
                Beispiel für eine Ersetzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-en" xml:lang="en">
                  <p>
                Example of a replacement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-fr" xml:lang="fr">
                  <p>
                Exemple d’un remplacement (l’ajout remplace une suppression)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-unclear-de" xml:lang="de">
                  <p>
                Unsichere Lesung wegen Streichung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        , wird pfand geben oder genommen umm <del>
                        <unclear>in</unclear>
                     </del>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-unclear-en" xml:lang="en">
                  <p>
                Unsafe reading due to deletion
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        , wird pfand geben oder genommen umm <del>
                        <unclear>in</unclear>
                     </del>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-del-unclear-fr" xml:lang="fr">
                  <p>
                Lecture incertaine en raison de la suppression
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        , wird pfand geben oder genommen umm <del>
                        <unclear>in</unclear>
                     </del>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-17" xml:lang="de">
                  <p>
            Mit <gi>del</gi> werden keine Streichungen, die von der Editorin oder dem Editor
            stammen, ausgezeichnet, sondern nur solche, die ein Schreiber vorgenommen hat. Bei
            mehrfach gestrichenen Texten, oder wenn Streichungen Hierarchiegrenzen überschreiten,
            müssen <gi>delSpan</gi> und <gi>anchor</gi> benutzt werden. Die Hierarchiegrenze wird
            überschritten, wenn die Verwendung von <gi>del</gi> aufgrund der Verschachtelung vieler
            Elemente nicht mehr ausreicht. Dasselbe Prinzip gilt für <gi>add</gi> und
            <gi>damage</gi>.
        </p>
                  <p>
            Rasuren werden mit dem Attribut <att>rend</att> = <val>rubbing</val> ausgezeichnet.
            Wenn bei Rasuren oder auch bei heftigen Streichungen gar nichts mehr lesbar ist, wird
            ein leeres <gi>gap</gi> innerhalb von <gi>del</gi> verwendet.
        </p>
                  <p>
            Das Attribut <att>hand</att> wird für Streichungen von anderer Hand verwendet, die oft
            an einer anderen Tintenfarbe zu erkennen sind. Handelt es sich um spätere
            Texteingriffe, z. B. Streichung mit anschliessender Korrektur, wird die Hand bei
            <gi>add</gi> innerhalb von <gi>subst</gi> nachgewiesen.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            With <gi>del</gi> no deletions that come from the editor are marked, only those that
            are in the source. If text is deleted several times or if deletions cross hierarchical
            boundaries, <gi>delSpan</gi> and <gi>anchor</gi> must be used.
        </p>
                  <p>
            Shaves are marked with the attribute <att>rend</att> = <val>rubbing</val>. If nothing
            is legible after shaving or heavy stroking, an empty <gi>gap</gi> is used within
            <gi>del</gi>.
        </p>
                  <p>
            The <att>hand</att> attribute is used for strokes with other ink. In later text
            interventions (deletion with correction), <att>hand</att> is found at <gi>add</gi>
            within <gi>subst</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-07-17" xml:lang="fr">
                  <p>
            Avec <gi>del</gi>, on ne marque pas les suppressions qui proviennent de l’éditeur, mais
            seulement celles qui ont été effectuées par un scribe. Pour les textes biffés plusieurs
            fois ou lorsque les suppressions dépassent les limites hiérarchiques, il faut utiliser
            <gi>delSpan</gi> et <gi>anchor</gi>. La limite hiérarchique est dépassée si
            l’utilisation de <gi>del</gi> ne suffit plus en raison de l’imbrication de nombreux
            éléments. Ce même principe s’applique pour <gi>add</gi> et <gi>damage</gi>.
        </p>
                  <p>
            Le texte érasé est signalés par l’attribut <att>rend</att> = <val>rubbing</val>. Si, en
            cas de gommage ou de ratures intense, plus rien n’est lisible, on utilise <gi>gap</gi>
            vide à l’intérieur de <gi>del</gi>.
        </p>
                  <p>
            L’attribut <att>hand</att> est utilisé pour les ratures d’une autre main, qui sont
            souvent reconnaissables à une autre couleur d’encre. S’il s’agit d’une intervention
            ultérieure sur le texte, par exemple une rature suivie d’une correction, la main est
            indiquée par <gi>add</gi> à l’intérieur de <gi>subst</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD">3.5.3. Additions, Deletions, and Omissions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-unclear"
                         ident="unclear">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">unklar</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">unclear</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">incertain</gloss>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="de">Enthält eine unsichere Lesung.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains an uncertain reading.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="fr">Contient une lecture incertaine.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
               </classes>
               <content>
                  <sequence minOccurs="0" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="reason" mode="delete"/>
                  <attDef ident="agent" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-unclear-de" xml:lang="de">
                  <p>
                Beispiel für eine unsichere Lesung ohne Beschädigung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    ve<unclear cert="high">stik</unclear>lich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-unclear-en" xml:lang="en">
                  <p>
                Example of an unsafe reading without damage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    ve<unclear cert="high">stik</unclear>lich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-unclear-fr" xml:lang="fr">
                  <p>
                Exemple de lecture incertaine sans altération
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
    ve<unclear cert="high">stik</unclear>lich
</egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Lesung unsicher ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-en" xml:lang="en">
                  <p>
                Example of a damaged passage whose reading is uncertain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-fr" xml:lang="fr">
                  <p>
                Exemple de passage altéré dont la lecture est incertaine
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Ist die Ursache eine Beschädigung, dann wird diese durch <gi>damage</gi> angegeben. Mit
            dem Attribut <att>cert</att> kann angegeben werden, wie sicher die Lesung ist. Erweist
            sich eine Stelle als absolut unlesbar, so wird sie stattdessen mit <gi>gap</gi>
            ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            If the cause is damage, then this is indicated by <gi>damage</gi>. <att>cert</att> can
            be used to specify how secure the reading is. If a passage turns out to be absolutely
            illegible, it is marked with <gi>gap</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Si la cause est une altération, celle-ci est indiquée avec <gi>damage</gi>. L’attribut
            <att>cert</att> permet d’indiquer le niveau de certitude de la lecture. Si un passage
            s’avère complètement illisible, il est signalé à la place par un <gi>gap</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA">12.3.3.1. Damage, Illegibility, and Supplied Text</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COEDADD">3.5.3. Additions, Deletions, and Omissions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-num"
                         ident="num">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Zahl</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">number</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">nombre</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Zahl.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="en">Contains a number.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un nombre.</desc>
               <classes>
                  <memberOf key="model.measureLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <elementRef key="hi"/>
                     <elementRef key="lb"/>
                     <elementRef key="pb"/>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="type" mode="delete"/>
                  <attDef ident="value" usage="req">
                     <desc rend="replace" versionDate="2025-02-03" xml:lang="de">der Zahlwert in arabischen Ziffern</desc>
                     <desc rend="replace" versionDate="2025-02-03" xml:lang="en">the numerical value in Arabic
            numerals</desc>
                     <desc rend="replace" versionDate="2025-02-03" xml:lang="fr">la valeur numérique en chiffres
            arabes</desc>
                     <datatype>
                        <rng:choice>
                           <rng:data type="float"/>
                           <rng:data type="int"/>
                        </rng:choice>
                     </datatype>
                     <valDesc>a numeric value.</valDesc>
                     <valDesc xml:lang="fr">une valeur numérique.</valDesc>
                     <valDesc xml:lang="de">ein numerischer Wert</valDesc>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-hi-num-de" xml:lang="de">
                  <p>
                Beispiel für eine römische Zahl
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-num-en" xml:lang="en">
                  <p>
                Example of a Roman number
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-hi-num-fr" xml:lang="fr">
                  <p>
                Exemple d’un nombre romain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="110">i<hi rend="sup">c</hi> und x</num> eyer.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-num-de" xml:lang="de">
                  <p>
                Beispiel für einen Bruch
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="0.75">3/4</num>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-num-en" xml:lang="en">
                  <p>
                Example of a fraction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="0.75">3/4</num>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-num-fr" xml:lang="fr">
                  <p>
                Exemple d’une fraction
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <num value="0.75">3/4</num>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Der Wert der Zahl wird im Attribut <att>value</att> maschinenlesbar hinterlegt.
        </p>
                  <p>
            Im Falle einer Bruchzahl werden Nenner und Zähler mit einem Schrägstrich voneinander
            getrennt und der Wert des Bruchs als Dezimalzahl im Attribut <att>value</att>
            hinterlegt.
        </p>
                  <p>
            Bei Angaben zu Massen, Gewichten, Währungen etc., in denen innerhalb von
            <gi>measure</gi> mit <att>quantity</att> die Anzahl ausgezeichnet wird, wird auf
            <gi>num</gi> verzichtet. Ebenso wird bei Daten, die mit <gi>date</gi>, und Zeiten, die
            mit <gi>time</gi> ausgezeichnet werden, auf <gi>num</gi> verzichtet.
        </p>
               </remarks>
               <remarks versionDate="2024-02-29" xml:lang="en">
                  <p>
            The value of the number is stored in machine-readable form in the <att>value</att>
            attribute.
        </p>
                  <p>
            In the case of a fractional number, the denominator and numerator are separated by a
            slash from each other and the value of the number as a decimal number in the
            <att>value</att> attribute deposited.
        </p>
                  <p>
            In the case of information on dimensions, weights, currencies, etc., in which
            <gi>measure</gi> is used to mark the number with <att>quantity</att>, <gi>num</gi> is
            not used. Likewise, <gi>num</gi> is not used for years that are described in more
            detail with <gi>date</gi> and <att>when-custom</att>. Within a time specification with
            <att>dur</att>, <gi>num</gi> is not used.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            La valeur du nombre est enregistrée avec l’attribut <att>value</att> de manière à être
            lisible par machine.
        </p>
                  <p>
            Dans le cas d’une fraction, le dénominateur et le numérateur sont séparés par une barre
            oblique et la valeur de la fraction est indiquée sous forme de numéro décimal dans
            l’attribut <att>value</att>.
        </p>
                  <p>
            Pour les données concernant les masses, les poids, les devises, etc., dans lesquelles
            le nombre est marqué avec <att>quantity</att> dans <gi>measure</gi>, on renonce à
            <gi>num</gi>. De même, <gi>num</gi> n’est pas utilisé pour les dates indiquées avec
            <gi>date</gi> ni pour les heures indiquées avec <gi>time</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONANU">3.6.3. Numbers and
Measures</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-measure"
                         ident="measure">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Massangabe</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">measure</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">mesure</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Enthält eine Massangabe jeder Art.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains a measurement of any type.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Contient une indication de mesure de n’importe
    quel type.</desc>
               <classes>
                  <memberOf key="att.measurement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.measureLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <macroRef key="ssrq.content.critical"/>
                     <macroRef key="ssrq.content.display"/>
                     <macroRef key="ssrq.content.content"/>
                     <macroRef key="ssrq.content.entities"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-measure"
                               mode="change"
                               module="core"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-03-23" xml:lang="en">constraint for tei:measure</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:measure[@type = 'age']">
                           <sch:let name="age" value="&#34;month|week|year&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $age, '$'))">
                    "
                        <sch:value-of select="./@unit"/>
                        " is not a valid time unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($age, '\|'), ',                         ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'area']">
                           <sch:let name="area"
                                    value="&#34;fauchée|Gertel|Hube|Juchart|Kammer|Klafter|Kuhsömmerung|Kuhwinterung|Mal|Mannmad|Mannwerk|Mitmal|Mütt|Rute|Schuh|Schuppose|Staffel|Tagwen|Zeile|Vierling&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $area, '$'))">
                    "
                        <sch:value-of select="./@unit"/>
                        " is not a valid area unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($area, '\|'), ',                         ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'currency']">
                           <sch:let name="currency"
                                    value="&#34;Angster|bluzger|Böhmischer_Groschen|bz|d|Dicken|Doubloon|ducatoon|Dukat|écu|écu_blanc|écu_dor|écu_petit|engrogne|filippo|fl|franc|Gros|Grossi|h|Halbgulden|Halbtaler|k|Kronentaler|L|lb|liard|lira|livre_faible|Louis_dor|Louistaler|lt|M|Mirliton|Ort|parpajola|Pistole|plp|Quart|S|scudo|soldo|sol_faible|Sonnendublone|Spagürli|ß|Taler|teston|Vierer|xr|zecchino&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $currency,                     '$'))"> "
                        <sch:value-of select="./@unit"/>
                        " is not a valid currency unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($currency, '\|'),                         ', ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'length']">
                           <sch:let name="length"
                                    value="&#34;Daumen|Elle|Finger|Fuss|Klafter|Linie|Meile|Schritt|Schuh|Stab|Vierling|Zoll|cm&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $length,                     '$'))"> "
                        <sch:value-of select="./@unit"/>
                        " is not a valid length unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($length, '\|'),                         ', ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'undefined']">
                           <sch:let name="various"
                                    value="&#34;Ballen|Bürde|Dutzend|Fuder|Gaden|Kloben|Laib|Loden|Maschen|Paar|Riste|Schoch|Schubkarre|Seil|Sester|Stock|Stuck|Zeine|billio|carriage&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $various,                     '$'))"> "
                        <sch:value-of select="./@unit"/>
                        " is not a valid unspecific unit – you need to choose from the
                        following list:
                        <sch:value-of select="string-join(tokenize($various, '\|'),                         ', ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'volume']">
                           <sch:let name="volume"
                                    value="&#34;Becher|Bosse|Brenten|Eimer|Fass|Fuder|Garbe|Immi|Kanne|Klafter|Kopf|Kratten|Kröttli|Ledi|Legel|Malter|Mass|Metzen|Mäss|Mässli|Mütt|Quart|Quartane|Röhrchen|Sack|Saum|Schaffen|Scheffel|Scheibe|Sechzehner|Sester|Ster|Stuck|Tonne|Trinken|Vierdung|Vierling|Viertel|Zuber|carica|water&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $volume,                     '$'))"> "
                        <sch:value-of select="./@unit"/>
                        " is not a valid capacity unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($volume, '\|'),                         ', ')"/>
                           </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:measure[@type = 'weight']">
                           <sch:let name="weight"
                                    value="&#34;Biner|Gewäg|Krinne|Lot|Pfefferpfund|Pfund|Quentli|Rupp|Stuck|Unze|Vierling|Zentner|denier|grain&#34;"/>
                           <sch:assert test="matches(@unit, concat('^', $weight,                     '$'))"> "
                        <sch:value-of select="./@unit"/>
                        " is not a valid weight unit – you need to choose from the following
                        list:
                        <sch:value-of select="string-join(tokenize($weight, '\|'),                         ', ')"/>
                           </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-30" xml:lang="de">die Art der Massangabe</desc>
                     <desc versionDate="2025-01-30" xml:lang="en">the type of measure</desc>
                     <desc versionDate="2025-01-30" xml:lang="fr">le type de la mesure</desc>
                     <datatype>
                        <dataRef key="ssrq.measure.att.type"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-measure-age-de" xml:lang="de">
                  <p>
                Beispiel für eine Altersangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>wan das jeman unser lannttluͤtten, er sye jung oder alltt,
        <lb/>
                     <measure quantity="14" type="age" unit="year">ob vierzechen jarenn</measure>
                     <lb/>von ainem paner endrunne ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-age-en" xml:lang="en">
                  <p>
                Example of an age statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>wan das jeman unser lannttluͤtten, er sye jung oder alltt,
        <lb/>
                     <measure quantity="14" type="age" unit="year">ob vierzechen jarenn</measure>
                     <lb/>von ainem paner endrunne ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-age-fr" xml:lang="fr">
                  <p>
                Exemple d’indication d’âge
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>wan das jeman unser lannttluͤtten, er sye jung oder alltt,
        <lb/>
                     <measure quantity="14" type="age" unit="year">ob vierzechen jarenn</measure>
                     <lb/>von ainem paner endrunne ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-price-de" xml:lang="de">
                  <p>
                Beispiel für einen Preis
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Item <measure commodity="wool" quantity="1" type="weight" unit="Zentner">ein zentner landtwull</measure> git <measure quantity="2" type="currency" unit="ß">ij ß</measure>.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-price-en" xml:lang="en">
                  <p>
                Example of a price
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Item <measure commodity="wool" quantity="1" type="weight" unit="Zentner">ein zentner landtwull</measure> git <measure quantity="2" type="currency" unit="ß">ij ß</measure>.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-price-fr" xml:lang="fr">
                  <p>
                Exemple de prix
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        Item <measure commodity="wool" quantity="1" type="weight" unit="Zentner">ein zentner landtwull</measure> git <measure quantity="2" type="currency" unit="ß">ij ß</measure>.
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-area-de" xml:lang="de">
                  <p>
                Beispiel für verschiedene Flächenangaben
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-area-en" xml:lang="en">
                  <p>
                Example of different area specifications
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-area-fr" xml:lang="fr">
                  <p>
                Exemple de différentes indications de territoires
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-de" xml:lang="de">
                  <p>
                Beispiel für Währungsbezeichnungen, die man auf Anhieb nicht umrechnen kann
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-en" xml:lang="en">
                  <p>
                Example of currency names that cannot be converted straight away
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-fr" xml:lang="fr">
                  <p>
                Exemple de noms de devises que l’on ne peut pas convertir d’un seul coup
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-unclear-de" xml:lang="de">
                  <p>
                Beispiel für eine unklare Mengenangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measure quantity="unknown" type="currency" unit="lb">etlich hundert pfund</measure>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-unclear-en" xml:lang="en">
                  <p>
                Example of an unclear quantity statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measure quantity="unknown" type="currency" unit="lb">etlich hundert pfund</measure>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measure-unclear-fr" xml:lang="fr">
                  <p>
                Exemple d’une indication de quantité peu claire
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measure quantity="unknown" type="currency" unit="lb">etlich hundert pfund</measure>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-de" xml:lang="de">
                  <p>
                Beispiel für verschiedene Mengenangaben von Getreide
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-en" xml:lang="en">
                  <p>
                Example of different amounts of grain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-fr" xml:lang="fr">
                  <p>
                Exemple de différentes quantités de céréales
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-23" xml:lang="de">
                  <p>
            Kann an einer Stelle keine genaue Mengenangabe gemacht werden, wird hierfür im Attribut
            <att>quantity</att> der Wert <val>unknown</val> verwendet. Stehen mehrere
            zusammengehörige Massangaben nebeneinander, werden diese mit <gi>measureGrp</gi> zu
            einer Gruppe zusammengefasst.
        </p>
               </remarks>
               <remarks versionDate="2025-07-23" xml:lang="en">
                  <p>
            If an exact quantity cannot be given at one point, then the value <val>unknown</val> is
            used in <att>quantity</att>. If there are several related quantities next to each
            other, they are combined into a group with <gi>measureGrp</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-07-23" xml:lang="fr">
                  <p>
            Si la quantité exacte ne peut pas être renseignée, la valeur <val>unknown</val> est
            utilisée avec l’attribut <att>quantity</att>. Si plusieurs indications de mesure se
            suivent côte à côte, elles sont réunies en un groupe avec <gi>measureGrp</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONANU">3.6.3. Numbers and
Measures</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-measureGrp"
                         ident="measureGrp">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Gruppe von Massangaben</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">measure group</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">mesures groupées</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Gruppe von Massangaben.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains a group of measurements.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un groupe de mesures.</desc>
               <classes>
                  <memberOf key="model.measureLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="cell" maxOccurs="unbounded" minOccurs="2"/>
                     <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                        <elementRef key="measure" maxOccurs="unbounded" minOccurs="2"/>
                        <alternate minOccurs="0" maxOccurs="unbounded">
                           <elementRef key="app"/>
                           <elementRef key="lb"/>
                           <textNode/>
                        </alternate>
                     </sequence>
                  </alternate>
               </content>
               <constraintSpec ident="sch-measureGrp" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-05-02" xml:lang="en">constraint for tei:measureGrp</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:measureGrp">
                           <sch:assert test="count(.//tei:measure) &gt; 1" xml:lang="en"> tei:measureGrp
                    should have at least two tei:measures as descendants. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-measureGrp-area-de" xml:lang="de">
                  <p>
                Beispiel für verschiedene Flächenangaben
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-area-en" xml:lang="en">
                  <p>
                Example of different area specifications
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-area-fr" xml:lang="fr">
                  <p>
                Exemple de différentes indications de territoires
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="field" quantity="3" type="area" unit="Juchart">dryg juchart akkers</measure> minder <measure commodity="field" quantity="0.5" type="area" unit="Mitmal">ains halben mitmels</measure>
                     </measureGrp>
                     <note>Es sind 3 Jucharten weniger 0.5 Mitmal (= 1/8 Juchart) = 2 7/8 Jucharten.</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-de" xml:lang="de">
                  <p>
                Beispiel für Währungsbezeichnungen, die man auf Anhieb nicht umrechnen kann
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-en" xml:lang="en">
                  <p>
                Example of currency names that cannot be converted straight away
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-currencies-fr" xml:lang="fr">
                  <p>
                Exemple de noms de devises que l’on ne peut pas convertir d’un seul coup
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        buͦß verfallen sin
        <measureGrp>
                        <measure quantity="3" type="currency" unit="lb">druͤ pfund</measure> und <measure quantity="5" type="currency" unit="ß">fuͤnf schilling
            pfenig</measure>
                     </measureGrp>
        . ...
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-de" xml:lang="de">
                  <p>
                Beispiel für verschiedene Mengenangaben von Getreide
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-en" xml:lang="en">
                  <p>
                Example of different amounts of grain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-measureGrp-wheat-fr" xml:lang="fr">
                  <p>
                Exemple de différentes quantités de céréales
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <measureGrp>
                        <measure commodity="wheat" quantity="10" type="volume" unit="Scheffel">zehen schoͤffel</measure> und <measure commodity="wheat" quantity="1" type="volume" unit="Viertel">ain viertail waissen</measure>
                     </measureGrp>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#msdim">11.3.4. Dimensions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-date"
                         ident="date">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Datum</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">date</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">date</gloss>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="de">Enthält ein Datum.</desc>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="en">Contains a date.</desc>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="fr">Contient une date.</desc>
               <classes>
                  <memberOf key="att.calendarSystem"/>
                  <memberOf key="att.datable"/>
                  <memberOf key="att.datable.custom"/>
                  <memberOf key="att.duration.iso"/>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <alternate minOccurs="0" maxOccurs="unbounded">
                     <elementRef key="precision"/>
                     <macroRef key="ssrq.content.default"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-date-outside-teiHeader"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-02-08" xml:lang="en">constraint for tei:date outside
        tei:teiHeader</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:date[not(ancestor::tei:teiHeader)]">
                           <sch:assert test="string-length(normalize-space(.)) &gt; 0 or child::*"> The
                    element tei:date must not be empty when outside tei:teiHeader. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-date-publicationStmt"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-02-08" xml:lang="en">constraint for tei:date inside
        tei:publicationStmt</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:date[ancestor::tei:publicationStmt]">
                           <sch:assert test="string-length(normalize-space(.)) = 0 and not(child::*)"> If
                    tei:date is part of tei:publicationStmt it must be empty. </sch:assert>
                           <sch:assert test=".[@type][@type/data(.) = ('electronic',                     'print')]"> If tei:date is part of tei:publicationStmt it must
                    contain @type with a value of 'electronic' or 'print'.
                    </sch:assert>
                           <sch:assert test=".[@when-custom or (@from-custom and                     @to-custom)][not(@calendar|@dur-iso|@notAfter-custom|@notBefore-custom|@period)]"> If tei:date is part of tei:publicationStmt it must contain @when-custom or @from-custom and to-custom, and may not contain @calendar, @dur-iso, @notAfter-custom, @notBefore-custom or @period. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="sch-el-date-electronic-print"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-02-17" xml:lang="en">constraint for tei:date with type
        'electronic' and 'print' outside tei:publicationStmt</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:date[not(ancestor::tei:publicationStmt)]">
                           <sch:report test=".[@type='electronic' or @type='print']">
                    If tei:date is outside tei:publicationStmt it may not be of @type
                    'electronic' or 'print'. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="dur-iso" mode="change">
                     <datatype>
                        <dataRef key="ssrq.duriso.date"/>
                     </datatype>
                  </attDef>
                  <attDef ident="period" mode="change">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.period.days"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.period.seasons"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Datums</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of date</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de date</desc>
                     <datatype>
                        <dataRef key="ssrq.type.date"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-date-abbr-de" xml:lang="de">
