            <dataSpec rend="add"
                      module="derived-module-ssrq-main-schema"
                      ident="ssrq.cover"
                      mode="add">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-10-27"
                     xml:lang="de">die Bezeichnung der Einbandseite</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-10-27"
                     xml:lang="en">the name of the cover page</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-10-27"
                     xml:lang="fr">le nom de la page de couverture</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <valList type="closed">
                     <valItem ident="cover">
                        <desc versionDate="2025-10-27" xml:lang="de">Einband</desc>
                        <desc versionDate="2025-10-27" xml:lang="en">cover</desc>
                        <desc versionDate="2025-10-27" xml:lang="fr">couverture</desc>
                        <desc versionDate="2025-10-27" xml:lang="it">copertina</desc>
                     </valItem>
                     <valItem ident="outside_front_cover">
                        <desc versionDate="2025-10-27" xml:lang="de">äussere vordere
                        Einbandseite</desc>
                        <desc versionDate="2025-10-27" xml:lang="en">outside front cover</desc>
                        <desc versionDate="2025-10-27" xml:lang="fr">plat supérieur (première de
                        couverture)</desc>
                        <desc versionDate="2025-10-27" xml:lang="it">prima di copertina</desc>
                     </valItem>
                     <valItem ident="inside_front_cover">
                        <desc versionDate="2025-10-27" xml:lang="de">innere vordere
                        Einbandseite</desc>
                        <desc versionDate="2025-10-27" xml:lang="en">inside front cover</desc>
                        <desc versionDate="2025-10-27" xml:lang="fr">contreplat supérieur (deuxième
                        de couverture)</desc>
                        <desc versionDate="2025-10-27" xml:lang="it">seconda di copertina</desc>
                     </valItem>
                     <valItem ident="inside_back_cover">
                        <desc versionDate="2025-10-27" xml:lang="de">innere hintere
                        Einbandseite</desc>
                        <desc versionDate="2025-10-27" xml:lang="en">inside back cover</desc>
                        <desc versionDate="2025-10-27" xml:lang="fr">contreplat inférieur
                        (troisième de couverture)</desc>
                        <desc versionDate="2025-10-27" xml:lang="it">terza di copertina</desc>
                     </valItem>
                     <valItem ident="outside_back_cover">
                        <desc versionDate="2025-10-27" xml:lang="de">äussere hintere
                        Einbandseite</desc>
                        <desc versionDate="2025-10-27" xml:lang="en">outside back cover</desc>
                        <desc versionDate="2025-10-27" xml:lang="fr">plat inférieur (quatrième de
                        couverture)</desc>
                        <desc versionDate="2025-10-27" xml:lang="it">quarta di copertina</desc>
                     </valItem>
                  </valList>
               </content>
            </dataSpec>
            <dataSpec rend="add"
                      module="derived-module-ssrq-main-schema"
                      ident="ssrq.date.calendar"
                      mode="add">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-29"
                     xml:lang="de">das Kalendersystem</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-29"
                     xml:lang="en">the calendar system</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-29"
                     xml:lang="fr">le système de calendrier</desc>
               <content xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <valList type="closed">
                     <valItem ident="gregorian">
                        <desc versionDate="2023-03-17" xml:lang="de">Gregorianischer
                        Kalender</desc>
                        <desc versionDate="2023-03-17" xml:lang="en">Gregorian calendar</desc>
                        <desc versionDate="2023-03-17" xml:lang="fr">calendrier grégorien</desc>
                        <desc versionDate="2023-03-17" xml:lang="it">calendario gregoriano</desc>
