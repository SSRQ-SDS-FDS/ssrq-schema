                     <editorialDecl>
                        <p>
                           <ref target="https://p.ssrq-sds-fds.ch/guidelines/transcription"/>
                        </p>
                     </editorialDecl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-editorialDecl-en" xml:lang="en">
                  <p>
                Sample transcription guidelines link
            </p>
