                        <desc versionDate="2023-05-02" xml:lang="en">in the middle of the
                        cover</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">au milieu de la
                        couverture</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">nel mezzo della
                        copertina</desc>
                     </valItem>
                     <valItem ident="left_margin">
                        <desc versionDate="2023-05-02" xml:lang="de">am linken Rand</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">on the left margin</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">dans la marge de gauche</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">sul margine sinistro</desc>
