               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COLI">3.8. Lists</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD6">2.6. The Revision Description</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-label"
                         ident="label">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Randanmerkung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">label</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">étiquette</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Enthält Randanmerkungen, die in den Editionstext
    integriert werden.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains marginal notes that are integrated into
    the edition text.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Contient des notes marginales qui seront intégrées
    dans le texte de l’édition.</desc>
               <classes>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
                  <memberOf key="model.labelLike"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-label" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-05-25" xml:lang="en">constraint for tei:label</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:label[not(parent::list)]">
                           <sch:assert test="preceding-sibling::*[1][self::tei:lb]"> tei:label must follow
                    after a tei:lb. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="place" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">der Ort der Randanmerkung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the place of the label</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le lieu de l’étiquette</desc>
                     <datatype>
                        <dataRef key="ssrq.place.label"/>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art der Randanmerkung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of the label</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de l’étiquette</desc>
                     <datatype>
                        <dataRef key="ssrq.type.label"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-label-de" xml:lang="de">
                  <p>
                Beispiel für eine Randanmerkung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <label place="left margin" type="keyword">Complices</label>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-label-en" xml:lang="en">
                  <p>
                Example of a marginal note
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <label place="left margin" type="keyword">Complices</label>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-label-fr" xml:lang="fr">
                  <p>
                Exemple de note marginale
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <label place="left margin" type="keyword">Complices</label>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COLI">3.8. Lists</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-head"
                         ident="head">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Überschrift</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">heading</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">titre</gloss>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="de">Enthält eine Überschrift oder einen Titel.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains a heading or title.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="fr">Contient un en-tête ou un titre.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="unbounded">
                        <elementRef key="bibl"/>
                        <elementRef key="p"/>
                        <macroRef key="ssrq.content.default"/>
                     </alternate>
                     <elementRef key="seg" maxOccurs="unbounded" minOccurs="2"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-head" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-02-25" xml:lang="en">constraint for tei:head</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:head[parent::tei:msDesc]">
                           <sch:report test=".[@hand or @n or @place or @resp or @type]"> If tei:head is
                    inside tei:msDesc the following attributes are forbidden: @hand, @n, @place,
                    @resp and @type. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="cert" mode="delete"/>
                  <attDef ident="n" mode="change">
                     <desc versionDate="2025-01-31" xml:lang="de">die Nummerierung der Überschrift</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the numbering of the heading</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">la numérotation du titre</desc>
                  </attDef>
                  <attDef ident="place" mode="change">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort der Überschrift</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the heading</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">le lieu du titre</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place.add"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="change">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art der Überschrift</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of heading</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type du titre</desc>
                     <datatype>
                        <dataRef key="ssrq.type.head"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-head-de" xml:lang="de">
                  <p>
                Titel, der von den Bearbeitenden zur besseren Strukturierung des Texts hinzugefügt wird
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <head resp="PS">Erbrecht</head>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-head-en" xml:lang="en">
                  <p>
                Title added by the editors to better structure the text
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <head resp="PS">Erbrecht</head>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-head-fr" xml:lang="fr">
                  <p>
                Titre ajouté par les éditeurs pour mieux structurer le texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <head resp="PS">Erbrecht</head>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-head-table-de" xml:lang="de">
                  <p>
                Beispiel für eine Überschrift in einer Tabelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-head-table-en" xml:lang="en">
                  <p>
                Example of a heading in a table
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-head-table-fr" xml:lang="fr">
                  <p>
                Exemple d’en-tête dans un tableau
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-09-26" xml:lang="de">
                  <p>
            Als Teil des <gi>teiHeader</gi> enthält das Element den Titel des Dokuments oder den
            Titel des Textträgers. Innerhalb des <gi>body</gi> kann <gi>head</gi> die Überschrift
            eines Kapitels oder Unterkapitels angeben, in <gi>list</gi> die Überschrift einer
            Liste, in <gi>table</gi> die Überschrift einer Tabelle.
        </p>
                  <p>
            Eine durch die Bearbeitenden hinzugefügte Überschrift, die nicht im Original vorhanden
            ist, wird mit dem Attribut <att>resp</att> gekennzeichnet. Mit dem Attribut
            <att>n</att> kann die Überschrift nummeriert, mit <att>xml:lang</att> eine vom
            umgebenden Text abweichende Sprache angegeben werden, auf <gi>foreign</gi> kann in
            diesem Fall verzichtet werden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-19" xml:lang="en">
                  <p>
            Contains the title of the document as part of the <gi>teiHeader</gi> and the
            description of the cited short title as part of <gi>listBibl</gi>; in <gi>body</gi> the
            heading of a chapter or subchapter etc.
        </p>
               </remarks>
               <remarks versionDate="2025-09-26" xml:lang="fr">
                  <p>
            S’il fait partie du <gi>teiHeader</gi>, l’élément contient le titre du document ou le
            titre du support de texte. A l’intérieur de <gi>body</gi>, <gi>head</gi> peut signaler
            le titre d’un chapitre ou d’un sous-chapitre, dans <gi>list</gi> le titre d’une liste,
            dans <gi>table</gi> le titre d’un tableau.
        </p>
                  <p>
            Un titre ajouté par les éditeurs qui n’est pas présent dans l’original est marqué avec
            l’attribut <att>resp</att>. L’attribut <att>n</att> peut être utilisé pour numéroter le
            titre et <att>xml:lang</att> peut être utilisé pour signaler une langue différente du
            texte principal. Dans ce cas, on peut renoncer à <gi>foreign</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSHD">4.2.1. Headings and Trailers</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-note"
                         ident="note">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Anmerkung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">note</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">note</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält entweder eine sachkritische Anmerkung zu
    einer Einzelstelle im Editionstext oder innerhalb von <gi>app</gi> den Verweis auf einen
    weiteren Textzeugen, in dem eine Textstelle wiederverwendet wird.</desc>
               <desc rend="replace" versionDate="2024-05-02" xml:lang="en">Contains either a factual comment on a single
    passage of the text of the edition or a reference to another textual witness in which the
    respective text is reused.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient soit une remarque critique sur un passage
    isolé dans le texte de l’édition, soit, à l’intérieur de <gi>app</gi>, le renvoi à un autre
    texte témoin dans lequel un passage est réutilisé.</desc>
               <classes>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="bibl"/>
                     <elementRef key="ref"/>
                     <macroRef key="ssrq.content.default"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-note" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-10-30" xml:lang="en">constraint for tei:note</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:note[parent::tei:app]">
                           <sch:assert test="every $child in * satisfies $child/name() = ('ref',                     'orig')"> If a tei:note is used inside tei:app, only tei:ref and
                    tei:orig are allowed as children. </sch:assert>
                           <sch:assert test="count(tei:ref) = 1"> A tei:note inside tei:app must have
                    exactly one tei:ref as a child. </sch:assert>
                           <sch:assert test="count(tei:orig) = 1 or count(tei:orig) = 0"> A tei:note
                    inside tei:app may have one or no tei:orig as a child. </sch:assert>
                           <sch:assert test="every $t in text()[normalize-space()] satisfies                     string-length($t) = 0"> A tei:note inside tei:app must not have text content.
                    </sch:assert>
                           <sch:assert test=".[@type]"> A tei:note inside a critical apparatus must have a
                    @type attribute. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:note[@type='text_comparison']">
                           <sch:assert test="parent::tei:app"> A tei:note with @type
                    "text_comparison" must be a child of tei:app. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art der Anmerkung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of note</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de la note</desc>
                     <datatype>
                        <dataRef key="ssrq.type.note"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-note-de" xml:lang="de">
                  <p>
                Anmerkung der Bearbeitenden
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>Fischer-Ordnung
    <lb/>vom Jahr <date calendar="gregorian"
                           from-custom="1710-01-01"
                           to-custom="1710-12-31">1710</date>. <note>Gemeint ist die Fischerordnung von 1710
    (<bibl>
                           <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?ID=3293386">StAZH III AAb 1.7, Nr. 76</ref>
                        </bibl>).</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-note-en" xml:lang="en">
                  <p>
                Note by the editor
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>Fischer-Ordnung
    <lb/>vom Jahr <date calendar="gregorian"
                           from-custom="1710-01-01"
                           to-custom="1710-12-31">1710</date>. <note>Gemeint ist die Fischerordnung von 1710
    (<bibl>
                           <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?ID=3293386">StAZH III AAb 1.7, Nr. 76</ref>
                        </bibl>).</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-note-fr" xml:lang="fr">
                  <p>
                Note de l’éditeur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>Fischer-Ordnung
    <lb/>vom Jahr <date calendar="gregorian"
                           from-custom="1710-01-01"
                           to-custom="1710-12-31">1710</date>. <note>Gemeint ist die Fischerordnung von 1710
    (<bibl>
                           <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?ID=3293386">StAZH III AAb 1.7, Nr. 76</ref>
                        </bibl>).</note>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-de" xml:lang="de">
                  <p>
                Beispiel für einen Apparat mit Textvergleich
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-en" xml:lang="en">
                  <p>
                Example of an apparatus with text comparison
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-app-note-fr" xml:lang="fr">
                  <p>
                Exemple d’un apparat critique avec comparaison de texte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <app>
                        <lem>graffschafft und gericht fuͤren oder ob man
                <lb/>jemant da fachen und usser miner herren <term ref="lem003769.02">biet</term> fuͤren welte</lem>
                        <rdg wit="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810d">ampt unnd
                <lb/>gepiet fachen oder füerenn</rdg>
                        <note type="text_comparison">
                           <ref target="urn:ssrq:SSRQ-SG-III_4-129-1">SSRQ-SG-III_4-129-1, Art.
                2</ref>
                           <orig>ampt unnd
                    <lb/>gepiet fachen oder füerenn</orig>
                        </note>
                     </app>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Ein <gi>note</gi>-Element folgt unmittelbar auf sein Bezugswort im Editionstext. Wird
            innerhalb von <gi>note</gi> Originaltext zitiert, wird dieser mit <gi>orig</gi>
            ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2024-05-02" xml:lang="en">
                  <p>
            A <gi>note</gi> element immediately follows the reference word in the edition text. If
            original text is quoted, it is marked with <gi>orig</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Un élément <gi>note</gi> suit immédiatement sa référence dans le texte de l’édition. Si
            le texte original est cité à l’intérieur de <gi>note</gi>, il est signalé avec
            <gi>orig</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONONO">3.9.1. Notes and Simple Annotation</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD27">2.2.6. The Notes Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICON">3.12.2.8. Notes and Statement of Language</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DI.html#DITPNO">10.3.5.4. Notes within Entries</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="GRAPHIC"
                         ident="graphic">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Graphik</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">graphic</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">graphique</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält in seinen Attributen einen Link zu einer
    Bilddatei.</desc>
               <desc rend="replace" versionDate="2023-03-15" xml:lang="en">Contains information about an image or graphic
    illustration as part of the text or external reference.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient dans ses attributs un lien vers un
    fichier image.</desc>
               <classes>
                  <memberOf key="att.internetMedia"/>
                  <memberOf key="att.resourced"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.graphicLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="sch-el-graphic" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-03-15" xml:lang="en">constraint for tei:graphic</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:graphic">
                           <sch:assert test="not(contains(@url, '/'))"> The usage of a
                    '/' is not allowed in @url </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art der Graphik</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of graphic</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type de graphique</desc>
                     <datatype>
                        <dataRef key="ssrq.type.graphic"/>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COGR">3.10. Graphics and Other Non-textual Components</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHFAX">12.1. Digital Facsimiles</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-pb"
                         ident="pb">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Seitenanfang</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">page beginning</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">début de page</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Markiert den Anfang einer Seite.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Describes the beginning of a page in the
    original.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Signale le début d’une page.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="att.global.facs"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.milestoneLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="n" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">die Nummerierung der neuen Seite</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the numbering of the new page</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">la numérotation de la nouvelle page</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.cover"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.numbering"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Seitenfangs</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of page beginning</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type du début de page</desc>
                     <datatype>
                        <dataRef key="ssrq.type.pb"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-pb-break-de" xml:lang="de">
                  <p>
                Trennung von Worten über Seitenwechsel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        geschri
        <pb/>
                     <lb break="no"/>ben
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-break-en" xml:lang="en">
                  <p>
                Separation of words spanning over page break
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        geschri
        <pb/>
                     <lb break="no"/>ben
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-break-fr" xml:lang="fr">
                  <p>
                Séparation des mots sur le changement de page
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
        geschri
        <pb/>
                     <lb break="no"/>ben
    </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-original-de" xml:lang="de">
                  <p>
                Beispiel für eine Originalfoliierung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r" type="original"/>
                     <lb/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-original-en" xml:lang="en">
                  <p>
                Example of original foiling
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r" type="original"/>
                     <lb/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-original-fr" xml:lang="fr">
                  <p>
                Exemple pour des folios originaux
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r" type="original"/>
                     <lb/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-section-de" xml:lang="de">
                  <p>
                Beispiel für eine Zählung von Pergamentstücken
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="s29"/>
                     <p>
                        <lb/>Allocantur sibi quos dominus dicto vicecastellano in presenti computo intrari
            <lb/>et allocari mandavit, in plenam satisfactionem expensarum de quibus
            <lb/>...
        </p>
                     <pb n="s30"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-section-en" xml:lang="en">
                  <p>
                Example of counting pieces of parchment
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="s29"/>
                     <p>
                        <lb/>Allocantur sibi quos dominus dicto vicecastellano in presenti computo intrari
            <lb/>et allocari mandavit, in plenam satisfactionem expensarum de quibus
            <lb/>...
        </p>
                     <pb n="s30"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-section-fr" xml:lang="fr">
                  <p>
                Exemple de comptage de section d’un parchemin
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="s29"/>
                     <p>
                        <lb/>Allocantur sibi quos dominus dicto vicecastellano in presenti computo intrari
            <lb/>et allocari mandavit, in plenam satisfactionem expensarum de quibus
            <lb/>...
        </p>
                     <pb n="s30"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-title-de" xml:lang="de">
                  <p>
                Blattzählung von Vorsatz- und Titelblättern mit römischen Ziffern
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_Ir" n="Ir"/>
                     <head>Urbar oder libell der <orgName>burgern zue <placeName>Werdenberg</placeName>
                        </orgName> er, vidimiert und renoviert anno salutis <date calendar="unknown" from-custom="1640-01-01" to-custom="1640-12-31">1640</date>
                     </head>
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_1" n="1"/>
                     <p>
                        <lb/>Ich, <persName>Jacob Felldtmann</persName>, der junger, der zeith der hochgeachten woledlen gestrengen frommen ehren ...
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-title-en" xml:lang="en">
                  <p>
                Page counting of endpapers and title pages with Roman numerals
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_Ir" n="Ir"/>
                     <head>Urbar oder libell der <orgName>burgern zue <placeName>Werdenberg</placeName>
                        </orgName> er, vidimiert und renoviert anno salutis <date calendar="unknown" from-custom="1640-01-01" to-custom="1640-12-31">1640</date>
                     </head>
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_1" n="1"/>
                     <p>
                        <lb/>Ich, <persName>Jacob Felldtmann</persName>, der junger, der zeith der hochgeachten woledlen gestrengen frommen ehren ...
        </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-pb-with-title-fr" xml:lang="fr">
                  <p>
                Pagination de plusieurs pages de titre ou pages de garde avec des chiffres romains
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_Ir" n="Ir"/>
                     <head>Urbar oder libell der <orgName>burgern zue <placeName>Werdenberg</placeName>
                        </orgName> er, vidimiert und renoviert anno salutis <date calendar="unknown" from-custom="1640-01-01" to-custom="1640-12-31">1640</date>
                     </head>
                     <pb facs="Burgerarchiv_Grabs_U_1640-1_1" n="1"/>
                     <p>
                        <lb/>Ich, <persName>Jacob Felldtmann</persName>, der junger, der zeith der hochgeachten woledlen gestrengen frommen ehren ...
        </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
                     <gi>pb</gi> wird am Anfang der Seite aufgeführt und enthält im Attribut <att>n</att> in
            der Regel die Nummerierung der Seite. Es können Foliierungen (z. B. <tag>pb
            n="109v"</tag>), Paginierungen (z. B. <tag>pb n="22"</tag>) oder
            bei Rotuli Abschnittszählungen von Pergamentstücken (z. B: <tag>pb
            n="s1"</tag>) verwendet werden. Eine aus dem Original stammende Nummerierung
            wird mit <att>type</att> = <val>original</val> gekennzeichnet. Besteht keine originale
            Zählung, wird eine Foliierung eingeführt.
        </p>
                  <p>
            Wenn ein Quellentext lediglich eine Seite umfasst (z. B. eine Urkunde), wird
            <gi>pb</gi> nur für das Verlinken mit den Faksimiles benötigt. Wenn ein Text über
            Vorderseite und Rückseite eines Einzelblatts verläuft (2 Seiten), wird <gi>pb</gi> ohne
            Attribute auf der ersten und zweiten Seite gesetzt. Erst ab drei Seiten wird mit
            <att>n</att> nummeriert. Bei mehreren Titelblättern oder Vorsatzblätter vor Beginn des
            eigentlichen Inhalts und der eigentlichen Paginierung empfiehlt sich eine Blattzählung
            im Attribut <att>n</att> mit römischen Ziffern (I, II, III, IV etc.), wie bei
            Handschriften üblich. Bei Drucken beginnt die Blattzählung (Foliierung) mit dem
            Titelblatt. Das Titelblatt wird nicht speziell ausgezeichnet. Leere Blätter oder leere
            Seiten werden mitgezählt. Bogensignaturen oder Lagenbezeichnungen werden nicht
            transkribiert.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
                     <gi>pb</gi> is listed at the top of the page and usually contains the foliation, e.g.
            <tag>pb n="109v"</tag>, or pagination, e.g. <tag>pb n="22"</tag>,
            in <att>n</att>. An original pagination or original foliation is marked with
            <att>type</att> = <val>original</val>. In the case of a source with original foiling,
            the verso is also marked with <att>type</att> = <val>original</val>.
        </p>
                  <p>
            If a source text is only one page long (e.g. a certificate), <gi>pb</gi> is only
            required for linking to the facsimiles. If a text runs over the front and back of a
            single sheet (2 pages), <gi>pb</gi> is set without attributes on the first and second
            page. Pages of three or more are numbered with <att>n</att>. On a toboggan, the change
            of sides is noted at the point where a new piece of parchment was sewn on. If there are
            several title pages or flyleaves before the beginning of the actual content and the
            actual pagination, it is advisable to number the pages <att>n</att> with Roman numerals
            (I, II, III, IV etc.), as is usual with manuscripts. When printing, sheet counting
            (foliation) begins with the title sheet. The title page is not specially marked. An
            existing page or sheet number is adopted and provided with <att>type</att> =
            <val>original</val>. Blank sheets or blank pages are counted. If there is no original
            page number, a page number is introduced. Sheet signatures are not transcribed.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
                     <gi>pb</gi> est mentionné au début de la page et contient généralement la numérotation
            des pages dans l’attribut <att>n</att>. Il est possible d’indiquer des folios (p. ex.
            <tag>pb n="109v"</tag>), des paginations (p. ex. <tag>pb
            n="22"</tag>) ou, dans le cas de rotuli, des comptages de sections de
            parchemin (p. ex. <tag>pb n="s1"</tag>). Une numérotation provenant de
            l’original est signalée avec <att>type</att> = <val>original</val>. S’il n’y a pas de
            numérotation originale, une foliation est introduit.
        </p>
                  <p>
            Si un texte source ne comprend qu’une seule page (p. ex. un document), <gi>pb</gi>
            n’est nécessaire que pour établir un lien vers les fac-similés. Si un texte s’étend sur
            le recto et le verso d’une seule feuille (2 pages), <gi>pb</gi> est placé sans
            attributs sur la première et la deuxième page. Ce n’est qu’à partir de trois pages que
            la numérotation se fait avec <att>n</att>. Dans le cas de plusieurs pages de titre ou
            de garde avant le début du contenu et de la pagination proprement dits, il est
            recommandé de compter les feuilles dans l’attribut <att>n</att> avec des chiffres
            romains (I, II, III, IV etc.), comme c’est habituellement le cas pour les manuscrits.
            Pour les imprimés, la numérotation des pages (foliation) commence avec la page de
            titre. La page de titre n’est pas spécialement marquée. Les feuilles ou pages blanches
            sont comptées. Les signatures des feuilles ou les désignations de position ne sont pas
            transcrites.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CORS5">3.11.3. Milestone
Elements</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-lb"
                         ident="lb">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Zeilenanfang</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">line beginning</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">début de ligne</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Markiert den Anfang einer Zeile.</desc>
               <desc rend="replace" versionDate="2023-04-21" xml:lang="en">Describes the beginning of a line.</desc>
               <desc rend="replace" versionDate="2023-04-21" xml:lang="fr">Signale le début d’une ligne.</desc>
               <classes>
                  <memberOf key="att.breaking"/>
                  <memberOf key="att.global.facs"/>
                  <memberOf key="model.milestoneLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <exemplum xml:id="ex-lb-de" xml:lang="de">
                  <p>
                Beispiel für eine Worttrennung am Zeilenende
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>ditz was do geschri
    <lb break="no"/>ben
</egXML>
               </exemplum>
               <exemplum xml:id="ex-lb-en" xml:lang="en">
                  <p>
                Example of word separation at the end of a line
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>ditz was do geschri
    <lb break="no"/>ben
</egXML>
               </exemplum>
               <exemplum xml:id="ex-lb-fr" xml:lang="fr">
                  <p>
                Exemple de séparation de mots en fin de ligne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <lb/>ditz was do geschri
    <lb break="no"/>ben
</egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Wird vor jeder Zeile an den Anfang der Zeile gesetzt, auch vor der ersten Zeile des
            Textes und wenn ein neuer Abschnitt beginnt. Wird auch bei Texten mit nur einer Zeile
            verwendet. Einrückungen werden nicht berücksichtigt.
        </p>
                  <p>
            Das Attribut <att>break</att> mit dem Wert <val>no</val> zeigt an, dass kein
            Zeilenumbruch ausserhalb eines Wortes vorliegt, das Folgende also kein neues Wort
            darstellt. Das gilt auch, wenn der Zeilenumbruch mit einem Seitenumbruch zusammenfällt.
        </p>
                  <p>
            Bei gedruckten Texten werden analog zu den handschriftlichen Texten Trennstriche mit
            eben hiermit und Bindestrichen bzw. Ergänzungsstriche mit <val>-</val> transkribiert.
        </p>
               </remarks>
               <remarks versionDate="2025-02-03" xml:lang="en">
                  <p>
            Placed at the beginning of the line before each line, including before the first line
            of text and when a new paragraph begins. Also used for texts with only one line.
            Indentations are ignored.
        </p>
                  <p>
            The attribute <att>break</att> shows whether there is a line break within a word – even
            if the line break coincides with the page break. In printed texts, hyphens are
            transcribed with just hereby and hyphens or additional dashes with '-',
            analogous to handwritten texts.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Se place au début de chaque ligne, même avant la première ligne du texte et lorsqu’un
            nouveau paragraphe commence. Est également utilisé pour les textes ne comportant qu’une
            seule ligne. Les indentations ne sont pas prises en compte.
        </p>
                  <p>
            L’attribut <att>break</att> avec la valeur <val>no</val> indique qu’il n’y a pas de
            saut de ligne en dehors d’un mot, et que ce qui suit ne constitue donc pas un nouveau
            mot. Cela vaut également lorsque le saut de ligne coïncide avec un saut de page.
        </p>
                  <p>
            Dans les textes imprimés, les traits d’union sont transcrits de la même manière que
            pour les textes manuscrits, les tirets étant signalés avec cet élément, alors que les
            tirets supplémentaires sont transcrits avec <val>-</val>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CORS5">3.11.3. Milestone
Elements</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DR.html#DRPAL">7.2.5. Speech Contents</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-cb"
                         ident="cb">
               <gloss rend="replace" versionDate="2023-08-23" xml:lang="de">Spaltenanfang</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">column beginning</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">début de colonne</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Markiert in einem mehrspaltigen Text den Anfang
    einer Spalte.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="en">Describes the beginning of a new column.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Signale le début d’une colonne dans un texte
    structuré en plusieurs colonnes.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.milestoneLike"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="n" mode="replace">
                     <desc versionDate="2025-01-31" xml:lang="de">die Spaltenzählung des Originals</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the column count of the original</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le nombre de colonnes de l’original</desc>
                     <datatype>
                        <dataRef key="ssrq.n.cb"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-cb-de" xml:lang="de">
                  <p>
                Beispiel für den Beginn einer neuen Spalte
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r"/>
                     <cb n="a"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <cb n="b"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <pb n="1v"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-cb-en" xml:lang="en">
                  <p>
                Example for the beginning of a new column
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r"/>
                     <cb n="a"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <cb n="b"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <pb n="1v"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-cb-fr" xml:lang="fr">
                  <p>
                Exemple de début de colonne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <pb n="1r"/>
                     <cb n="a"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <cb n="b"/>
                     <p>
        ...
    </p>
                     <p>
        ...
    </p>
                     <pb n="1v"/>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CORS5">3.11.3. Milestone
Elements</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-author"
                         ident="author">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Autor</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">author</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">auteur</gloss>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="de">Enthält den Autor eines Stücks oder als Teil von
    <gi>msItem</gi> den Schreiber.</desc>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="en">Contains the writer of a source as part of
    <gi>msItem</gi>.</desc>
               <desc rend="replace" versionDate="2025-07-14" xml:lang="fr">Permet d’indiquer l’auteur d’une source, ou le
    scribe, à l’intérieur de <gi>msItem</gi>.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="att.naming"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded" preserveOrder="false">
                     <elementRef key="persName" minOccurs="0"/>
                     <textNode/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="role" mode="replace">
                     <desc versionDate="2025-02-24" xml:lang="de">die Rolle des Schreibers</desc>
                     <desc versionDate="2025-02-24" xml:lang="en">the role of the writer</desc>
                     <desc versionDate="2025-02-25" xml:lang="fr">le rôle du scribe</desc>
                     <datatype>
                        <dataRef key="ssrq.role.author"/>
                     </datatype>
                  </attDef>
                  <attDef ident="resp" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-author-de" xml:lang="de">
                  <p>
                Beispiel für die Angabe des Schreibers
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <author role="scribe">
                        <persName ref="per002336">Adam Böniger</persName>, Landschreiber von Glarus </author>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-author-en" xml:lang="en">
                  <p>
                Example of identifying the scribe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <author role="scribe">
                        <persName ref="per002336">Adam Böniger</persName>, Landschreiber von Glarus </author>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-author-fr" xml:lang="fr">
                  <p>
                Exemple d’identification du scribe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <author role="scribe">
                        <persName ref="per002336">Adam Böniger</persName>, Landschreiber von Glarus </author>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOR">3.12.2.2. Titles, Authors, and Editors</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD21">2.2.1. The Title Statement</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-editor"
                         ident="editor">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Herausgeber/Herausgeberin</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">editor</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">éditeur</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Herausgeberin/einen Herausgeber der
    Editionseinheit.</desc>
               <desc rend="replace" versionDate="2023-08-17" xml:lang="en">In the <gi>titleStmt</gi> of a piece, the editors
    of the edition unit are thus recorded.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un éditeur de l’unité d’édition.</desc>
               <classes/>
               <content>
                  <elementRef key="persName"/>
               </content>
               <exemplum xml:id="ex-editor-de" xml:lang="de">
                  <p>
                Angabe der Bearbeitenden eines Bandes
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <titleStmt>
        ...
        <editor>
                           <persName>Ariane Huber Hernández</persName>
                        </editor>
                        <editor>
                           <persName>Michael Nadig</persName>
                        </editor>
        ...
    </titleStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-editor-en" xml:lang="en">
                  <p>
                Indication of the editors of a volume
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <titleStmt>
        ...
        <editor>
                           <persName>Ariane Huber Hernández</persName>
                        </editor>
                        <editor>
                           <persName>Michael Nadig</persName>
                        </editor>
        ...
    </titleStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-editor-fr" xml:lang="fr">
                  <p>
                Indication des personnes ayant travaillé sur un volume
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <titleStmt>
        ...
        <editor>
                           <persName>Ariane Huber Hernández</persName>
                        </editor>
                        <editor>
                           <persName>Michael Nadig</persName>
                        </editor>
        ...
    </titleStmt>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOR">3.12.2.2. Titles, Authors, and Editors</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-respStmt"
                         ident="respStmt">
               <gloss rend="replace" versionDate="2025-02-06" xml:lang="de">Angaben zur Verantwortung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">responsibility statement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">statut de la responsabilité</gloss>
               <desc rend="replace" versionDate="2025-02-21" xml:lang="de">Enthält Elemente zur Beschreibung der
    Verantwortung der Beteiligten an der Edition.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains elements for describing the
    responsibility for the edition.</desc>
               <desc rend="replace" versionDate="2025-02-21" xml:lang="fr">Contient des éléments déclaratifs sur la
    responsabilité des personnes impliquées dans l’édition.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="1">
                        <elementRef key="persName" maxOccurs="unbounded"/>
                        <elementRef key="orgName"/>
                     </alternate>
                     <elementRef key="resp" maxOccurs="unbounded"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-respStmt-de" xml:lang="de">
                  <p>
                Codierung einer einzelnen Verantwortlichkeit, inklusive des Namens
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-respStmt-en" xml:lang="en">
                  <p>
                Coding of a single responsibility, including the name
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-respStmt-fr" xml:lang="fr">
                  <p>
                Encodage de la responsabilité d’une personne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOR">3.12.2.2. Titles, Authors, and Editors</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD21">2.2.1. The Title Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD22">2.2.2. The Edition Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD26">2.2.5. The Series Statement</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-resp"
                         ident="resp">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Verantwortung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">responsibility</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">responsabilité</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Beschreibt die Art der Verantwortung der
    Beteiligten an der Edition.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Describes the nature of the responsibility.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Décrit la nature de la responsabilité des
    personnes impliquées dans l’édition.</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <macroRef key="ssrq.role.resp.de"/>
                     <macroRef key="ssrq.role.resp.fr"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-respStmt-de" xml:lang="de">
                  <p>
                Codierung einer einzelnen Verantwortlichkeit, inklusive des Namens
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-respStmt-en" xml:lang="en">
                  <p>
                Coding of a single responsibility, including the name
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-respStmt-fr" xml:lang="fr">
                  <p>
                Encodage de la responsabilité d’une personne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <respStmt>
                        <persName>Rainer Hugener</persName>
                        <resp>Transkription</resp>
                        <resp>Erstellung Faksimile</resp>
                     </respStmt>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOR">3.12.2.2. Titles, Authors, and Editors</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD21">2.2.1. The Title Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD22">2.2.2. The Edition Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD26">2.2.5. The Series Statement</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-title"
                         ident="title">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Titel</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">title</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">titre</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält als Teil des <gi>titleStmt</gi> den Titel
    des Bandes bzw. der Editionseinheit, als Teil des <gi>seriesStmt</gi> den Titel der Reihe
    SSRQ.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains the title of the volume of legal sources
    or the edition unit as part of the <gi>titleStmt</gi>, and the title of the series as part of
    the <gi>seriesStmt</gi>.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient le titre du volume ou de l’unité
    d’édition à l’intérieur du <gi>titleStmt</gi>, et le titre de la série des SDS à l’intérieur de
    <gi>seriesStmt</gi>.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.emphLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <textNode/>
                     <elementRef key="pc"/>
                     <elementRef key="hi"/>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="level" mode="delete"/>
                  <attDef ident="type" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-title-de" xml:lang="de">
                  <p>
                Beispiel für einen Bandtitel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <title>Rechtsquellen der Stadt und Herrschaft Rapperswil (mit den Höfen Busskirch/Jona, Kempraten und Wagen) </title>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-title-en" xml:lang="en">
                  <p>
                Example of a volume title
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <title>Rechtsquellen der Stadt und Herrschaft Rapperswil (mit den Höfen Busskirch/Jona, Kempraten und Wagen) </title>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-title-fr" xml:lang="fr">
                  <p>
                Exemple de titre de volume
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <title>Rechtsquellen der Stadt und Herrschaft Rapperswil (mit den Höfen Busskirch/Jona, Kempraten und Wagen) </title>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOR">3.12.2.2. Titles, Authors, and Editors</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD21">2.2.1. The Title Statement</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD26">2.2.5. The Series Statement</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-publisher"
                         ident="publisher">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Verlag</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">publisher</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">imprimeur/éditeur</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält bei Druckschriften als Teil von
    <gi>docImprint</gi> den Namen der Druckerei bzw. des Druckers, als Teil von
    <gi>publicationStmt</gi> die Angabe der herausgebenden Institution. </desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">In the case of publications, contains the name of
    the printer as part of <gi>docImprint</gi> and details of the issuing institution as part of
    <gi>publicationStmt</gi>.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient, pour les documents imprimés, le nom de
    l’imprimerie ou de l’imprimeur comme partie de <gi>docImprint</gi>, et l’indication de
    l’institution éditrice comme partie de <gi>publicationStmt</gi>.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <textNode/>
                     <elementRef key="persName"/>
                     <elementRef key="orgName"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-publisher-custom"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2023-06-23" xml:lang="en">constraint for tei:publisher</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:publisher[ancestor::tei:publicationStmt]">
                           <sch:assert test="normalize-space(.) = 'SSRQ-SDS-FDS'"> If
                    tei:publisher is part of tei:publicationStmt it must contain the text
                    "SSRQ-SDS-FDS". </sch:assert>
                           <sch:assert test="not(@cert)"> If tei:publisher is part of tei:publicationStmt
                    it may not have the attribute @cert. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="resp" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-docImprint-1-de" xml:lang="de">
                  <p>
                Beispiel für ein Impressum mit Druckort und Druckerei
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-en" xml:lang="en">
                  <p>
                Example of an imprint with place of printing and printer
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-fr" xml:lang="fr">
                  <p>
                Exemple d’imprimé avec lieu d’impression et nom de l’imprimeur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-publisher-cert-de" xml:lang="de">
                  <p>
                Verwendung mit
                <att>
                    cert
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher cert="low">Heidegger und Rahn</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-publisher-cert-en" xml:lang="en">
                  <p>
                Use with
                <att>
                    cert
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher cert="low">Heidegger und Rahn</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-publisher-cert-fr" xml:lang="fr">
                  <p>
                Utiliser avec
                <att>
                    cert
                </att>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher cert="low">Heidegger und Rahn</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD24">2.2.4. Publication, Distribution, Licensing, etc.</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-pubPlace"
                         ident="pubPlace">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Publikationsort</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">publication place</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">lieu de publication</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält den Publikationsort.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Contains the place of publication.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient le lieu de publication.</desc>
               <classes>
                  <memberOf key="att.canonical"/>
                  <memberOf key="att.global.responsibility"/>
               </classes>
               <content>
                  <textNode/>
               </content>
               <attList>
                  <attDef ident="ref" mode="replace" usage="req">
                     <datatype>
                        <dataRef key="ssrq.pointer.places"/>
                     </datatype>
                  </attDef>
                  <attDef ident="resp" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-docImprint-1-de" xml:lang="de">
                  <p>
                Beispiel für ein Impressum mit Druckort und Druckerei
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-en" xml:lang="en">
                  <p>
                Example of an imprint with place of printing and printer
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-fr" xml:lang="fr">
                  <p>
                Exemple d’imprimé avec lieu d’impression et nom de l’imprimeur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Bei Druckschriften wird innerhalb von <gi>docImprint</gi> der Publikationsort mit
            <gi>pubPlace</gi> genannt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            This can be both the place of publication of the electronic edition and the place of
            publication of the article or book listed in the bibliography. In the case of
            publications, the place of printing is named with <gi>pubPlace</gi> within
            <gi>docImprint</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Pour les documents imprimés, le lieu de publication est signalé avec <gi>pubPlace</gi>
            dans <gi>docImprint</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-bibl"
                         ident="bibl">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">bibliographische Angabe</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">bibliographical statement</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">référence bibliographique</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält eine bibliographische Angabe mit
    Stellenreferenz.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Contains a bibliographical reference with page
    references.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient une indication bibliographique
    référencée.</desc>
               <classes>
                  <memberOf key="att.global"/>
                  <memberOf key="model.biblLike"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="pc"/>
                     <elementRef key="ref"/>
                     <textNode/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-bibl" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-10-16" xml:lang="en">constraint for tei:bibl</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:bibl[@xml:id]">
                           <sch:assert test="./parent::tei:listBibl"> The attribute @xml:id for tei:bibl
                    is allowed only inside tei:listBibl. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="change">
                     <datatype>
                        <dataRef key="ssrq.id"/>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:lang" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-bibl-zot-de" xml:lang="de">
                  <p>
                Bibliographischer Verweis auf Zotero-Literaturdatenbank
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="http://zotero.org/groups/5048222/items/M8D9EG5B"/>, S. 93 </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-zot-en" xml:lang="en">
                  <p>
                Bibliographic reference to Zotero literature database
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="http://zotero.org/groups/5048222/items/M8D9EG5B"/>, S. 93 </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-zot-fr" xml:lang="fr">
                  <p>
                Référence bibliographique renvoyant à la base de données bibliographiques Zotero
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="http://zotero.org/groups/5048222/items/M8D9EG5B"/>, S. 93 </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-doc-de" xml:lang="de">
                  <p>
                Verweis auf ein anderes Stück
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="urn:ssrq:SSRQ-ZH-NF_II_11-74-1">SSRQ ZH NF II/11, Nr. 74</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-doc-en" xml:lang="en">
                  <p>
                Reference to another piece
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="urn:ssrq:SSRQ-ZH-NF_II_11-74-1">SSRQ ZH NF II/11, Nr. 74</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-doc-fr" xml:lang="fr">
                  <p>
                Référence à une autre pièce
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="urn:ssrq:SSRQ-ZH-NF_II_11-74-1">SSRQ ZH NF II/11, Nr. 74</ref>
                     </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-url-de" xml:lang="de">
                  <p>
                Externer Verweis
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?id=345640">StAZH, KAT 410</ref>, fol. 81r </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-url-en" xml:lang="en">
                  <p>
                External reference
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?id=345640">StAZH, KAT 410</ref>, fol. 81r </bibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-bibl-url-fr" xml:lang="fr">
                  <p>
                Référence qui renvoie à un lien externe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <bibl>
                        <ref target="https://suche.staatsarchiv.djiktzh.ch/detail.aspx?id=345640">StAZH, KAT 410</ref>, fol. 81r </bibl>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Das Kindelement <gi>ref</gi> verweist auf externe Websites, weitere edierte Stücke oder
            die Literaturdatenbank der SSRQ auf <ref target="https://www.zotero.org/groups/5048222/ssrq/">Zotero</ref>.
        </p>
               </remarks>
               <remarks versionDate="2023-07-18" xml:lang="en">
                  <p>
            The <gi>ref</gi> child element links to external websites, other edited pieces, or the
            Zotero literature database.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            L’élément enfant <gi>ref</gi> renvoie à des sites Web externes, à d’autres pièces
            éditées ou à la base de données bibliographique des SDS sur <ref target="https://www.zotero.org/groups/5048222/ssrq/">Zotero</ref>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBITY">3.12.1. Methods of Encoding Bibliographic References and Lists of References</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD3">2.2.7. The Source Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCAS2">16.3.2. Declarable Elements</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="gi-listBibl"
                         ident="listBibl">
               <gloss rend="replace" versionDate="2023-09-14" xml:lang="de">Liste bibliographischer Angaben</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">list of bibliographical statements</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">liste des références bibliographiques</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Liste bibliographischer
    Angaben.</desc>
               <desc rend="replace" versionDate="2023-07-19" xml:lang="en">Contains bibliographic information encoded with
    <gi>bibl</gi>.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une liste de références
    bibliographiques.</desc>
               <classes>
                  <memberOf key="att.typed"/>
                  <memberOf key="model.biblLike"/>
               </classes>
               <content>
                  <elementRef key="bibl" maxOccurs="unbounded"/>
               </content>
               <attList>
                  <attDef ident="type" mode="change" usage="req">
                     <desc versionDate="2025-01-29" xml:lang="de">der Typ der Liste bibliographischer
            Angaben</desc>
                     <desc versionDate="2025-01-29" xml:lang="en">the type of the list of bibliographic
            statements</desc>
                     <desc versionDate="2025-01-29" xml:lang="fr">le type de référence(s)
            bibliographiques(s)</desc>
                     <datatype>
                        <dataRef key="ssrq.type.listbibl"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-listBibl-edition-de" xml:lang="de">
                  <p>
                Verweis auf eine Edition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="edition">
                        <bibl>Ostorero dans <ref target="https://www.zotero.org/groups/ssrq/items/9IHZLWTG">Ostorero et al. 1999</ref>, p. 344-353</bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listBibl-edition-en" xml:lang="en">
                  <p>
                Reference to editions
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="edition">
                        <bibl>Ostorero dans <ref target="https://www.zotero.org/groups/ssrq/items/9IHZLWTG">Ostorero et al. 1999</ref>, p. 344-353</bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listBibl-edition-fr" xml:lang="fr">
                  <p>
                Référence à une édition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="edition">
                        <bibl>Ostorero dans <ref target="https://www.zotero.org/groups/ssrq/items/9IHZLWTG">Ostorero et al. 1999</ref>, p. 344-353</bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listBibl-summary-de" xml:lang="de">
                  <p>
                Verweis auf Regesten
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="summary">
                        <bibl>
                           <ref target="https://mobile.cmistar.ch/webclients-r20/shstaatsarchiv/#/content/ad7a1f69cfb248178cecdfa5e2cd3621">StASH, Urkunden, 1/1642-I
            (Archivverzeichnis StASH)</ref>
                        </bibl>
                        <bibl>
                           <ref>SHUR</ref>, Bd. 1, S. 200</bibl>
                        <bibl>
                           <ref>Regesta Imperii</ref> XI,1 <ref target="http://www.regesta-imperii.de/id/1418-09-18_4_0_11_1_0_3949_3489">Nr. 3489</ref>
                        </bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listBibl-summary-en" xml:lang="en">
                  <p>
                Reference to summaries
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="summary">
                        <bibl>
                           <ref target="https://mobile.cmistar.ch/webclients-r20/shstaatsarchiv/#/content/ad7a1f69cfb248178cecdfa5e2cd3621">StASH, Urkunden, 1/1642-I
            (Archivverzeichnis StASH)</ref>
                        </bibl>
                        <bibl>
                           <ref>SHUR</ref>, Bd. 1, S. 200</bibl>
                        <bibl>
                           <ref>Regesta Imperii</ref> XI,1 <ref target="http://www.regesta-imperii.de/id/1418-09-18_4_0_11_1_0_3949_3489">Nr. 3489</ref>
                        </bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-listBibl-summary-fr" xml:lang="fr">
                  <p>
                Référence à des résumés
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <listBibl type="summary">
                        <bibl>
                           <ref target="https://mobile.cmistar.ch/webclients-r20/shstaatsarchiv/#/content/ad7a1f69cfb248178cecdfa5e2cd3621">StASH, Urkunden, 1/1642-I
            (Archivverzeichnis StASH)</ref>
                        </bibl>
                        <bibl>
                           <ref>SHUR</ref>, Bd. 1, S. 200</bibl>
                        <bibl>
                           <ref>Regesta Imperii</ref> XI,1 <ref target="http://www.regesta-imperii.de/id/1418-09-18_4_0_11_1_0_3949_3489">Nr. 3489</ref>
                        </bibl>
                     </listBibl>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Jede <gi>listBibl</gi> sollte nur einen Typ von bibliographischen Angaben enthalten,
            der mit dem Attribut <att>type</att> angegeben wird.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Chaque <gi>listBibl</gi> ne doit contenir qu’un seul type de référence bibliographique,
            spécifié avec l’attribut <att>type</att>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBITY">3.12.1. Methods of Encoding Bibliographic References and Lists of References</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD3">2.2.7. The Source Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCAS2">16.3.2. Declarable Elements</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="core"
                         xml:id="TEXTLANG"
                         ident="textLang">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Textsprache</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">text language</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">langue du texte</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Gibt die Textsprache eines Textes an.</desc>
               <desc rend="replace" versionDate="2023-07-20" xml:lang="en">Describes a text language of a source.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Permet d’indiquer la langue d’un texte.</desc>
               <classes>
                  <memberOf key="att.global"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="n" mode="delete"/>
                  <attDef ident="xml:id" mode="delete"/>
                  <attDef ident="xml:lang" mode="change" usage="req"/>
                  <attDef ident="mainLang" mode="delete"/>
                  <attDef ident="otherLangs" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-textLang-de" xml:lang="de">
                  <p>
                Beispiel für die Angabe mehrerer Textsprachen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-textLang-en" xml:lang="en">
                  <p>
                Example of specifying multiple text languages
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-textLang-fr" xml:lang="fr">
                  <p>
                Exemple où plusieurs langues de texte sont indiquées
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <msItem>
                        <textLang xml:lang="de"/>
                        <textLang xml:lang="fr"/>
                        <docImprint>
                           <pubPlace>Zürich</pubPlace>
                           <publisher>Max von Schilda</publisher>
                        </docImprint>
                     </msItem>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Für jede Textsprache wird ein eigenes <gi>textLang</gi>-Element angelegt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-20" xml:lang="en">
                  <p>
            A separate <gi>textLang</gi> element is created for each text language.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Un élément <gi>textLang</gi> distinct est créé pour chaque langue de texte.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#COBICOI">3.12.2.4. Imprint, Size of a Document, and Reprint Information</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/MS.html#mslangs">11.6.6. Languages and Writing Systems</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="analysis"
                         xml:id="gi-pc"
                         ident="pc">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Satzzeichen</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">punctuation character</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">signe de ponctuation</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beinhaltet ein Satzzeichen, welches unter
    Berücksichtigung sprachlicher Regelungen besonders verarbeitet wird.</desc>
               <desc rend="replace" versionDate="2024-04-30" xml:lang="en">Contains a punctuation mark, which is processed
    specially considering linguistic regulations (for example, by adding a space).</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un signe de ponctuation qui est traité de
    manière particulière en tenant compte des règles linguistiques.</desc>
               <classes/>
               <content>
                  <valList type="closed">
                     <valItem ident=";"/>
                     <valItem ident=":"/>
                     <valItem ident="?"/>
                     <valItem ident="!"/>
                     <valItem ident="%"/>
                  </valList>
               </content>
               <attList>
                  <attDef ident="force" mode="delete"/>
                  <attDef ident="unit" mode="delete"/>
                  <attDef ident="pre" mode="delete"/>
               </attList>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Damit eine sprachabhängige Darstellung der Interpunktion möglich ist, werden
            Satzzeichen, die in den unterschiedlichen Sprachen der Edition (v. a. Deutsch und
            Französisch) anders behandelt werden müssen, mit <gi>pc</gi> ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Afin de permettre une représentation de la ponctuation en fonction de la langue, les
            signes de ponctuation qui doivent être traités différemment dans les différentes
            langues de l’édition (surtout en allemand et en français) sont signalés par
            <gi>pc</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/AI.html#AIPC">18.1.2. Below the Word Level</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/AI.html#AILALW">18.4.2. Lightweight Linguistic Annotation</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="certainty"
                         xml:id="gi-precision"
                         ident="precision">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Genauigkeit</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">precision</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">précision</gloss>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="de">Gibt den Grad der Unsicherheit einer Datierung
    an.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Indicates uncertainty in dating.</desc>
               <desc rend="replace" versionDate="2025-07-05" xml:lang="fr">Indique le degré de certitude dans la
    datation.</desc>
               <classes>
                  <memberOf key="att.scoping"/>
                  <memberOf key="model.global.meta"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="sch-el-precision" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-03-07" xml:lang="en">constraint for tei:precision</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:precision[@match]">
                           <sch:let name="parent" value="./parent::*"/>
                           <sch:assert test="every $matchAttr in tokenize(./@match, ' ')                     satisfies exists($parent/@*[name() = substring-after($matchAttr,                     '@')])"> Every value that is targeted via @match must have a
                    corresponding attribute on the parent element. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="precision" usage="req">
                     <desc rend="replace" versionDate="2025-02-24" xml:lang="de">die Präzision der in <att>match</att>
            genannten Attribute</desc>
                     <desc rend="replace" versionDate="2025-02-24" xml:lang="en">the precision of the attributes mentioned
            in <att>match</att>
                     </desc>
                     <desc rend="replace" versionDate="2025-02-24" xml:lang="fr">la précision des attributs mentionnés dans
            <att>match</att>
                     </desc>
                     <datatype>
                        <dataRef key="teidata.certainty"/>
                     </datatype>
                  </attDef>
                  <attDef ident="stdDeviation" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-precision-de" xml:lang="de">
                  <p>
                Beispiel für ein unsicheres Datum
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian"
                           notAfter-custom="1355-12-31"
                           notBefore-custom="1341-01-01"> Um 1346 und um 1350 <precision match="@notBefore-custom     @notAfter-custom" precision="low"/>
                     </date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-precision-en" xml:lang="en">
                  <p>
                Example of an uncertain date
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian"
                           notAfter-custom="1355-12-31"
                           notBefore-custom="1341-01-01"> Um 1346 und um 1350 <precision match="@notBefore-custom     @notAfter-custom" precision="low"/>
                     </date>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-precision-fr" xml:lang="fr">
                  <p>
                Exemple de date incertaine
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <date calendar="julian"
                           notAfter-custom="1355-12-31"
                           notBefore-custom="1341-01-01"> Um 1346 und um 1350 <precision match="@notBefore-custom     @notAfter-custom" precision="low"/>
                     </date>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Mit dem Attribut <att>match</att> wird auf ein oder mehrere Attribute von <gi>date</gi>
            Bezug genommen. Mit dem Attribut <att>precision</att> wird der Grad der Unsicherheit
            angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
                     <att>match</att> is used to refer to one or more attributes of <gi>date</gi>.
            <att>precision</att> specifies the degree of uncertainty.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            L’attribut <att>match</att> permet de faire référence à un ou plusieurs attributs de
            <gi>date</gi>. L’attribut <att>precision</att> indique le degré de certitude.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CE.html#CEPREC">22.2. Indications of Precision</ref>
               </listRef>
            </elementSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="figures"
                       type="atts"
                       ident="att.tableDecoration">
               <desc versionDate="2006-04-17" xml:lang="en">provides attributes used to decorate rows or cells of a table.</desc>
               <desc versionDate="2009-05-28" xml:lang="fr">fournit des attributs pour mettre en forme les lignes ou les cellules d'un tableau.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">assegna degli attributi utilizzati per decorare righe e celle di una tabella</desc>
               <classes/>
               <attList>
                  <attDef ident="role" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">die spezielle Verwendung der
                    Tabellenzelle</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the special use of the table
                    cell</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">l’utilisation spécifique de la
                    cellule du tableau</desc>
                     <valList type="closed">
                        <valItem ident="label">
                           <desc versionDate="2023-03-03" xml:lang="de">Spaltenüberschrift</desc>
                           <desc versionDate="2023-06-29" xml:lang="en">column heading</desc>
                           <desc versionDate="2023-06-29" xml:lang="fr">en-tête de colonne</desc>
                           <desc versionDate="2024-04-15" xml:lang="it">intestazione di
                            colonna</desc>
                        </valItem>
                     </valList>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FT.html#FT">15. Tables, Formulæ, Graphics, and Notated Music</ref>
               </listRef>
            </classSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="figures"
                         xml:id="gi-table"
                         ident="table">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Tabelle</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">table</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">tableau</gloss>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="de">Enthält eine Tabelle.</desc>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="en">Describes a table.</desc>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="fr">Contient un tableau.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                     <alternate minOccurs="0" maxOccurs="unbounded">
                        <elementRef key="cb"/>
                        <elementRef key="head"/>
                        <elementRef key="pb"/>
                     </alternate>
                     <elementRef key="row" maxOccurs="unbounded"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="rows" mode="delete"/>
                  <attDef ident="cols" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-table-de" xml:lang="de">
                  <p>
                Beispiel für eine Preisliste für Wein mit vier Spalten, wovon die letzten drei Spalten mit «gbz», «xr» bzw. «dn» überschrieben sind (Währungen)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-table-en" xml:lang="en">
                  <p>
                Example of a price list for wine with four columns, of which the last three columns are titled "gbz", "xr" and
                "dn" (currencies)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-table-fr" xml:lang="fr">
                  <p>
                Exemple d’une liste de prix pour un vin à quatre colonnes, dont les trois dernières colonnes sont intitulées "gbz", "xr" et
                "dn" (devises)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Wird zusammen mit <gi>row</gi> (Zeile) und <gi>cell</gi> (Zelle) für die Wiedergabe von
            Tabellen benötigt. Es wird von oben nach unten und von links nach rechts kodiert. Wann
            immer eine Tabelle als Fliesstext dargestellt werden kann, soll auf die Kodierung in
            Form einer Tabelle verzichtet werden. In Tabellen und Listen werden – insbesondere bei
            den gedruckten Mandaten – Gänsefüsschen als Unterführungszeichen benutzt, um Wörter
            oder Zahlen aus der oberen Zeile zu wiederholen. In solchen Fällen wird das
            «Ditto-Mark» (U+0022) verwendet. Ebenso kommt in Tabellen ein Querstrich als Nullwert
            vor (vgl. Beispiel). Bei der Transkription wird hierfür der Halbgeviertstrich (U+2013)
            verwendet, vgl. die Tabelle der Sonderzeichen in den <ref target="special.de.md#code-tabelle-fur-sonderzeichen">Transkriptionsrichtlinien</ref>.
        </p>
               </remarks>
               <remarks versionDate="2023-07-11" xml:lang="en">
                  <p>
            Is required together with <gi>row</gi> (row) and <gi>cell</gi> (cell) to display
            tables. It is counted from top to bottom and from left to right. Whenever possible, a
            table can be presented as continuous text, it should not be presented in the form of a
            table. In tables and lists - especially in the printed mandates - quotation marks are
            used as underscores to repeat words or numbers from the top line (see example below).
            In such cases, the "Ditto-Mark" (U+0022) is used (to be transcribed with the
            character string "). A slash also occurs in tables as a zero value (see example
            below). In the transcription, the digit-wide en dash - (U+2012) used (to be
            transliterated with the character string ‒).
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Cet élément doit être utilisé avec <gi>row</gi> (ligne) et <gi>cell</gi> (cellule) pour
            afficher les tableaux. Il est encodé de haut en bas et de gauche à droite. Chaque fois
            qu’un tableau peut être représenté sous forme de texte continu, il faut renoncer à
            l’encodage sous forme de tableau. Dans les tableaux et les listes, on utilise – en
            particulier dans les mandats imprimés – des guillemets comme signes de subordination
            pour répéter des mots ou des chiffres de la ligne supérieure. Dans de tels cas, on
            utilise le guillemet anglais, sous forme de guillemet double (U+0022). De même, on
            trouve dans les tableaux un trait transversal comme valeur zéro (voir exemple). Dans la
            transcription, on utilise à cet effet le tiret demi-cadratin (U+2013), cf. le tableau
            des caractères spéciaux dans <ref target="special.fr.md">principes de
            transcription</ref>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FT.html#FTTAB1">15.1.1. TEI Tables</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="figures"
                         xml:id="gi-row"
                         ident="row">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Zeile</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">row</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">ligne</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Zeile einer Tabelle.</desc>
               <desc rend="replace" versionDate="2023-07-11" xml:lang="en">Describes a row of a table.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une ligne d’un tableau.</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="cell"/>
                     <elementRef key="measureGrp"/>
                  </alternate>
               </content>
               <exemplum xml:id="ex-row-de" xml:lang="de">
                  <p>
                Einfaches Beispiel für Zeilen in einer Tabelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-row-en" xml:lang="en">
                  <p>
                Simple example of rows in a table
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-row-fr" xml:lang="fr">
                  <p>
                Exemple de lignes dans un tableau
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Wird zusammen mit <gi>table</gi> (Tabelle) und <gi>cell</gi> (Zelle) für die Kodierung
            von Tabellen benötigt.
        </p>
               </remarks>
               <remarks versionDate="2023-07-11" xml:lang="en">
                  <p>
            Is required together with <gi>table</gi> (table) and <gi>cell</gi> (cell) for
            displaying tables.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Cet élément est nécessaire avec <gi>table</gi> (tableau) et <gi>cell</gi> (cellule)
            pour encoder des tableaux.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FT.html#FTTAB1">15.1.1. TEI Tables</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="figures"
                         xml:id="gi-cell"
                         ident="cell">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Zelle einer Tabelle</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">cell of a table</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">cellule d’un tableau</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält eine Zelle einer Tabelle.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Describes a cell of a table.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient la cellule d’un tableau.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.tableDecoration"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-01-31" xml:lang="de">die Ausrichtung des Texts innerhalb der
            Tabellenzelle</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the text alignment within the table
            cell</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">l’alignement du texte à l’intérieur de la
            cellule du tableau</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.cell"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-cell-de" xml:lang="de">
                  <p>
                Einfaches Beispiel für Zellen in einer Tabelle
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-cell-en" xml:lang="en">
                  <p>
                Simple example of cells in a table
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-cell-fr" xml:lang="fr">
                  <p>
                Exemple simple de cellules dans un tableau
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <table>
                        <head>Von dem wein</head>
                        <row>
                           <cell/>
                           <cell role="label">gbz</cell>
                           <cell role="label">xr</cell>
                           <cell role="label">₰</cell>
                        </row>
                        <row>
                           <cell>für j saum wein</cell>
                           <cell>–</cell>
                           <cell>1</cell>
                           <cell>–</cell>
                        </row>
                        <pb/>
                        <head>item</head>
                        <row>
                           <cell>für j lägelen wein</cell>
                           <cell>–</cell>
                           <cell>–</cell>
                           <cell>2</cell>
                        </row>
                     </table>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Wird zusammen mit <gi>table</gi> und <gi>row</gi> für die Darstellung von Tabellen
            benötigt. Mit <att>role</att> = <val>label</val> wird eine Spaltenüberschrift, z. B.
            die Währung einer Spalte, angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-11" xml:lang="en">
                  <p>
            Is required within <gi>table</gi> together with <gi>row</gi> (row) for displaying
            tables. With <att>role</att> = <val>label</val> a column heading, e.g. B. a currency of
            a column entry specified.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Est requis avec <gi>table</gi> et <gi>row</gi> pour afficher les tableaux. Avec
            <att>role</att> = <val>label</val>, on indique un titre de colonne, p. ex. la devise
            (monnaie) d’une colonne.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FT.html#FTTAB1">15.1.1. TEI Tables</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="figures"
                         xml:id="gi-figure"
                         ident="figure">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Abbildung</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">figure</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">illustration</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Beschreibt eine Abbildung jeder Art.</desc>
               <desc rend="replace" versionDate="2023-04-11" xml:lang="en">Contains elements that describe graphical
    information.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Décrit une illustration de n’importe quel
    type.</desc>
               <classes>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
               </classes>
               <content>
                  <elementRef key="graphic" minOccurs="0"/>
               </content>
               <constraintSpec ident="sch-el-figure" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-07-05" xml:lang="en">constraint for tei:figure</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:figure[@type = 'illustration']">
                           <sch:assert test="tei:graphic"> If the @type of tei:figure is
                    'illustration' an element tei:graphic is required. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:figure[not(@type = 'illustration')]">
                           <sch:assert test="not(*) and not(text())"> If the @type of tei:figure is not
                    'illustration' tei:figure must be empty. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="place" mode="change">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort der Abbildung</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the figure</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">l’emplacement d’illustration</desc>
                  </attDef>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-01-31" xml:lang="de">die Art der Abbildung</desc>
                     <desc versionDate="2025-01-31" xml:lang="en">the type of the figure</desc>
                     <desc versionDate="2025-01-31" xml:lang="fr">le type d’illustration</desc>
                     <datatype>
                        <dataRef key="ssrq.type.figure"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-figure-1-de" xml:lang="de">
                  <p>
                Beispiel für eine Unterschrift mit Notariatszeichen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-figure-1-en" xml:lang="en">
                  <p>
                Example of a notarial sign with signature
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-figure-1-fr" xml:lang="fr">
                  <p>
                Exemple de signature avec marque de notaire
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
                     <gi>figure</gi> beschreibt Notarzeichen (= Notariatszeichen, Notariatssignet, Signum),
            Federzeichnungen, Holzschnitte, Verweiszeichen oder bei Kopien von Urkunden die Stelle,
            an der sich in der Originalurkunde das Siegel befindet (L. S. = Locus sigilli) oder
            Abbildungen, die mit <gi>graphic</gi> referenziert werden. Die Art der Abbbildung wird
            mit dem Attribut <att>type</att> angegeben.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            Contains notary signs (= notarial sign, notarial signet, signum), pen drawings,
            woodcuts, reference signs or, in the case of copies of deeds, the place where the seal
            is located in the original deed (L. S. = Locus sigilli) or illustrations starting with
            <gi>graphic</gi> be referenced.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
                     <gi>figure</gi> décrit des symboles de notaires (= sigle, sceau, signum), des dessins à
            la plume, des gravures sur bois, des signes de renvoi ou, dans le cas de copies
            d’actes, l’endroit où se trouve le sceau dans l’acte original (L. S. = Locus sigilli)
            ou des illustrations qui sont référencées avec <gi>graphic</gi>. Le type d’illustration
            est indiqué avec l’attribut <att>type</att>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FT.html#FTGRA">15.4. Specific Elements for Graphic Images</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-teiHeader"
                         ident="teiHeader">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">TEI Kopfbereich</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">TEI header</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">en-tête TEI</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält alle Metadaten zum edierten Text.</desc>
               <desc rend="replace" versionDate="2023-05-04" xml:lang="en">Contains all metadata about the edited
    document.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient toutes les métadonnées sur le texte
    édité.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="fileDesc"/>
                     <elementRef key="encodingDesc"/>
                     <elementRef key="profileDesc" minOccurs="0"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-teiHeader-de" xml:lang="de">
                  <p>
                Beispiel für einen Kopfbereich mit allen Kindbereichen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <teiHeader>
                        <fileDesc>
            ...
        </fileDesc>
                        <encodingDesc>
            ...
        </encodingDesc>
                        <profileDesc>
            ...
        </profileDesc>
                     </teiHeader>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-teiHeader-en" xml:lang="en">
                  <p>
                Example of a header area with all child areas
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <teiHeader>
                        <fileDesc>
            ...
        </fileDesc>
                        <encodingDesc>
            ...
        </encodingDesc>
                        <profileDesc>
            ...
        </profileDesc>
                     </teiHeader>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-teiHeader-fr" xml:lang="fr">
                  <p>
                Exemple d’un en-tête avec tous les éléments enfants
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <teiHeader>
                        <fileDesc>
            ...
        </fileDesc>
                        <encodingDesc>
            ...
        </encodingDesc>
                        <profileDesc>
            ...
        </profileDesc>
                     </teiHeader>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD11">2.1.1. The TEI Header and Its Components</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CC.html#CCDEF">16.1. Varieties of Composite Text</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-fileDesc"
                         ident="fileDesc">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Beschreibung der Datei</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">file description</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">description du fichier</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Elemente zur Beschreibung der
    Editionseinheit, zur Publikation des Dokuments, zur Reihe SSRQ und zur Überlieferung des
    Dokuments.</desc>
               <desc rend="replace" versionDate="2023-07-17" xml:lang="en">Contains elements describing the edited template
    and the digital capture.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des éléments descriptifs et déclaratifs
    sur l’unité d’édition, la publication du document, la série SDS et la mise à disposition du
    document.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="titleStmt"/>
                     <elementRef key="publicationStmt"/>
                     <elementRef key="seriesStmt"/>
                     <elementRef key="sourceDesc"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-fileDesc-de" xml:lang="de">
                  <p>
                Beispiel für den Aufbau einer Dateibeschreibung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <fileDesc>
                        <titleStmt>
            ...
        </titleStmt>
                        <publicationStmt>
            ...
        </publicationStmt>
                        <seriesStmt>
            ...
        </seriesStmt>
                        <sourceDesc>
            ...
        </sourceDesc>
                     </fileDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-fileDesc-en" xml:lang="en">
                  <p>
                Example of the structure of a file description
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <fileDesc>
                        <titleStmt>
            ...
        </titleStmt>
                        <publicationStmt>
            ...
        </publicationStmt>
                        <seriesStmt>
            ...
        </seriesStmt>
                        <sourceDesc>
            ...
        </sourceDesc>
                     </fileDesc>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-fileDesc-fr" xml:lang="fr">
                  <p>
                Exemple de la structure qui décrit un fichier
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <fileDesc>
                        <titleStmt>
            ...
        </titleStmt>
                        <publicationStmt>
            ...
        </publicationStmt>
                        <seriesStmt>
            ...
        </seriesStmt>
                        <sourceDesc>
            ...
        </sourceDesc>
                     </fileDesc>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD2">2.2. The File Description</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HD11">2.1.1. The TEI Header and Its Components</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="header"
                         xml:id="gi-titleStmt"
                         ident="titleStmt">
               <gloss rend="replace" versionDate="2023-07-18" xml:lang="de">Angaben zum Titel</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">title statement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">informations sur le titre</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Enthält Elemente zur Beschreibung des Titels und
    der Verantwortung der Beteiligten an der Edition.</desc>
               <desc rend="replace" versionDate="2023-07-18" xml:lang="en">Contains elements describing title and
    responsibilities.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Contient des éléments descriptifs et déclaratifs
    sur le titre et les responsabilités des personnes impliquées dans l’édition.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="1">
                     <elementRef key="title"/>
                     <elementRef key="editor" maxOccurs="unbounded"/>
                     <elementRef key="respStmt" maxOccurs="unbounded"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-titleStmt-de" xml:lang="de">
                  <p>
                Beispiel für eine Titelangabe
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <titleStmt>
                        <title>I. Abteilung: Die Rechtsquellen des Kantons Schilda. Neue Folge. Zweiter Teil: Rechte der Landschaft. Band 1: Die Obervogteien der Stadt
        Schilda. </title>
                        <editor>
                           <persName>Max Mustermann</persName>
                        </editor>
                        <editor>
                           <persName>Erika Mustermann</persName>
                        </editor>
                        <respStmt>
                           <persName>Max Mustermann</persName>
                           <persName>Erika Mustermann</persName>
                           <resp>Transkription</resp>
                        </respStmt>
                        <respStmt>
                           <persName>Max Mustermann</persName>
                           <resp>XML-Codierung der Transkription</resp>
                        </respStmt>
                        <respStmt>
                           <persName>Erika Mustermann</persName>
                           <resp>Qualitätskontrolle</resp>
                        </respStmt>
                     </titleStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-titleStmt-en" xml:lang="en">
                  <p>
                Example of a title statement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
