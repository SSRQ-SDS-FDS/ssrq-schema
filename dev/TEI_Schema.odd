                     <valItem ident="verso_above">
                        <desc versionDate="2022-05-10" xml:lang="de">auf der Rückseite oben</desc>
                        <desc versionDate="2022-05-10" xml:lang="en">at the top of the verso</desc>
                        <desc versionDate="2024-06-21" xml:lang="fr">au verso en haut de la
