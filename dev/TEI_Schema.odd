                     <desc versionDate="2024-11-13" xml:lang="en">quarter</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">quart du</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">quarto del</desc>
                  </valItem>
                  <valItem ident="repeated-duration">
