                     </valItem>
                     <valItem ident="below">
                        <desc versionDate="2023-05-02" xml:lang="de">unterhalb der Zeile</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">below the line</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">au-dessous de la ligne</desc>
