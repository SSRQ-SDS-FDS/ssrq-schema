                           <ref target="https://p.ssrq-sds-fds.ch/guidelines/transcription"/>
                        </p>
                     </editorialDecl>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-editorialDecl-fr" xml:lang="fr">
