                        </respStmt>
                        <respStmt>
                           <persName>Erika Mustermann</persName>
                           <resp>Qualitätskontrolle</resp>
                        </respStmt>
                     </titleStmt>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-titleStmt-fr" xml:lang="fr">
                  <p>
                Exemple de titre
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
