                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/CO.html#CONADA">3.6.4. Dates and Times</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDDATE">14.4. Dates</ref>
               </listRef>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       type="atts"
                       xml:id="class-attr-dimensions"
                       ident="att.dimensions">
               <desc versionDate="2007-08-05" xml:lang="en">provides attributes for describing the size of physical objects.</desc>
               <desc versionDate="2009-05-25" xml:lang="fr">fournit des attributs pour décrire la taille des objets physiques.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">assegna degli attributi che descrivono la grandezza di
    oggetti fisici</desc>
               <classes/>
               <attList>
                  <attDef ident="quantity" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">die Grösse der mit <att>unit</att>
                    angegebenen Masseinheit</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the size of the unit specified
                    with <att>unit</att>
                     </desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la taille de l’unité est indiquée
                    dans <att>unit</att>
                     </desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.quantity.positive"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.dimensions.unknown"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="unit" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">die Masseinheit</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the unit of measurement</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">l’unité de mesure</desc>
                     <datatype>
                        <dataRef key="ssrq.measure.lengths.base.cm"/>
                     </datatype>
                  </attDef>
               </attList>
            </classSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       module="tei"
                       xml:id="GLOBAL"
                       type="atts"
                       ident="att.global">
               <desc versionDate="2007-10-02" xml:lang="en">provides attributes common to all elements in the TEI encoding scheme.</desc>
               <desc versionDate="2007-06-12" xml:lang="fr">fournit un jeu d'attributs communs à tous les éléments
    dans le système de codage TEI.</desc>
               <desc versionDate="2007-01-21" xml:lang="it">stabilisce un insieme di attributi comuni a tutti gli
    elementi dello schema di codifica TEI</desc>
               <classes/>
               <attList>
                  <attDef ident="xml:lang" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">die Sprache gemäss ISO
                    639-1</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the language according to ISO
                    639-1</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">la langue selon ISO 639-1</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.de"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.fr"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.he"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.it"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.la"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.lang.rm"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="xml:id" usage="opt">
                     <gloss versionDate="2007-07-02" xml:lang="en">identifier</gloss>
                     <gloss versionDate="2008-03-30" xml:lang="fr">identifiant</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">identificatore</gloss>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="de">die ID des Elements</desc>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="en">the ID of the element</desc>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="fr">l’ID de l’élément</desc>
                     <datatype>
                        <dataRef name="ID"/>
                     </datatype>
                  </attDef>
                  <attDef ident="n" usage="opt">
                     <gloss versionDate="2007-07-02" xml:lang="en">number</gloss>
                     <gloss versionDate="2008-03-30" xml:lang="fr">nombre</gloss>
                     <gloss versionDate="2007-11-06" xml:lang="it">numero</gloss>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="de">die Nummerierung des
                    Elements</desc>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="en">the numbering of the
                    element</desc>
                     <desc rend="replace" versionDate="2025-01-31" xml:lang="fr">la numérotation de
                    l’élément</desc>
