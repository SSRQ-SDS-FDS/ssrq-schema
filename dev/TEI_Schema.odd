               <exemplum xml:id="ex-div-body-de" xml:lang="de">
                  <p>
                Beispiel für einen Abschnitt innerhalb von
                <gi>
                    body
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <div>
                        <pb facs="STAW_B_2_a_1_II_23" n="23"/>
                        <p>
                           <lb/>Item dehein fleischß ze koffen, da der sterbet
            <lb/>des vehs ist, da die weiden zuͦ samen stoßent,
            <lb/>da daz vaͤch zuͦ samen gaut,
            <lb/>
                           <del>und</del> die wil und der gebraͤst waͤret
            <lb/>und <date dur-iso="P2M">zwen manot</date> dar nach.
        </p>
                        <p>
                           <lb/>Item dehein kalb koffen noch
            <lb/>metzgen, es sye denn <measure quantity="3" type="age" unit="week">dry wochen</measure>
                           <lb/>alt oder elter.
        </p>
                        <p>
                           <lb/>Item si sont oͧch dehein beynnbrüchel
            <lb/>in der metzt <add place="above">nit</add> verkoffen denn under
            <lb/>den toren, alz daz von alter her
            <lb/>komen ist.
        </p>
                     </div>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-div-body-en" xml:lang="en">
                  <p>
                Example of a division inside
                <gi>
                    body
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <div>
                        <pb facs="STAW_B_2_a_1_II_23" n="23"/>
                        <p>
                           <lb/>Item dehein fleischß ze koffen, da der sterbet
            <lb/>des vehs ist, da die weiden zuͦ samen stoßent,
            <lb/>da daz vaͤch zuͦ samen gaut,
            <lb/>
                           <del>und</del> die wil und der gebraͤst waͤret
            <lb/>und <date dur-iso="P2M">zwen manot</date> dar nach.
        </p>
                        <p>
                           <lb/>Item dehein kalb koffen noch
            <lb/>metzgen, es sye denn <measure quantity="3" type="age" unit="week">dry wochen</measure>
                           <lb/>alt oder elter.
        </p>
                        <p>
                           <lb/>Item si sont oͧch dehein beynnbrüchel
            <lb/>in der metzt <add place="above">nit</add> verkoffen denn under
            <lb/>den toren, alz daz von alter her
            <lb/>komen ist.
        </p>
                     </div>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-div-body-fr" xml:lang="fr">
                  <p>
                Exemple de division à l’intérieur de
                <gi>
                    body
                </gi>
                  </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <div>
                        <pb facs="STAW_B_2_a_1_II_23" n="23"/>
                        <p>
                           <lb/>Item dehein fleischß ze koffen, da der sterbet
            <lb/>des vehs ist, da die weiden zuͦ samen stoßent,
            <lb/>da daz vaͤch zuͦ samen gaut,
            <lb/>
                           <del>und</del> die wil und der gebraͤst waͤret
            <lb/>und <date dur-iso="P2M">zwen manot</date> dar nach.
        </p>
                        <p>
                           <lb/>Item dehein kalb koffen noch
            <lb/>metzgen, es sye denn <measure quantity="3" type="age" unit="week">dry wochen</measure>
                           <lb/>alt oder elter.
        </p>
                        <p>
                           <lb/>Item si sont oͧch dehein beynnbrüchel
            <lb/>in der metzt <add place="above">nit</add> verkoffen denn under
            <lb/>den toren, alz daz von alter her
            <lb/>komen ist.
        </p>
                     </div>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
                     <gi>div</gi> gibt die höheren Gliederungsebenen eines Textes wieder. Originale Absätze
            werden mit <gi>p</gi> gekennzeichnet. Sofern das Original stärker gegliedert oder
            strukturiert ist, kann man beides verwenden, gegebenenfalls zusammen mit dem Attribut
            <att>type</att>.
        </p>
                  <p>
            Abschnitte, welche die Editorin bzw. der Editor zur inhaltlichen Strukturierung
            (lesbarer Text) einfügt, werden hingegen mit <gi>seg</gi> ausgezeichnet.
        </p>
                  <p>
            Weitere Hinweise zur Strukturierung von Quellentexten finden sich in den <ref target="textstructure.md">Transkriptionsrichtlinien</ref>.
        </p>
                  <p>
            Bei längeren Paratexten (Einleitung, Kommentar) können Abschnitte mit dem Attribut
            <att>n</att> nummeriert und gegebenenfalls mit dem Attribut <att>type</att> näher
            bezeichnet werden.
        </p>
                  <p>
            Im <gi>back</gi>-Bereich kann mit dem Attribut <att>xml:lang</att> die Sprache des
            Kommentars spezifiziert werden, wenn es sich um eine mehrsprachige Editionseinheit
            handelt.
        </p>
               </remarks>
               <remarks versionDate="2024-08-06" xml:lang="en">
                  <p>
            Original paragraphs are only marked with <gi>p</gi> (without an additional
            <gi>div</gi>). If the original is more articulated or structured, you can use both,
            possibly together with <att>type</att>. Sections that the editor inserts to structure
            the content (readable text) are marked with <gi>seg</gi>.
        </p>
                  <p>
            Further information on structuring source texts can be found in the <ref target="textstructure.md">Transcription Guidelines</ref>. For the structuring of
            closing formulas, see the examples on the Closing Formulas page.
        </p>
                  <p>
            For longer paratexts (introduction, comment), chapters can be numbered with
            <gi>div</gi> with <att>n</att> and, if necessary, with <att>type</att>.
        </p>
                  <p>
            In the <gi>back</gi> area, the language of the comment can be specified with
            <att>xml:lang</att>, if it is a multilingual edition unit.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
                     <gi>div</gi> représente les niveaux de structure supérieurs d’un texte. Les paragraphes
            originaux sont signalés avec <gi>p</gi>. Dans la mesure où l’original est plus articulé
            ou plus structuré, on peut utiliser les deux, éventuellement avec l’attribut
            <att>type</att>.
        </p>
                  <p>
            Les paragraphes que l’éditeur distingue pour structurer le contenu (et rendre le texte
            plus lisible) sont en revanche signalés par <gi>seg</gi>.
        </p>
                  <p>
            Vous trouverez d’autres indications sur la structuration des textes sources dans les
            <ref target="textstructure.md">principes de transcription</ref>.
        </p>
                  <p>
            Pour les paratextes plus longs (introduction, commentaire), les sections peuvent être
            numérotées avec <att>n</att> et, si nécessaire, désignées plus précisément avec
            l’attribut <att>type</att>.
        </p>
                  <p>
            Dans la zone <gi>back</gi>, l’attribut <att>xml:lang</att> permet de spécifier la
            langue du commentaire s’il s’agit d’une unité d’édition multilingue.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSDIV">4.1. Divisions of the Body</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-signed"
                         ident="signed">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Unterschrift</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">signature</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">signature</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Unterschrift mit oder ohne
    Notarzeichen.</desc>
               <desc rend="replace" versionDate="2023-05-23" xml:lang="en">Includes signatures and signatures with notary
    marks and is usually found at the end of a text.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient une signature avec ou sans marque
    notariée.</desc>
               <classes/>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <exemplum xml:id="ex-signed-de" xml:lang="de">
                  <p>
                Beispiel für eine Unterschrift mit Notariatszeichen
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-signed-en" xml:lang="en">
                  <p>
                Example of a signature with a notary’s mark
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-signed-fr" xml:lang="fr">
                  <p>
                Exemple de signature avec symbole de notaire
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <signed>
                        <figure type="notarial_sign"/>
                        <lb/>Et ego Hainricus Jacobi de Augiamaiori ...
        </signed>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSOC">4.2.2. Openers and Closers</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-docImprint"
                         ident="docImprint">
               <gloss rend="replace" versionDate="2023-07-31" xml:lang="de">Impressum</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">document imprint</gloss>
               <gloss rend="replace" versionDate="2023-07-31" xml:lang="fr">imprimé</gloss>
               <desc rend="replace" versionDate="2023-04-05" xml:lang="de">Enthält bei Druckschriften den Druckort
    (<gi>pubPlace</gi>) und den Namen der Druckerei (<gi>publisher</gi>).</desc>
               <desc rend="replace" versionDate="2023-04-05" xml:lang="en">Contains the place of printing (<gi>pubPlace</gi>)
    and the name of the printer (<gi>publisher</gi>).</desc>
               <desc rend="replace" versionDate="2023-04-05" xml:lang="fr">Contient, pour les imprimés, le lieu d’impression
    (<gi>pubPlace</gi>) et le nom de l’imprimeur (<gi>publisher</gi>).</desc>
               <classes/>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="pubPlace" maxOccurs="unbounded"/>
                     <elementRef key="publisher"/>
                     <sequence minOccurs="1" maxOccurs="1">
                        <elementRef key="pubPlace" maxOccurs="unbounded"/>
                        <elementRef key="publisher"/>
                     </sequence>
                  </alternate>
               </content>
               <exemplum xml:id="ex-docImprint-1-de" xml:lang="de">
                  <p>
                Beispiel für ein Impressum mit Druckort und Druckerei
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-en" xml:lang="en">
                  <p>
                Example of an imprint with place of printing and printer
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-1-fr" xml:lang="fr">
                  <p>
                Exemple d’imprimé avec lieu d’impression et nom de l’imprimeur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-2-de" xml:lang="de">
                  <p>
                Beispiel für ein Impressum mit mehreren Druckorten
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <pubPlace>Bern</pubPlace>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-2-en" xml:lang="en">
                  <p>
                Example of an imprint with several places of printing
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <pubPlace>Bern</pubPlace>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-2-fr" xml:lang="fr">
                  <p>
                Exemple d’imprimé avec plusieurs lieux d’impression
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <pubPlace>Zürich</pubPlace>
                        <pubPlace>Bern</pubPlace>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-3-de" xml:lang="de">
                  <p>
                Beispiel für ein Impressum mit einer Druckerei
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-3-en" xml:lang="en">
                  <p>
                Example of an imprint with a printing company
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-docImprint-3-fr" xml:lang="fr">
                  <p>
                Exemple d’imprimé avec le nom de l’imprimeur
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <docImprint>
                        <publisher>Johann Heinrich Hamberger</publisher>
                     </docImprint>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSTITL">4.6. Title Pages</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="textstructure"
                         xml:id="gi-back"
                         ident="back">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Kommentarbereich</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">comment section</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">zone de commentaires</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Enthält weiterführende Informationen zu einem
    edierten Quellenstück, ordnet das Stück historisch ein und gibt Auskunft, warum ein Stück für
    die Edition ausgewählt wurde.</desc>
               <desc rend="replace" versionDate="2023-04-04" xml:lang="en">The commentary contains further information on an
    edited piece, classifies the piece historically and provides information on why a piece was
    chosen for the edition.</desc>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="fr">Contient des informations complémentaires sur une
    pièce éditée, sur le contexte historique ou sur les raisons pour lesquelles la pièce a été
    sélectionnée pour l’édition.</desc>
               <classes/>
               <content>
                  <elementRef key="div" maxOccurs="unbounded"/>
               </content>
               <constraintSpec ident="sch-el-back"
                               mode="add"
                               scheme="schematron"
                               xml:lang="en">
                  <desc versionDate="2025-06-06" xml:lang="en">constraint for tei:note in tei:back</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:back">
                           <sch:report test=".//tei:note"> The element tei:note is not allowed in
                    tei:back. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-back-de" xml:lang="de">
                  <p>
                Beispiel für einen Kommentarbereich mit zwei Abschnitten
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <back>
                        <div n="1">
                           <p>
                Zum Verkauf der Burg <placeName ref="loc007559.01">Wildenburg</placeName> sowie zu den nachfolgenden Verkäufen an die Grafen <orgName ref="org000144">von Toggenburg</orgName> vgl. den Kommentar zum edierten Stück <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CH-StiASG/Urkunden/CC.2.B.1/charter">Bd. 5, Nr. 2839 </ref>
                              </bibl> sowie <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000118351">Gabathuler 2009c</ref>, S. 235–239 </bibl> .
            </p>
                        </div>
                        <div n="2">
                           <p>
                Zum Verkauf von Boden durch die Hohensaxer an die <orgName ref="org000425">Appenzeller </orgName> in der <placeName ref="loc007565">Saxerlücke</placeName>, der einzigen direkten Verbindung zwischen der Freiherrschaft Sax-Hohensax und Appenzell, zum Bau einer
                Letzi am <date calendar="julian" when-custom="1346-01-20">20. Januar 1346</date> (vgl. <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000080293">Deplazes-Haefliger 1976</ref>, S. 10 </bibl> , gedruckt in <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CSGVI/1346_I_20.1/charter">Bd. 6, Nr.
                3966 </ref>
                              </bibl> ).
            </p>
                        </div>
                     </back>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-back-en" xml:lang="en">
                  <p>
                Example of a comments section with two divisions
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <back>
                        <div n="1">
                           <p>
                Zum Verkauf der Burg <placeName ref="loc007559.01">Wildenburg</placeName> sowie zu den nachfolgenden Verkäufen an die Grafen <orgName ref="org000144">von Toggenburg</orgName> vgl. den Kommentar zum edierten Stück <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CH-StiASG/Urkunden/CC.2.B.1/charter">Bd. 5, Nr. 2839 </ref>
                              </bibl> sowie <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000118351">Gabathuler 2009c</ref>, S. 235–239 </bibl> .
            </p>
                        </div>
                        <div n="2">
                           <p>
                Zum Verkauf von Boden durch die Hohensaxer an die <orgName ref="org000425">Appenzeller </orgName> in der <placeName ref="loc007565">Saxerlücke</placeName>, der einzigen direkten Verbindung zwischen der Freiherrschaft Sax-Hohensax und Appenzell, zum Bau einer
                Letzi am <date calendar="julian" when-custom="1346-01-20">20. Januar 1346</date> (vgl. <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000080293">Deplazes-Haefliger 1976</ref>, S. 10 </bibl> , gedruckt in <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CSGVI/1346_I_20.1/charter">Bd. 6, Nr.
                3966 </ref>
                              </bibl> ).
            </p>
                        </div>
                     </back>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-back-fr" xml:lang="fr">
                  <p>
                Exemple d’une zone de commentaires avec deux divisions
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <back>
                        <div n="1">
                           <p>
                Zum Verkauf der Burg <placeName ref="loc007559.01">Wildenburg</placeName> sowie zu den nachfolgenden Verkäufen an die Grafen <orgName ref="org000144">von Toggenburg</orgName> vgl. den Kommentar zum edierten Stück <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CH-StiASG/Urkunden/CC.2.B.1/charter">Bd. 5, Nr. 2839 </ref>
                              </bibl> sowie <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000118351">Gabathuler 2009c</ref>, S. 235–239 </bibl> .
            </p>
                        </div>
                        <div n="2">
                           <p>
                Zum Verkauf von Boden durch die Hohensaxer an die <orgName ref="org000425">Appenzeller </orgName> in der <placeName ref="loc007565">Saxerlücke</placeName>, der einzigen direkten Verbindung zwischen der Freiherrschaft Sax-Hohensax und Appenzell, zum Bau einer
                Letzi am <date calendar="julian" when-custom="1346-01-20">20. Januar 1346</date> (vgl. <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000080293">Deplazes-Haefliger 1976</ref>, S. 10 </bibl> , gedruckt in <bibl>
                                 <ref target="http://permalink.snl.ch/bib/chbsg000056393">ChSG</ref>, <ref target="http://monasterium.net/mom/CSGVI/1346_I_20.1/charter">Bd. 6, Nr.
                3966 </ref>
                              </bibl> ).
            </p>
                        </div>
                     </back>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Die Bemerkungen lassen sich mit <gi>div</gi> und <gi>p</gi> strukturieren. Mithilfe von
            <gi>ref</gi>-Elementen werden Literatur und Internetlinks (z. B. verzeichnete
            Archivstücke etc.) referenziert.
        </p>
                  <p>
            Im Kommentarbereich werden Personen, Orte und Institutionen, die über die Register
            gefunden werden sollen, sowie Daten ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2023-08-18" xml:lang="en">
                  <p>
            Multiple comments can be structured with <gi>div</gi>. Literature and Internet links
            (e.g. listed archive pieces, etc.) can be referenced with <gi>ref</gi> elements. In the
            comment, people, places and institutions that should be found via the index search will
            be marked. Other tags such as <gi>date</gi> or <gi>measure</gi> are omitted, especially
            since these can easily be automatically tagged later in their current, standardized
            form.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Les commentaires peuvent être structurés avec <gi>div</gi> et <gi>p</gi>. L’élément
            <gi>ref</gi> permet de référencer la littérature et les liens Internet (p. ex. pièces
            d’archives signalées ou inventoriées, etc.).
        </p>
                  <p>
            Dans cette zone de commentaires, les personnes, lieux et institutions qui se trouvent
            dans les répertoires (base de données), ainsi que les dates, sont mis en évidence par
            des balises.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DSBACK">4.7. Back Matter</ref>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/DS.html#DS">4. Default Text Structure</ref>
               </listRef>
            </elementSpec>
            <classSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                       xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                       rend="change"
                       predeclare="true"
                       module="transcr"
                       type="atts"
                       ident="att.global.facs">
               <desc versionDate="2021-05-09" xml:lang="en">provides attributes used to express correspondence between an element and all or part of a facsimile image or surface.</desc>
               <desc versionDate="2009-11-16" xml:lang="fr">attributs utilisables pour les éléments correspondant à tout ou partie d'une image, parce qu'ils contiennent une représentation alternative de cette image, généralement mais
    pas nécessairement, une transcription.</desc>
               <desc versionDate="2007-11-06" xml:lang="it">elementi che possono essere associati a un'immagine o una
    superficie all'interno dell'elemento facsimile</desc>
               <classes/>
               <attList>
                  <attDef ident="facs" mode="replace">
                     <desc versionDate="2025-01-28" xml:lang="de">der Name eines oder mehrerer
                    Faksimiles</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the name of one or more
                    facsimiles</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le nom d’un ou plusieurs
                    fac-similés</desc>
                     <datatype>
                        <rng:list>
                           <rng:oneOrMore>
                              <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.facs.name"/>
                           </rng:oneOrMore>
                        </rng:list>
                     </datatype>
                  </attDef>
               </attList>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHFAX">12.1. Digital Facsimiles</ref>
               </listRef>
            </classSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-addSpan"
                         ident="addSpan">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">hinzugefügte Passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">added passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">passage supplémentaire</gloss>
               <desc rend="replace" versionDate="2025-02-05" xml:lang="de">Markiert eine grössere, die Hierarchiegrenzen
    überschreitende Hinzufügung eines Schreibers.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Denotes major additions.</desc>
               <desc rend="replace" versionDate="2025-04-29" xml:lang="fr">Marque l’ajout de la part d’un scribe d’une
    importante séquence de texte qui ne peut être signalée seulement par un <gi>add</gi>.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.placement"/>
                  <memberOf key="att.spanning"/>
                  <memberOf key="att.typed"/>
                  <memberOf key="att.written"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="addSpan-requires-spanTo" scheme="schematron" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:addSpan">
                        <sch:assert test="@spanTo">The @spanTo attribute of <sch:name/> is required.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="addSpan-requires-spanTo-fr"
                               scheme="schematron"
                               xml:lang="fr">
                  <constraint>
                     <sch:rule context="tei:addSpan">
                        <sch:assert test="@spanTo">L'attribut spanTo est requis.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="place" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">der Ort der Hinzufügung</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the place of the addition</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">le lieu d’ajout</desc>
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.place.add"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-04" xml:lang="de">das verwendete Schreibmittel</desc>
                     <desc versionDate="2025-02-04" xml:lang="en">the writing means used</desc>
                     <desc versionDate="2025-02-04" xml:lang="fr">les moyens d’écriture utilisés</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.add"/>
                     </datatype>
                  </attDef>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-01-29" xml:lang="de">die Art der Hinzufügung</desc>
                     <desc versionDate="2025-01-29" xml:lang="en">the kind of addition</desc>
                     <desc versionDate="2025-01-29" xml:lang="fr">le type d’ajout</desc>
                     <datatype>
                        <dataRef key="ssrq.type.add"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-addSpan-de" xml:lang="de">
                  <p>
                Beispiel für eine umfangreichere Hinzufügung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-addSpan-en" xml:lang="en">
                  <p>
                Example of a larger addition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-addSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’un ajout volumineux
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <addSpan hand="otherHand" place="bottom" rend="pencil" spanTo="add1"/>
                     <lb/>Presentibus
    <lb/>Antonio nepote domini officialis, fratre Germano ordinis Predicatorum; dominus
    <lb/>officialis prefatus monuit dictam Jordanam pro secunda dilatione
    <lb/>et assignata est ad cras pro tertia.
    <lb/>Delayens <anchor xml:id="add1"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Für <gi>addSpan</gi> gelten die gleichen Regeln wie für <gi>add</gi> (s. dort).
        </p>
                  <p>
            Zusätzlich wird mit dem Attribut <att>spanTo</att> zwingend auf den Endpunkt der
            Hinzufügung verwiesen, der mit <gi>anchor</gi> markiert wird.
        </p>
               </remarks>
               <remarks versionDate="2023-07-11" xml:lang="en">
                  <p>
            The attribute <att>spanTo</att> is used to refer to the end point of the addition which
            is marked with <gi>anchor</gi>.
        </p>
                  <p>
            The place of addition must be in <att>place</att> and the hand of the added place can
            be held with <att>hand</att>. If necessary, inside <att>rend</att> it can be specified
            how the addition was made (pencil, other ink, etc.). If an addition is the hand of the
            first scribe, then the hand is not specifically noted.
        </p>
               </remarks>
               <remarks versionDate="2025-04-29" xml:lang="fr">
                  <p>
            Les mêmes règles s’appliquent à <gi>addSpan</gi> qu’à <gi>add</gi> (voir ici).
        </p>
                  <p>
            De plus, l’attribut <att>spanTo</att> est utilisé pour faire référence au point final
            du passage ajouté, qui est marqué par <gi>anchor</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHAD">12.3.1.4. Additions and Deletions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-damage"
                         ident="damage">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">Schaden</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">damage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">altération</gloss>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="de">Enthält beschädigten Text.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="en">Denotes a damaged section.</desc>
               <desc rend="replace" versionDate="2023-07-13" xml:lang="fr">Contient une zone du texte altéré.</desc>
               <classes>
                  <memberOf key="att.damaged"/>
                  <memberOf key="att.dimensions"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <alternate minOccurs="1" maxOccurs="1">
                        <elementRef key="add"/>
                        <elementRef key="gap"/>
                        <elementRef key="supplied"/>
                        <elementRef key="unclear"/>
                     </alternate>
                     <alternate minOccurs="1" maxOccurs="1">
                        <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                           <elementRef key="gap"/>
                           <elementRef key="supplied"/>
                        </sequence>
                        <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                           <elementRef key="gap"/>
                           <elementRef key="unclear"/>
                        </sequence>
                     </alternate>
                  </alternate>
               </content>
               <attList>
                  <attDef ident="unit" mode="replace">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.measure.lengths.base.cm"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.dimensions.typography"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="quantity" mode="change">
                     <datatype>
                        <dataRef key="ssrq.quantity.positive"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-damage-add-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, in die eine andere Hand Text eingetragen hat
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-add-en" xml:lang="en">
                  <p>
                Example of a damaged area where text has been written by another hand
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-add-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré où le texte a été écrit par une autre main
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <add hand="otherHand" place="overwritten">zuͦ trincken</add>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Text unlesbar ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-en" xml:lang="en">
                  <p>
                Example of a damaged spot where the text is unreadable
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-gap-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré où le texte est illisible
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <gap quantity="9" unit="cm"/>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Text ergänzt wurde
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-en" xml:lang="en">
                  <p>
                Example of a damaged passage whose text has been added
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré dont le texte a été complété
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Lesung unsicher ist
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-en" xml:lang="en">
                  <p>
                Example of a damaged passage whose reading is uncertain
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-unclear-fr" xml:lang="fr">
                  <p>
                Exemple de passage altéré dont la lecture est incertaine
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="ink_blot">
                        <unclear>die</unclear>
                     </damage>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-27" xml:lang="de">
                  <p>
            Die Art der Beschädigung wird mit dem Attribut <att>agent</att> standardisiert
            beschrieben.
        </p>
                  <p>
            Sofern möglich, wird der fehlende Text mit <gi>supplied</gi> oder bei unsicherer Lesung
            mit <gi>unclear</gi> ergänzt. Wenn kein Text ergänzt werden kann, wird <gi>gap</gi>
            verwendet. Je nach Stärke der Beschädigung kann auch eine Kombination der Elemente
            <gi>unclear</gi>, <gi>supplied</gi> und <gi>gap</gi> verwendet werden.
        </p>
                  <p>
            In der Regel werden mit <gi>damage</gi> physikalische Zerstörungen und nicht mutwillige
            Eingriffe ausgezeichnet. Eine Rasur wird mit <gi>del</gi> ausgezeichnet. Eine
            Beschreibung von grösseren Schäden erfolgt zusätzlich pauschal in <gi>condition</gi>.
        </p>
                  <p>
            Bei einer die Hierarchiegrenzen überschreitenden Beschädigung ist <gi>damageSpan</gi>
            zu verwenden.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            The type of damage is described in more detail with <att>agent</att>. As far as
            possible, the missing text is supplemented with <gi>supplied</gi> or, if reading is
            uncertain, with <gi>unclear</gi>. If no text can be added, <gi>gap</gi> is used. A
            combination of the <gi>unclear</gi>, <gi>supplied</gi>, and <gi>gap</gi> tags can also
            be used, depending on the severity of the corruption. For longer text passages, when
            <gi>damage</gi> alone is no longer sufficient, <gi>damageSpan</gi> should be used.
        </p>
                  <p>
            As a rule, <gi>damage</gi> is used to mark physical destruction and non-wanton
            interference. A shave is marked with <gi>del</gi>. A general description of major
            damage is also given in the metadata.
        </p>
               </remarks>
               <remarks versionDate="2025-02-27" xml:lang="fr">
                  <p>
            Le type d’altération est décrit de manière standardisée à l’aide de l’attribut
            <att>agent</att>.
        </p>
                  <p>
            Dans la mesure du possible, le texte manquant est complété par <gi>supplied</gi> ou, si
            la lecture est incertaine, par <gi>unclear</gi>. Si aucun texte ne peut être complété,
            on utilise <gi>gap</gi>. Selon l’importance de la détérioration, il est également
            possible d’utiliser une combinaison des éléments <gi>unclear</gi>, <gi>supplied</gi> et
            <gi>gap</gi>.
        </p>
                  <p>
            En règle générale, <gi>damage</gi> est utilisé pour marquer une altération physique,
            généralement involontaire, plutôt qu’une intervention délibérée. Dans ce dernier cas,
            on utilise <gi>del</gi>. Une description des altérations plus importante se fait en
            outre de manière globale <gi>condition</gi>.
        </p>
                  <p>
            Si l’altération concerne une longue séquence de texte qui dépasse les limites
            hiérarchiques, il faut utiliser <gi>damageSpan</gi>. La limite hiérarchique est
            dépassée si l’utilisation de <gi>damage</gi> ne suffit plus en raison de l’imbrication
            de nombreux éléments. Ce même principe s’applique pour <gi>add</gi> et <gi>del</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA">12.3.3.1. Damage, Illegibility, and Supplied Text</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-damageSpan"
                         ident="damageSpan">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">beschädigte Passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">damaged passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">passage altéré</gloss>
               <desc rend="replace" versionDate="2025-07-17" xml:lang="de">Markiert eine grössere beschädigte, die
    Hierarchiegrenzen überschreitende Passage, die nicht durch einfaches <gi>damage</gi> kodiert
    werden kann.</desc>
               <desc rend="replace" versionDate="2023-05-11" xml:lang="en">Denotes larger sections that are damaged.</desc>
               <desc rend="replace" versionDate="2025-07-17" xml:lang="fr">Marque une importante séquence de texte altérée
    qui ne peut être signalée seulement par un <gi>damage</gi>.</desc>
               <classes>
                  <memberOf key="att.damaged"/>
                  <memberOf key="att.spanning"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="damageSpan-requires-spanTo"
                               scheme="schematron"
                               xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:damageSpan">
                        <sch:assert test="@spanTo">The @spanTo attribute of <sch:name/> is required.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="damageSpan-requires-spanTo-fr"
                               scheme="schematron"
                               xml:lang="fr">
                  <constraint>
                     <sch:rule context="tei:damageSpan">
                        <sch:assert test="@spanTo">L'attribut spanTo est requis.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <exemplum xml:id="ex-damageSpan-de" xml:lang="de">
                  <p>
                Beispiel für einen umfangreicheren Schaden
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damageSpan-en" xml:lang="en">
                  <p>
                Example of a more extensive damage
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damageSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’une séquence volumineuse altérée
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damageSpan agent="faded_ink" spanTo="damage1"/>
                     <lb/>geschwüsterige, einandern erben und im fahl die
    <lb/>mutter im leben wär, soll die mutter den dritten
    <lb/>theil und die geschwüsterte die zwenn theil erben. <anchor xml:id="damage1"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Für <gi>damageSpan</gi> gelten die gleichen Regeln wie für <gi>damage</gi> (s. dort).
        </p>
                  <p>
            Zusätzlich wird mit dem Attribut <att>spanTo</att> zwingend auf den Endpunkt der
            beschädigten Passage verwiesen, der mit <gi>anchor</gi> markiert wird.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            The attribute <att>spanTo</att> is used to force reference to the endpoint of
            corruption, which is marked with <gi>anchor</gi>. The type of damage is described in
            more detail with <att>agent</att> analogous to <gi>damage</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Les mêmes règles s’appliquent à <gi>damageSpan</gi> et à <gi>damage</gi> (voir ici).
        </p>
                  <p>
            De plus, l’attribut <att>spanTo</att> est utilisé pour faire référence au point final
            du passage altéré, qui est marqué avec <gi>anchor</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA">12.3.3.1. Damage, Illegibility, and Supplied Text</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-delSpan"
                         ident="delSpan">
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="de">getilgte Passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">deleted passage</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">passage supprimé</gloss>
               <desc rend="replace" versionDate="2025-07-17" xml:lang="de">Markiert eine grössere, die Hierarchiegrenzen
    überschreitende Tilgung eines Schreibers, die nicht durch ein einfaches <gi>del</gi> kodiert
    werden kann.</desc>
               <desc rend="replace" versionDate="2023-05-11" xml:lang="en">Denotes larger sections deleted from the
    text.</desc>
               <desc rend="replace" versionDate="2025-07-17" xml:lang="fr">Marque la suppression de la part d’un scribe d’une
    importante séquence de texte qui ne peut être signalée seulement par un <gi>del</gi>.</desc>
               <classes>
                  <memberOf key="att.global.rendition"/>
                  <memberOf key="att.spanning"/>
                  <memberOf key="att.written"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <constraintSpec ident="delSpan-requires-spanTo" scheme="schematron" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:delSpan">
                        <sch:assert test="@spanTo">The @spanTo attribute of <sch:name/> is required.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="delSpan-requires-spanTo-fr"
                               scheme="schematron"
                               xml:lang="fr">
                  <constraint>
                     <sch:rule context="tei:delSpan">
                        <sch:assert test="@spanTo">L'attribut spanTo est requis.</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="rend" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">das Aussehen der Tilgung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the appearance of the deletion</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">l’apparence de la suppression</desc>
                     <datatype>
                        <dataRef key="ssrq.rend.del"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-delSpan-de" xml:lang="de">
                  <p>
                Beispiel für eine umfangreichere Tilgung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-delSpan-en" xml:lang="en">
                  <p>
                Example of a larger deletion
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-delSpan-fr" xml:lang="fr">
                  <p>
                Exemple d’une suppression volumineuse
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <delSpan hand="otherHand" rend="crossout" spanTo="del1"/>
                     <lb/>Wir der Burgermeyster
    <lb/>Radt und der groß Radt. Embietend
    <lb/>allen und yeden unsern Burgeren
    <lb/>unsern günstlichen gruͦß / geneygten
    <lb/>willen / unnd alles guͦts zuͦvor / unnd thuͦnd üch sampt unnd sunders
    <lb/>zuͦ vernemmen. <anchor xml:id="del1"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-05" xml:lang="de">
                  <p>
            Für <gi>delSpan</gi> gelten die gleichen Regeln wie für <gi>del</gi> (s. dort).
        </p>
                  <p>
            Zusätzlich wird mit dem Attribut <att>spanTo</att> zwingend auf den Endpunkt der
            Tilgung verwiesen, der mit <gi>anchor</gi> markiert wird.
        </p>
               </remarks>
               <remarks versionDate="2023-07-13" xml:lang="en">
                  <p>
            With <att>spanTo</att> a mandatory reference is made to the end point of the erasure,
            which is marked with <gi>anchor</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-05" xml:lang="fr">
                  <p>
            Les mêmes règles s’appliquent à <gi>delSpan</gi> et à <gi>del</gi> (voir ici).
        </p>
                  <p>
            De plus, l’attribut <att>spanTo</att> est utilisé pour faire référence au point final
            du passage supprimé, qui est marqué avec <gi>anchor</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHAD">12.3.1.4. Additions and Deletions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-fw"
                         ident="fw">
               <gloss rend="replace" versionDate="2023-07-13" xml:lang="de">Gestaltungselement</gloss>
               <gloss rend="replace" versionDate="2023-07-13" xml:lang="en">forme work</gloss>
               <gloss rend="replace" versionDate="2023-07-13" xml:lang="fr">élément de mise en page</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält Gestaltungselemente, die nicht zum
    eigentlichen Text gehören.</desc>
               <desc rend="replace" versionDate="2023-08-18" xml:lang="en">Contains catchwords and reclamants. The word at
    the bottom of the page is usually omitted or transcribed on the next page.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient des éléments de mise en page qui ne font
    pas partie du texte lui-même.</desc>
               <classes>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="unbounded">
                     <macroRef key="ssrq.content.default"/>
                  </sequence>
               </content>
               <attList>
                  <attDef ident="type" mode="replace" usage="req">
                     <desc versionDate="2025-02-03" xml:lang="de">die Art des Gestaltungselements</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the type of forme work</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">le type d’élément de mise en page</desc>
                     <datatype>
                        <dataRef key="ssrq.type.fw"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-fw-de" xml:lang="de">
                  <p>
                Beispiel für eine Kustode
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <fw type="catchword">theil</fw>
                        <pb n="2v"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-fw-en" xml:lang="en">
                  <p>
                Example of a custodian
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <fw type="catchword">theil</fw>
                        <pb n="2v"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-fw-fr" xml:lang="fr">
                  <p>
                Exemple de réclame
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <fw type="catchword">theil</fw>
                        <pb n="2v"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-06" xml:lang="de">
                  <p>
            Wir benutzen das Element für Kustoden (Lagenbezeichnungen) und Reklamanten
            (Anfangswörter der Folgeseite), sofern diese transkribiert werden. Vgl. hierzu die <ref target="paratext.de.md">Transkriptionsrichtlinien</ref>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-06" xml:lang="fr">
                  <p>
            Nous utilisons cet élément pour les signatures (qui numérotent les cahiers en vue leur
            assemblage) et les réclames (premiers mots de la page suivante), à condition que ces
            éléments soient transcrits. Voir les <ref target="paratext.fr.md">principes de
            transcription</ref>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHSK">12.6. Headers, Footers, and Similar Matter</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-handShift"
                         ident="handShift">
               <gloss rend="replace" versionDate="2023-03-15" xml:lang="de">Handwechsel</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="en">change of hands</gloss>
               <gloss rend="replace" versionDate="2025-02-03" xml:lang="fr">changement de main</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Markiert den Wechsel einer Hand im Text.</desc>
               <desc rend="replace" versionDate="2023-05-11" xml:lang="en">Indicates the change of a hand.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Signale un changement de main dans le
    texte.</desc>
               <classes>
                  <memberOf key="att.written"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="hand" mode="change" usage="req"/>
                  <attDef ident="new" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-handShift-de" xml:lang="de">
                  <p>
                Beispiel für einen Handwechsel
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <handShift hand="otherHand"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handShift-en" xml:lang="en">
                  <p>
                Example of a hand shift
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <handShift hand="otherHand"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-handShift-fr" xml:lang="fr">
                  <p>
                Exemple de changement de main
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>mutter im leben wär, soll die mutter den dritten <handShift hand="otherHand"/>
                        <lb/>theil und die geschwüsterte die zwenn theil erben.
    </p>
                  </egXML>
               </exemplum>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDH">12.3.2.1. Document Hands</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-space"
                         ident="space">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Lücke</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">space</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">lacune</gloss>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="de">Markiert eine Lücke, die vom Schreiber bewusst
    zwecks späterer Ergänzung offen gelassen wurde.</desc>
               <desc rend="replace" versionDate="2023-05-11" xml:lang="en">Denotes a gap that the writer deliberately left
    open for later completion.</desc>
               <desc rend="replace" versionDate="2025-02-07" xml:lang="fr">Marque une lacune que le scribe a délibérément
    laissée ouverte en vue d’un complément ultérieur.</desc>
               <classes>
                  <memberOf key="att.dimensions"/>
               </classes>
               <content>
                  <empty/>
               </content>
               <attList>
                  <attDef ident="quantity" mode="change" usage="req">
                     <datatype>
                        <dataRef key="ssrq.quantity.positive"/>
                     </datatype>
                  </attDef>
                  <attDef ident="unit" mode="replace" usage="req">
                     <datatype>
                        <rng:choice>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.measure.lengths.base.cm"/>
                           <ref xmlns="http://relaxng.org/ns/structure/1.0"
                                name="ssrq.dimensions.typography"/>
                        </rng:choice>
                     </datatype>
                  </attDef>
                  <attDef ident="dim" mode="delete"/>
                  <attDef ident="resp" mode="delete"/>
               </attList>
               <exemplum xml:id="ex-space-de" xml:lang="de">
                  <p>
                Beispiel für einen Freiraum von 5 cm
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <space quantity="5" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-space-en" xml:lang="en">
                  <p>
                Example of a free space of 5 cm
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <space quantity="5" unit="cm"/>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-space-fr" xml:lang="fr">
                  <p>
                Exemple d’une lacune de 5 cm
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <space quantity="5" unit="cm"/>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Die Grösse der Lücke wird zwingend mit den Attributen <att>unit</att> und
            <att>quantity</att> angegeben. Dabei handelt es sich um ein leeres Element.
        </p>
                  <p>
            Fehlender Text infolge unbewusster Zeilensprünge wird, wenn er von den Bearbeitenden
            ergänzt wird, hingegen mit <gi>supplied</gi> ausgezeichnet.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            The size of the gap must be specified with <att>unit</att> and <att>quantity</att>.
            This is an empty tag. Gaps due to unintentional line jumps, on the other hand, are
            marked with <gi>supplied</gi>.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            La taille de la lacune est impérativement indiquée avec les attributs <att>unit</att>
            et <att>quantity</att>. Il s’agit d’un élément vide.
        </p>
                  <p>
            Le texte manquant en raison de sauts de ligne involontaires est en revanche signalé par
            éditeurs avec <gi>supplied</gi>.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHSP">12.4.1. Space</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-subst"
                         ident="subst">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Ersetzung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">substitution</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">substitution</gloss>
               <desc rend="replace" versionDate="2023-07-31" xml:lang="de">Enthält eine Ersetzung.</desc>
               <desc rend="replace" versionDate="2023-07-31" xml:lang="en">Contains a substitution.</desc>
               <desc rend="replace" versionDate="2023-07-31" xml:lang="fr">Contient une séquence de texte remplacée par une
    autre.</desc>
               <classes>
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                  <sequence minOccurs="1" maxOccurs="1" preserveOrder="false">
                     <elementRef key="del"/>
                     <elementRef key="add"/>
                     <elementRef key="lb" minOccurs="0"/>
                     <elementRef key="pb" minOccurs="0"/>
                  </sequence>
               </content>
               <constraintSpec ident="sch-el-subst" scheme="schematron" xml:lang="en">
                  <desc versionDate="2025-05-05" xml:lang="en">constraint for tei:subst</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:subst">
                           <sch:report test="tei:add[following-sibling::tei:del]"> tei:del must come
                    before tei:add when used inside tei:subst. </sch:report>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <constraintSpec ident="substContents1" scheme="schematron" xml:lang="en">
                  <constraint>
                     <sch:rule context="tei:subst">
                        <sch:assert test="child::tei:add and (child::tei:del or child::tei:surplus)">
                           <sch:name/> must have at least one child add and at least one child del or surplus</sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="replace">
                     <desc versionDate="2025-02-14" xml:lang="de">die Art der Ersetzung</desc>
                     <desc versionDate="2025-02-14" xml:lang="en">the type of substitution</desc>
                     <desc versionDate="2025-02-14" xml:lang="fr">le type de substitution</desc>
                     <datatype>
                        <dataRef key="ssrq.type.subst"/>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-subst-de" xml:lang="de">
                  <p>
                Beispiel für eine Ersetzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-en" xml:lang="en">
                  <p>
                Example of a replacement
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-fr" xml:lang="fr">
                  <p>
                Exemple d’un remplacement (l’ajout remplace une suppression)
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>zugeschafft</del>
                        <add place="above">angethan</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-lb-de" xml:lang="de">
                  <p>
                Beispiel für eine Ersetzung mit Zeilenumbruch
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>ihr gnaden</del>
                        <lb/>
                        <add hand="hand17c" place="left margin">man</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-lb-en" xml:lang="en">
                  <p>
                Example of a replacement with a line break
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>ihr gnaden</del>
                        <lb/>
                        <add hand="hand17c" place="left margin">man</add>
                     </subst>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-subst-lb-fr" xml:lang="fr">
                  <p>
                Exemple de substitution avec un saut de ligne
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <subst>
                        <del>ihr gnaden</del>
                        <lb/>
                        <add hand="hand17c" place="left margin">man</add>
                     </subst>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-02-07" xml:lang="de">
                  <p>
            Gruppiert eine Tilgung (oder überschüssigen Text) mit einer Hinzufügung in beliebiger
            Reihenfolge, wenn die Kombination beider Vorgänge als einzelner Eingriff in den Text zu
            betrachten ist.
        </p>
               </remarks>
               <remarks versionDate="2023-11-16" xml:lang="en">
                  <p>
            Groups one deletion (or excess text) with one addition in any order if the combination
            should be considered as a single intervention in the text.
        </p>
               </remarks>
               <remarks versionDate="2025-02-07" xml:lang="fr">
                  <p>
            Regroupe une suppression (ou un texte en trop) avec un ajout, dans n’importe quel
            ordre, si la combinaison des deux opérations doit être considérée comme une seule
            intervention sur le texte.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHSU">12.3.1.5. Substitutions</ref>
               </listRef>
            </elementSpec>
            <elementSpec xmlns:rng="http://relaxng.org/ns/structure/1.0"
                         xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                         rend="change"
                         module="transcr"
                         xml:id="gi-supplied"
                         ident="supplied">
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="de">Ergänzung</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="en">supplement</gloss>
               <gloss rend="replace" versionDate="2025-02-04" xml:lang="fr">ajout</gloss>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="de">Enthält eine Ergänzung durch die
    Bearbeitenden.</desc>
               <desc rend="replace" versionDate="2023-07-14" xml:lang="en">Contains an addition by the editor.</desc>
               <desc rend="replace" versionDate="2025-02-06" xml:lang="fr">Contient un ajout de la part des éditeurs.</desc>
               <classes>
                  <memberOf key="att.global.responsibility"/>
                  <memberOf key="att.global.source"/>
               </classes>
               <content>
                  <alternate minOccurs="1" maxOccurs="unbounded">
                     <elementRef key="p"/>
                     <macroRef key="ssrq.content.default"/>
                  </alternate>
               </content>
               <constraintSpec ident="sch-el-supplied" scheme="schematron" xml:lang="en">
                  <desc versionDate="2023-05-02" xml:lang="en">constraint for tei:supplied</desc>
                  <constraint>
                     <sch:pattern>
                        <sch:rule context="tei:supplied">
                           <sch:assert test=".[@resp][not(@source)] or .[@source][not(@resp)]">
                    tei:supplied must contain either a @resp or a @source attribute. </sch:assert>
                        </sch:rule>
                        <sch:rule context="tei:supplied[@source]">
                           <sch:let name="sources"
                                    value="for $source in tokenize(@source, ' ')                     return replace($source,                     '^(id-ssrq-[\w\d-]+)(#(\d+|fol\d+[rv]?|[pn]\d+))?$',                     '$1')"/>
                           <sch:assert test="every $source in $sources satisfies exists(id($source))"
                                       xml:lang="en"> Every referenced ID in @source must belong to an element with
                    the same ID. </sch:assert>
                        </sch:rule>
                     </sch:pattern>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="reason" mode="replace">
                     <desc versionDate="2025-02-03" xml:lang="de">der Grund für die Ergänzung</desc>
                     <desc versionDate="2025-02-03" xml:lang="en">the reason for the supplement</desc>
                     <desc versionDate="2025-02-03" xml:lang="fr">la raison de l’ajout</desc>
                     <datatype>
                        <dataRef key="ssrq.reason.supplied"/>
                     </datatype>
                  </attDef>
                  <attDef ident="cert" mode="delete"/>
                  <attDef ident="source" mode="replace">
                     <datatype>
                        <rng:list>
                           <rng:oneOrMore>
                              <rng:choice>
                                 <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.id"/>
                                 <ref xmlns="http://relaxng.org/ns/structure/1.0" name="ssrq.pointer.urn"/>
                              </rng:choice>
                           </rng:oneOrMore>
                        </rng:list>
                     </datatype>
                  </attDef>
               </attList>
               <exemplum xml:id="ex-supplied-de" xml:lang="de">
                  <p>
                Beispiel für eine Ergänzung
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Item so sollend die <supplied reason="omitted" resp="rhr">von</supplied> Mure,
        <lb/>von Bintz und von Egmatingen den weg gen.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-supplied-en" xml:lang="en">
                  <p>
                Example of an addition
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Item so sollend die <supplied reason="omitted" resp="rhr">von</supplied> Mure,
        <lb/>von Bintz und von Egmatingen den weg gen.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-supplied-fr" xml:lang="fr">
                  <p>
                Exemple d’ajout
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <p>
                        <lb/>Item so sollend die <supplied reason="omitted" resp="rhr">von</supplied> Mure,
        <lb/>von Bintz und von Egmatingen den weg gen.
    </p>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-de" xml:lang="de">
                  <p>
                Beispiel für eine beschädigte Stelle, deren Text ergänzt wurde
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-en" xml:lang="en">
                  <p>
                Example of a damaged passage whose text has been added
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <exemplum xml:id="ex-damage-supplied-fr" xml:lang="fr">
                  <p>
                Exemple d’un passage altéré dont le texte a été complété
            </p>
                  <egXML xmlns="http://www.tei-c.org/ns/Examples">
                     <damage agent="water">
                        <supplied source="id-ssrq-ad28656b-5c8d-459c-afb4-3e6ddf70810f">verthruwen</supplied>
                     </damage>
                  </egXML>
               </exemplum>
               <remarks versionDate="2025-07-14" xml:lang="de">
                  <p>
            Wenn die Bearbeitenden eine Passage frei ergänzen, weisen sie sich im Attribut
            <att>resp</att> mit ihrem Kürzel aus. Erfolgt eine Textergänzung anhand einer weiteren
            Textvorlage, wird auf diese mit dem Attribut <att>source</att> referenziert. Der Grund
            für eine Ergänzung kann mit <att>reason</att> angegeben werden. Eine Anmerkung in
            <gi>note</gi> oder ein Kommentar in <gi>back</gi> ist nötig.
        </p>
               </remarks>
               <remarks versionDate="2023-07-14" xml:lang="en">
                  <p>
            If an editor freely adds a passage, he identifies himself in <att>resp</att> with his
            abbreviation. If a text is supplemented using another text template, this is referenced
            with <att>source</att>. The reason for an addition can be specified with
            <att>reason</att>. A note in <gi>note</gi> or a comment in <gi>back</gi> is required.
        </p>
               </remarks>
               <remarks versionDate="2025-07-14" xml:lang="fr">
                  <p>
            Si un éditeur ajoute librement un passage, il s’identifie avec <att>resp</att> en
            indiquant son abréviation. Si un texte est complété à l’aide d’une autre variante de
            texte, celle-ci est référencée par <att>source</att>. La raison d’un ajout peut être
            signalée avec l’attribut <att>reason</att>. Une <gi>note</gi> ou un commentaire dans
            <gi>back</gi> est nécessaire.
        </p>
               </remarks>
               <listRef>
                  <ref target="https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA">12.3.3.1. Damage, Illegibility, and Supplied Text</ref>
               </listRef>
            </elementSpec>
            <moduleSpec ident="ssrq.core.module">
               <desc versionDate="2025-01-30" xml:lang="de">das Modul für SSRQ-spezifische
            Hinzufügungen</desc>
               <desc versionDate="2025-01-30" xml:lang="en">the module for SLS specific
            additions</desc>
               <desc versionDate="2025-01-30" xml:lang="fr">le module pour les ajouts spécifiques
            SDS</desc>
            </moduleSpec>
            <classSpec rend="add"
                       ident="ssrq.att.seal"
                       mode="add"
                       module="ssrq.core.module"
                       type="atts">
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-28"
                     xml:lang="de">eine Klasse von Attributen zur
            Beschreibung von Siegeln</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-28"
                     xml:lang="en">a class of attributes for describing
            seals</desc>
               <desc xmlns:rng="http://relaxng.org/ns/structure/1.0"
                     versionDate="2025-01-28"
                     xml:lang="fr">une classe d’attributs permettant de
            décrire les sceaux</desc>
               <attList xmlns:rng="http://relaxng.org/ns/structure/1.0">
                  <attDef ident="attachment" mode="add">
                     <desc versionDate="2025-01-28" xml:lang="de">die Befestigungsart des
                    Siegels</desc>
                     <desc versionDate="2025-01-28" xml:lang="en">the method of attachment of the
                    seal</desc>
                     <desc versionDate="2025-01-28" xml:lang="fr">le type d’apposition du
                    sceau</desc>
                     <valList type="closed">
                        <valItem ident="applied">
                           <desc versionDate="2023-05-31" xml:lang="de">aufgedrückt</desc>
                           <desc versionDate="2023-05-31" xml:lang="en">applied</desc>
                           <desc versionDate="2023-05-31" xml:lang="fr">plaqué</desc>
                           <desc versionDate="2023-05-31" xml:lang="it">aderente</desc>
                        </valItem>
                        <valItem ident="sealed_on_a_cord">
                           <desc versionDate="2023-05-31" xml:lang="de">angehängt an einer
                            Kordel</desc>
                           <desc versionDate="2023-05-31" xml:lang="en">sealed on a cord</desc>
                           <desc versionDate="2023-05-31" xml:lang="fr">attaché à une
