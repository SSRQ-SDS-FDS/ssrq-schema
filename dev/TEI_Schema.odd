                        <desc versionDate="2022-09-05" xml:lang="it">a piè di pagina</desc>
                     </valItem>
                     <valItem ident="cover">
                        <desc versionDate="2023-05-02" xml:lang="de">auf dem Umschlag</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">on the cover</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">sur la couverture</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">sulla copertina</desc>
                     </valItem>
                     <valItem ident="cover_above">
                        <desc versionDate="2023-05-02" xml:lang="de">auf dem Umschlag oben</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">at the top of the cover</desc>
                        <desc versionDate="2023-05-02" xml:lang="fr">en haut de la
                        couverture</desc>
                        <desc versionDate="2022-09-05" xml:lang="it">nella parte superiore della
                        copertina</desc>
                     </valItem>
                     <valItem ident="cover_bottom">
                        <desc versionDate="2023-05-02" xml:lang="de">auf dem Umschlag unten</desc>
                        <desc versionDate="2023-05-02" xml:lang="en">at the bottom of the
