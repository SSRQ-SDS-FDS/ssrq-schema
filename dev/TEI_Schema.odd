            </classSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-calendar"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of dating
            attributes</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[@calendar]">
                        <sch:assert test=".[@when-custom|@notBefore-custom|@notAfter-custom|@from-custom|@to-custom]"> More attributes must be used together with @calendar to specify the date. </sch:assert>
                     </sch:rule>
                     <sch:rule context="tei:*[@when-custom|@notBefore-custom|@notAfter-custom|@from-custom|@to-custom][not(ancestor::tei:publicationStmt)][not(self::tei:time)]">
                        <sch:assert test=".[@calendar]"> @calendar must be used, when either
                        @when-custom, @from-custom, @to-custom, @notAfter-custom or
                        @notBefore-custom is used. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-data-custom"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of custom
            dating attributes</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[@when-custom]">
                        <sch:report test="@notBefore-custom|@notAfter-custom|@from-custom|@to-custom">
                        @when-custom cannot be used together with @notBefore-custom,
                        @notAfter-custom, @from-custom or @to-custom. </sch:report>
                     </sch:rule>
                     <sch:rule context="tei:*[@from-custom or @to-custom]">
                        <sch:assert test="@from-custom and @to-custom"> @from-custom and @to-custom
                        must always be used together. </sch:assert>
                        <sch:report test="@notBefore-custom|@notAfter-custom"> The usage of
                        @notBefore-custom and @notAfter-custom is not allowed together with
                        @from-custom and @to-custom. </sch:report>
                        <sch:assert test="if (matches(@from-custom,                         '^\d{4}-\d{2}-\d{2}$') and matches(@from-custom,                         '^\d{4}-\d{2}-\d{2}$')) then (number(translate(@to-custom,                         '-', '')) - number(translate(@from-custom,                         '-', ''))) &gt; 0 else true()"> Invalid timespan:
                        @to-custom must be a point later in time than @from-custom. </sch:assert>
                     </sch:rule>
                     <sch:rule context="tei:*[@notBefore-custom and @notAfter-custom]">
                        <sch:assert test="if (matches(@notBefore-custom,                         '^\d{4}-\d{2}-\d{2}$') and matches(@notAfter-custom,                         '^\d{4}-\d{2}-\d{2}$')) then (number(translate(@notAfter-custom,                         '-', '')) - number(translate(@notBefore-custom,                         '-', ''))) &gt; 0 else true()"> Invalid timespan:
                        @notAfter-custom must be a point later in time than @notBefore-custom.
                        </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-dimensions"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of @quantity
            and @unit</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[@unit='unknown']">
                        <sch:assert test="./@quantity='unknown'" xml:lang="en"> If @unit
                        has the value 'unknown', @quantity must be 'unknown'
                        too. </sch:assert>
                     </sch:rule>
                     <sch:rule context="tei:*[@unit or @quantity]">
                        <sch:assert test="@quantity and @unit" xml:lang="en"> @unit and @quantity
                        must be used together. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-dimensions-2"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to prevent that quantity is
            zero</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[number(@quantity)=0 or number(@quantity)=0.0]">
                        <sch:report test="not(@type='currency')" xml:lang="en"> @quantity
                        may only be zero, if it occurs in combination with
                        @type="currency". </sch:report>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-spanTo"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the usage of
            @spanTo</desc>
               <constraint>
                  <sch:rule context="tei:*[@spanTo]">
                     <sch:assert test="id(@spanTo) and following::*[@xml:id=(current()/@spanTo)]">
                    The element indicated by @spanTo (
                        <sch:value-of select="@spanTo"/>
                        ) must occur after the current element <sch:name/>. </sch:assert>
                  </sch:rule>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-facs"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure the pattern of
            facsimile names</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="*[@facs]">
                        <sch:report test="matches(@facs, '__')" xml:lang="en"> An
                        underscore should not be followed by another underscore in @facs.
                        </sch:report>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-wit"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the reference of
            @wit</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[@wit]">
                        <sch:let name="wits"
                                 value="for $wit in tokenize(@wit, ' ')                         return tokenize($wit, '#')[1]"/>
                        <sch:assert test="every $wit in $wits satisfies id($wit)/name() =                         ('bibl', 'witness')"
                                    xml:lang="en"> Every referenced ID
                        in @wit must belong to a tei:witness or tei:bibl element. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-att-hand"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to check the reference of
            @hand</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[@hand]">
                        <sch:let name="handNoteRef" value="@hand"/>
                        <sch:assert test="exists(id($handNoteRef)) and id($handNoteRef)/name() =                         'handNote'"> The referenced ID in @hand must belong to a
                        tei:handNote element. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-trim-attributes"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to trim any attribute
            value</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="@*">
                        <sch:report test="matches(., '^(\s+|\t+|\n)(.*)$')" xml:lang="en"> The value of <sch:name/> should not start with whitespace.
                        </sch:report>
                        <sch:report test="matches(., '^(.*)(\s+|\t+|\n)$')" xml:lang="en"> The value of <sch:name/> should not end with whitespace.
                        </sch:report>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-duplicate-attribute-values"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure that no attribute has
            duplicate values</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="@*">
                        <sch:assert test="count(distinct-values(tokenize(.))) =                         count(tokenize(.))"> An attribute should not have duplicate values.
                        </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-non-empty-elements"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to ensure the usage of text in
            elements</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:*[name() = ('ab', 'abbr',                     'add', 'additional', 'author',                     'availability', 'bibl', 'body',                     'custEvent', 'custodialHist', 'del',                     'dimensions', 'div', 'docImprint',                     'editorialDecl', 'encodingDesc', 'expan',                     'extent', 'foreign', 'fw', 'handDesc',                     'head', 'hi', 'history', 'idno',                     'item', 'keywords', 'label', 'lem',                     'licence', 'list', 'listBibl',                     'listWit', 'measure', 'measureGrp',                     'msContents', 'msItem', 'note', 'num',                     'objectDesc', 'orgName', 'orig',                     'origPlace', 'p', 'persName',                     'physDesc', 'placeName', 'publicationStmt',                     'publisher', 'pubPlace', 'q', 'quote',                     'repository', 'resp', 'respStmt',                     'row', 'sealDesc', 'seg', 'settlement',                     'sic', 'signed', 'sourceDesc', 'subst',                     'summary', 'supplied', 'support',                     'supportDesc', 'table', 'TEI',                     'teiHeader', 'text', 'textClass',                     'time', 'title', 'unclear',                     'witness')][not(*)]">
                        <sch:assert test="string-length(normalize-space(.)) &gt; 0"> The element
                        <sch:name/> must not be empty. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="non-breaking-whitespace"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-01-28" xml:lang="en">constraint to forbid non-breaking
            space</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="text()">
                        <sch:report role="warning" test="matches(., ' ')"> It is not
                        allowed to use a non-breaking space in the text. </sch:report>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="no-quotation-marks"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-05-19" xml:lang="en">constraint to forbid quotation
            marks</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="text()">
                        <sch:report role="warning" test="matches(., '[«»‹›]')">It is not
                        allowed to use quotation marks in the text. Use tei:quote, tei:q, tei:orig
                        or tei:foreign instead.</sch:report>
                     </sch:rule>
                  </sch:pattern>
                  <sch:pattern>
                     <sch:rule context="text()[not(./ancestor::tei:cell)]">
                        <sch:report role="warning" test="matches(., '&#34;')">It is not
                        allowed to use quotation marks in the text. Use tei:quote, tei:q, tei:orig
                        or tei:foreign instead.</sch:report>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="sch-milestones"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-09-01" xml:lang="en">constraint for milestones</desc>
               <constraint>
                  <sch:pattern>
                     <sch:rule context="tei:pb | tei:cb | tei:lb">
                        <sch:assert test="ancestor::tei:body or ancestor::tei:orig">tei:<sch:name/>
                        may only be used inside tei:body or tei:orig. </sch:assert>
                     </sch:rule>
                  </sch:pattern>
               </constraint>
            </constraintSpec>
            <constraintSpec xmlns:sch="http://purl.oclc.org/dsdl/schematron"
                            ident="unique-xml-ids"
                            scheme="schematron"
                            xml:lang="en">
               <desc versionDate="2025-10-20" xml:lang="en">constraint to ensure the uniqueness of
            xml:id attributes. </desc>
               <constraint>
                  <sch:rule context="tei:TEI">
                     <sch:assert test="count(//@xml:id) = count(distinct-values(//@xml:id))"> All
                    values of @xml:id attributes in this document must be unique. </sch:assert>
                  </sch:rule>
               </constraint>
            </constraintSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.anchor.spans"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-08-17" xml:lang="de">Anker- und umspannende Elemente</desc>
               <desc versionDate="2023-08-17" xml:lang="en">anchor and spanning elements</desc>
               <desc versionDate="2023-08-17" xml:lang="fr">éléments d’ancrage et de serrage</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="addSpan"/>
                     <elementRef key="anchor"/>
                     <elementRef key="damageSpan"/>
                     <elementRef key="delSpan"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.content"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-03-23" xml:lang="de">inhaltliche Auszeichnung</desc>
               <desc versionDate="2023-06-29" xml:lang="en">distinction of content</desc>
               <desc versionDate="2023-03-23" xml:lang="fr">distinction du contenu</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="date"/>
                     <elementRef key="num"/>
                     <elementRef key="time"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.critical"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-03-23" xml:lang="de">textkritische Auszeichnungen</desc>
               <desc versionDate="2023-06-29" xml:lang="en">critical markup</desc>
               <desc versionDate="2023-03-23" xml:lang="fr">distinctions de la critique
            textuelle</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="abbr"/>
                     <elementRef key="add"/>
                     <elementRef key="app"/>
                     <elementRef key="choice"/>
                     <elementRef key="damage"/>
                     <elementRef key="del"/>
                     <elementRef key="foreign"/>
                     <elementRef key="gap"/>
                     <elementRef key="handShift"/>
                     <elementRef key="note"/>
                     <elementRef key="sic"/>
                     <elementRef key="space"/>
                     <elementRef key="subst"/>
                     <elementRef key="supplied"/>
                     <elementRef key="unclear"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.default"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-06-29" xml:lang="de">standardmässiger Inhalt</desc>
               <desc versionDate="2023-06-29" xml:lang="en">default content</desc>
               <desc versionDate="2023-06-29" xml:lang="fr">contenu par défaut</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <textNode/>
                     <macroRef key="ssrq.content.anchor.spans"/>
                     <macroRef key="ssrq.content.content"/>
                     <macroRef key="ssrq.content.critical"/>
                     <macroRef key="ssrq.content.display"/>
                     <macroRef key="ssrq.content.entities"/>
                     <macroRef key="ssrq.content.measure"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.display"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-06-29" xml:lang="de">Markup, das die Darstellung
            beschreibt</desc>
               <desc versionDate="2023-06-29" xml:lang="en">markup that describes the
            presentation</desc>
               <desc versionDate="2023-06-29" xml:lang="fr">balisage qui décrit la présentation</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="ab"/>
                     <elementRef key="cb"/>
                     <elementRef key="figure"/>
                     <elementRef key="fw"/>
                     <elementRef key="head"/>
                     <elementRef key="hi"/>
                     <elementRef key="label"/>
                     <elementRef key="lb"/>
                     <elementRef key="orig"/>
                     <elementRef key="pb"/>
                     <elementRef key="pc"/>
                     <elementRef key="q"/>
                     <elementRef key="quote"/>
                     <elementRef key="signed"/>
                     <elementRef key="table"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.entities"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-06-29" xml:lang="de">Auszeichnung von mit Namen versehenen
            Entitäten</desc>
               <desc versionDate="2023-06-29" xml:lang="en">markup of named entities</desc>
               <desc versionDate="2023-06-29" xml:lang="fr">balisage des entités nommées</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="orgName"/>
                     <elementRef key="persName"/>
                     <elementRef key="placeName"/>
                     <elementRef key="term"/>
                  </alternate>
               </content>
            </macroSpec>
            <macroSpec rend="add"
                       ident="ssrq.content.measure"
                       mode="add"
                       module="ssrq.core.module">
               <desc versionDate="2023-06-29" xml:lang="de">Auszeichnung von Massen und ähnlichen
            Dingen</desc>
               <desc versionDate="2023-06-29" xml:lang="en">marking of measures and similar
            things</desc>
               <desc versionDate="2023-03-23" xml:lang="fr">distinction des mesures et choses
            similaires</desc>
               <content>
                  <alternate minOccurs="1" maxOccurs="1">
                     <elementRef key="measure"/>
                     <elementRef key="measureGrp"/>
                  </alternate>
               </content>
            </macroSpec>
            <dataSpec rend="add"
                      module="derived-module-ssrq-main-schema"
                      ident="ssrq.agent"
                      mode="add">
