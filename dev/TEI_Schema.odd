                     <desc versionDate="2024-11-13" xml:lang="en">to</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">à</desc>
                     <desc versionDate="2024-11-13" xml:lang="it">a</desc>
                  </valItem>
                  <valItem ident="week">
                     <desc versionDate="2024-11-13" xml:lang="de">Woche</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="de">Wochen</desc>
                     <desc versionDate="2024-11-13" xml:lang="en">week</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="en">weeks</desc>
                     <desc versionDate="2024-11-13" xml:lang="fr">semaine</desc>
                     <desc type="plural" versionDate="2024-11-13" xml:lang="fr">semaines</desc>
